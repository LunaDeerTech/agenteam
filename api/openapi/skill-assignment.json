          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded complete JSON representation; no-store, at most 128 KiB. HEAD validates the same representation and emits no body.",
            "headers": {
              "Cache-Control": {
