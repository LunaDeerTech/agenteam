  "info": {
    "title": "Current Human Owner Agent Skill assignments",
    "version": "1.0.0",
    "description": "Explicit same-transaction Skill configuration commands and safe current reads over the default App graph. No model execution, skill package installation, AgentRun management tool or expanded Tool/Mount/Model/Secret selections."
  },
