          "name": "agent_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "./common.json#/components/schemas/ID"
          }
        }
      ],
      "post": {
        "operationId": "skillAssignmentLookupCommand",
        "description": "Reads only the original complete intent and key, with current Owner/Project and initialized Agent authorization, including initialized deleting Agents. Does not compare historical expected_version with the current version. not_observed does not prove non-commit and does not authorize automatic resend. Expected version is Agent.config_version. Strict 8 KiB JSON; unknown/duplicate members and query rejected. Original Origin/CSRF boundary. Total 30s including cleanup. Unknown retains original key and complete intent for explicit lookup. A queued ingress receipt is durable pending, not evidence of RoundInput application, resumed waiting or a model call.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "./common.json#/components/schemas/IdempotencyKey"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
