    "/api/v1/projects/{project_id}/agents/{agent_id}/skills/assign": {
      "parameters": [
        {
          "name": "project_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "./common.json#/components/schemas/ID"
          }
        },
        {
          "name": "agent_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "./common.json#/components/schemas/ID"
          }
        }
      ],
      "post": {
        "operationId": "skillAssignmentAssignCommand",
        "description": "Explicit enabled=true assigns or enables. enabled=false saves disabled configuration and revokes current use. Changing enabled retires the old AssignmentID and creates a new identity. Same Skill and enabled is a no-op; no installation or tool authorization. Expected version is Agent.config_version. Strict 8 KiB JSON; unknown/duplicate members and query rejected. Original Origin/CSRF boundary. Total 30s including cleanup. Unknown retains original key and complete intent for explicit lookup. A queued ingress receipt is durable pending, not evidence of RoundInput application, resumed waiting or a model call.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "./common.json#/components/schemas/IdempotencyKey"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bounded complete JSON representation; no-store, at most 128 KiB. HEAD validates the same representation and emits no body.",
            "headers": {
              "Cache-Control": {
