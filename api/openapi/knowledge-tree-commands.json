  "components": {
    "schemas": {
      "Title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "not": {
          "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]"
        }
      },
      "ConfirmationToken": {
        "type": "string",
        "minLength": 5,
        "maxLength": 8192,
        "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
        "not": {
          "pattern": "\\s"
        },
        "description": "Opaque original confirmation material. Signature/current scope and replay order are owned by Knowledge Service."
      },
      "Creator": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "user_id"
            ],
            "properties": {
              "kind": {
                "const": "human"
              },
              "user_id": {
                "$ref": "./common.json#/components/schemas/ID"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "project_id",
              "agent_id",
              "execution_id"
            ],
            "properties": {
              "kind": {
                "const": "agent_run"
              },
              "project_id": {
                "$ref": "./common.json#/components/schemas/ID"
              },
              "agent_id": {
                "$ref": "./common.json#/components/schemas/ID"
              },
              "execution_id": {
                "$ref": "./common.json#/components/schemas/ID"
              }
            }
          }
        ]
      },
      "Document": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "project_id",
          "parent_document_id",
          "title",
          "content_version",
          "source_kind",
          "media_type",
          "status",
          "indexing_status",
          "created_by",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "project_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "parent_document_id": {
            "oneOf": [
              {
                "$ref": "./common.json#/components/schemas/ID"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "$ref": "#/components/schemas/Title"
          },
          "content_version": {
            "$ref": "./common.json#/components/schemas/Version"
          },
          "source_kind": {
            "enum": [
              "text",
              "file"
            ]
          },
          "media_type": {
            "enum": [
              "text/markdown",
              "text/plain",
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            ]
          },
          "status": {
            "const": "active"
          },
          "indexing_status": {
            "enum": [
              "pending",
              "processing",
              "ready",
              "failed"
            ]
          },
          "created_by": {
            "$ref": "#/components/schemas/Creator"
          },
          "created_at": {
            "$ref": "./common.json#/components/schemas/Instant"
          },
          "updated_at": {
            "$ref": "./common.json#/components/schemas/Instant"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source_kind": {
                  "const": "text"
                }
              }
            },
            "then": {
              "properties": {
                "media_type": {
                  "enum": [
                    "text/markdown",
                    "text/plain"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "media_type": {
                  "enum": [
                    "application/pdf",
                    "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                  ]
                }
              }
            }
          }
        ]
      },
      "RenameRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_version",
          "title"
        ],
        "properties": {
          "expected_version": {
            "$ref": "./common.json#/components/schemas/Version"
          },
          "title": {
            "$ref": "#/components/schemas/Title"
          }
        }
      },
      "MoveRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_parent_id",
          "target_parent_id"
        ],
        "properties": {
          "expected_parent_id": {
            "oneOf": [
              {
                "$ref": "./common.json#/components/schemas/ID"
              },
              {
                "type": "null"
              }
            ]
          },
          "target_parent_id": {
            "oneOf": [
              {
                "$ref": "./common.json#/components/schemas/ID"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "PreviewRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      },
      "DeleteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "confirmation_token"
        ],
        "properties": {
          "confirmation_token": {
            "$ref": "#/components/schemas/ConfirmationToken"
          }
        }
      },
      "LookupRequest": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "document_id",
              "request"
            ],
            "properties": {
              "command": {
                "const": "update"
              },
              "document_id": {
                "$ref": "./common.json#/components/schemas/ID"
              },
              "request": {
                "$ref": "#/components/schemas/RenameRequest"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "document_id",
              "request"
            ],
            "properties": {
              "command": {
                "const": "move"
              },
              "document_id": {
                "$ref": "./common.json#/components/schemas/ID"
              },
              "request": {
                "$ref": "#/components/schemas/MoveRequest"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "document_id",
              "request"
            ],
            "properties": {
              "command": {
                "const": "delete-subtree"
              },
              "document_id": {
                "$ref": "./common.json#/components/schemas/ID"
              },
              "request": {
                "$ref": "#/components/schemas/DeleteRequest"
              }
            }
          }
        ]
      },
      "RenameResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document"
        ],
        "properties": {
          "document": {
            "$ref": "#/components/schemas/Document"
          }
        }
      },
      "MoveResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document",
          "changed"
        ],
        "properties": {
          "document": {
            "$ref": "#/components/schemas/Document"
          },
          "changed": {
            "type": "boolean"
          }
        }
      },
      "PreviewResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root_id",
          "nodes",
          "scope_digest",
          "confirmation_token",
          "expires_at"
        ],
        "properties": {
          "root_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          },
          "scope_digest": {
            "$ref": "./common.json#/components/schemas/Digest"
          },
          "confirmation_token": {
            "$ref": "#/components/schemas/ConfirmationToken"
          },
          "expires_at": {
            "$ref": "./common.json#/components/schemas/Instant"
          }
        }
      },
      "DeleteResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root_id",
          "deleted_ids",
          "cleanup_pending"
        ],
        "properties": {
          "root_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "deleted_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "./common.json#/components/schemas/ID"
            }
          },
          "cleanup_pending": {
            "type": "boolean"
          }
        }
      },
      "DocumentReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "document",
          "changed"
        ],
        "properties": {
          "command": {
            "enum": [
              "update",
              "move"
            ]
          },
          "document": {
            "$ref": "#/components/schemas/Document"
          },
          "changed": {
            "type": "boolean"
          }
        }
      },
      "DeleteReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "root_id",
          "changed",
          "deleted_ids",
          "cleanup_pending"
        ],
        "properties": {
          "command": {
            "const": "delete-subtree"
          },
          "root_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "changed": {
            "const": true
          },
          "deleted_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "./common.json#/components/schemas/ID"
            }
          },
          "cleanup_pending": {
            "type": "boolean"
          }
        }
      },
      "LookupResult": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "receipt"
            ],
            "properties": {
              "state": {
                "enum": [
                  "in_progress",
                  "not_observed"
                ]
              },
              "receipt": {
                "type": "null"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "receipt"
            ],
            "properties": {
              "state": {
                "const": "committed"
              },
              "receipt": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/DocumentReceipt"
                  },
                  {
                    "$ref": "#/components/schemas/DeleteReceipt"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "$ref": "./common.json#/components/schemas/IdempotencyKey"
        },
        "description": "Exactly one original business key; no trimming, automatic generation or replay."
      },
      "CSRF": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Original safe Account Problem and CommitState; no internal material. Expired or failed native I/O aborts the connection.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "./common.json#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-agenteam_session",
        "description": "Original Account Session; configured loopback HTTP uses agenteam_local_session. No caller Actor or bearer bypass."
      }
    }
  }
}
