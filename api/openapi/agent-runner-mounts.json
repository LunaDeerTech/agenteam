  "components": {
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-agenteam_session"
      }
    },
    "responses": {
      "Problem": {
        "description": "Safe Problem Details.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "./common.json#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "AvailableRunner": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "version",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 4096
          },
          "version": {
            "$ref": "./common.json#/components/schemas/Version"
          },
          "status": {
            "enum": [
              "online",
              "offline",
              "incompatible"
            ]
          }
        }
      },
      "AvailableRunnerPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/AvailableRunner"
            }
          },
          "next_cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        }
      },
      "RunnerMountItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mount_id",
          "runner_id",
          "workspace",
          "name"
        ],
        "properties": {
          "mount_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "runner_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "workspace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,254}$",
            "description": "Exact portable single ASCII segment. No trailing dot; first dot-separated segment must not equal CON/PRN/AUX/NUL/COM1..9/LPT1..9 case-insensitively. No normalization or truncation."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "AgentRunnerMounts": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "agent_id",
          "agent_version",
          "items"
        ],
        "properties": {
          "project_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "agent_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "agent_version": {
            "$ref": "./common.json#/components/schemas/Version"
          },
          "items": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "$ref": "#/components/schemas/RunnerMountItem"
            }
          }
        }
      }
    }
  }
