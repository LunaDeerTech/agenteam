    "/api/v1/projects/{project_id}/available-runners": {
      "parameters": [
        {
          "name": "project_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "./common.json#/components/schemas/ID"
          }
        }
      ],
