                "type": "null"
              }
            }
          }
        ]
      },
      "AgentUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{1,30}[A-Za-z0-9]$"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "tag_color": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 8192
          },
          "instructions": {
            "type": "string",
            "maxLength": 32768
          },
          "inject_agents_md": {
            "type": "boolean"
          },
          "model_ref": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "reasoning_effort": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "approval_policy": {
            "enum": [
              "default",
              "auto",
              "allow"
            ]
          },
          "approval_model_ref": {
            "anyOf": [
              {
                "$ref": "./common.json#/components/schemas/ID"
              },
              {
                "type": "null"
              }
            ]
          },
          "allowed_tool_ids": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "$ref": "./common.json#/components/schemas/ID"
            },
            "description": "Explicit non-null canonical ascending IDs; each set <=128 and all three sets together <=256. Go validates order and the combined bound."
          },
          "allowed_mount_ids": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "$ref": "./common.json#/components/schemas/ID"
            },
            "description": "Explicit non-null canonical ascending IDs; each set <=128 and all three sets together <=256. Go validates order and the combined bound."
          },
          "allowed_secret_variable_ids": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "$ref": "./common.json#/components/schemas/ID"
            },
            "description": "Explicit non-null canonical ascending IDs; each set <=128 and all three sets together <=256. Go validates order and the combined bound."
          },
          "runner_mounts": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "$ref": "#/components/schemas/RunnerMountDeclaration"
            },
            "description": "Unique (runner_id,workspace) pairs, preserved original order. Mutually exclusive with allowed_mount_ids; null rejects. Counts toward the original total 256 references and complete JSON 512 KiB cap."
          }
        },
        "description": "A presence-preserving patch, not a replacement configuration. Omission leaves a field unchanged; null clears only display_name, tag_color, reasoning_effort and approval_model_ref. Non-null false, empty strings and empty reference arrays are explicit values. Each supplied array fully replaces that set; creation defaults are never reinserted. The domain validates the complete proposed configuration and current references, including Model/approval compatibility. Identity, version, lifecycle, timestamps, Skill assignments and the two creation-only switches are forbidden.",
        "allOf": [
          {
            "not": {
              "required": [
                "allowed_mount_ids",
                "runner_mounts"
              ]
            }
          }
        ]
      },
      "AgentUpdateBody": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_version",
          "request"
        ],
        "properties": {
