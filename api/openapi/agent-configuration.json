                  "$ref": "./common.json#/components/schemas/ID"
                }
              }
            },
            "else": {
              "properties": {
                "approval_model_ref": {
                  "type": "null"
                }
              }
            }
          }
        ],
        "description": "Complete current Owner configuration, not the nine-field directory, an Execution snapshot or a capability grant. Only an active Agent with a completed-create publication proof is readable. No Skill package/assignment list, Model parameters, credentials or Secret material. Version is the original positive int64 decimal string; normalized_name and timestamp relationships are additionally checked by Go."
      },
      "AgentCreateMutation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "changed",
          "event_ids"
        ],
        "properties": {
          "agent": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AgentConfig"
              },
              {
                "properties": {
                  "version": {
                    "const": "1"
                  }
                }
              }
            ]
          },
          "changed": {
            "const": true
          },
          "event_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "./common.json#/components/schemas/ID"
            }
          },
          "runner_mounts": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "$ref": "#/components/schemas/RunnerMountBinding"
            },
            "description": "Present if and only if original request used runner_mounts, including []. Frozen original command allocations match declarations one-for-one and Mount ID set equals agent.allowed_mount_ids. Legacy receipts omit this field unchanged; null rejects."
          }
        },
        "description": "Original create result, including historical replay: version 1, active, created_at=updated_at, exactly one event. Config fields must match the saved intent, with only the original Registry-resolved install-skill default allowed in the Tool set. No no-op create arm. Runner declarations return their original frozen mapping, never a current reallocation; new/legacy receipt profile must match the original request."
      },
      "AgentCreateLookupBody": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "request"
        ],
        "properties": {
          "command": {
            "const": "agent.create"
          },
          "request": {
            "$ref": "#/components/schemas/AgentCreate"
          }
        }
      },
      "AgentCreateLookup": {
        "oneOf": [
