        "properties": {
          "agent_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{1,30}[A-Za-z0-9]$"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "tag_color": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 8192
          },
          "instructions": {
            "type": "string",
            "maxLength": 32768
          },
          "inject_agents_md": {
            "type": "boolean"
          },
          "model_ref": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "reasoning_effort": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "approval_policy": {
            "enum": [
              "default",
              "auto",
              "allow"
            ]
          },
          "approval_model_ref": {
            "anyOf": [
              {
                "$ref": "./common.json#/components/schemas/ID"
              },
              {
                "type": "null"
              }
            ]
          },
          "allowed_tool_ids": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "$ref": "./common.json#/components/schemas/ID"
            },
            "description": "Explicit non-null canonical ascending IDs; each set <=128 and all three sets together <=256. Go validates order and the combined bound."
          },
          "allowed_mount_ids": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "$ref": "./common.json#/components/schemas/ID"
            },
            "description": "Explicit non-null canonical ascending IDs; each set <=128 and all three sets together <=256. Go validates order and the combined bound."
          },
          "allowed_secret_variable_ids": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "$ref": "./common.json#/components/schemas/ID"
            },
            "description": "Explicit non-null canonical ascending IDs; each set <=128 and all three sets together <=256. Go validates order and the combined bound."
          },
          "add_skills_enabled": {
            "type": "boolean",
            "default": true
          },
          "install_skill_enabled": {
            "type": "boolean",
            "default": true
          },
          "runner_mounts": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "$ref": "#/components/schemas/RunnerMountDeclaration"
            },
            "description": "Unique (runner_id,workspace) pairs, preserved original order. Mutually exclusive with allowed_mount_ids; null rejects. Counts toward the original total 256 references and complete JSON 512 KiB cap."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "approval_policy": {
                  "const": "auto"
                }
              },
              "required": [
                "approval_policy"
              ]
            },
            "then": {
              "required": [
                "approval_model_ref"
              ],
              "properties": {
                "approval_model_ref": {
                  "$ref": "./common.json#/components/schemas/ID"
                }
              }
            },
            "else": {
              "properties": {
                "approval_model_ref": {
                  "type": "null"
                }
              }
            }
          },
          {
            "oneOf": [
              {
                "required": [
                  "allowed_mount_ids"
                ],
                "not": {
                  "required": [
                    "runner_mounts"
                  ]
                }
              },
              {
                "required": [
                  "runner_mounts"
                ],
                "not": {
                  "required": [
                    "allowed_mount_ids"
                  ]
                }
              }
            ]
          }
        ],
        "description": "Caller generates one AgentID before sending and retains it with the original intent. Omitted description/instructions expand to empty strings; omitted nullable metadata expands to null. Omitted creation-only switches expand to true; explicit false is valid and null is forbidden. Neither false nor empty arrays bypasses any real provider. No trimming or normalization except server-owned normalized_name. The real Registry may append its default install-skill Tool ID when enabled; Skills assignments are separate facts."
      },
      "AgentCreateBody": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request"
        ],
        "properties": {
          "request": {
            "$ref": "#/components/schemas/AgentCreate"
          }
        }
      },
