  "components": {
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-agenteam_session",
        "description": "Original Account Session; configured loopback HTTP uses agenteam_local_session. No caller Actor or bearer bypass."
      }
    },
    "responses": {
      "Problem": {
        "description": "Safe Problem Details; original commit state and recovery hint are preserved.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "./common.json#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "AgentCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "name",
          "model_ref",
          "inject_agents_md",
          "approval_policy",
          "allowed_tool_ids",
          "allowed_secret_variable_ids"
