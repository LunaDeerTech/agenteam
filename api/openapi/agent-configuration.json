      "AgentUpdateMutation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "changed",
          "event_ids"
        ],
        "properties": {
          "agent": {
            "$ref": "#/components/schemas/AgentConfig"
          },
          "changed": {
            "type": "boolean"
          },
          "event_ids": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "$ref": "./common.json#/components/schemas/ID"
            }
          },
          "runner_mounts": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "$ref": "#/components/schemas/RunnerMountBinding"
            },
            "description": "Present if and only if original request used runner_mounts, including []. Frozen original command allocations match declarations one-for-one and Mount ID set equals agent.allowed_mount_ids. Legacy receipts omit this field unchanged; null rejects."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "changed": {
                  "const": true
                }
              },
              "required": [
                "changed"
              ]
            },
            "then": {
              "properties": {
                "event_ids": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "event_ids": {
                  "maxItems": 0
                }
              }
            }
          }
        ],
        "description": "Original update receipt: changed=true has exactly one event and version=caller expected+1; changed=false has no events and retains caller expected. HTTP checks the original Project/Agent and every present patch field. A historical receipt is not replaced with the current configuration; omission never asks HTTP to read current fields. Runner declarations return their original frozen mapping, never a current reallocation; new/legacy receipt profile must match the original request."
      },
      "AgentUpdateLookup": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "receipt"
            ],
            "properties": {
              "status": {
                "const": "committed"
              },
              "receipt": {
