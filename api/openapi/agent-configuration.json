            "const": "agent.update"
          },
          "target_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "expected_version": {
            "$ref": "./common.json#/components/schemas/Version"
          },
          "request": {
            "$ref": "#/components/schemas/AgentUpdate"
          }
        },
        "description": "Exactly the original target, expected version and complete original patch, preserving omission/null/value and all arrays. The server recomputes the digest from these fields and the current stable Human User; the caller never supplies a digest."
      },
      "AgentCommandLookupBody": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AgentCreateLookupBody"
