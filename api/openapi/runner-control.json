          "root_path",
          "version",
          "credential_generation",
          "status",
          "public_key_fingerprint",
          "enrolled_at",
          "last_seen_at",
          "last_hello",
          "created_at",
          "updated_at"
        ],
        "description": "Current public projection. Online is current DB row + hello + both generations + unexpired 30s lease, not instant owner-death proof. Fingerprint and enrolled_at are both null or both present. Last hello Runner ID must match. No raw key, token or nonce.",
        "allOf": [
          {
            "if": {
              "properties": {
                "public_key_fingerprint": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "enrolled_at": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "enrolled_at": {
                  "$ref": "./common.json#/components/schemas/Instant"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "online"
                }
              }
            },
            "then": {
              "properties": {
                "public_key_fingerprint": {
                  "$ref": "./common.json#/components/schemas/Digest"
                },
                "enrolled_at": {
                  "$ref": "./common.json#/components/schemas/Instant"
                },
                "last_seen_at": {
                  "$ref": "./common.json#/components/schemas/Instant"
                },
                "last_hello": {
                  "$ref": "#/components/schemas/HelloSnapshot"
                }
              }
            }
          }
        ]
      },
      "RunnerPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Runner"
            },
            "maxItems": 200
          },
          "next": {
            "oneOf": [
              {
                "$ref": "./common.json#/components/schemas/ID"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "next"
        ],
        "description": "Non-snapshot keyset in ascending ID order. next is the last returned ID only when lookahead exists; null at the end. Encoded body at most 2MiB."
      },
      "CreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runner_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "name": {
            "$ref": "#/components/schemas/Name"
          },
          "description": {
            "$ref": "#/components/schemas/Description"
          },
          "tags": {
            "$ref": "#/components/schemas/Tags"
          },
          "root_path": {
            "$ref": "#/components/schemas/RootPath"
          }
        },
        "required": [
          "runner_id",
          "name",
          "description",
          "tags",
          "root_path"
        ]
      },
      "UpdateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expected_version": {
            "$ref": "./common.json#/components/schemas/Version"
          },
          "name": {
            "$ref": "#/components/schemas/Name"
          },
          "description": {
            "$ref": "#/components/schemas/Description"
          },
          "tags": {
            "$ref": "#/components/schemas/Tags"
          }
        },
        "required": [
          "expected_version"
        ],
        "anyOf": [
          {
            "required": [
              "name"
            ]
          },
          {
            "required": [
              "description"
            ]
          },
          {
            "required": [
              "tags"
            ]
          }
        ]
      },
      "CredentialRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expected_version": {
            "$ref": "./common.json#/components/schemas/Version"
          }
        },
        "required": [
          "expected_version"
        ]
      },
      "Command": {
        "enum": [
          "runner.create",
          "runner.update",
          "runner.enrollment.issue",
          "runner.revoke"
        ]
      },
      "LookupRequest": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": {
                "const": "runner.create"
              },
              "request": {
                "$ref": "#/components/schemas/CreateRequest"
              }
            },
            "required": [
              "command",
              "request"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": {
                "const": "runner.update"
              },
              "request": {
                "$ref": "#/components/schemas/UpdateRequest"
              }
            },
            "required": [
              "command",
              "request"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": {
                "const": "runner.enrollment.issue"
              },
              "request": {
                "$ref": "#/components/schemas/CredentialRequest"
              }
            },
            "required": [
              "command",
              "request"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": {
                "const": "runner.revoke"
              },
              "request": {
                "$ref": "#/components/schemas/CredentialRequest"
              }
            },
            "required": [
              "command",
              "request"
            ]
          }
        ],
        "description": "Exact original intent. For create, request.runner_id must equal the path Runner ID. Server derives original semantic digest; no client digest accepted."
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "command": {
            "$ref": "#/components/schemas/Command"
          },
          "runner": {
            "$ref": "#/components/schemas/Runner"
          },
          "changed": {
            "type": "boolean"
          }
        },
        "required": [
          "command_id",
          "command",
          "runner",
          "changed"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "command": {
                  "not": {
                    "const": "runner.update"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "changed": {
                  "const": true
                }
              }
            }
          }
        ]
      },
      "Material32": {
        "type": "string",
        "minLength": 43,
        "maxLength": 43,
        "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
        "description": "Canonical unpadded base64url of exactly 32 bytes. Shape does not prove issuer or purpose."
      },
      "PublicMutation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "receipt": {
            "$ref": "#/components/schemas/Receipt"
          },
          "token_available": {
            "const": false
          }
        },
        "required": [
          "receipt",
          "token_available"
        ]
      },
      "FirstMaterialMutation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "receipt": {
            "$ref": "#/components/schemas/Receipt"
          },
          "token_available": {
            "const": true
          },
          "enrollment_token": {
            "$ref": "#/components/schemas/Material32"
          },
          "expires_at": {
            "$ref": "./common.json#/components/schemas/Instant"
          }
        },
        "required": [
          "receipt",
          "token_available",
          "enrollment_token",
          "expires_at"
        ],
        "allOf": [
          {
            "properties": {
              "receipt": {
                "properties": {
                  "command": {
                    "enum": [
                      "runner.create",
                      "runner.enrollment.issue"
                    ]
                  }
                }
              }
            }
          }
        ]
      },
      "Mutation": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/PublicMutation"
          },
          {
            "$ref": "#/components/schemas/FirstMaterialMutation"
          }
        ],
        "description": "Only a first known-committed create/enrollment may publish token. Replay and Lookup cannot repeat token; expired/aborted transport cannot turn a known commit into not_committed."
      },
      "LookupResponse": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "state": {
                "const": "not_observed"
              },
              "token_available": {
                "const": false
              }
            },
            "required": [
              "state",
              "token_available"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "state": {
                "const": "committed"
              },
              "receipt": {
                "$ref": "#/components/schemas/Receipt"
              },
              "token_available": {
                "const": false
              }
            },
            "required": [
              "state",
              "receipt",
              "token_available"
            ]
          }
        ]
      },
      "EnrollmentRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runner_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "token": {
            "$ref": "#/components/schemas/Material32"
          },
          "public_key": {
            "$ref": "#/components/schemas/Material32"
          },
          "root_path": {
            "$ref": "#/components/schemas/RootPath"
          },
          "os": {
            "enum": [
              "linux",
              "darwin"
            ]
          },
          "arch": {
            "enum": [
              "amd64",
              "arm64"
            ]
          }
        },
        "required": [
          "runner_id",
          "token",
          "public_key",
          "root_path",
          "os",
          "arch"
        ]
      },
      "EnrollmentResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runner_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "version": {
            "allOf": [
              {
                "$ref": "./common.json#/components/schemas/Version"
              },
              {
                "not": {
                  "const": "1"
                }
              }
            ]
          },
          "credential_generation": {
            "$ref": "./common.json#/components/schemas/Version"
          },
          "enrolled_at": {
            "$ref": "#/components/schemas/ProtocolInstant"
          },
          "public_key_fingerprint": {
            "$ref": "./common.json#/components/schemas/Digest"
          }
        },
        "required": [
          "runner_id",
          "version",
          "credential_generation",
          "enrolled_at",
          "public_key_fingerprint"
        ]
      },
      "ChallengeRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runner_id": {
            "$ref": "./common.json#/components/schemas/ID"
          }
        },
        "required": [
          "runner_id"
        ]
      },
      "ChallengeResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nonce": {
            "$ref": "#/components/schemas/Material32"
          },
          "expires_at": {
            "$ref": "#/components/schemas/ProtocolInstant"
          }
        },
        "required": [
          "nonce",
          "expires_at"
        ]
      }
    },
    "parameters": {
      "RunnerID": {
        "name": "runner_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "./common.json#/components/schemas/ID"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "$ref": "./common.json#/components/schemas/IdempotencyKey"
        },
        "description": "Exactly one header; retain original key and original DTO through lookup/replay."
      }
    },
    "responses": {
      "Problem": {
        "description": "Safe shared Problem. 400 malformed/presence; 401 current identity/nonce/signature; 403 admin/CSRF/Origin; 404 missing Runner; 405 method; 409 version/key/state/capacity; 413 body; 415 media/encoding; 503 dependency/unknown/shutdown; 500 internal. No raw material/cause/SQL. CommitUnknown keeps original attempt/cause and lookup advice for management; never auto-replay device material. HEAD has no body. Native abort may publish no complete Problem.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "./common.json#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "Session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-agenteam_session"
      },
      "LocalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "agenteam_local_session"
      },
      "CSRF": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      },
      "RunnerSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Exactly one Runner <base64url(strict-auth-json)> device signature; never a Session or bearer token."
      }
    }
  }
}
