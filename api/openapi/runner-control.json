    "/api/v1/runner/control": {
      "get": {
        "operationId": "connectRunnerControl",
        "security": [
          {
            "RunnerSignature": []
          }
        ],
        "description": "WSS HTTP/1.1 upgrade only; 5s original authentication/upgrade budget. Exactly one canonical WebSocket key, version 13, Upgrade websocket and Connection upgrade; exact single subprotocol agenteam.runner.v1, no extensions/compression. Reject Cookie/Origin/CSRF, body, query and RawPath. Authorization is Runner plus base64url strict JSON {runner_id,nonce,timestamp,signature}, decoded at most 2048 bytes. Ed25519 signs UTF-8 agenteam-runner-control-v1\\n + runner_id + \\n + nonce + \\n + timestamp + \\n (actual LF). Timestamp canonical Unix seconds; DB window ±30s. Authenticate consumes nonce before upgrade. Fixed v1.0 thirteen-frame contract is defined in D15 and internal/runnerprotocol; OpenAPI does not model a post-upgrade HTTP JSON response.",
        "parameters": [
          {
            "name": "Sec-WebSocket-Protocol",
            "in": "header",
            "required": true,
            "schema": {
              "const": "agenteam.runner.v1"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "Current authenticated connection reserved; hello still required within 5s before online. Separate owner retains socket/reader/writer/actual callbacks through Stop/Drain.",
            "headers": {
              "Sec-WebSocket-Protocol": {
                "schema": {
                  "const": "agenteam.runner.v1"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
