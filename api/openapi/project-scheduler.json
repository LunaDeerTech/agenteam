          },
          "405": {
            "description": "Original safe Problem; no publication after the original deadline."
          },
          "409": {
            "description": "Original safe Problem; no publication after the original deadline."
          },
          "413": {
            "description": "Original safe Problem; no publication after the original deadline."
          },
          "415": {
            "description": "Original safe Problem; no publication after the original deadline."
          },
          "500": {
            "description": "Original safe Problem; no publication after the original deadline."
          },
          "503": {
            "description": "Original safe Problem; no publication after the original deadline."
          }
        }
      },
      "patch": {
        "operationId": "projectSchedulerUpdate",
        "summary": "Replace scheduler configuration through the original Owner UpdateProject command",
        "security": [
          {
            "browserSession": []
          }
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "./common.json#/components/schemas/ID"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:/-]{1,128}(?![\\s\\S])"
            },
            "description": "Exactly one original key, shared with the existing Project update command namespace."
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Original current Account Session CSRF."
          }
        ],
        "description": "Thirty-second total budget, inheriting earlier deadlines. Strict UTF-8 application/json <=4096 bytes, no query/encoding/unknown or duplicate members. All fields required. Uses UpdateCommand=\"update\" and the original Project expected_version/key. Response is only historical Project acknowledgement. Read current settings with a separate GET; never attach that later GET to a historical receipt. Existing key-only POST commands/lookup remains unchanged and does not validate caller-supplied scheduler intent. Pausing does not stop existing Execution; enabling does not start a planned Sprint or launch a runtime.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SchedulerUpdateInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Historical acknowledgement from the original UpdateProject call, including no-op and same-key replay. Contains no scheduler values.",
            "headers": {
              "Content-Length": {
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchedulerUpdateReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Original safe Problem; no publication after the original deadline.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./common.json#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Original safe Problem; no publication after the original deadline.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./common.json#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Original safe Problem; no publication after the original deadline.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./common.json#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Original safe Problem; no publication after the original deadline.",
            "content": {
