                  "$ref": "./common.json#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Original safe Problem; no publication after the original deadline.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./common.json#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Original safe Problem; no publication after the original deadline.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./common.json#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{id}/commands/lookup": {
      "$ref": "./project-owner.json#/paths/~1api~1v1~1projects~1{id}~1commands~1lookup"
    }
  },
  "components": {
    "schemas": {
      "SchedulerConfiguration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "version",
          "scheduler_enabled",
          "scheduler_max_concurrency"
        ],
        "properties": {
          "project_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "version": {
            "$ref": "./common.json#/components/schemas/PositiveInt64String"
          },
          "scheduler_enabled": {
            "type": "boolean"
          },
          "scheduler_max_concurrency": {
            "oneOf": [
              {
                "$ref": "./common.json#/components/schemas/PositiveInt64String"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explicit null means unlimited; otherwise canonical positive int64 decimal string. Never a JSON number."
          }
        }
      },
      "SchedulerUpdateInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_version",
          "scheduler_enabled",
          "scheduler_max_concurrency"
        ],
        "properties": {
          "expected_version": {
            "$ref": "./common.json#/components/schemas/PositiveInt64String"
          },
          "scheduler_enabled": {
            "type": "boolean"
          },
          "scheduler_max_concurrency": {
            "oneOf": [
              {
                "$ref": "./common.json#/components/schemas/PositiveInt64String"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explicit null means unlimited; otherwise canonical positive int64 decimal string. Never a JSON number."
          }
        }
      },
      "SchedulerUpdateReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "version"
        ],
        "properties": {
          "project_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "version": {
            "$ref": "./common.json#/components/schemas/PositiveInt64String"
          }
        }
      }
    },
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-agenteam_session",
        "description": "Original Account Session; configured loopback HTTP uses agenteam_local_session. No caller Actor or bearer bypass."
      }
    }
  }
}
