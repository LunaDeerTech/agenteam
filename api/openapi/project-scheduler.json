{
  "openapi": "3.1.0",
  "info": {
    "title": "Project Scheduler Owner configuration",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/projects/{project_id}/scheduler": {
      "get": {
        "operationId": "projectSchedulerGet",
        "summary": "Read current Owner Project scheduler configuration",
        "security": [
          {
            "browserSession": []
          }
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "./common.json#/components/schemas/ID"
            }
          }
        ],
        "description": "Two-second total budget from before Account authentication. No body or query. Current Session and Owner are revalidated in the service transaction; administrators have no bypass. Maximum complete JSON representation 4096 bytes.",
        "responses": {
          "200": {
            "description": "Current Project version and complete scheduler configuration; not a historical command receipt.",
            "headers": {
              "Content-Length": {
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchedulerConfiguration"
                }
              }
            }
          },
          "400": {
            "description": "Original safe Problem; no publication after the original deadline.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./common.json#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Original safe Problem; no publication after the original deadline.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./common.json#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Original safe Problem; no publication after the original deadline.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./common.json#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Original safe Problem; no publication after the original deadline.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./common.json#/components/schemas/Problem"
                }
              }
            }
          },
          "405": {
