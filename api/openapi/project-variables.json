        },
        "description": "Exactly one original key, unchanged and not trimmed; duplicate header values rejected, including identical ones."
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        },
        "description": "Canonical decimal 1..100; duplicate, empty or noncanonical forms rejected."
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "allowEmptyValue": false,
        "schema": {
