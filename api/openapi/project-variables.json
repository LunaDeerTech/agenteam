    "schemas": {
      "VariableName": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
        "not": {
          "pattern": "^[aA][gG][eE][nN][tT][eE][aA][mM](?:$|_)"
        }
      },
      "VariableDescription": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*$",
        "description": "At most 4096 UTF-8 bytes; Unicode scalar text; TAB/LF/CR permitted."
      },
      "VariableValue": {
        "type": "string",
        "maxLength": 32768,
        "pattern": "^[^\\u0000]*$",
        "description": "Ordinary value, not a Secret. At most 32768 UTF-8 bytes; no NUL; no normalization."
      },
