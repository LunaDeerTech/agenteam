      "CSRF": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "description": "Actual current Account Session CSRF token; POST Lookup is unsafe and also requires it."
      }
    },
    "responses": {
      "Problem": {
        "description": "Safe shared Problem with original commit_state and lawful hint, never error text or a candidate receipt. Failed publication after a successful mutation aborts the connection instead of asserting rollback.",
        "headers": {
          "Cache-Control": {
            "schema": {
              "const": "no-store"
            }
          },
          "Content-Length": {
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Exact length of the complete representation; HEAD has no response body."
          },
          "X-Request-ID": {
            "schema": {
              "$ref": "./common.json#/components/schemas/ID"
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "./common.json#/components/schemas/Problem"
            }
          }
        }
      },
      "Variable": {
