  "components": {
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-agenteam_session",
        "description": "Current authenticated browser Session (__Host-agenteam_session on HTTPS; agenteam_local_session on the configured HTTP development origin); each request still requires current Project Owner authorization."
      }
    },
    "responses": {
      "Problem": {
        "description": "Safe RFC 9457 Problem retaining the original Fault and commit_state; no path, query, content or storage locator. Read Audit failure/unknown never returns a representation.",
        "headers": {
          "Cache-Control": {
            "schema": {
              "const": "no-store"
            }
          },
          "Content-Length": {
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "not": {
                "pattern": "[^0-9]"
              }
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "./common.json#/components/schemas/Problem"
            }
          }
        }
      },
      "HeadProblem": {
        "description": "Same status and headers as GET, with no body.",
        "headers": {
          "Cache-Control": {
            "schema": {
              "const": "no-store"
            }
          },
          "Content-Length": {
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "not": {
                "pattern": "[^0-9]"
              }
            }
          }
        }
      }
    },
    "schemas": {
      "ArtifactRef": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "artifact_id",
          "file_id"
        ],
        "properties": {
          "project_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "artifact_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "file_id": {
            "$ref": "./common.json#/components/schemas/ID"
          }
        }
      },
      "ObjectMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "media_type",
          "byte_size",
          "sha256"
        ],
        "properties": {
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f]"
            }
          },
          "byte_size": {
            "$ref": "./common.json#/components/schemas/Progress"
          },
          "sha256": {
            "$ref": "./common.json#/components/schemas/Digest"
          }
        }
      },
      "ArtifactMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_ref",
          "kind",
          "name",
          "object",
          "created_at",
          "version"
        ],
        "properties": {
          "artifact_ref": {
            "$ref": "#/components/schemas/ArtifactRef"
          },
          "kind": {
            "enum": [
              "generated",
              "user_upload"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "1–255 UTF-8 bytes; no path separators or control characters.",
            "not": {
              "pattern": "[/\\\\\\u0000-\\u001f\\u007f-\\u009f]"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "not": {
              "pattern": "\\u0000"
            },
            "description": "At most 4096 UTF-8 bytes; omitted when empty."
          },
          "object": {
            "$ref": "#/components/schemas/ObjectMetadata"
          },
          "source_execution_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "source_operation_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "created_by_user_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "created_by_agent_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "created_at": {
            "$ref": "./common.json#/components/schemas/Instant"
          },
          "version": {
            "$ref": "./common.json#/components/schemas/Version"
          }
        },
        "oneOf": [
          {
            "required": [
              "created_by_user_id"
            ],
            "not": {
              "required": [
                "created_by_agent_id"
              ]
            }
          },
          {
            "required": [
              "created_by_agent_id",
              "source_execution_id"
            ],
            "not": {
              "required": [
                "created_by_user_id"
              ]
            }
          }
        ],
        "dependentRequired": {
          "source_operation_id": [
            "source_execution_id"
          ]
        }
      },
      "ArtifactPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/ArtifactMetadata"
            }
          },
          "next_cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "not": {
              "pattern": "\\u0000"
            }
          }
        }
      },
      "ArtifactRead": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact",
          "projection",
          "offset",
          "next_offset",
          "truncated"
        ],
        "properties": {
          "artifact": {
            "$ref": "#/components/schemas/ArtifactMetadata"
          },
          "projection": {
            "enum": [
              "text",
              "image_ref",
              "file_ref"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536,
            "description": "At most the requested UTF-8 byte limit; omitted for an empty text window."
          },
          "offset": {
            "$ref": "./common.json#/components/schemas/Progress"
          },
          "next_offset": {
            "$ref": "./common.json#/components/schemas/Progress"
          },
          "truncated": {
            "type": "boolean"
          },
          "invalid_utf8": {
            "const": true
          }
        },
        "oneOf": [
          {
            "properties": {
              "projection": {
                "const": "text"
              }
            },
            "not": {
              "required": [
                "invalid_utf8"
              ]
            }
          },
          {
            "properties": {
              "projection": {
                "const": "image_ref"
              },
              "offset": {
                "const": "0"
              },
              "next_offset": {
                "const": "0"
              },
              "truncated": {
                "const": false
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                },
                {
                  "required": [
                    "invalid_utf8"
                  ]
                }
              ]
            }
          },
          {
            "properties": {
              "projection": {
                "const": "file_ref"
              },
              "offset": {
                "const": "0"
              },
              "next_offset": {
                "const": "0"
              },
              "truncated": {
                "const": false
              }
            },
            "not": {
              "required": [
                "text"
              ]
            }
          }
        ]
      },
      "ArtifactContentIntent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "media_type",
          "content"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "1..255 UTF-8 bytes; no slash, backslash or Unicode control characters. Preserved without trimming.",
            "x-max-utf8-bytes": 255
          },
          "description": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*$(?![\\s\\S])",
            "description": "Optional; at most 4096 UTF-8 bytes, no NUL. Omitted and empty have the same domain semantics.",
            "x-max-utf8-bytes": 4096
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Valid MIME normalized by the existing Object contract; input and normalized representation each at most 256 bytes. UI offers text/plain and text/markdown.",
            "x-max-utf8-bytes": 256
          },
          "content": {
            "type": "string",
            "maxLength": 1048576,
            "description": "At most 1048576 decoded UTF-8 bytes, including empty content and NUL. No trimming, line-ending or Unicode normalization. Invalid UTF-8 and lone UTF-16 escapes are rejected.",
            "x-max-utf8-bytes": 1048576
          }
        }
      },
      "ArtifactContentMetadata": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactMetadata"
          },
          {
            "properties": {
              "kind": {
                "const": "generated"
              },
              "created_by_agent_id": false,
              "source_execution_id": false,
              "source_operation_id": false
            },
            "required": [
              "created_by_user_id"
            ]
          }
        ],
        "description": "Safe original content-created Artifact metadata, fully bound to the current stable Human and original name, description, normalized MIME, content byte size and SHA256. Contains no content, command key or storage identity."
      },
      "ArtifactContentCreated": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact"
        ],
        "properties": {
          "artifact": {
            "$ref": "#/components/schemas/ArtifactContentMetadata"
          }
        }
      },
      "ArtifactCreationLookup": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "artifact"
            ],
            "properties": {
              "state": {
                "enum": [
                  "not_observed",
                  "pending",
                  "cancel_requested",
                  "cancelled"
                ]
              },
              "artifact": {
                "type": "null"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "artifact"
            ],
            "properties": {
              "state": {
                "const": "committed"
              },
              "artifact": {
                "$ref": "#/components/schemas/ArtifactContentMetadata"
              }
            }
          }
        ],
        "description": "A current authorized observation, never a reservation of an absent key. Pending/cancellation states carry no Object read authority. Historical committed metadata does not replace current List/Read authorization."
      },
      "ArtifactCreationCancelled": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "cleanup"
            ],
            "properties": {
              "state": {
                "const": "not_observed"
              },
              "cleanup": {
                "type": "null"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "cleanup"
            ],
            "properties": {
              "state": {
                "const": "cancel_requested"
              },
              "cleanup": {
                "const": "pending"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "cleanup"
            ],
            "properties": {
              "state": {
                "const": "cancelled"
              },
              "cleanup": {
                "const": "completed"
              }
            }
          }
        ],
        "description": "Only a nil-error original cancellation result can confirm pending/completed cleanup. not_observed means Lookup found no original command and Cancel was not called; it does not mean cancellation or cleanup completed."
      }
    },
    "parameters": {
      "CSRF": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "description": "Original current browser Session CSRF token; original Origin checks also apply to every POST, including Lookup."
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]+$(?![\\s\\S])"
        },
        "description": "Exactly one original key, bound by the domain to stable Human identity, Project and the full canonical creation semantics. Never put it or the original body in a URL or log."
      }
    }
  }
}
