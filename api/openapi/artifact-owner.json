      "post": {
        "operationId": "artifactOwnerCreateContent",
        "description": "Current Human Owner only; original Origin/CSRF and current Session checks apply before dispatch. No queries, Range, If-Range, Content-Encoding, unknown or duplicate decoded JSON keys, caller provenance or expected version. All three routes accept exactly the same full body, at most 7340032 encoded JSON bytes including whitespace; decoded UTF-8 content is at most 1048576 bytes. The server generates its own attempt. Preserve the original key/body after every dispatched but unconfirmed result, including a later transaction reporting not_committed: earlier intent/upload transactions may already have committed. Unknown requires explicit Lookup, never automatic reposting or polling. Successful responses are bounded by 65536 bytes. The entry 2s business context includes body I/O and original domain calls, but the original actual return/technical settle tail must still join before HTTP can return. Creates a generated Artifact from inline UTF-8 content. The full semantic digest permits original-key replay; it does not accept Source, upload or Agent provenance. Current active Project mutation authority is required.",
        "security": [
          {
            "browserSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CSRF"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "x-max-encoded-json-bytes": 7340032,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArtifactContentIntent"
              }
            }
          }
        },
        "responses": {
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "410": {
