  "components": {
    "schemas": {
      "Title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "not": {
          "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]"
        }
      },
      "Creator": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "user_id"
            ],
            "properties": {
              "kind": {
                "const": "human"
              },
              "user_id": {
                "$ref": "./common.json#/components/schemas/ID"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "project_id",
              "agent_id",
              "execution_id"
            ],
            "properties": {
              "kind": {
                "const": "agent_run"
              },
              "project_id": {
                "$ref": "./common.json#/components/schemas/ID"
              },
              "agent_id": {
                "$ref": "./common.json#/components/schemas/ID"
              },
              "execution_id": {
                "$ref": "./common.json#/components/schemas/ID"
              }
            }
          }
        ]
      },
      "Document": {
        "$ref": "./knowledge-content.json#/components/schemas/Document"
      },
      "CreateFileRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parent_document_id",
          "title",
          "media_type",
          "bytes_base64"
        ],
        "properties": {
          "parent_document_id": {
            "oneOf": [
              {
                "$ref": "./common.json#/components/schemas/ID"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "$ref": "#/components/schemas/Title"
          },
          "media_type": {
            "enum": [
              "text/plain",
              "text/markdown",
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            ]
          },
          "bytes_base64": {
            "type": "string",
            "maxLength": 1398104,
            "contentEncoding": "base64",
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?(?![\\s\\S])",
            "description": "Original bytes, strict canonical standard base64. Decoded size <=1048576 bytes, including exact boundary. The server measures SHA256 for the original UploadSource; no client-provided Object identity or digest is trusted."
          }
        },
        "description": "The caller chooses a stable canonical UUIDv7 document_id in the path. Explicit null is root; otherwise the current active parent must belong to this same Project and differ from the target. All checks and publication remain in the Knowledge service."
      },
      "ReplaceFileRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_version",
          "media_type",
          "bytes_base64"
        ],
        "properties": {
          "expected_version": {
            "$ref": "./common.json#/components/schemas/Version"
          },
          "media_type": {
            "enum": [
              "text/plain",
              "text/markdown",
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            ]
          },
          "bytes_base64": {
            "type": "string",
            "maxLength": 1398104,
            "contentEncoding": "base64",
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?(?![\\s\\S])",
            "description": "Original bytes, strict canonical standard base64. Decoded size <=1048576 bytes, including exact boundary. The server measures SHA256 for the original UploadSource; no client-provided Object identity or digest is trusted."
          }
        },
        "description": "Replace only the canonical source. Title and parent are untouched. No-op remains the original version; a changed source advances by one. Current service validation remains authoritative."
      },
      "LookupRequest": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "document_id",
              "request"
            ],
            "properties": {
              "command": {
                "const": "create"
              },
              "document_id": {
                "$ref": "./common.json#/components/schemas/ID"
              },
              "request": {
                "$ref": "#/components/schemas/CreateFileRequest"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "document_id",
              "request"
            ],
            "properties": {
              "command": {
                "const": "update"
              },
              "document_id": {
                "$ref": "./common.json#/components/schemas/ID"
              },
              "request": {
                "$ref": "#/components/schemas/ReplaceFileRequest"
              }
            }
          }
        ],
        "description": "Wrap the complete original create/replace request and original target/key. Encoded outer limit 1414572 bytes; nested original request limit 1414488 bytes. The minimal canonical envelope adds exactly 84 bytes."
      },
      "DocumentResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document"
        ],
        "properties": {
          "document": {
            "$ref": "#/components/schemas/Document"
          }
        }
      },
      "DocumentReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "document",
          "changed"
        ],
        "properties": {
          "command": {
            "enum": [
              "create",
              "update"
            ]
          },
          "document": {
            "$ref": "#/components/schemas/Document"
          },
          "changed": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "command": {
                  "const": "create"
                }
              }
            },
            "then": {
              "properties": {
                "changed": {
                  "const": true
                },
                "document": {
                  "properties": {
                    "content_version": {
                      "const": "1"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "LookupResult": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "receipt"
            ],
            "properties": {
              "state": {
                "enum": [
                  "in_progress",
                  "not_observed"
                ]
              },
              "receipt": {
                "type": "null"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "receipt"
            ],
            "properties": {
              "state": {
                "const": "committed"
              },
              "receipt": {
                "$ref": "#/components/schemas/DocumentReceipt"
              }
            }
          }
        ]
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "$ref": "./common.json#/components/schemas/IdempotencyKey"
        },
        "description": "Exactly one original business key; no trimming, automatic generation or replay."
      },
      "CSRF": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Original safe Account Problem and CommitState; no internal material. Expired or failed native I/O aborts the connection.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "./common.json#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-agenteam_session",
        "description": "Original Account Session; configured loopback HTTP uses agenteam_local_session. No caller Actor or bearer bypass."
      }
    }
  }
}
