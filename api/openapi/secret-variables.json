    "schemas": {
      "SecretVariableName": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}(?![\\s\\S])",
        "not": {
          "pattern": "^[aA][gG][eE][nN][tT][eE][aA][mM](?:$|_)"
        }
      },
      "SecretVariableDescription": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*$",
        "description": "At most 4096 UTF-8 bytes; Unicode scalar text; TAB/LF/CR permitted."
      },
      "SecretVariableValue": {
        "type": "string",
        "minLength": 1,
        "maxLength": 65536,
        "pattern": "^[^\\u0000]+$",
        "writeOnly": true,
        "description": "Exactly 1..65536 UTF-8 bytes, no NUL, no normalization. Whitespace is material. Empty is invalid and never means deletion. Only create/update requests accept this field; it must not be logged, hashed into public DTOs or returned."
      },
      "SecretVariable": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "project_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
