            "$ref": "./common.json#/components/schemas/ID"
          }
        },
        {
          "name": "limit",
          "in": "query",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "description": "Canonical positive decimal; omitted means 50."
        },
        {
          "name": "cursor",
          "in": "query",
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "description": "Opaque HMAC cursor bound to current Human user, Project, Task and created_at DESC,id DESC. Null next_cursor means no older page. Not a snapshot: refresh explicitly to observe newer executions."
