          },
          "purpose": {
            "enum": [
              "task/work",
              "task/review"
            ]
          },
          "status": {
            "enum": [
              "created",
              "preparing",
              "running",
              "waiting",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "version": {
            "$ref": "./common.json#/components/schemas/Version"
          },
          "created_at": {
            "$ref": "./common.json#/components/schemas/Instant"
          },
          "started_at": {
            "anyOf": [
              {
                "$ref": "./common.json#/components/schemas/Instant"
              },
              {
                "type": "null"
              }
            ]
          },
          "completed_at": {
            "anyOf": [
              {
                "$ref": "./common.json#/components/schemas/Instant"
              },
              {
                "type": "null"
              }
            ]
          },
          "cancel_requested_at": {
            "anyOf": [
              {
                "$ref": "./common.json#/components/schemas/Instant"
              },
              {
                "type": "null"
              }
            ]
          },
          "snapshot_id": {
            "anyOf": [
              {
                "$ref": "./common.json#/components/schemas/ID"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "completed",
                  "model_failed",
                  "incomplete_response",
                  "runtime_failed",
                  "cancelled"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "waiting_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "approval",
              null
            ]
          },
          "waiting_reference": {
            "oneOf": [
              {
                "$ref": "./common.json#/components/schemas/ID"
              },
              {
                "type": "null"
              }
            ]
          },
          "waiting_at": {
            "oneOf": [
              {
                "$ref": "./common.json#/components/schemas/Instant"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "description": "Canonical Execution belonging to this Project and Task trigger. Reason is null when no canonical terminal reason exists. Nonterminal cancel_requested_at means cancellation requested, not terminal completion. No transcript, prompt, runtime content, lease or private error is exposed. Waiting fields are all null unless status is waiting; waiting uses reason approval, the original Approval UUIDv7 reference, and waiting_at >= started_at. Resume/terminal clears all three."
      },
      "TaskExecutionPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/TaskExecution"
            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "TaskExecutionDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "execution"
        ],
        "properties": {
          "execution": {
            "$ref": "#/components/schemas/TaskExecution"
          }
        }
      },
      "RuntimeTextItem": {
        "type": "object",
        "description": "The immutable final text item. id and source_reference.id identify the actual response-producing Round, not necessarily the first Round. seq and revision describe this limited final snapshot, not the number of transcript entries or model/tool rounds. For durable_final_text_v1, started_at equals execution.started_at. For durable_final_text_v2, started_at is the final Round created_at and must be within the inclusive execution.started_at to execution.completed_at interval. Both schemas require updated_at and completed_at to equal execution.completed_at.",
        "additionalProperties": false,
        "required": [
          "id",
          "execution_id",
          "seq",
          "type",
          "status",
          "revision",
          "started_at",
          "updated_at",
          "completed_at",
          "source_reference",
          "data"
        ],
        "properties": {
          "id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "execution_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "seq": {
            "const": "1"
          },
          "type": {
            "const": "text"
          },
          "status": {
            "const": "completed"
          },
          "revision": {
            "const": "1"
          },
          "started_at": {
            "$ref": "./common.json#/components/schemas/Instant"
          },
          "updated_at": {
            "$ref": "./common.json#/components/schemas/Instant"
          },
          "completed_at": {
            "$ref": "./common.json#/components/schemas/Instant"
          },
          "source_reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "const": "execution_round"
              },
              "id": {
                "$ref": "./common.json#/components/schemas/ID"
              }
            }
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "content"
            ],
            "properties": {
              "content": {
                "type": "string",
                "description": "Exact concatenated successful TextParts; UTF-8 at most 16 MiB, also bounded by original complete response JSON. May be empty. Render as text, never HTML."
              }
            }
          }
        }
      },
      "RuntimeSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "generation",
          "included_update_progress",
          "execution_version",
          "items"
        ],
        "properties": {
          "schema": {
            "enum": [
              "durable_final_text_v1",
              "durable_final_text_v2"
            ]
          },
          "generation": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "included_update_progress": {
            "const": "1"
          },
          "execution_version": {
            "$ref": "./common.json#/components/schemas/Version"
          },
          "items": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "$ref": "#/components/schemas/RuntimeTextItem"
            }
          }
        },
        "description": "Immutable original terminal snapshot. generation equals execution.snapshot_id; execution_version equals terminal version. Succeeded has exactly one text item from the actual final response Round, failed/cancelled none. Empty items requires an actual producer row. v1 retains its original exact start-time binding; v2 permits a final Round that starts after Execution start. included_update_progress=1 and item seq/revision=1 belong only to this complete final snapshot, not to the full Transcript or active stream. This generation/progress is not a WebSocket epoch or active stream watermark."
      },
      "TaskRuntimeView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "execution",
          "availability",
          "snapshot"
        ],
        "properties": {
          "execution": {
            "$ref": "#/components/schemas/TaskExecution"
          },
          "availability": {
            "enum": [
              "pending",
              "available",
              "not_recorded"
            ]
          },
          "snapshot": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RuntimeSnapshot"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "available"
                }
              }
            },
            "then": {
              "properties": {
                "snapshot": {
                  "$ref": "#/components/schemas/RuntimeSnapshot"
                },
                "execution": {
                  "properties": {
                    "status": {
                      "enum": [
                        "succeeded",
                        "failed",
                        "cancelled"
                      ]
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "snapshot": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "pending"
                }
              }
            },
            "then": {
              "properties": {
                "execution": {
                  "properties": {
                    "status": {
                      "enum": [
                        "created",
                        "preparing",
                        "running",
                        "waiting"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "not_recorded"
                }
              }
            },
            "then": {
              "properties": {
                "execution": {
                  "properties": {
                    "status": {
                      "enum": [
                        "succeeded",
                        "failed",
                        "cancelled"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "ExecutionCancelRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_version",
          "expected_task_version"
        ],
        "properties": {
          "expected_version": {
            "$ref": "./common.json#/components/schemas/Version"
          },
          "expected_task_version": {
            "$ref": "./common.json#/components/schemas/Version"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Optional, nonblank, no NUL, at most 1024 UTF-8 bytes; original bytes retained. Null is rejected."
          }
        }
      },
      "TaskCancellationProtection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "state",
          "blocker_id"
        ],
        "properties": {
          "id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "version": {
            "$ref": "./common.json#/components/schemas/Version"
          },
          "state": {
            "const": "blocked"
          },
          "blocker_id": {
            "$ref": "./common.json#/components/schemas/ID"
          }
        }
      },
      "ExecutionCancelReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "execution",
          "task"
        ],
        "properties": {
          "execution": {
            "$ref": "#/components/schemas/TaskExecution"
          },
          "task": {
            "$ref": "#/components/schemas/TaskCancellationProtection"
          }
        },
        "description": "Immutable accepted postimage: execution and task versions are each original expected version + 1. Execution remains nonterminal with cancel_requested_at present. The Task is blocked with the original user_cancelled_execution blocker. A later current GET may have a newer version/state."
      },
      "ExecutionCancelResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt",
          "replayed"
        ],
        "properties": {
          "receipt": {
            "$ref": "#/components/schemas/ExecutionCancelReceipt"
          },
          "replayed": {
            "type": "boolean"
          }
        }
      },
      "ExecutionCancelLookup": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "found",
          "receipt"
        ],
        "properties": {
          "found": {
            "type": "boolean"
          },
          "receipt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExecutionCancelReceipt"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "description": "found=false requires receipt=null. A found receipt confirms the original command only; lookup never repeats the mutation."
      }
    }
  }
}
