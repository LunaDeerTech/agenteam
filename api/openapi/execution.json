    "/api/v1/projects/{project_id}/tasks/{task_id}/executions/{execution_id}/cancel": {
      "parameters": [
        {
          "name": "project_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "./common.json#/components/schemas/ID"
          }
        },
        {
          "name": "task_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "./common.json#/components/schemas/ID"
          }
        },
        {
          "name": "execution_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "./common.json#/components/schemas/ID"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          }
        }
      ],
      "post": {
        "operationId": "taskExecutionCancel",
        "security": [
          {
            "browserSession": []
          }
        ],
        "description": "Use the original request body and Idempotency-Key for lookup/replay. Idempotency is checked before current versions. New cancellation of an already requested or terminal execution returns INVALID_STATE. This does not cancel the Task itself. Mutations use current Owner authorization and CSRF checks.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecutionCancelRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted immutable receipt, or lookup result; Cache-Control: no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionCancelResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, identity, key, query or unsupported reason."
          },
          "401": {
            "description": "Missing or expired current session."
          },
          "403": {
            "description": "Current session/CSRF authorization denied."
          },
          "404": {
            "description": "Project, Task or Execution is unavailable to current Owner."
          },
          "409": {
            "description": "VERSION_CONFLICT, TASK_VERSION_CONFLICT, INVALID_STATE, IDEMPOTENCY_KEY_REUSED, RESOURCE_BUSY or domain Task protection conflict."
          },
          "503": {
            "description": "Dependency or commit outcome unavailable; COMMIT_UNKNOWN requires original-intent lookup."
          }
        }
      }
    },
