  "openapi": "3.1.0",
  "info": {
    "title": "Task execution history and cancellation for current Human Owners",
    "version": "1.0.0",
    "description": "Current Session and Project Owner are checked on every request. Execution history and runtime-view remain explicit reads. Cancellation atomically protects the Task with blocked/user_cancelled_execution and records cancel_requested_at, then signals the original execution. Its immutable receipt is acceptance, never proof of stopped work; read current Execution and Task separately. Unknown cancellation uses the same original key/body through lookup. No admin bypass or replacement execution."
  },
