  "components": {
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-agenteam_session",
        "description": "Original Account boundary; local development uses its existing secure/local cookie rules."
      }
    },
    "schemas": {
      "TaskExecution": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "project_id",
          "task_id",
          "agent_id",
          "purpose",
          "status",
          "version",
          "created_at",
          "started_at",
          "completed_at",
          "cancel_requested_at",
          "snapshot_id",
          "reason"
        ],
        "properties": {
          "id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "project_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "task_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "agent_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "purpose": {
            "enum": [
              "task/work",
              "task/review"
            ]
          },
          "status": {
            "enum": [
              "created",
              "preparing",
              "running",
              "waiting",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "version": {
            "$ref": "./common.json#/components/schemas/Version"
          },
          "created_at": {
            "$ref": "./common.json#/components/schemas/Instant"
          },
          "started_at": {
            "anyOf": [
              {
                "$ref": "./common.json#/components/schemas/Instant"
              },
              {
                "type": "null"
              }
            ]
          },
          "completed_at": {
            "anyOf": [
              {
                "$ref": "./common.json#/components/schemas/Instant"
              },
              {
                "type": "null"
              }
            ]
          },
          "cancel_requested_at": {
            "anyOf": [
              {
                "$ref": "./common.json#/components/schemas/Instant"
              },
              {
                "type": "null"
              }
            ]
          },
          "snapshot_id": {
            "anyOf": [
              {
                "$ref": "./common.json#/components/schemas/ID"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "completed",
                  "model_failed",
                  "incomplete_response",
                  "runtime_failed",
                  "cancelled"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "description": "Canonical Execution belonging to this Project and Task trigger. Reason is null when no canonical terminal reason exists. Nonterminal cancel_requested_at means cancellation requested, not terminal completion. No transcript, prompt, runtime content, lease or private error is exposed."
      },
      "TaskExecutionPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/TaskExecution"
            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "TaskExecutionDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "execution"
        ],
        "properties": {
          "execution": {
            "$ref": "#/components/schemas/TaskExecution"
          }
        }
      },
      "RuntimeTextItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "execution_id",
          "seq",
          "type",
          "status",
          "revision",
          "started_at",
          "updated_at",
          "completed_at",
          "source_reference",
          "data"
        ],
        "properties": {
          "id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "execution_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "seq": {
            "const": "1"
          },
          "type": {
            "const": "text"
          },
          "status": {
            "const": "completed"
          },
          "revision": {
            "const": "1"
          },
          "started_at": {
            "$ref": "./common.json#/components/schemas/Instant"
          },
          "updated_at": {
            "$ref": "./common.json#/components/schemas/Instant"
          },
          "completed_at": {
            "$ref": "./common.json#/components/schemas/Instant"
          },
          "source_reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "const": "execution_round"
              },
              "id": {
                "$ref": "./common.json#/components/schemas/ID"
              }
            }
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "content"
            ],
            "properties": {
              "content": {
                "type": "string",
                "description": "Exact concatenated successful TextParts; UTF-8 at most 16 MiB, also bounded by original complete response JSON. May be empty. Render as text, never HTML."
              }
            }
          }
        }
      },
      "RuntimeSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "generation",
          "included_update_progress",
          "execution_version",
          "items"
        ],
        "properties": {
          "schema": {
            "const": "durable_final_text_v1"
          },
          "generation": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "included_update_progress": {
            "const": "1"
          },
          "execution_version": {
            "$ref": "./common.json#/components/schemas/Version"
          },
          "items": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "$ref": "#/components/schemas/RuntimeTextItem"
            }
          }
        },
        "description": "Immutable original terminal snapshot. generation equals execution.snapshot_id; execution_version equals terminal version. Succeeded has exactly one text item, failed/cancelled none. Empty items requires an actual producer row. This generation/progress is not a WebSocket epoch or active stream watermark."
      },
      "TaskRuntimeView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "execution",
          "availability",
          "snapshot"
        ],
        "properties": {
          "execution": {
            "$ref": "#/components/schemas/TaskExecution"
          },
          "availability": {
            "enum": [
              "pending",
              "available",
              "not_recorded"
            ]
          },
          "snapshot": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RuntimeSnapshot"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "available"
                }
              }
            },
            "then": {
              "properties": {
                "snapshot": {
                  "$ref": "#/components/schemas/RuntimeSnapshot"
                },
                "execution": {
                  "properties": {
                    "status": {
                      "enum": [
                        "succeeded",
                        "failed",
                        "cancelled"
                      ]
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "snapshot": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "pending"
                }
              }
            },
            "then": {
              "properties": {
                "execution": {
                  "properties": {
                    "status": {
                      "enum": [
                        "created",
                        "preparing",
                        "running",
                        "waiting"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "not_recorded"
                }
              }
            },
            "then": {
              "properties": {
                "execution": {
                  "properties": {
                    "status": {
                      "enum": [
                        "succeeded",
                        "failed",
                        "cancelled"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
