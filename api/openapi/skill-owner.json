            "$ref": "./common.json#/components/schemas/ID"
          }
        },
        {
          "name": "skill_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "./common.json#/components/schemas/ID"
          }
        }
      ],
      "get": {
        "operationId": "skillOwnerDetailGet",
        "security": [
          {
            "browserSession": []
          }
        ],
        "description": "No query parameters or request body, including a bare question mark. Current Human Session and Project Owner authorization precede protected reads. The original 2s total budget includes actual SQL and HTTP cleanup.",
        "responses": {
          "200": {
            "description": "Complete current-authorized representation. HEAD performs all checks but emits no body.",
