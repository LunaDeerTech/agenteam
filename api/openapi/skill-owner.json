  "components": {
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-agenteam_session",
        "description": "Original Account session cookie; configured loopback HTTP uses agenteam_local_session. No bearer or caller-supplied Actor."
      }
    },
    "schemas": {
      "SkillMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "project_id",
          "name",
          "normalized_name",
          "description",
          "protected",
          "current_revision",
          "version"
        ],
        "properties": {
          "id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "project_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])",
            "description": "UTF-8 byte cap and exact normalized_name relation are enforced by the service and adapter."
          },
          "normalized_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 384,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]+(?![\\s\\S])",
            "not": {
              "pattern": "^\\s*(?![\\s\\S])"
            },
            "description": "UTF-8 byte cap is 8192; LF and TAB are allowed, other control characters are rejected."
          },
          "protected": {
            "type": "boolean"
          },
          "current_revision": {
            "$ref": "./common.json#/components/schemas/Revision"
          },
          "version": {
            "$ref": "./common.json#/components/schemas/Version"
          }
        }
      },
      "SkillDirectory": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/components/schemas/SkillMetadata"
            }
          }
        }
      },
      "SkillCatalog": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/SkillMetadata"
            }
          },
          "next_cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "description": "Opaque signed current-read position, bound to Project, User, view, limit and order. Not a snapshot or authorization."
          }
        }
      },
      "SkillTextFile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "utf8_text"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Formal Skill path validation: relative slash-separated file path, no dot components, backslash/colon/control characters or normalization/case-fold collisions."
          },
          "utf8_text": {
            "type": "string",
            "maxLength": 8388608,
            "pattern": "^[^\\u0000\\r]*(?![\\s\\S])",
            "description": "Exact UTF-8 text. Full request is additionally bounded to 1 MiB; SKILL.md has the original 256 KiB cap and strict metadata grammar."
          }
        }
      },
      "SkillTextSource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "files"
        ],
        "properties": {
          "kind": {
            "const": "text_files"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "$ref": "#/components/schemas/SkillTextFile"
            }
          }
        }
      },
      "SkillInstallRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill_id",
          "mode",
          "source"
        ],
        "properties": {
          "skill_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "mode": {
            "const": "create"
          },
          "source": {
            "$ref": "#/components/schemas/SkillTextSource"
          }
        }
      },
      "SkillInstallCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request"
        ],
        "properties": {
          "request": {
            "$ref": "#/components/schemas/SkillInstallRequest"
          }
        }
      },
      "SkillInstallReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill_id",
          "revision",
          "version"
        ],
        "properties": {
          "skill_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "revision": {
            "const": "1"
          },
          "version": {
            "const": "1"
          }
        }
      }
    },
    "responses": {
      "Problem": {
