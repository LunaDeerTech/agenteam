  "components": {
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-agenteam_session",
        "description": "Original Account session cookie; configured loopback HTTP uses agenteam_local_session. No bearer or caller-supplied Actor."
      }
    },
    "schemas": {
      "SkillMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "project_id",
          "name",
          "normalized_name",
          "description",
          "protected",
          "current_revision",
          "version"
        ],
        "properties": {
          "id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "project_id": {
            "$ref": "./common.json#/components/schemas/ID"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])",
            "description": "UTF-8 byte cap and exact normalized_name relation are enforced by the service and adapter."
          },
          "normalized_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 384,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]+(?![\\s\\S])",
            "not": {
              "pattern": "^\\s*(?![\\s\\S])"
            },
            "description": "UTF-8 byte cap is 8192; LF and TAB are allowed, other control characters are rejected."
          },
          "protected": {
            "type": "boolean"
          },
          "current_revision": {
            "$ref": "./common.json#/components/schemas/Revision"
          },
          "version": {
            "$ref": "./common.json#/components/schemas/Version"
          }
        }
      },
      "SkillDirectory": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/components/schemas/SkillMetadata"
            }
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Original Account safe Problem. It does not disclose the request path/query, private cause or dependency error.",
        "headers": {
          "Cache-Control": {
            "schema": {
              "const": "no-store"
            }
          },
          "Content-Length": {
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
            }
          },
          "X-Request-ID": {
            "schema": {
              "$ref": "./common.json#/components/schemas/ID"
            }
          },
          "Content-Type": {
            "schema": {
              "const": "application/problem+json"
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "./common.json#/components/schemas/Problem"
            }
          }
        }
      },
      "HeadProblem": {
        "description": "The same Problem representation headers and length as GET, without a body.",
        "headers": {
          "Cache-Control": {
            "schema": {
              "const": "no-store"
            }
          },
          "Content-Length": {
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
            }
          },
          "X-Request-ID": {
            "schema": {
              "$ref": "./common.json#/components/schemas/ID"
            }
          },
          "Content-Type": {
            "schema": {
              "const": "application/problem+json"
            }
          }
        }
      }
    }
  }
