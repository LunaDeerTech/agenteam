# Central Account/SMTP and security/database/MinIO. Product readiness remains false.
# The process reads its environment; it does not load this file automatically.
AGENTEAM_CENTRAL_LOG_LEVEL=info
AGENTEAM_CENTRAL_SHUTDOWN_TIMEOUT=10s
AGENTEAM_CENTRAL_HTTP_ADDR=127.0.0.1:8080
# Production requires HTTPS. HTTP is only for literal localhost/loopback;
# a TLS-terminating proxy must preserve the canonical public Host.
AGENTEAM_CENTRAL_PUBLIC_ORIGIN=http://localhost:8080
# Required explicit deployment coordinates; replace this example password.
AGENTEAM_CENTRAL_DATABASE_URL=postgresql://agenteam:replace-me@127.0.0.1:5432/agenteam
AGENTEAM_CENTRAL_DATABASE_TLS_MODE=verify-full
# Omit CA_FILE to use system roots; otherwise select your deployment's PEM CA.
# AGENTEAM_CENTRAL_DATABASE_CA_FILE=/path/to/deployment-ca.pem
AGENTEAM_CENTRAL_DATABASE_MAX_CONNS=10
AGENTEAM_CENTRAL_DATABASE_CONNECT_TIMEOUT=5s
AGENTEAM_CENTRAL_DATABASE_STARTUP_TIMEOUT=2m
AGENTEAM_CENTRAL_DATABASE_LOCK_TIMEOUT=5s

# Required independent random 32-byte signing key per deployment. This placeholder
# is deliberately invalid. Use strict padded standard base64; never reuse a
# Secret AES key. Keep previous kids only while old cursors must verify.
AGENTEAM_CENTRAL_CURSOR_KEYRING={"format":1,"current_kid":"c1","keys":[{"kid":"c1","key_b64":"<deployment-generated-32-byte-key-base64>"}]}

# Required independent Knowledge tree confirmation keys. Use 1-32 unique kids
# and strict padded base64 for exactly 32 random bytes per key. Every retained
# key must differ from all current/history cursor, Secret, download and Account
# keys, even when their IDs differ. Keep prior kids while issued confirmations
# must verify. This placeholder is deliberately invalid; there is no default.
AGENTEAM_CENTRAL_KNOWLEDGE_CONFIRMATION_KEYRING={"format":1,"current_kid":"k1","keys":[{"kid":"k1","key_b64":"<deployment-generated-independent-knowledge-confirmation-key-base64>"}]}

# Required independent AES-256 master keys. Versions are canonical positive
# int64 decimal strings; no material may equal any cursor key or historical key
# at another version. Keep required older versions until retirement completes.
# This placeholder is deliberately invalid. Never log this environment value.
AGENTEAM_CENTRAL_SECRET_KEYRING={"format":1,"current_version":"1","keys":[{"version":"1","key_b64":"<deployment-generated-independent-32-byte-key-base64>"}]}

# Optional outbound deployment CA, appended to system roots. Separate from DB CA.
# Explicit unreadable/invalid CA fails pure configuration validation; no TLS bypass.
# AGENTEAM_CENTRAL_OUTBOUND_CA_FILE=/path/to/outbound-ca.pem
# Private destination rules live in the database; no environment allow-list exists.

# Required explicit trusted deployment storage. Precreate a private bucket with
# versioning never enabled, no ObjectLock, lifecycle or bucket policy. These
# credentials and endpoints never use runtime outbound rules or ambient AWS env.
AGENTEAM_CENTRAL_OBJECT_ENDPOINT=https://minio.example.invalid:9000
AGENTEAM_CENTRAL_OBJECT_BUCKET=agenteam
AGENTEAM_CENTRAL_OBJECT_ACCESS_KEY=replace-with-deployment-access-key
AGENTEAM_CENTRAL_OBJECT_SECRET_KEY=replace-with-deployment-secret-key
AGENTEAM_CENTRAL_OBJECT_TLS_MODE=verify-full
# AGENTEAM_CENTRAL_OBJECT_CA_FILE=/path/to/object-store-ca.pem
# Optional Runner-facing alias of the SAME store; startup verifies both origins.
# AGENTEAM_CENTRAL_OBJECT_TRANSFER_ENDPOINT=https://runner-storage.example.invalid:9000
AGENTEAM_CENTRAL_OBJECT_SPOOL_DIR=/var/lib/agenteam/object-spool

# Required independent random signing material, different from every current or
# historical cursor/Secret key. Placeholder is deliberately invalid.
AGENTEAM_CENTRAL_OBJECT_DOWNLOAD_KEYRING={"format":1,"current_kid":"d1","keys":[{"kid":"d1","key_b64":"<deployment-generated-independent-download-key-base64>"}]}

# Required independent random 32-byte Account keys, different from every current
# or historical cursor/Secret/download key. This placeholder is deliberately
# invalid; use strict padded standard base64 and never log the environment value.
AGENTEAM_CENTRAL_ACCOUNT_KEYRING={"format":1,"current_kid":"a1","keys":[{"kid":"a1","key_b64":"<deployment-generated-independent-account-key-base64>"}]}
# Required fixed absolute recovery file. Precreate its parent as a service-owned
# 0700 directory without symlinks. Startup creates/checks a service-owned 0600
# regular file; --check-config only validates this path and never opens it.
# Contains sensitive bootstrap/recovery material: restrict reading and backups.
AGENTEAM_CENTRAL_ACCOUNT_RECOVERY_LOG=/var/lib/agenteam/account-recovery/recovery.jsonl
