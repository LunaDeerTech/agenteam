# D04 Audit/cursor/Secret/outbound and database-backed diagnostics. Product readiness remains false.
# The process reads its environment; it does not load this file automatically.
AGENTEAM_CENTRAL_LOG_LEVEL=info
AGENTEAM_CENTRAL_SHUTDOWN_TIMEOUT=10s
AGENTEAM_CENTRAL_HTTP_ADDR=127.0.0.1:8080
AGENTEAM_CENTRAL_PUBLIC_ORIGIN=http://localhost:8080
# Required explicit deployment coordinates; replace this example password.
AGENTEAM_CENTRAL_DATABASE_URL=postgresql://agenteam:replace-me@127.0.0.1:5432/agenteam
AGENTEAM_CENTRAL_DATABASE_TLS_MODE=verify-full
# Omit CA_FILE to use system roots; otherwise select your deployment's PEM CA.
# AGENTEAM_CENTRAL_DATABASE_CA_FILE=/path/to/deployment-ca.pem
AGENTEAM_CENTRAL_DATABASE_MAX_CONNS=10
AGENTEAM_CENTRAL_DATABASE_CONNECT_TIMEOUT=5s
AGENTEAM_CENTRAL_DATABASE_STARTUP_TIMEOUT=2m
AGENTEAM_CENTRAL_DATABASE_LOCK_TIMEOUT=5s

# Required independent random 32-byte signing key per deployment. This placeholder
# is deliberately invalid. Use strict padded standard base64; never reuse a
# Secret AES key. Keep previous kids only while old cursors must verify.
AGENTEAM_CENTRAL_CURSOR_KEYRING={"format":1,"current_kid":"c1","keys":[{"kid":"c1","key_b64":"<deployment-generated-32-byte-key-base64>"}]}

# Required independent AES-256 master keys. Versions are canonical positive
# int64 decimal strings; no material may equal any cursor key or historical key
# at another version. Keep required older versions until retirement completes.
# This placeholder is deliberately invalid. Never log this environment value.
AGENTEAM_CENTRAL_SECRET_KEYRING={"format":1,"current_version":"1","keys":[{"version":"1","key_b64":"<deployment-generated-independent-32-byte-key-base64>"}]}

# Optional outbound deployment CA, appended to system roots. Separate from DB CA.
# Explicit unreadable/invalid CA fails pure configuration validation; no TLS bypass.
# AGENTEAM_CENTRAL_OUTBOUND_CA_FILE=/path/to/outbound-ca.pem
# Private destination rules live in the database; no environment allow-list exists.
