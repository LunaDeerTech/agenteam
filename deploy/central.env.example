# D03 database-backed diagnostics. Product readiness remains false.
# The process reads its environment; it does not load this file automatically.
AGENTEAM_CENTRAL_LOG_LEVEL=info
AGENTEAM_CENTRAL_SHUTDOWN_TIMEOUT=10s
AGENTEAM_CENTRAL_HTTP_ADDR=127.0.0.1:8080
AGENTEAM_CENTRAL_PUBLIC_ORIGIN=http://localhost:8080
# Required explicit deployment coordinates; replace this example password.
AGENTEAM_CENTRAL_DATABASE_URL=postgresql://agenteam:replace-me@127.0.0.1:5432/agenteam
AGENTEAM_CENTRAL_DATABASE_TLS_MODE=verify-full
# Omit CA_FILE to use system roots; otherwise select your deployment's PEM CA.
# AGENTEAM_CENTRAL_DATABASE_CA_FILE=/path/to/deployment-ca.pem
AGENTEAM_CENTRAL_DATABASE_MAX_CONNS=10
AGENTEAM_CENTRAL_DATABASE_CONNECT_TIMEOUT=5s
AGENTEAM_CENTRAL_DATABASE_STARTUP_TIMEOUT=2m
AGENTEAM_CENTRAL_DATABASE_LOCK_TIMEOUT=5s
