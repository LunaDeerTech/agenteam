+        },
+      );
+    };
+    Object.defineProperty(window, "__d26IndependentObservation", {
+      value: {
+        arm,
+        async take(stage: string) {
+          const record = records.get(stage);
+          if (!record) throw new Error("INDEPENDENT_STAGE_MISSING");
+          try {
