+type wireFixture struct {
+	net       *netfixture.Descriptor
+	policy    *outbound.PolicyService
+	transport wire.Transport
+	actor     id.Actor
+	adapter   *wire.OpenAIChat
+	budget    *wire.Budget
+	budgets   []*wire.Budget
