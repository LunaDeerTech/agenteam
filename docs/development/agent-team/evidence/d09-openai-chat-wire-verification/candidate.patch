+		if e := b.Drain(cancelled); e == nil || b.Joined() {
+			t.Fatal("Drain falsely joined held bodies")
+		}
+		force, forceStop := context.WithTimeout(context.Background(), 5*time.Second)
+		defer forceStop()
+		if e := b.Force(force); e != nil || !b.Joined() {
