+	v := AvailableChatModel{ID: mustID[mc.Model](t), ProviderID: mustID[mc.Provider](t), Scope: scope, Name: "public model", ProviderName: "public provider", Version: 1, Capabilities: caps.Clone()}
+	caps.InputModalities[0] = "image"
