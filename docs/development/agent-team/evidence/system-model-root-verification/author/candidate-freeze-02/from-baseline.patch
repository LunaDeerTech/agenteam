+	v.stop(t, syscall.SIGINT)
+	for _, sentinel := range []string{"root-model-credential-sentinel", "root-model-updated-sentinel", "temporary-root-value"} {
+		if strings.Contains(v.p.stderr.String()+v.p.stdout.String(), sentinel) {
