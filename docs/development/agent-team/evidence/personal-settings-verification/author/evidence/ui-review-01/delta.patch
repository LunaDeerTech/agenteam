+  route.path.endsWith('/appearance')
+    ? 'appearance'
+    : route.path.endsWith('/password')
+      ? 'password'
+      : 'profile',
+)
+const title = computed(
+  () => ({ profile: '基本资料', appearance: '主题', password: '修改密码' })[section.value],
+)
