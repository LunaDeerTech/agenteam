+const emit = defineEmits<{ logout: [] }>()
+const route = useRoute()
+const groups = [
+  { label: '个人资料', path: '/settings/profile', leaf: '基本资料' },
+  { label: '界面偏好', path: '/settings/appearance', leaf: '主题' },
+  { label: '账号安全', path: '/settings/password', leaf: '修改密码' },
