+          <button
+            type="button"
+            class="settings-group-toggle"
+            :aria-expanded="expanded.has(group.path)"
+            :aria-controls="`settings-${group.leaf}`"
+            @click="toggle(group.path)"
+          >
+            {{ group.label }}
+          </button>
+          <ul v-if="expanded.has(group.path)" :id="`settings-${group.leaf}`">
