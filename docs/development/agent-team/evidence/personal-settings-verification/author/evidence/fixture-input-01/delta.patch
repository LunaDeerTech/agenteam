+    const other = await second.newPage();
+    const oldOther = await enter(other, data.admin, "/settings/profile");
+    let posts = 0;
+    page.on("request", (r) => {
+      if (
+        r.method() === "POST" &&
+        new URL(r.url()).pathname === "/api/v1/me/change-password"
+      )
+        posts++;
+    });
+    await passwordFields(
+      page,
+      data.admin.password,
+      data.new_password,
+      data.new_password + "different",
+    );
+    await page.getByRole("button", { name: "修改密码", exact: true }).click();
+    await expect(page.locator("#settings-confirmation")).toHaveAttribute(
+      "aria-invalid",
+      "true",
+    );
+    expect(posts).toBe(0);
+    await passwordFields(
+      page,
+      "Wrong private current value",
+      data.new_password,
+    );
+    const wrong = await responseFor(
+      page,
+      () => page.getByRole("button", { name: "修改密码", exact: true }).click(),
+      "/api/v1/me/change-password",
+      "POST",
+      400,
+    );
+    expect((await wrong.json()).field_errors).toContainEqual({
+      path: "/current_password",
+      code: "INVALID",
+    });
+    await expect(page.locator("#settings-current_password")).toBeEditable();
+    await passwordFields(page, data.admin.password, "aaaaaaaaaaaaaaaa");
+    const weak = await responseFor(
+      page,
+      () => page.getByRole("button", { name: "修改密码", exact: true }).click(),
+      "/api/v1/me/change-password",
+      "POST",
+      400,
+    );
+    expect((await weak.json()).field_errors).toContainEqual({
+      path: "/password",
+      code: "PASSWORD_WEAK",
+    });
+    await expect(page.locator("#settings-current_password")).toBeEditable();
+    await passwordFields(page, data.admin.password, data.new_password);
+    await responseFor(
+      page,
+      () => page.getByRole("button", { name: "修改密码", exact: true }).click(),
+      "/api/v1/me/change-password",
+      "POST",
+    );
+    await expect(
+      page.getByText("密码已修改，当前登录已更新，其他旧登录已失效。", {
+        exact: true,
+      }),
+    ).toBeVisible();
+    for (const field of ["current_password", "new_password", "confirmation"])
+      expect(
+        (await page.locator(`#settings-${field}`).inputValue()) === "",
+      ).toBe(true);
+    const rotated = await identity(page);
+    expect(
+      rotated.status === 200 &&
+        rotated.user_id === original.user_id &&
+        rotated.session_id !== original.session_id &&
+        rotated.csrf_length === 43,
+    ).toBe(true);
+    await navigate(page, "基本资料");
+    await page.locator("#profile-display-name").fill("After password rotation");
+    await responseFor(
+      page,
+      () => page.getByRole("button", { name: "保存资料", exact: true }).click(),
+      "/api/v1/me",
+      "PATCH",
+    );
+    await expect(page.getByText("资料已保存。", { exact: true })).toBeVisible();
+    expect((await identity(other)).status).toBe(401);
+    await other.reload();
+    await expect(
+      other.getByRole("heading", { name: "登录", exact: true }),
+    ).toBeVisible();
+    await expect(other.locator("#profile-email")).toHaveCount(0);
+    const fresh = await signin.newPage();
+    await enter(
+      fresh,
+      { ...data.admin, password: data.new_password },
+      "/settings/profile",
+    );
+    await logout(fresh);
+    await fresh
+      .getByRole("textbox", { name: "邮箱", exact: true })
+      .fill(data.admin.email);
+    await privateFill(fresh.locator("#login-password"), data.admin.password);
+    const refused = await responseFor(
+      fresh,
+      () => fresh.getByRole("button", { name: "登录", exact: true }).click(),
+      "/api/v1/sessions/login",
+      "POST",
+      401,
+    );
+    expect((await refused.json()).code).toBe("UNAUTHENTICATED");
+    await privateFill(fresh.locator("#login-password"), "");
+    expect((await profile(page)).user.initial_password_suggestion).toBe(false);
+    await storedMaterialsAbsent(page);
+    const final = await profile(page);
+    result({
+      user_id: original.user_id,
+      session_id: rotated.session_id,
+      old_session_ids: [original.session_id, oldOther.session_id],
+      version: final.user.version,
+      writes: 2,
+    });
+  } finally {
+    await second.close();
+    await signin.close();
+    data.admin.password = "";
+    data.new_password = "";
+  }
+});
