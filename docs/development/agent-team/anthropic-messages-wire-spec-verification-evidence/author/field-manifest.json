  "project_decisions": [
    "API base_url exact path plus /messages (different configuration convention from SDK origin)",
    "No tool SDK/runtime execution or generic transport; product waits for accepted tools",
    "Ordered C0 Message plus optional Event.PartIndex; empty TextPart permitted by C0 and preserved as structure",
    "Bounded native name subset, strict unknown fields, explicit unsupported features, no capability inference",
    "Nullable usage tolerance is project normalization; SDK Required annotation does not authorize invented zero"
  ],
  "c0_evidence": {
    "path": "internal/central/model/contract/chat.go",
    "baseline": "0d22c7fd9202a81478804f2b810ebaddc350e856",
    "sha256": "01f2abe8a8d5be54ed3193f22be75094f3868e2b09a6d8ca5dab6fb70aac2d88",
    "functions": [
      "TextPart.Validate permits empty text; Message.Validate requires one or more actual parts",
      "Message.Clone preserves Parts order; ToolCallPart.Validate is final object/number/depth boundary"
    ]
  }
}
