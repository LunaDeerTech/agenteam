import { createSystemAccountSecurityAPI } from '../source/web/src/api/system-account-security'
import { createSystemSMTPSettingsAPI } from '../source/web/src/api/system-smtp-settings'
import { createSystemSMTPDeliveryAPI } from '../source/web/src/api/system-smtp-delivery'
