func (f *smtpDeliveryWebFixture) captureRequest(w http.ResponseWriter, r *http.Request) bool {
	if r.Method != "POST" || (r.URL.Path != "/api/v1/system/smtp/test" && !strings.HasPrefix(r.URL.Path, "/api/v1/system/mail-jobs/")) {
		return true
	}
	f.mu.Lock()
	defer f.mu.Unlock()
	if !(f.cut.armed && f.cut.path == r.URL.Path) && (f.cut.key == "" || r.Header.Get("Idempotency-Key") != f.cut.key) {
		return true
	}
	raw, e := io.ReadAll(io.LimitReader(r.Body, 16385))
	_ = r.Body.Close()
	if e != nil || len(raw) > 16384 {
		clear(raw)
		http.Error(w, "owned request capture failed", 400)
		return false
	}
	r.Body = &smtpDeliveryCapturedBody{Reader: bytes.NewReader(raw), raw: raw}
	if f.cut.armed && f.cut.key == "" {
		f.cut.method = r.Method
		f.cut.key = r.Header.Get("Idempotency-Key")
		f.cut.csrf = r.Header.Get("X-CSRF-Token")
		f.cut.body = append([]byte(nil), raw...)
		f.cut.sameBody = true
		f.cut.sameCSRF = true
		f.cut.sameMethodPath = true
	} else {
		f.cut.replays++
		f.cut.sameBody = f.cut.sameBody && bytes.Equal(f.cut.body, raw)
		f.cut.sameCSRF = f.cut.sameCSRF && f.cut.csrf == r.Header.Get("X-CSRF-Token")
		f.cut.sameMethodPath = f.cut.sameMethodPath && f.cut.method == r.Method && f.cut.path == r.URL.Path
	}
	f.cut.dispatched++
	return true
}
func (f *smtpDeliveryWebFixture) controlResponse(response *http.Response) error {
	r := response.Request
	if r == nil {
		return nil
	}
	f.mu.Lock()
	defer f.mu.Unlock()
	if !f.cut.armed || r.Method != f.cut.method || r.URL.Path != f.cut.path || r.Header.Get("Idempotency-Key") != f.cut.key {
		return nil
	}
	if response.StatusCode != 202 {
		return nil
	}
	raw, e := io.ReadAll(io.LimitReader(response.Body, 600001))
	_ = response.Body.Close()
	defer clear(raw)
	var value map[string]any
	if e != nil || len(raw) > 600000 || json.Unmarshal(raw, &value) != nil {
		return errors.New("owned cut requires original accepted response")
	}
	job, ok := value["job_id"].(string)
	if !ok {
		return errors.New("owned cut accepted job missing")
	}
	if _, e = foundation.ParseID[struct{}](job); e != nil {
		return errors.New("owned cut accepted job invalid")
	}
	retry := strings.HasSuffix(r.URL.Path, "/retry")
	if (!retry && len(value) != 1) || (retry && (len(value) != 2 || value["version"] == nil || job == f.cut.sourceID)) {
		return errors.New("owned cut accepted response shape mismatch")
	}
	f.cut.jobID = job
	f.cut.armed = false
	f.cut.dropped++
	return &invitationResponseLost{status: response.StatusCode, header: response.Header.Clone(), prefix: append([]byte(nil), raw[:len(raw)/2]...), length: len(raw)}
}
func (f *smtpDeliveryWebFixture) waitJob(ctx context.Context, jobID, phase string) {
	f.t.Helper()
	bounded, cancel := context.WithTimeout(ctx, 12*time.Second)
	defer cancel()
	conn, closeConnection := invitationsWebConnect(f.t, bounded, f.db)
	defer closeConnection()
	tick := time.NewTicker(20 * time.Millisecond)
	defer tick.Stop()
	for {
		var actual string
		var joined bool
		e := conn.QueryRow(bounded, `SELECT j.phase,(j.current_attempt_id IS NULL AND j.phase='cancelled') OR (a.job_id=j.id AND a.phase='closed' AND a.terminal AND a.io_joined AND a.result IS NOT NULL) FROM agenteam_account.mail_jobs j LEFT JOIN agenteam_account.mail_attempts a ON a.id=j.current_attempt_id WHERE j.id=$1`, jobID).Scan(&actual, &joined)
		if e == nil && actual == phase && joined {
			return
		}
		select {
		case <-bounded.Done():
			f.t.Fatal("owned current delivery did not terminally join", phase)
		case <-tick.C:
		}
	}
}
func (f *smtpDeliveryWebFixture) databaseJobs(ctx context.Context) []map[string]any {
	f.t.Helper()
	conn, closeConnection := invitationsWebConnect(f.t, ctx, f.db)
	defer closeConnection()
	rows, e := conn.Query(ctx, `SELECT i.job_id::text,i.kind,coalesce(j.phase,'enqueue_pending'),coalesce(j.attempts,0)::text,coalesce(j.version,1)::text,i.created_at,a.channel,a.result,coalesce(j.reason,''),cfg.configured,coalesce(a.terminal,false),coalesce(a.io_joined,false),coalesce(a.phase,'')
 FROM agenteam_account.delivery_intents i LEFT JOIN agenteam_account.mail_jobs j ON j.id=i.job_id AND j.intent_id=i.id LEFT JOIN agenteam_account.mail_attempts a ON a.id=j.current_attempt_id AND a.job_id=j.id CROSS JOIN agenteam_account.smtp_settings cfg WHERE cfg.singleton ORDER BY i.created_at DESC,i.job_id DESC`)
	if e != nil {
		f.t.Fatal("owned management database observation failed", e)
	}
	defer rows.Close()
	out := []map[string]any{}
	for rows.Next() {
		var job, kind, phase, attempts, version, reason, protocol string
		var created time.Time
		var channel, result *string
		var configured, terminal, joined bool
		if e = rows.Scan(&job, &kind, &phase, &attempts, &version, &created, &channel, &result, &reason, &configured, &terminal, &joined, &protocol); e != nil {
			f.t.Fatal(e)
		}
		at, e := foundation.NewInstant(created)
		if e != nil {
			f.t.Fatal(e)
		}
		compatibility := "backend_log"
		if configured {
			compatibility = "smtp"
		}
		var actual any
		if channel != nil {
			if *channel == "log" {
				actual = "backend_log"
			} else if *channel == "smtp" {
				actual = "smtp"
			} else {
				f.t.Fatal("unrecognized owned actual channel")
			}
			compatibility = actual.(string)
		}
		if result != nil && (!terminal || !joined || protocol != "closed") {
			f.t.Fatal("owned result was not the actually joined current attempt")
		}
		if phase == "processing" {
			phase = "unknown"
		}
		item := map[string]any{"job_id": job, "kind": kind, "phase": phase, "attempts": attempts, "version": version, "created_at": at.String(), "channel": compatibility, "attempt_channel": actual, "attempt_result": result}
		if reason != "" {
			item["reason"] = reason
		}
		out = append(out, item)
	}
	if e = rows.Err(); e != nil {
		f.t.Fatal(e)
	}
	return out
}
func (f *smtpDeliveryWebFixture) waitHeld(ctx context.Context, connections int) {
	bounded, cancel := context.WithTimeout(ctx, 5*time.Second)
	defer cancel()
	tick := time.NewTicker(20 * time.Millisecond)
	defer tick.Stop()
	for {
		v, e := f.smtp.State(bounded, f.smtpHeld.ID)
		if e == nil && v.Connections == connections && v.Mail == connections && v.Closed == 0 {
			return
		}
		select {
		case <-bounded.Done():
			f.t.Fatal("owned actual SMTP hold was not reached")
		case <-tick.C:
		}
	}
}
func (f *smtpDeliveryWebFixture) seedRead(ctx context.Context) {
	f.t.Helper()
	if f.mode != "read" || len(f.databaseJobs(ctx)) != 0 {
		f.t.Fatal("owned empty read premise changed")
	}
	// Both accepted production worker slots are occupied by real SMTP I/O.
	// A due scan is observed in SQL before formal revoke. This does not prove
	// an in-memory enqueue or the return code of a later root ClaimDelivery call.
	f.configureSMTP(ctx, f.smtpHeld)
	held := []string{}
	for range 2 {
		r := f.setup.entryHTTP(ctx, f.adminClient, "POST", "/api/v1/system/smtp/test", map[string]string{"recipient": "read-held@example.test"}, f.csrf, true, 202)
		held = append(held, httpString(f.t, r, "job_id"))
	}
	f.waitHeld(ctx, 2)
	f.unconfigureSMTP(ctx)
	cancelled := ""
	for n := range 23 {
		r := f.setup.entryHTTP(ctx, f.adminClient, "POST", "/api/v1/system/invitations", map[string]string{"email": fmt.Sprintf("smtp-delivery-read-%02d@example.test", n)}, f.csrf, true, 201)
		if n == 0 {
			f.waitQueued(ctx, httpString(f.t, r, "job_id"))
			f.setup.entryHTTP(ctx, f.adminClient, "POST", "/api/v1/system/invitations/"+httpString(f.t, r, "id")+"/revoke", map[string]any{"version": r["version"]}, f.csrf, true, 204)
			cancelled = httpString(f.t, r, "job_id")
			f.cancelledID = cancelled
		}
	}
	client := f.setup.entryClient()
	anonymous := f.setup.entryHTTP(ctx, client, "GET", "/api/v1/auth/bootstrap", nil, "", false, 200)
	f.setup.entryHTTP(ctx, client, "POST", "/api/v1/password-resets/request", map[string]string{"email": f.admin.Email}, httpString(f.t, anonymous, "csrf_token"), true, 202)
	if e := f.smtp.Release(ctx, f.smtpHeld.ID); e != nil {
		f.t.Fatal(e)
	}
	for _, job := range held {
		f.waitJob(ctx, job, "sent")
	}
	f.waitJob(ctx, cancelled, "cancelled")
	bounded, cancel := context.WithTimeout(ctx, 15*time.Second)
	defer cancel()
	tick := time.NewTicker(25 * time.Millisecond)
	defer tick.Stop()
	for {
		rows := f.databaseJobs(bounded)
		ready := len(rows) == 26
		resets := 0
		for _, row := range rows {
			if row["kind"] == "password_reset" {
				resets++
			}
			if row["phase"] != "sent" && row["phase"] != "cancelled" {
				ready = false
			}
			if row["job_id"] == cancelled && (row["attempt_channel"] != nil || row["attempts"] != "0") {
				f.t.Fatal("formal revocation acquired an unexpected attempt")
			}
		}
		if ready && resets == 1 {
			f.cancelledFacts(bounded)
			return
		}
		select {
		case <-bounded.Done():
			f.t.Fatal("formal three-kind continuous read preparation did not join")
		case <-tick.C:
		}
	}
}
func (f *smtpDeliveryWebFixture) cutFacts(ctx context.Context) map[string]any {
	f.mu.Lock()
	c := f.cut
	c.body = nil
	f.mu.Unlock()
	if c.key == "" || c.jobID == "" {
		f.t.Fatal("owned accepted cut missing")
	}
	namespace, name, resource, action, auditResource := "account.smtp", "smtp-test", f.singletonID, "smtp.test.request", c.jobID
	if c.sourceID != "" {
		namespace, name, resource, action, auditResource = "account.mail-retry", "mail-retry", c.sourceID, "smtp.delivery.retry", c.sourceID
	}
	key, e := foundation.NewCommandIdentity(namespace, []string{f.admin.UserID}, name, foundation.IdempotencyKey(c.key))
	if e != nil {
		f.t.Fatal("owned command identity invalid")
	}
	digest := sha256.Sum256([]byte(key.Canonical()))
	identityDigest := "sha256:" + hex.EncodeToString(digest[:])
	conn, closeConnection := invitationsWebConnect(f.t, ctx, f.db)
	defer closeConnection()
	var commands, intents, events, audits int
	if e = conn.QueryRow(ctx, `WITH owned AS (SELECT * FROM agenteam_account.commands WHERE identity_digest=$1 AND namespace=$2 AND command_name=$3 AND owner_id=$4 AND user_id=$4 AND resource_id=$5 AND attempt_id=$6 AND phase='committed')
 SELECT (SELECT count(*) FROM owned),
 (SELECT count(*) FROM agenteam_account.delivery_intents i JOIN owned c ON i.id=c.id AND i.job_id=c.attempt_id AND i.initiator_id=c.user_id),
 (SELECT count(*) FROM agenteam_outbox.events e JOIN owned c ON e.id=c.id WHERE e.event_type='account.delivery-requested' AND e.producer='account'),
 (SELECT count(*) FROM agenteam_audit.audit_records a JOIN owned c ON a.cause_ref=c.id::text WHERE a.scope='system' AND a.producer='account' AND a.action=$7 AND a.resource_kind='mail_job' AND a.resource_id=$8 AND a.user_id=$4 AND a.outcome='success' AND a.ordinal=0)`, identityDigest, namespace, name, f.admin.UserID, resource, c.jobID, action, auditResource).Scan(&commands, &intents, &events, &audits); e != nil {
		f.t.Fatal("owned exact command/intent/event/audit facts unavailable", e)
	}
	return map[string]any{"commands": commands, "intents": intents, "events": events, "audits": audits, "dropped": c.dropped, "replays": c.replays, "dispatched": c.dispatched, "same_body": c.sameBody, "same_csrf": c.sameCSRF, "same_method_path": c.sameMethodPath, "job_id": c.jobID}
}
func newSMTPDeliveryWebRoot(t *testing.T, ctx context.Context, own *smtpDeliveryWebFixture) *authenticationWebFixture {
	t.Helper()
	db := pgfixture.NewDatabase(t)
	conn, closeConnection := invitationsWebConnect(t, ctx, db)
	defer closeConnection()
	if own.smtp != nil {
		migrator, e := postgres.NewMigrator(db.Config(t, nil))
		if e != nil {
			t.Fatal("owned SMTP policy migration setup failed", e)
		}
		if result := migrator.Migrate(ctx); !result.Migrated {
			t.Fatal("owned SMTP policy migrations failed", result.Fault)
		}
		ports, e := outbound.SelectedPorts(uint16(own.smtpFailed.Port), uint16(own.smtpSuccess.Port), uint16(own.smtpUnknown.Port), uint16(own.smtpHeld.Port))
		if e != nil {
			t.Fatal(e)
		}
		rule, e := outbound.NewRule(own.smtp.PrivateIP+"/32", ports, false)
		if e != nil {
			t.Fatal(e)
		}
		_, e = outbound.NewRules(rule)
		if e != nil {
			t.Fatal(e)
		}
		raw, e := json.Marshal([]map[string]any{{"cidr": own.smtp.PrivateIP + "/32", "ports": []int{own.smtpFailed.Port, own.smtpSuccess.Port, own.smtpUnknown.Port, own.smtpHeld.Port}, "allow_http": false}})
		if e != nil {
			t.Fatal(e)
		}
		if _, e = conn.Exec(ctx, `UPDATE agenteam_outbound.outbound_policy SET rules=$1::jsonb WHERE singleton AND version=1`, string(raw)); e != nil {
			t.Fatal("owned exact SMTP policy seed failed", e)
		}
	}
	listener, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal("owned frontend listener unavailable")
	}
	t.Cleanup(func() { _ = listener.Close() })
	origin := "http://" + listener.Addr().String()
	inputs := accountenv.New(t)
	objects, err := objectfixture.Environment(ctx, db.Name)
	if err != nil {
		t.Fatal("owned object fixture unavailable")
	}
	values := inputs.Values()
	for _, v := range objects {
		k, value, _ := strings.Cut(v, "=")
		values[k] = value
	}
	for k, v := range map[string]string{
		"DATABASE_URL": db.Fixture.URL(db.Name), "DATABASE_CA_FILE": db.Fixture.CAFile,
		"DATABASE_STARTUP_TIMEOUT": "15s", "HTTP_ADDR": "127.0.0.1:0", "PUBLIC_ORIGIN": origin, "SHUTDOWN_TIMEOUT": "2s",
		"CURSOR_KEYRING": `{"format":1,"current_kid":"test","keys":[{"kid":"test","key_b64":"AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="}]}`,
		"SECRET_KEYRING": `{"format":1,"current_version":"1","keys":[{"version":"1","key_b64":"ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8="}]}`,
	} {
		values[config.Prefix+k] = v
	}
	var environment []string
	for k, v := range values {
		environment = append(environment, k+"="+v)
	}
