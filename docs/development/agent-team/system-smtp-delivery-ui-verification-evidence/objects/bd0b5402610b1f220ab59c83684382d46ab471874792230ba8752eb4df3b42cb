// All controls are task-owned. Production requests, job state, command/audit
// transactions and SMTP attempts run unchanged; no mail phase/version is seeded.
type smtpDeliveryCut struct {
	path, method, key, csrf, jobID, sourceID string
	body                                     []byte
	armed                                    bool
	dispatched, dropped, replays             int
	sameBody, sameCSRF, sameMethodPath       bool
}
type smtpDeliveryWebFixture struct {
	*authenticationWebFixture
	mode                                           string
	admin, member                                  personalWebCredential
	setup                                          *entryWebFixture
	adminClient                                    *http.Client
	csrf                                           string
	smtp                                           *smtpfixture.Fixture
	smtpFailed, smtpSuccess, smtpUnknown, smtpHeld smtpfixture.Endpoint
	mu                                             sync.Mutex
	cut                                            smtpDeliveryCut
	failRead, failSession                          atomic.Bool
	readFailures, sessionFailures                  atomic.Int32
	invitationID, sourceID, singletonID            string
	secrets                                        []string
}

func newSMTPDeliveryWebFixture(t *testing.T, ctx context.Context, mode string) *smtpDeliveryWebFixture {
	t.Helper()
	f := &smtpDeliveryWebFixture{mode: mode}
	var e error
	f.smtp, e = smtpfixture.Start(ctx)
	if e != nil {
		t.Fatal("owned SMTP delivery fixture unavailable", e)
	}
	t.Cleanup(func() {
		c, cancel := context.WithTimeout(context.Background(), 20*time.Second)
		defer cancel()
		if e := f.smtp.Close(c); e != nil {
			t.Error(e)
		}
	})
	for _, item := range []struct {
		target   *smtpfixture.Endpoint
		scenario smtpfixture.Scenario
	}{
		{&f.smtpSuccess, smtpfixture.Scenario{Mode: "none"}},
		{&f.smtpFailed, smtpfixture.Scenario{Mode: "none", MailCode: 550}},
		{&f.smtpUnknown, smtpfixture.Scenario{Mode: "none", CloseStage: "accepted"}},
		{&f.smtpHeld, smtpfixture.Scenario{Mode: "none", PauseStage: "mail"}},
	} {
		*item.target, e = f.smtp.Create(ctx, item.scenario)
		if e != nil {
			t.Fatal(e)
		}
	}
	f.authenticationWebFixture = newSMTPDeliveryWebRoot(t, ctx, f)
	t.Cleanup(func() {
		c, cancel := context.WithTimeout(context.Background(), 3*time.Second)
		defer cancel()
		if e := f.smtp.Release(c, f.smtpHeld.ID); e != nil {
			t.Error("owned paused SMTP release failed", e)
		}
	})
	f.admin = personalWebCredential{Email: f.entry.Email, Password: f.entry.Password, UserID: f.entry.ID}
	f.setup = &entryWebFixture{authenticationWebFixture: f.authenticationWebFixture}
	f.adminClient = f.setup.entryClient()
	anonymous := f.setup.entryHTTP(ctx, f.adminClient, "GET", "/api/v1/auth/bootstrap", nil, "", false, 200)
	f.setup.entryHTTP(ctx, f.adminClient, "POST", "/api/v1/sessions/login", map[string]string{"email": f.admin.Email, "password": f.admin.Password}, httpString(t, anonymous, "csrf_token"), true, 200)
	session := f.setup.entryHTTP(ctx, f.adminClient, "GET", "/api/v1/session", nil, "", false, 200)
	f.csrf = httpString(t, session, "csrf_token")
	configuration := f.setup.entryHTTP(ctx, f.adminClient, "GET", "/api/v1/system/smtp", nil, "", false, 200)
	f.singletonID = httpString(t, configuration, "id")
	if mode == "authority" {
		helper := &personalWebFixture{authenticationWebFixture: f.authenticationWebFixture}
		f.member = helper.inviteMember(ctx, f.adminClient, f.csrf, "smtp-delivery-member@example.test", "smtp-delivery-member")
	}
	if mode != "read" {
		receipt := f.setup.entryHTTP(ctx, f.adminClient, "POST", "/api/v1/system/invitations", map[string]string{"email": "smtp-delivery-source@example.test"}, f.csrf, true, 201)
		f.invitationID = httpString(t, receipt, "id")
		f.sourceID = httpString(t, receipt, "job_id")
		f.waitJob(ctx, f.sourceID, "sent")
		f.configureSMTP(ctx, f.smtpSuccess)
	}
	f.secrets = []string{f.admin.Password, f.member.Password}
	f.private("smtp-delivery-material.json", map[string]any{"admin": f.admin, "member": f.member, "source_id": f.sourceID})
	t.Cleanup(func() {
		for _, secret := range f.secrets {
			if secret != "" && f.log.contains(secret) {
				t.Error("SMTP delivery private material escaped restricted fixture")
			}
		}
		f.mu.Lock()
		clear(f.cut.body)
		f.cut = smtpDeliveryCut{}
		f.mu.Unlock()
		f.admin.Password = ""
		f.member.Password = ""
		f.secrets = nil
	})
	return f
}

