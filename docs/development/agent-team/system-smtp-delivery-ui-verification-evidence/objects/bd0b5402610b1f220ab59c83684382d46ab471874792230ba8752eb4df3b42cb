type smtpDeliveryWebIPC struct {
	Sequence  int    `json:"sequence"`
	Action    string `json:"action"`
	ID        string `json:"id"`
	Phase     string `json:"phase"`
	Endpoint  string `json:"endpoint"`
	UserID    string `json:"user_id"`
	SessionID string `json:"session_id"`
}

func (f *smtpDeliveryWebFixture) deliveryIPC(ctx context.Context, r smtpDeliveryWebIPC) map[string]any {
	out := map[string]any{"ok": true, "sequence": r.Sequence}
	validID := func(raw string) {
		if _, e := foundation.ParseID[struct{}](raw); e != nil {
			f.t.Fatal("invalid owned delivery ID")
		}
	}
	switch r.Action {
	case "snapshot":
		out["jobs"] = f.databaseJobs(ctx)
		if f.cancelledID != "" {
			out["cancelled_unattempted"] = f.cancelledFacts(ctx)
		}
	case "seed-read":
		f.seedRead(ctx)
		out["jobs"] = f.databaseJobs(ctx)
	case "wait":
		validID(r.ID)
		if r.Phase != "sent" && r.Phase != "failed" && r.Phase != "unknown" && r.Phase != "cancelled" {
			f.t.Fatal("invalid owned terminal phase")
		}
		f.waitJob(ctx, r.ID, r.Phase)
		out["jobs"] = f.databaseJobs(ctx)
	case "configure":
		endpoints := map[string]smtpfixture.Endpoint{"success": f.smtpSuccess, "failed": f.smtpFailed, "unknown": f.smtpUnknown, "held": f.smtpHeld}
		endpoint, ok := endpoints[r.Endpoint]
		if !ok {
			f.t.Fatal("unknown owned SMTP endpoint")
		}
		f.configureSMTP(ctx, endpoint)
	case "unconfigure":
		f.unconfigureSMTP(ctx)
	case "release":
		if e := f.smtp.Release(ctx, f.smtpHeld.ID); e != nil {
			f.t.Fatal(e)
		}
	case "wait-held":
		f.waitHeld(ctx, 1)
	case "compete":
		validID(r.ID)
		observed := f.setup.entryHTTP(ctx, f.adminClient, "GET", "/api/v1/system/mail-jobs/"+r.ID+"/management", nil, "", false, 200)
		out["receipt"] = f.setup.entryHTTP(ctx, f.adminClient, "POST", "/api/v1/system/mail-jobs/"+r.ID+"/retry", map[string]any{"version": observed["version"]}, f.csrf, true, 202)
	case "revoke-source":
		list := f.setup.entryHTTP(ctx, f.adminClient, "GET", "/api/v1/system/invitations?limit=25", nil, "", false, 200)
		found := false
		for _, item := range httpItems(f.t, list) {
			v, ok := item.(map[string]any)
			if !ok {
				f.t.Fatal("formal source observation invalid")
			}
			if v["id"] == f.invitationID {
				f.setup.entryHTTP(ctx, f.adminClient, "POST", "/api/v1/system/invitations/"+f.invitationID+"/revoke", map[string]any{"version": v["version"]}, f.csrf, true, 204)
				found = true
			}
		}
		if !found {
			f.t.Fatal("exact formal source missing before revoke")
		}
	case "arm-drop":
		path := "/api/v1/system/smtp/test"
		if r.ID != "" {
			validID(r.ID)
			path = "/api/v1/system/mail-jobs/" + r.ID + "/retry"
		}
		f.mu.Lock()
		clear(f.cut.body)
		f.cut = smtpDeliveryCut{path: path, sourceID: r.ID, armed: true}
		f.mu.Unlock()
		out["armed"] = true
	case "cut-facts":
		out["facts"] = f.cutFacts(ctx)
	case "wait-cut":
		f.mu.Lock()
		job := f.cut.jobID
		f.mu.Unlock()
		validID(job)
		f.waitJob(ctx, job, r.Phase)
		out["job_id"] = job
	case "arm-get-fail":
		f.failRead.Store(true)
		out["armed"] = true
	case "arm-session-fail":
		f.failSession.Store(true)
		out["armed"] = true
	case "failure-facts":
		out["read_failures"] = f.readFailures.Load()
		out["session_failures"] = f.sessionFailures.Load()
	case "demote", "promote", "revoke-session":
		if f.mode != "authority" || r.UserID != f.admin.UserID {
			f.t.Fatal("exact delivery authority target rejected")
		}
		validID(r.SessionID)
		conn, done := invitationsWebConnect(f.t, ctx, f.db)
		defer done()
		var exists bool
		if e := conn.QueryRow(ctx, `SELECT EXISTS(SELECT 1 FROM agenteam_account.sessions WHERE id=$1 AND user_id=$2 AND revoked_at IS NULL)`, r.SessionID, r.UserID).Scan(&exists); e != nil || !exists {
			f.t.Fatal("exact owned active Session missing")
		}
		if r.Action == "revoke-session" {
			tag, e := conn.Exec(ctx, `UPDATE agenteam_account.sessions SET revoked_at=clock_timestamp(),revoked_reason='administrative' WHERE id=$1 AND user_id=$2 AND revoked_at IS NULL`, r.SessionID, r.UserID)
			if e != nil || tag.RowsAffected() != 1 {
				f.t.Fatal("exact owned Session revoke failed")
			}
		} else {
			role, old := "user", "admin"
			if r.Action == "promote" {
				role, old = "admin", "user"
			}
			tag, e := conn.Exec(ctx, `UPDATE agenteam_account.users SET role=$1,version=version+1,updated_at=clock_timestamp() WHERE id=$2 AND role=$3`, role, r.UserID, old)
			if e != nil || tag.RowsAffected() != 1 {
				f.t.Fatal("exact owned role transition failed")
			}
		}
	default:
		f.t.Fatal("unknown SMTP delivery IPC action")
	}
	return out
}

func (f *smtpDeliveryWebFixture) browserSMTPDelivery(ctx context.Context) map[string]any {
	f.t.Helper()
	root, e := filepath.Abs("../account-captcha-web")
	if e != nil {
		f.t.Fatal(e)
	}
	cmd := exec.CommandContext(ctx, "node", filepath.Join(root, "node_modules/@playwright/test/cli.js"), "test", "--config", filepath.Join(root, "system-smtp-delivery.config.js"))
	cmd.Dir = root
	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
	cmd.Cancel = func() error { return syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL) }
	cmd.WaitDelay = time.Second
	for _, value := range os.Environ() {
		if !strings.HasPrefix(value, "TMPDIR=") && !strings.HasPrefix(value, "AGENTEAM_AUTH_WEB_") && !strings.HasPrefix(value, "AGENTEAM_SMTP_DELIVERY_WEB_") && !strings.HasPrefix(value, "PLAYWRIGHT_NO_COPY_PROMPT=") && !strings.HasPrefix(value, "DEBUG=") && !strings.HasPrefix(value, "PWDEBUG=") {
			cmd.Env = append(cmd.Env, value)
		}
	}
	cmd.Env = append(cmd.Env, "TMPDIR="+f.directory, "AGENTEAM_AUTH_WEB_ORIGIN="+f.origin, "AGENTEAM_SMTP_DELIVERY_WEB_CASE="+f.mode, "AGENTEAM_AUTH_WEB_PRIVATE="+f.directory, "AGENTEAM_AUTH_WEB_CHROMIUM=/usr/bin/chromium", "PLAYWRIGHT_NO_COPY_PROMPT=1")
	if images := os.Getenv("AGENTEAM_AUTH_WEB_IMAGES"); images != "" {
		if !filepath.IsAbs(images) {
			f.t.Fatal("SMTP delivery image path must be absolute")
		}
		cmd.Env = append(cmd.Env, "AGENTEAM_AUTH_WEB_IMAGES="+images)
	}
	var output bytes.Buffer
	cmd.Stdout, cmd.Stderr = &output, &output
	if e = cmd.Start(); e != nil {
		f.t.Fatal("locked SMTP delivery browser runner could not start")
	}
	done := make(chan error, 1)
	go func() { done <- cmd.Wait() }()
	joined := false
	defer func() {
		if !joined {
			_ = cmd.Cancel()
			<-done
		}
		_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
		cmd.Env = nil
	}()
	tick := time.NewTicker(20 * time.Millisecond)
	defer tick.Stop()
	sequence := 0
	var runErr error
wait:
	for {
		select {
		case runErr = <-done:
			joined = true
			break wait
		case <-tick.C:
			raw, err := os.ReadFile(filepath.Join(f.directory, "smtp-delivery-ipc.json"))
			if errors.Is(err, os.ErrNotExist) {
				continue
			}
			var request smtpDeliveryWebIPC
			decode := json.Unmarshal(raw, &request)
			clear(raw)
			if err != nil || decode != nil || request.Sequence < 1 || request.Sequence > 128 {
				f.t.Error("private SMTP delivery IPC rejected")
				_ = cmd.Cancel()
				continue
			}
			if request.Sequence <= sequence {
				continue
			}
			if request.Sequence != sequence+1 {
				f.t.Error("private SMTP delivery IPC sequence invalid")
				_ = cmd.Cancel()
				continue
			}
			reply := f.deliveryIPC(ctx, request)
			sequence = request.Sequence
			f.private("smtp-delivery-ack-"+strconv.Itoa(sequence)+".json", reply)
		}
	}
	safe := output.String()
	for _, secret := range f.secrets {
		if secret != "" {
			safe = strings.ReplaceAll(safe, secret, "[redacted]")
		}
	}
	f.mu.Lock()
	for _, secret := range []string{f.cut.key, f.cut.csrf, string(f.cut.body)} {
		if secret != "" {
			safe = strings.ReplaceAll(safe, secret, "[redacted]")
		}
	}
	f.mu.Unlock()
	f.t.Log(safe)
	if runErr != nil {
		f.t.Fatalf("actual SMTP delivery production browser failed: %v", runErr)
	}
	raw, e := os.ReadFile(filepath.Join(f.directory, "smtp-delivery-result.json"))
	if e != nil {
		f.t.Fatal("safe SMTP delivery browser result missing")
	}
	defer clear(raw)
	var result map[string]any
	if json.Unmarshal(raw, &result) != nil || result["completed"] != true {
		f.t.Fatal("safe SMTP delivery browser result invalid")
	}
	return result
}

