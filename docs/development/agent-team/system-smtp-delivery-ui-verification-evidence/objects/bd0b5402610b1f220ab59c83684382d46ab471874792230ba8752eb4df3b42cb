		e := conn.QueryRow(c, `SELECT j.phase='pending' AND j.attempts=0 AND j.current_attempt_id IS NULL AND j.pass>0 FROM agenteam_account.mail_jobs j JOIN agenteam_account.delivery_intents i ON i.id=j.intent_id AND i.job_id=j.id WHERE j.id=$1 AND i.kind='invitation' AND i.initiator_id=$2`, job, f.admin.UserID).Scan(&scanned)
