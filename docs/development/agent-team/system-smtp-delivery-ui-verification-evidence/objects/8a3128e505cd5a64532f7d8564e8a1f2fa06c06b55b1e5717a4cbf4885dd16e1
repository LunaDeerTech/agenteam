function button(label: string, root: ParentNode = document) {
  const value = [...root.querySelectorAll<HTMLButtonElement>('button')].find(
    (node) =>
      (
        node.querySelector('.button-label[aria-hidden="false"]')?.textContent ?? node.textContent
      )?.trim() === label || node.getAttribute('aria-label') === label,
  )
  expect(value, `button ${label}`).toBeTruthy()
  return value!
}
async function click(label: string, root: ParentNode = document) {
  button(label, root).click()
  await flushPromises()
}
function field(label: string) {
  const node = [...document.querySelectorAll<HTMLLabelElement>('label')].find(
    (value) => value.textContent?.replace(/\s*\*$/, '') === label,
  )
  expect(node, `field ${label}`).toBeTruthy()
  return document.getElementById(node!.htmlFor) as HTMLInputElement
}
async function change(label: string, value: string) {
  const node = field(label)
  node.value = value
  node.dispatchEvent(new Event('input', { bubbles: true }))
  await flushPromises()
}
async function submit(label = '请求测试发送') {
  const submitter = button(label)
  submitter.form!.dispatchEvent(
    new SubmitEvent('submit', { bubbles: true, cancelable: true, submitter }),
  )
  await flushPromises()
}
function dialogs(count = 1) {
  const layers = [...document.querySelectorAll<HTMLElement>('[role="dialog"]')]
  expect(layers).toHaveLength(count)
  for (const layer of layers.slice(0, -1)) {
    expect(layer.inert).toBe(true)
    expect(layer.getAttribute('aria-hidden')).toBe('true')
  }
  const top = layers.at(-1)!
  expect(top.inert).toBe(false)
  expect(top.getAttribute('aria-hidden')).toBeNull()
  return { layers, top }
}

describe('SMTP delivery controller observations and explicit commands', () => {
  it('does not publish a list row below the version already confirmed by a retry receipt', async () => {
    const f = await controller(),
      p = f.page
    await p.openDetail(id(20))
    const pending = p.requestRetry()
    await flushPromises()
    f.setDelivery(async (path, init) =>
      init.method === 'POST'
        ? json({ job_id: id(21), version: '27' }, 202)
        : json(path.includes('?') ? { items: [job(21, '5')] } : job(21, '5')),
    )
    p.finishRetry(true)
    await pending
    expect(p.state.confirmed?.version).toBe('27')
    expect(p.detail.phase).toBe('error')
    p.backToList()
    await p.refresh()
    expect(p.list.phase).toBe('error')
    expect(p.list.rows).toHaveLength(0)
    expect(p.state.confirmed?.version).toBe('27')
  })
  it('gates only new tests by complete configured observation and separates receipt from failed post-read', async () => {
    const f = await controller(),
      p = f.page
    p.updateRecipient('Recipient@[IPv6:2001:DB8::7]')
    f.available.ready = false
    await p.requestTest()
    expect(f.writes()).toHaveLength(0)
    f.available.ready = true
    f.available.configured = false
    await p.requestTest()
    expect(f.writes()).toHaveLength(0)
    f.available.configured = true
    p.updateRecipient('bad address')
    await p.requestTest()
    expect(f.writes()).toHaveLength(0)
    p.updateRecipient('Recipient@[IPv6:2001:DB8::7]')
    f.setDelivery(async (_, i) =>
      i.method === 'POST' ? json({ job_id: id(21) }, 202) : problem('UNAVAILABLE'),
    )
    await p.requestTest()
    expect(p.state.confirmed).toEqual({ kind: 'test', jobID: id(21) })
    expect(p.progress.value?.phase).toBe('confirmed')
    expect(p.detail.phase).toBe('error')
    expect(p.state.writeMessage).toContain('请求已确认，任务详情读取失败')
    expect(p.draft.recipient).toBe('')
    expect(f.writes()).toHaveLength(1)
    expect(JSON.parse(f.writes()[0]![1].body as string)).toEqual({
      recipient: 'Recipient@[IPv6:2001:DB8::7]',
    })
    f.setDelivery(async () => json(job(21, '9')))
    await p.rereadDetail()
    expect(p.detail.value?.version).toBe('9')
    expect(p.state.confirmed?.jobID).toBe(id(21))
    expect(f.writes()).toHaveLength(1)
    p.updateRecipient('next@example.test')
    expect(p.canTest.value).toBe(true)
    expect(p.feedback.value).toBe('idle')
  })
  it('commits only whole successful pages and retains the exact previous cursor across inline detail', async () => {
    const f = await controller(),
      p = f.page,
      rows = Array.from({ length: 25 }, (_, n) => job(100 - n))
    f.setDelivery(async (path) =>
      path.includes('cursor=opaque%2Bnext')
        ? json({ items: [job(70, '8')] })
        : path.includes('?')
          ? json({ items: rows, next_cursor: 'opaque+next' })
          : json(job(70, '6')),
    )
    await p.firstPage()
    expect(p.list.rows).toHaveLength(25)
    expect(p.list.hasNext).toBe(true)
    await p.nextPage()
    expect(p.list.page).toBe(2)
    expect(p.list.rows[0]?.version).toBe('8')
    await p.openDetail(id(70))
    expect(p.detail.value?.version).toBe('8')
    p.backToList()
    expect(p.list.page).toBe(2)
    expect(p.list.rows[0]?.job_id).toBe(id(70))
    await p.refresh()
    expect(f.reads().at(-1)![0]).toContain('cursor=opaque%2Bnext')
    await p.previousPage()
    expect(p.list.page).toBe(1)
    f.setDelivery(async () => json({ items: [job(60), { ...job(59), recipient: 'unexpected' }] }))
    await p.nextPage()
    expect(p.list.phase).toBe('error')
    expect(p.list.rows).toHaveLength(0)
    expect(p.list.page).toBe(1)
    f.setDelivery(async () => json({ items: [] }))
    await p.refresh()
    expect(f.reads().at(-1)![0]).toBe('/api/v1/system/mail-jobs/management?limit=25')
    expect(p.list.phase).toBe('empty')
  })
  it.each(['list', 'detail'] as const)(
    'retires cancelled %s synchronously and never auto-restarts after detach/reattach or native join',
    async (scope) => {
      const f = await controller(),
        p = f.page,
        tail = barrier(),
        cancel = vi.fn(() => tail.promise)
      f.setDelivery(
        async () =>
          new Response(new ReadableStream<Uint8Array>({ cancel }), {
            headers: { 'Content-Type': 'application/json' },
          }),
      )
      const task = scope === 'list' ? p.refresh() : p.openDetail(id(20))
      await flushPromises()
      expect(p[scope].phase).toBe('loading')
      p.detach()
      expect(p[scope].phase).toBe('error')
      expect(p[scope].message).toContain('读取已取消')
      p.attach()
      const count = f.reads().length
      try {
        await task
        expect(cancel).toHaveBeenCalledTimes(1)
        expect(f.auth.state.busy).toBe(true)
        await flushPromises()
        expect(f.reads()).toHaveLength(count)
      } finally {
        tail.resolve()
      }
      await flushPromises()
      expect(p[scope].phase).toBe('error')
      expect(f.reads()).toHaveLength(count)
      f.setDelivery(async () => json(scope === 'list' ? { items: [] } : job()))
      await (scope === 'list' ? p.refresh() : p.rereadDetail())
      expect(p[scope].phase).toBe(scope === 'list' ? 'empty' : 'ready')
    },
  )
  it('waits for a preceding actual owner only for a never-started initial read', async () => {
    const f = await fixture(),
      held = barrier<Response>()
    f.setConfiguration(() => held.promise)
    const request = f.auth.system.smtp.get()
    await flushPromises()
    const p = createSystemSMTPDelivery(f.auth, () => ({ ready: true, configured: true }))
    disposers.push(p.dispose)
    p.afterNavigation('/system/smtp', '')
    p.attach()
    expect(p.list.phase).toBe('waiting')
    expect(f.reads()).toHaveLength(0)
    held.resolve(json(settings()))
    await request
    await flushPromises()
    expect(f.reads()).toHaveLength(1)
    expect(p.list.phase).toBe('ready')
    p.detach()
    p.attach()
    await flushPromises()
    expect(f.reads()).toHaveLength(1)
  })
  it.each([
    [job(), true],
    [{ ...job(), phase: 'failed', attempt_result: 'unknown' }, true],
    [
      { ...job(), phase: 'cancelled', attempts: '0', attempt_channel: null, attempt_result: null },
      true,
    ],
    [{ ...job(), phase: 'unknown', attempt_channel: null, attempt_result: null }, false],
    [{ ...job(), phase: 'unknown', attempt_result: 'unknown' }, true],
    [{ ...job(), phase: 'sent', attempt_result: null }, false],
    [{ ...job(), phase: 'retry_wait' }, false],
    [{ ...job(), version: '9223372036854775807' }, false],
  ] as const)(
    'uses necessary retry eligibility without equating phase and result %#',
    (value, allowed) => {
      expect(smtpJobRetryReason(value as SMTPDeliveryJob) === '').toBe(allowed)
    },
  )
  it('captures retry source/version, requires reread after known refusal, and accepts a new current version greater than one', async () => {
    const f = await controller(),
      p = f.page
    await p.openDetail(id(20))
    const first = p.requestRetry()
    await flushPromises()
    expect(p.retryConfirmation.target).toEqual({ job_id: id(20), version: '5' })
    f.setDelivery(async (_, i) =>
      i.method === 'GET' ? json(job(20, '9')) : problem('VERSION_CONFLICT', 409),
    )
    await p.rereadDetail()
    expect(p.detail.value?.version).toBe('9')
    expect(p.retryConfirmation.target?.version).toBe('5')
    p.finishRetry(true)
    await first
    expect(JSON.parse(f.writes()[0]![1].body as string)).toEqual({ version: '5' })
    expect(p.state.requiresRead).toBe(true)
    expect(p.retryReady.value).toBe(false)
    expect(p.progress.value?.phase).toBe('rejected')
    await p.rereadDetail()
    const next = p.requestRetry()
    await flushPromises()
    expect(p.retryConfirmation.target?.version).toBe('9')
    expect(f.writes()).toHaveLength(1)
    f.setDelivery(async (_, i) =>
      i.method === 'POST' ? json({ job_id: id(21), version: '27' }, 202) : json(job(21, '29')),
    )
    p.finishRetry(true)
    await next
    expect(p.state.confirmed).toEqual({
      kind: 'retry',
      sourceID: id(20),
      jobID: id(21),
      version: '27',
    })
    expect(p.detail.value?.version).toBe('29')
    expect(f.writes()).toHaveLength(2)
    f.setDelivery(async () => json(job(21, '1')))
    await p.rereadDetail()
    expect(p.detail.value?.version).toBe('29')
  })
  it('retains an uncertain original across failed management reads and disabled current configuration', async () => {
    const f = await controller(),
      p = f.page
    f.setDelivery(async () => problem('NOT_FOUND', 404))
    p.updateRecipient('Original@Example.Test')
    await p.requestTest()
    const original = f.writes()[0]![1]
    expect(p.progress.value?.phase).toBe('uncertain')
    f.available.configured = false
    await p.checkOriginal()
    expect(p.progress.value?.canRetryOriginal).toBe(true)
    expect(p.state.confirmed).toBeNull()
    expect(p.list.phase).toBe('error')
    f.setDelivery(async (_, i) =>
      i.method === 'POST'
        ? json({ job_id: id(21) }, 202)
        : json({ ...job(21), phase: 'unknown', attempt_result: 'unknown', reason: 'unknown' }),
    )
    await p.retryOriginal()
    expect(p.state.confirmed?.jobID).toBe(id(21))
    expect(p.detail.value?.phase).toBe('unknown')
    expect(
      f.writes()[1]![1].body === original.body &&
        JSON.stringify(f.writes()[1]![1].headers) === JSON.stringify(original.headers),
    ).toBe(true)
  })
  it('does not permit a fresh key after explicit abandon until a successful explicit read', async () => {
    const f = await controller(),
      p = f.page
    f.setDelivery(async () => problem('UNAVAILABLE'))
    p.updateRecipient('a@example.test')
    await p.requestTest()
    const abandoned = p.abandonOperation()
    await flushPromises()
    p.finishConfirmation(true)
    await abandoned
    expect(p.progress.value).toBeNull()
    expect(p.state.requiresRead).toBe(true)
    expect(f.writes()).toHaveLength(1)
    p.updateRecipient('b@example.test')
    expect(p.draft.recipient).toBe('')
    await p.refresh()
    expect(p.state.requiresRead).toBe(true)
    f.setDelivery(async () => json({ items: [] }))
    await p.refresh()
    p.updateRecipient('b@example.test')
    expect(p.canTest.value).toBe(true)
  })
  it('uses a coordinator generation independent of configuration discard and detaches before attaching', async () => {
    const f = await fixture(),
      configuration = createSystemSMTPSettings(f.auth),
      delivery = createSystemSMTPDelivery(f.auth)
    const sections = createSMTPSections(f.auth, configuration, delivery)
    disposers.push(sections.dispose)
    sections.afterNavigation('/system/smtp', '')
    sections.attach()
    await flushPromises()
    configuration.updateField('sender_name', 'draft')
    const order: string[] = []
    const detach = configuration.detach.bind(configuration),
      attach = delivery.attach.bind(delivery)
    vi.spyOn(configuration, 'detach').mockImplementation(() => {
      order.push('old-detach:' + sections.active.value)
      detach()
    })
    vi.spyOn(delivery, 'attach').mockImplementation(() => {
      order.push('new-attach:' + sections.active.value)
      attach()
    })
    const pending = sections.switchTo('delivery')
    await flushPromises()
    expect(await sections.switchTo('delivery')).toBe(false)
    expect(f.reads()).toHaveLength(0)
    configuration.finishConfirmation(true)
    expect(await pending).toBe(true)
    await flushPromises()
    expect(order).toEqual(['old-detach:configuration', 'new-attach:delivery'])
    expect(f.reads()).toHaveLength(1)
    expect(configuration.draft.sender_name).toBe('')
    expect(sections.active.value).toBe('delivery')
    sections.afterNavigation('/system/users', '/system/smtp')
    expect(sections.active.value).toBe('configuration')
  })
})

