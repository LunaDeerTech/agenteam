  expect(source.phase === "unknown" && source.attempt_channel === "smtp" && source.attempt_result === "unknown" && source.attempts === "1").toBe(true);
  await expect(title(page, "测试请求已接受")).toBeVisible();
  await expect(title(page, "请求结果未确认")).toHaveCount(0);
  await ipc("configure", { endpoint: "success" });
  await button(page, "申请新重试周期").click();
  await expect(top(page)).toHaveAccessibleName("申请新重试周期？");
  const back = page.goBack();
  await expect(page.locator('[role="dialog"]')).toHaveCount(2);
  await expect(top(page)).toHaveAccessibleName("放弃投递草稿或原请求追踪？");
  const beforeChecking = await seq(page);
  await restored(page, 2);
  await factAfter(page, beforeChecking, f => f.path === "/api/v1/session" && f.method === "GET" && f.status === 503);
  expect((await ipc("failure-facts")).session_failures === 1).toBe(true);
  await top(page).getByRole("button", { name: "继续编辑", exact: true }).click();
  await back;
  await expect(page).toHaveURL(/\/system\/smtp$/);
  await expect(page.locator('[role="dialog"]')).toHaveCount(1);
  await expect(top(page)).toHaveAccessibleName("申请新重试周期？");
  await focusContained(page);
  expect((await writes(page)).length === 1).toBe(true);
  await ipc("arm-drop", { id: source.job_id });
  after = await seq(page);
  await top(page).getByRole("button", { name: "确认申请新周期", exact: true }).click();
  await expect(title(page, "请求结果未确认")).toBeVisible();
  const cut = await factAfter(page, after, f => f.path === retryPath(source.job_id) && f.method === "POST" && f.status === 202);
  expect(!cut.receipt).toBe(true);
  const child = (await ipc("wait-cut", { phase: "sent" })).job_id as string;
  expect(child !== source.job_id && (await originalFacts(1)).job_id === child).toBe(true);
  after = await seq(page);
  await button(page, "检查当前状态").click();
  await originalSession(page, after, identity);
  const observed = await factAfter(page, after, f => f.path === jobPath(source.job_id) && f.status === 200 && f.ended && !!f.job);
  expect(observed.job!.phase === "unknown" && observed.job!.attempt_result === "unknown" && BigInt(observed.job!.version) === BigInt(source.version) + 1n).toBe(true);
  await expect(title(page, "请求结果未确认")).toBeVisible();
  await expect(title(page, "新重试周期已接受")).toHaveCount(0);
  await expect(button(page, "重试原请求")).toBeEnabled();
  expect((await writes(page)).length === 2).toBe(true);
  await originalFacts(1);
  after = await seq(page);
  await button(page, "重试原请求").click();
  const replay = await accepted(page, after, retryPath(source.job_id));
  expect(replay.job_id === child && BigInt(replay.version!) > 1n).toBe(true);
  await factAfter(page, after, f => f.path === jobPath(child) && f.status === 200 && f.ended && f.job?.phase === "sent" && f.job.attempt_channel === "smtp" && f.job.attempt_result === "sent" && f.job.version === replay.version);
  await expect(title(page, "新重试周期已接受")).toBeVisible();
  await expect(title(page, "请求结果未确认")).toHaveCount(0);
  await expect(button(page, "重试原请求")).toHaveCount(0);
  expect((await writes(page)).length === 3).toBe(true);
  expect((await originalFacts(2)).job_id === child).toBe(true);
  result({ delivery_unknown_confirmed: true, retry_request_unknown: true,
    native_two_confirmations: true, same_identity_recovery: true, native_tab: true,
    original_version_replay: true, current_read_not_receipt: true, exact_command: true,
    original_material_equal: true, browser_write_count: 3,
    browser_session_id: identity.session_id, source_job_id: source.job_id,
    source_version: source.version, confirmed_job_id: child, receipt_version: replay.version });
});
