    (f) =>
      f.path === "/api/v1/system/models/" + target &&
      f.method === "GET" &&
      f.status === 200 &&
      f.ended &&
      !!f.model,
  );
  await factAfter(
    page,
    model.sequence,
    (f) =>
      f.path === "/api/v1/system/model-providers/" + model.model!.provider_id &&
