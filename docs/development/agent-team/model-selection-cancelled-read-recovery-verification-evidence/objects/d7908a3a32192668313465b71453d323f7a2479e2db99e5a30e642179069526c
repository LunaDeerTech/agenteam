    .toBe(true);
  for (const key of ["Tab", "Shift+Tab", "Shift+Tab", "Tab"]) {
    await page.keyboard.press(key);
    expect(
      await top(page).evaluate((n) => n.contains(document.activeElement)),
    ).toBe(true);
  }
}

