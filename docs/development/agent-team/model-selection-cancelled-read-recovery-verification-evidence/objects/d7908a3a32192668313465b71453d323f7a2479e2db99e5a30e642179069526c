  await privateFill(page.locator("#login-password"), data.password);
  await button(page, "登录").click();
  await factAfter(
    page,
    after,
    (f) =>
      f.path === "/api/v1/session" &&
      f.status === 200 &&
      f.ended &&
      f.session?.user_id === data.user_id &&
      f.session.role === (who === "member" ? "user" : "admin"),
  );
