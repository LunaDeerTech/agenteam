+	evidence := f.browserSelection(ctx)
+	for _, key := range []string{"held_before_discard", "same_session", "cancelled_not_loading", "ready_preserved", "no_automatic_pair", "zero_write_until_recovery", "incomplete_draft_blocked", "explicit_pairs", "receipt_and_db"} {
+		if evidence[key] != true {
+			t.Fatalf("independent cancellation evidence incomplete: %s", key)
+		}
+	}
+	after := f.selectionFacts(ctx)
+	oldState := before["selection"].(map[string]any)
+	state := after["selection"].(map[string]any)
+	version, err := strconv.ParseUint(oldState["version"].(string), 10, 64)
+	if err != nil || state["id"] != oldState["id"] || state["version"] != strconv.FormatUint(version+1, 10) {
+		t.Fatal("independent final selector version mismatch")
+	}
+	bindings := state["configured"].(map[string]any)
+	for _, purpose := range []string{"embedding", "memory", "reranker"} {
+		target := bindings[purpose].(*string)
+		if target == nil || *target != f.ids[purpose] {
+			t.Fatal("independent final saved binding mismatch")
+		}
+	}
+	if bindings["image"].(*string) != nil {
+		t.Fatal("independent explicit optional clear missing")
+	}
+	for _, key := range []string{"commands", "audits", "events", "distinct_keys"} {
+		if after[key].(int) != before[key].(int)+1 {
+			t.Fatalf("independent final durable count mismatch: %s", key)
+		}
+	}
+	if after["embedding_events"] != before["embedding_events"] || after["deliveries"] != 0 || after["invocations"] != 0 {
+		t.Fatal("independent unexpected downstream effect")
+	}
+	if len(after["references"].([]map[string]string)) != 3 {
+		t.Fatal("independent final reference count mismatch")
+	}
+	t.Log("independent held-reference cancellation, explicit recovery and one formal selector save verified; 45s browser/2m top budgets")
+}
