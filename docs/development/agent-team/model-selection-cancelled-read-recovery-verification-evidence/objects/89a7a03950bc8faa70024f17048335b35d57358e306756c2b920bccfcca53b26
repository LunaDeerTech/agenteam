const receipt = (version = '2') => ({ kind: 'model.selection.update', resource_id: id(900), version, affected_references: '0' })
const json = (value: unknown, status = 200) => new Response(JSON.stringify(value), { status, headers: { 'Content-Type': status >= 400 ? 'application/problem+json' : 'application/json', 'X-Request-ID': id(9) } })
const problem = (code = 'DEPENDENCY_UNAVAILABLE', status = 503) => json({ type: 'urn:agenteam:problem:independent', title: '', detail: '', status, code, instance: '/api/v1/system/model-selection', request_id: id(9), commit_state: status < 500 ? 'not_committed' : 'not_started' }, status)
function gate<T>() { let resolve!: (value: T) => void; const promise = new Promise<T>(r => { resolve = r }); return { promise, resolve } }
function held(value: unknown) {
  const cancelled = gate<void>(), tail = gate<void>()
  const response = new Response(new ReadableStream<Uint8Array>({ start(c) { c.enqueue(new TextEncoder().encode(JSON.stringify(value))) }, cancel() { cancelled.resolve(); return tail.promise } }), { headers: { 'Content-Type': 'application/json' } })
  return { response, cancelled, tail }
}
