const model = (n: number, parent: number, type: ModelType): ProviderModel => ({ id: id(n), provider_id: id(parent), version: '1', created_at: time, updated_at: time, input: { name: 'Model ' + n, provider_model_id: ' Native ' + n, type, enabled: true, parameters: {}, request_overwrite: {}, header_overwrite: {}, capabilities: { tool_calls: false, parallel_tool_calls: false, streaming: false, reasoning: false, input_modalities: ['text'], output_modalities: type === 'chat' ? ['text'] : type === 'embedding' ? ['vector'] : type === 'image_generation' ? ['image'] : [], reasoning_efforts: [], structured_output_modes: type === 'chat' ? ['json_schema'] : [], context_length: null, max_output: null } } })
