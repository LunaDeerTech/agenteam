async function fixture(app = false) {
  const sources = new Map<string, Provider>([[id(100), provider(100, 'openai-embeddings')], [id(110), provider(110, 'openai-chat-completions')], [id(120), provider(120, 'jina-rerank')], [id(130), provider(130, 'openai-images-generations')]])
  const records = new Map<string, ProviderModel>([[id(200), model(200, 100, 'embedding')], [id(210), model(210, 110, 'chat')], [id(211), model(211, 110, 'chat')], [id(220), model(220, 120, 'reranker')], [id(230), model(230, 130, 'image_generation')]])
  let current = session(), saved = initial(), conflicts = 0, cuts = 0, getFailures = 0
  let sessionReply: Fetch = async () => json(current)
  let selectionRead: Fetch = async () => json(saved)
  let providerDetail: Fetch = async path => sources.has(path.split('/').at(-1)!) ? json(sources.get(path.split('/').at(-1)!)) : problem('NOT_FOUND', 404)
  let modelDetail: Fetch = async path => records.has(path.split('/').at(-1)!) ? json(records.get(path.split('/').at(-1)!)) : problem('NOT_FOUND', 404)
  let providerPage: Fetch = async () => json({ items: [...sources.values()].sort((a, b) => b.id.localeCompare(a.id)), next_cursor: null })
  let modelPage: Fetch = async path => json({ items: [...records.values()].filter(m => m.provider_id === new URL(path, 'http://fixture.invalid').searchParams.get('provider_id')).sort((a, b) => b.id.localeCompare(a.id)), next_cursor: null })
  const accepted = new Map<string, ReturnType<typeof receipt>>()
  const calls: { path: string; init: RequestInit }[] = []
  const fetcher: Fetch = async (path, init) => {
    calls.push({ path, init })
    if (path === '/api/v1/session') return sessionReply(path, init)
    if (path === '/api/v1/system/model-selection') {
      if (init.method === 'GET') { if (getFailures) { getFailures--; return problem() } return selectionRead(path, init) }
      const key = new Headers(init.headers).get('Idempotency-Key')!, old = accepted.get(key)
      if (old) return json(old)
      if (conflicts) { conflicts--; saved = { ...saved, version: '2' }; return problem('VERSION_CONFLICT', 409) }
      const body = JSON.parse(String(init.body)), result = receipt(String(BigInt(body.expected_version) + 1n))
      saved = { id: body.id, version: result.version, configured: { embedding: body.embedding, memory: body.memory, reranker: body.reranker, image: body.image } }
      accepted.set(key, result)
      if (cuts) { cuts--; throw new Error('synthetic-accepted-response-cut') }
      return json(result)
    }
    if (path.endsWith('/model-commands/lookup')) { const r = accepted.get(new Headers(init.headers).get('Idempotency-Key')!); return json({ found: !!r, receipt: r ?? null }) }
    if (path.startsWith('/api/v1/system/model-providers?')) return providerPage(path, init)
    if (path.startsWith('/api/v1/system/model-providers/')) return providerDetail(path, init)
    if (path.startsWith('/api/v1/system/models?')) return modelPage(path, init)
    if (path.startsWith('/api/v1/system/models/')) return modelDetail(path, init)
    if (path.startsWith('/api/v1/system/users?') || path.startsWith('/api/v1/system/invitations?')) return json({ items: [] })
    if (path.endsWith('/bootstrap')) return json({ csrf_token: 'A'.repeat(43), challenge_modes: ['rotate'], delivery_channel: 'backend_log' })
    if (path.endsWith('/logout')) return new Response(null, { status: 204 })
    throw new Error('unexpected private fixture route')
  }
  const auth = createSessionController(createAccountAPI(fetcher), createSystemAccountAPI(fetcher), createSystemInvitationAPI(fetcher), createSystemProviderAPI(fetcher), createSystemModelAPI(fetcher), createSystemModelSelectionAPI(fetcher), createSystemAccountSecurityAPI(fetcher))
  selected.auth = auth
  const router = createRouter({ history: createMemoryHistory(), routes: [
    { path: '/', component: HomeView, meta: { authentication: true, protected: true } },
    { path: '/login', name: 'login', component: LoginView, meta: { authentication: true } },
    { path: '/system', component: SystemSettingsView, redirect: '/system/users', meta: { authentication: true, protected: true, systemAdmin: true, navigation: { label: '系统设置', order: 20 } }, children: [
      { path: 'users', component: SystemUsersView }, { path: 'invitations', component: SystemInvitationsView }, { path: 'providers', component: SystemProvidersView }, { path: 'models', component: SystemModelsView }, { path: 'model-selection', component: SystemModelSelectionView },
    ] },
  ] })
  let page: SystemModelSelectionController | undefined
  if (app) {
    installAuthentication(router, auth); await router.push('/system/model-selection'); await router.isReady()
    const host = document.createElement('div'); host.id = 'app'; document.body.append(host)
    mounted = mount(App, { attachTo: host, global: { plugins: [router] } })
  } else { await auth.restore(); page = createSystemModelSelection(auth); pages.push(page); page.attach() }
  await flushPromises(); await flushPromises()
  return { auth, page: page!, router, sources, records, calls, saved: () => saved, setSaved: (v: SelectionState) => { saved = v },
    conflict: () => { conflicts++ }, cut: () => { cuts++ }, failGet: () => { getFailures++ },
    setSelectionRead: (f: Fetch) => { selectionRead = f },
    setSession: (f: Fetch) => { sessionReply = f }, resetSession: (n = 2) => { current = session(n); sessionReply = async () => json(current) },
    setProviderDetail: (f: Fetch) => { providerDetail = f }, resetProviderDetail: () => { providerDetail = async p => json(sources.get(p.split('/').at(-1)!)) },
    setModelDetail: (f: Fetch) => { modelDetail = f }, setProviders: (f: Fetch) => { providerPage = f }, setModels: (f: Fetch) => { modelPage = f },
    writes: () => calls.filter(c => c.path === '/api/v1/system/model-selection' && c.init.method === 'PUT'),
    details: () => calls.filter(c => /\/(models|model-providers)\//.test(c.path)),
    listings: () => calls.filter(c => /\/(models|model-providers)\?/.test(c.path)),
  }
}
const label = (b: HTMLButtonElement) => b.getAttribute('aria-label') ?? b.querySelector('.button-label[aria-hidden="false"]')?.textContent?.trim() ?? b.textContent?.trim()
function button(text: string, within: ParentNode = document) { const b = [...within.querySelectorAll<HTMLButtonElement>('button')].find(n => label(n) === text); if (!b) throw new Error('missing actual button: ' + text); return b }
async function click(text: string, within: ParentNode = document) { const b = button(text, within); expect(b.disabled).toBe(false); b.click(); await flushPromises(); await flushPromises() }
const dialogs = () => [...document.querySelectorAll<HTMLElement>('[role="dialog"]')]
const top = () => { const d = dialogs().at(-1); if (!d) throw new Error('missing actual dialog'); return d }
function heading(text: string) { return [...document.querySelectorAll('h3')].some(h => [...h.childNodes].filter(n => !(n instanceof HTMLElement && n.getAttribute('aria-hidden') === 'true')).map(n => n.textContent).join('').trim() === text) }
async function choose(f: Awaited<ReturnType<typeof fixture>>, purpose: SelectionPurpose, parent: number, target: number) {
  f.page.choosePurpose(purpose); await flushPromises()
  f.page.selectProvider(f.page.choices[purpose].providers.rows.find(p => p.id === id(parent))!); await flushPromises()
  f.page.selectModel(f.page.choices[purpose].models.rows.find(m => m.id === id(target))!); await flushPromises()
}


function observedPage() {
  return (mounted!.vm.$ as unknown as { provides: Record<symbol, unknown> }).provides[systemModelSelectionKey] as SystemModelSelectionController
}
const phases = (p: SystemModelSelectionController) => Object.fromEntries(['embedding','memory','reranker','image'].map(k => [k, p.references[k as SelectionPurpose].phase]))
const report = (name: string, value: unknown) => console.log(JSON.stringify({ diagnostic: name, facts: value }))

describe('Private fixed Selection discard diagnosis', () => {
  it('uses public App controls to retire a pending reference; after actual native tail the untouched loading rows persist until explicit reread', async () => {
    const f = await fixture(true), p = observedPage()
    expect(phases(p)).toEqual({ embedding: 'ready', memory: 'ready', reranker: 'ready', image: 'ready' })
    await click('编辑用途'); await click('不配置 Reranker', top()); await click('取消', top())
    expect(p.confirmation.open).toBe(true)
    const entered = gate<void>(), pending = held(f.records.get(id(210)))
    let requests = 0
    f.setModelDetail(async path => {
      if (path.endsWith(id(210))) { requests++; entered.resolve(); return pending.response }
      return json(f.records.get(path.split('/').at(-1)!))
    })
    const sessionsBefore = f.calls.filter(c => c.path === '/api/v1/session').length
    window.dispatchEvent(new Event('pageshow'))
    await entered.promise; await flushPromises(); await flushPromises()
    expect(f.calls.filter(c => c.path === '/api/v1/session')).toHaveLength(sessionsBefore + 1)
    expect(f.auth.state.phase).toBe('authenticated'); expect(dialogs()).toHaveLength(2)
    expect(f.auth.state.busy).toBe(true)
    expect(phases(p)).toEqual({ embedding: 'ready', memory: 'loading', reranker: 'loading', image: 'loading' })
    expect(button('放弃修改', top()).disabled).toBe(false)
    report('before-public-discard', { phase: f.auth.state.phase, busy: f.auth.state.busy, phases: phases(p), confirmOperable: !button('放弃修改', top()).disabled, writes: f.writes().length })
    await click('放弃修改', top()); await pending.cancelled.promise; await flushPromises()
    expect(dialogs()).toHaveLength(0); expect(p.editor.open).toBe(false)
    expect(f.auth.state.busy).toBe(true)
    expect(button('编辑用途').disabled).toBe(true)
    pending.tail.resolve(); await flushPromises(); await flushPromises()
    expect(f.auth.state.busy).toBe(false)
    expect(pending.response.body!.locked).toBe(false)
    const settledCalls = f.calls.length
    await flushPromises(); await flushPromises()
    expect(f.calls).toHaveLength(settledCalls)
    expect(phases(p)).toEqual({ embedding: 'ready', memory: 'loading', reranker: 'loading', image: 'loading' })
    await click('编辑用途'); await click('不配置 Image Generation', top())
    expect(p.changed.value).toBe(true); expect(p.locked.value).toBe(false); expect(p.blocked.value).toBe(false)
    expect(p.draftDetails.memory).toBeNull(); expect(p.draftDetails.reranker).toBeNull()
    expect(button('保存用途配置', top()).disabled).toBe(true)
    report('after-native-tail-and-reopen', { busy: f.auth.state.busy, nativeReaderReleased: !pending.response.body!.locked, changed: p.changed.value, locked: p.locked.value, blocked: p.blocked.value, phases: phases(p), draftReady: { embedding: !!p.draftDetails.embedding, memory: !!p.draftDetails.memory, reranker: !!p.draftDetails.reranker, imageCleared: p.draft.image === null }, saveDisabled: button('保存用途配置', top()).disabled, writes: f.writes().length, readsAfterSettle: f.calls.length-settledCalls, accountReads: f.calls.filter(c=>c.path==='/api/v1/system/account-settings').length })
    f.setModelDetail(async path => json(f.records.get(path.split('/').at(-1)!)))
    await click('重读 Memory', top()); await click('重读 Reranker', top())
    expect(button('保存用途配置', top()).disabled).toBe(false)
    expect(f.writes()).toHaveLength(0); expect(requests).toBe(1)
    report('explicit-public-reread-recovers', { canSave: p.canSave.value, busy: f.auth.state.busy, phases: phases(p), writes: f.writes().length })
  })

  it('waits for restored references to finish before the same public discard and reopens a saveable draft', async () => {
    const f = await fixture(true), p = observedPage()
    expect(phases(p)).toEqual({ embedding: 'ready', memory: 'ready', reranker: 'ready', image: 'ready' })
    await click('编辑用途'); await click('不配置 Reranker', top()); await click('取消', top())
    window.dispatchEvent(new Event('pageshow')); await flushPromises(); await flushPromises()
    expect(phases(p)).toEqual({ embedding: 'ready', memory: 'ready', reranker: 'ready', image: 'ready' })
    expect(f.auth.state.busy).toBe(false)
    await click('放弃修改', top()); await click('编辑用途'); await click('不配置 Image Generation', top())
    expect(button('保存用途配置', top()).disabled).toBe(false); expect(f.writes()).toHaveLength(0)
    report('completed-read-control', { canSave: p.canSave.value, busy: f.auth.state.busy, phases: phases(p), writes: f.writes().length })
  })
})

describe('Private fixed Selection state read discard diagnosis', () => {
  it('uses public discard while the restored singleton read is pending and only explicit refresh removes orphan loading', async () => {
    const f = await fixture(true), p = observedPage()
    expect(phases(p)).toEqual({ embedding: 'ready', memory: 'ready', reranker: 'ready', image: 'ready' })
    await click('编辑用途'); await click('不配置 Reranker', top()); await click('取消', top())
    const entered = gate<void>(), pending = held(f.saved())
    f.setSelectionRead(async () => { entered.resolve(); return pending.response })
    window.dispatchEvent(new Event('pageshow')); await entered.promise; await flushPromises(); await flushPromises()
    expect(f.auth.state.phase).toBe('authenticated'); expect(p.selection.phase).toBe('loading')
    expect(dialogs()).toHaveLength(2); expect(button('放弃修改', top()).disabled).toBe(false)
    await click('放弃修改', top()); await pending.cancelled.promise; await flushPromises()
    expect(f.auth.state.busy).toBe(true); pending.tail.resolve(); await flushPromises(); await flushPromises()
    expect(f.auth.state.busy).toBe(false); expect(pending.response.body!.locked).toBe(false)
    const count = f.calls.length; await flushPromises(); await flushPromises(); expect(f.calls).toHaveLength(count)
    expect(p.selection.phase).toBe('loading'); expect(p.selection.value).toBeNull()
    expect(dialogs()).toHaveLength(0); expect(button('配置用途').disabled).toBe(true)
    expect(button('刷新配置').disabled).toBe(false); expect(f.writes()).toHaveLength(0)
    report('singleton-after-native-tail', { busy: f.auth.state.busy, nativeReaderReleased: !pending.response.body!.locked, selectionPhase: p.selection.phase, selectionValueNull: p.selection.value === null, editDisabled: button('配置用途').disabled, refreshEnabled: !button('刷新配置').disabled, readsAfterSettle: f.calls.length-count, writes: f.writes().length })
    f.setSelectionRead(async () => json(f.saved())); await click('刷新配置')
    expect(p.selection.phase).toBe('ready'); expect(phases(p)).toEqual({ embedding: 'ready', memory: 'ready', reranker: 'ready', image: 'ready' })
    expect(button('编辑用途').disabled).toBe(false); expect(f.writes()).toHaveLength(0)
    report('singleton-explicit-refresh', { selectionPhase: p.selection.phase, phases: phases(p), editEnabled: !button('编辑用途').disabled, writes: f.writes().length })
  })
})
