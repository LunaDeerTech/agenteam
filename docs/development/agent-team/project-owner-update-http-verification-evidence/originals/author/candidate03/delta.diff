+func projectUpdateAbort(fn func()) (aborted bool) {
+	defer func() {
+		if value := recover(); value != nil {
+			if value != http.ErrAbortHandler {
+				panic(value)
+			}
+			aborted = true
+		}
+	}()
+	fn()
+	return
+}
