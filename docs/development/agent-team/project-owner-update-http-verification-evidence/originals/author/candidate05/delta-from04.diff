+				} else if !aborted || s.updates.Load()+s.lookups.Load() != 0 || auth != 0 || writes != 0 || headers != 0 || base.Body.Len() != 0 || base.flushes != 0 || base.Header().Get("Content-Type") != "" {
+					t.Fatal("unsupported capability reached auth/service/publication")
+				}
+			})
