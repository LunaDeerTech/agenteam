const clone = <T>(v: T): T => JSON.parse(JSON.stringify(v));

describe("Independent closed deletion-impact projection", () => {
  it("accepts every one of the 256 legal subsets with independent required/unbound derivation", async () => {
    for (let mask = 0; mask < 256; mask++) {
      const body = impact(
        kinds.flatMap((_, i) => (mask & (1 << i) ? [i] : [])),
      );
      const got = await parse(body);
      expect(got).toEqual(body);
      expect(Object.isFrozen(got)).toBe(true);
      expect(Object.isFrozen(got.reference_groups)).toBe(true);
      expect(got.reference_groups.every(Object.isFrozen)).toBe(true);
    }
  });
  it("preserves the exact 10000 boundary across eight groups and rejects noncanonical or excess counts", async () => {
    const body = impact([0, 1, 2, 3, 4, 5, 6, 7]);
    body.reference_count = "10000";
    body.reference_groups[0]!.count = "9993";
    expect(await parse(body)).toEqual(body);
    const invalid: unknown[] = [];
    for (const count of [
      "0",
      "01",
      "+1",
      "1.0",
      "1e0",
      "-1",
      "10001",
      1,
      null,
    ]) {
      const value = clone(impact([4]));
      (value.reference_groups[0] as any).count = count;
      (value as any).reference_count = count;
      invalid.push(value);
    }
    const tooMany = clone(body);
    tooMany.reference_count = "10001";
    tooMany.reference_groups[0]!.count = "9994";
    invalid.push(tooMany);
    const wrongTotal = clone(body);
    wrongTotal.reference_count = "9999";
    invalid.push(wrongTotal);
    for (const value of invalid)
      await expect(parse(value)).rejects.toMatchObject({
        kind: "invalid-response",
      });
  });
  it("rejects Summary requirement/blocker lies, crossed or unknown pairs, closed-field violations, duplicate/order/ninth groups", async () => {
    const values: unknown[] = [];
    for (const requirement of ["none", "optional", null])
      values.push({ ...impact([4]), replacement_requirement: requirement });
    values.push({
      ...impact([4]),
      delete_blocker: "reference_adapter_unbound",
    });
    values.push({ ...impact([4, 7]), delete_blocker: null });
    for (const pair of [
      ["agent", "meeting_summary"],
      ["project_summary", "memory"],
      ["platform_selector", "summary"],
      ["unknown", "meeting_summary"],
    ]) {
      const v = impact([4]);
      v.reference_groups[0] = {
        owner_kind: pair[0] as any,
        role: pair[1] as any,
        count: "1",
      };
      values.push(v);
    }
    const duplicate = impact([4]);
    duplicate.reference_count = "2";
    duplicate.reference_groups.push({ ...duplicate.reference_groups[0]! });
    values.push(duplicate);
    const reversed = impact([3, 4, 5]);
    reversed.reference_groups.reverse();
    values.push(reversed);
    const ninth = impact([0, 1, 2, 3, 4, 5, 6, 7]);
    ninth.reference_groups.push({ ...ninth.reference_groups[4]! });
    ninth.reference_count = "9";
    values.push(ninth);
    for (const key of Object.keys(impact([4]))) {
      const v = clone(impact([4]));
      delete (v as any)[key];
      values.push(v);
    }
    values.push({ ...impact([4]), debug: true });
    const extra = impact([4]);
    (extra.reference_groups[0] as any).reasoning_effort = "high";
    values.push(extra);
    values.push({ ...impact([4]), model_id: id(31) });
    for (const value of values)
      await expect(parse(value)).rejects.toMatchObject({
        kind: "invalid-response",
      });
  });
});

