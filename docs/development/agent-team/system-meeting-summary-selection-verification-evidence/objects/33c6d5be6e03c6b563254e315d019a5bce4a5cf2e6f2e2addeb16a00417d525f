// These probes use formal service calls and real fixture PG rows; only explicit
// corruption cases edit a persisted command, restoring its original bytes.
func TestIndependentSummaryA(t *testing.T) {
	t.Run("stored_plan_receipt_and_dual_owner", independentSummaryStored)
	t.Run("committed_unknown_then_current_session_revoked", independentSummaryUnknown)
}

func independentSummaryStored(t *testing.T) {
	v := newMeetingSummaryFixture(t, true)
	target, next := v.chat(t, true), v.chat(t, true)
	legacy := v.setMemory(t, target)
	v.selectModel(t, target)
	req := mc.DeleteModelRequest{CommandMeta: v.meta(t, "independent-dual-delete"), ID: target, ExpectedVersion: 1, Replacement: &next}
	receipt, e := v.service.DeleteModel(testContext(t), req)
	if e != nil || receipt.AffectedReferences != 2 {
		t.Fatal("dual owner delete", e)
	}
	summary := v.summary(t)
	platform, e := v.service.GetPlatformSelection(testContext(t), v.admin)
	if e != nil || summary.Model == nil || *summary.Model != next || platform.Configured == nil || platform.Configured.Memory != next || platform.Version != legacy.ExpectedVersion+2 {
		t.Fatal("both canonical owners not advanced exactly", e)
	}
	identity, e := f.NewCommandIdentity("model.system", []string{v.admin.Details().UserID}, "model.delete", req.Key)
	if e != nil {
		t.Fatal(e)
	}
	var originalPlan, originalReceipt []byte
	if e = v.raw.QueryRow(testContext(t), `SELECT mutation_plan,safe_receipt FROM agenteam_model.commands WHERE command_identity=$1`, identity.Canonical()).Scan(&originalPlan, &originalReceipt); e != nil {
		t.Fatal(e)
	}
	write := func(plan, receipt []byte) {
		t.Helper()
		if _, e := v.raw.Exec(testContext(t), `UPDATE agenteam_model.commands SET mutation_plan=$1,safe_receipt=$2 WHERE command_identity=$3`, plan, receipt, identity.Canonical()); e != nil {
			t.Fatal(e)
		}
	}
	t.Cleanup(func() { write(originalPlan, originalReceipt) })
	baseline := v.summaryFacts(t)
	for _, mode := range []string{"old_owner_missing", "unchanged_role_rewritten", "reference_wrong_version", "receipt_version"} {
		t.Run(mode, func(t *testing.T) {
			var plan map[string]any
			if json.Unmarshal(originalPlan, &plan) != nil {
				t.Fatal("plan decode")
			}
			safe := append([]byte(nil), originalReceipt...)
			switch mode {
			case "old_owner_missing":
				delete(plan, "AfterSelection")
			case "unchanged_role_rewritten":
				plan["AfterSelection"].(map[string]any)["Embedding"] = next.String()
			case "reference_wrong_version":
				plan["References"].([]any)[0].(map[string]any)["Version"] = "999"
			case "receipt_version":
				changed := receipt
				changed.Version++
				safe = summaryJSON(t, changed)
			}
			write(summaryJSON(t, plan), safe)
			got, e := v.service.LookupCommand(testContext(t), model.LookupCommandRequest{Meta: req.CommandMeta, Command: "model.delete"})
			requireCode(t, e, f.DependencyUnavailable)
			if got.Found || got.Receipt != nil {
				t.Fatal("bad stored command leaked receipt")
			}
			again, e := v.service.DeleteModel(testContext(t), req)
			requireCode(t, e, f.DependencyUnavailable)
			if again != (mc.CommandReceipt{}) {
				t.Fatal("bad replay leaked receipt")
			}
			write(originalPlan, originalReceipt)
			httpSameFacts(t, baseline, v.summaryFacts(t))
		})
	}
	// Old plans have no Summary discriminator: an unused embedded receipt does
	// not override the original safe receipt, preserving the historical loader.
	oldID, _ := f.NewCommandIdentity("model.system", []string{v.admin.Details().UserID}, "model.selection.update", legacy.Key)
	var oldPlan []byte
	if e = v.raw.QueryRow(testContext(t), `SELECT mutation_plan FROM agenteam_model.commands WHERE command_identity=$1`, oldID.Canonical()).Scan(&oldPlan); e != nil {
		t.Fatal(e)
	}
	var p map[string]any
	if json.Unmarshal(oldPlan, &p) != nil {
		t.Fatal("old plan decode")
	}
	if _, ok := p["BeforeMeetingSummary"]; ok {
		t.Fatal("legacy discriminator present")
	}
	p["Receipt"].(map[string]any)["version"] = "999"
	if _, e = v.raw.Exec(testContext(t), `UPDATE agenteam_model.commands SET mutation_plan=$1 WHERE command_identity=$2`, summaryJSON(t, p), oldID.Canonical()); e != nil {
		t.Fatal(e)
	}
	old, e := v.service.UpdatePlatformSelection(testContext(t), legacy)
	if _, restore := v.raw.Exec(testContext(t), `UPDATE agenteam_model.commands SET mutation_plan=$1 WHERE command_identity=$2`, oldPlan, oldID.Canonical()); restore != nil {
		t.Fatal(restore)
	}
	if e != nil || old.ResourceID != legacy.Selection.ID || old.Version != legacy.ExpectedVersion+1 {
		t.Fatal("legacy loader changed", e)
	}
	httpSameFacts(t, baseline, v.summaryFacts(t))
}

func independentSummaryUnknown(t *testing.T) {
	base := newMeetingSummaryFixture(t, true)
	target := base.chat(t, false)
	request := base.choice(t, target)
	identity, _ := f.NewCommandIdentity("model.system", []string{base.admin.Details().UserID}, "model.selection.update", request.Key)
	trace := newProjectModelPGTrace(t, net.JoinHostPort("127.0.0.1", base.db.Fixture.Port))
	u, e := url.Parse(base.db.Fixture.URL(base.db.Name))
	if e != nil {
		t.Fatal(e)
	}
	u.Host = trace.listener.Addr().String()
	raw := openStore(t, base.db.Config(t, map[string]string{"URL": u.String(), "TLS_MODE": "disable"}))
	writer := &meetingSummaryCommitStore{Store: raw, target: identity.Canonical(), arm: func() { trace.dropCommitACK.Store(true) }, reached: make(chan struct{}), release: make(chan struct{})}
	candidate := assemble(t, base.db, raw, writer)
	candidate.admin = base.admin
	var once sync.Once
	release := func() { once.Do(func() { close(writer.release) }) }
	t.Cleanup(release)
	ctx, cancel := context.WithTimeout(context.Background(), 12*time.Second)
	defer cancel()
	type response struct {
		receipt mc.CommandReceipt
		err     error
	}
	done := make(chan response, 1)
	joined := false
	t.Cleanup(func() {
		release()
		cancel()
		if !joined {
			select {
			case <-done:
				joined = true
			case <-time.After(2 * time.Second):
				t.Error("failed probe did not join its command goroutine")
			}
		}
	})
	go func() { r, e := candidate.service.UpdateMeetingSummarySelection(ctx, request); done <- response{r, e} }()
	waitSignal(t, trace.ackDropped)
	waitSignal(t, writer.reached)
	if e := base.account.Logout(testContext(t), account.LogoutRequest{Actor: base.admin, Key: "independent-unknown-logout"}); e != nil {
		t.Fatal("formal current Session logout", e)
	}
	release()
	var got response
	select {
	case got = <-done:
		joined = true
	case <-ctx.Done():
		t.Fatal("writer did not join")
	}
	writer.mu.Lock()
	original := writer.original
	writer.mu.Unlock()
	var unknown *model.UnknownCommandError
	if !errors.As(got.err, &unknown) || got.receipt != (mc.CommandReceipt{}) || original.State() != f.Unknown || unknown.AttemptID() != original.AttemptID() || unknown.Cause().Details().Primary.Canonical() != identity.Canonical() {
		t.Fatal("revoked confirmation lost original Unknown", got.err)
	}
	lookup, e := base.service.LookupCommand(testContext(t), model.LookupCommandRequest{Meta: request.CommandMeta, Command: "model.selection.update"})
	requireCode(t, e, f.SessionRevoked)
	if lookup.Found || lookup.Receipt != nil {
		t.Fatal("revoked lookup leaked receipt")
	}
	fresh := base.login(t, "admin@mail.com")
	if fresh.actor.Details().UserID != base.admin.Details().UserID || fresh.actor.Details().SessionID == base.admin.Details().SessionID {
		t.Fatal("formal login did not establish new Session of same User")
	}
	base.admin, base.adminBrowser = fresh.actor, fresh
	request.Actor = fresh.actor
	before := base.summaryFacts(t)
	accepted, e := base.service.UpdateMeetingSummarySelection(testContext(t), request)
	if e != nil || accepted.Version != request.ExpectedVersion+1 {
		t.Fatal("accepted write not replayed after restored authority", e)
	}
	httpSameFacts(t, before, base.summaryFacts(t))
	if current := base.summary(t); current.Model == nil || *current.Model != target {
		t.Fatal("real commit disappeared")
	}
	t.Log("actual COMMIT ACK lost; original Unknown survived current-Session denial; goroutine joined; new-Session replay had no effects")
}

