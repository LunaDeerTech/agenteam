func independentSummaryUpgrade(t *testing.T) {
	binary, want := os.Getenv("AGENTEAM_MEETING_SUMMARY_OLD_BINARY"), os.Getenv("AGENTEAM_MEETING_SUMMARY_OLD_SHA256")
	data, e := os.ReadFile(binary)
	if e != nil {
		t.Fatal("old binary missing")
	}
	sum := sha256.Sum256(data)
	clear(data)
	if !filepath.IsAbs(binary) || hex.EncodeToString(sum[:]) != want {
		t.Fatal("unbound old binary")
	}
	db := pgfixture.NewDatabase(t)
	dir := t.TempDir()
	if e = os.Chmod(dir, 0700); e != nil {
		t.Fatal(e)
	}
	path := filepath.Join(dir, "private.json")
	ctx, cancel := context.WithTimeout(context.Background(), 90*time.Second)
	defer cancel()
	cmd := exec.CommandContext(ctx, binary, "-test.run=^TestMeetingSummaryOldProducer$", "-test.timeout=85s", "-test.v")
	cmd.Dir = dir
	cmd.Env = append(os.Environ(), "AGENTEAM_MEETING_SUMMARY_OLD_DATABASE="+db.Name, "AGENTEAM_MEETING_SUMMARY_OLD_HANDOFF="+path)
	var out, errout bytes.Buffer
	cmd.Stdout = &out
	cmd.Stderr = &errout
	if e = cmd.Start(); e != nil {
		t.Fatal(e)
	}
	e = cmd.Wait()
	t.Logf("old producer actual exit=%d stdout_sha256=%x stderr_sha256=%x", cmd.ProcessState.ExitCode(), sha256.Sum256(out.Bytes()), sha256.Sum256(errout.Bytes()))
	if e != nil {
		t.Fatal("old binary failed", e)
	}
	stat, e := os.Stat(path)
	if e != nil || stat.Mode().Perm() != 0600 {
		t.Fatal("private handoff mode")
	}
	raw, e := os.ReadFile(path)
	if e != nil {
		t.Fatal(e)
	}
	var h meetingSummaryOldHandoff
	dec := json.NewDecoder(bytes.NewReader(raw))
	dec.DisallowUnknownFields()
	if e = dec.Decode(&h); e != nil {
		t.Fatal("handoff decode")
	}
	var tail any
	if dec.Decode(&tail) != io.EOF {
		t.Fatal("handoff trailing")
	}
	clear(raw)
	if e = os.Remove(path); e != nil {
		t.Fatal(e)
	}
	conn := db.Connect(t)
	var count, max int
	var absent bool
	if e = conn.QueryRow(testContext(t), `SELECT count(*),max(version),to_regclass('agenteam_model.meeting_summary_selection') IS NULL FROM agenteam_meta.migration_journal WHERE state='applied'`).Scan(&count, &max, &absent); e != nil || count != 19 || max != 19 || !absent {
		t.Fatal("not old schema1..19", e)
	}
	if len(h.History) != 3 || h.Selection.Scope != "system" || h.Provider.Scope != "system" || h.Model.Scope != "system" || h.Model.Replacement != nil || h.Provider.Replacement != nil {
		t.Fatal("handoff shape")
	}
	history := func() {
		t.Helper()
		for _, table := range []string{"agenteam_model.commands", "agenteam_audit.audit_records", "agenteam_outbox.events"} {
			old, ok := h.History[table]
			if !ok {
				t.Fatal("history table")
			}
			var rows map[string]json.RawMessage
			if json.Unmarshal(old, &rows) != nil || len(rows) == 0 {
				t.Fatal("history raw")
			}
			ids := make([]string, 0, len(rows))
			for key := range rows {
				if _, e = f.ParseID[struct{}](key); e != nil {
					t.Fatal("history ID")
				}
				ids = append(ids, key)
			}
			var now []byte
			if e = conn.QueryRow(testContext(t), `SELECT coalesce(jsonb_object_agg(id::text,to_jsonb(r)),'{}'::jsonb) FROM `+table+` r WHERE id::text=ANY($1)`, ids).Scan(&now); e != nil || !bytes.Equal(old, now) {
				t.Fatal("old original SQL bytes changed", table, e)
			}
			t.Logf("old rows table=%s count=%d sha256=%x", table, len(rows), sha256.Sum256(old))
		}
	}
	history()
	migrateModel(t, modelMigrator(t, db, modelMigrationFiles(t, "00020")), 20)
	history()
	store := openStore(t, db.Config(t, nil))
	v := assemble(t, db, store, store)
	user, e := f.ParseID[id.User](h.User)
	if e != nil {
		t.Fatal(e)
	}
	session, e := f.ParseID[id.Session](h.Session)
	if e != nil {
		t.Fatal(e)
	}
	actor, e := id.NewHuman(user, session)
	if e != nil {
		t.Fatal(e)
	}
	v.admin = actor
	meta := func(key string) mc.CommandMeta {
		return mc.CommandMeta{Actor: actor, Scope: id.SystemScope(), Key: f.IdempotencyKey(key)}
	}
	old := mc.UpdatePlatformSelectionRequest{CommandMeta: meta(h.Selection.Key), ExpectedVersion: h.Selection.ExpectedVersion, Selection: h.Selection.Selection}
	if old.Validate() != nil {
		t.Fatal("old request")
	}
	replay, e := v.service.UpdatePlatformSelection(testContext(t), old)
	if e != nil || replay != h.SelectionReceipt {
		t.Fatal("original selection changed", e)
	}
	for _, r := range []struct {
		kind    string
		d       meetingSummaryOldDelete
		receipt mc.CommandReceipt
	}{{"provider.delete", h.Provider, h.ProviderReceipt}, {"model.delete", h.Model, h.ModelReceipt}} {
		if r.receipt.Validate() != nil {
			t.Fatal("receipt")
		}
		got, e := v.service.LookupCommand(testContext(t), model.LookupCommandRequest{Meta: meta(r.d.Key), Command: r.kind})
		if e != nil || !got.Found || got.Receipt == nil || *got.Receipt != r.receipt {
			t.Fatal("original delete receipt lookup", e)
		}
	}
	if e = v.service.InitializeMeetingSummarySelection(testContext(t)); e != nil {
		t.Fatal(e)
	}
	current, e := v.service.GetMeetingSummarySelection(testContext(t), actor)
	if e != nil || current.Model != nil || current.Version != 1 {
		t.Fatal("upgrade invented summary default", e)
	}
	req := mc.UpdateMeetingSummarySelectionRequest{CommandMeta: old.CommandMeta, SelectionID: current.ID, ExpectedVersion: current.Version, Model: old.Selection.Memory}
	_, e = v.service.UpdateMeetingSummarySelection(testContext(t), req)
	requireCode(t, e, f.IdempotencyKeyReused)
	req.Key = "independent-new-summary"
	accepted, e := v.service.UpdateMeetingSummarySelection(testContext(t), req)
	if e != nil {
		t.Fatal(e)
	}
	collision := old
	collision.Key = req.Key
	_, e = v.service.UpdatePlatformSelection(testContext(t), collision)
	requireCode(t, e, f.IdempotencyKeyReused)
	lookup, e := v.service.LookupCommand(testContext(t), model.LookupCommandRequest{Meta: req.CommandMeta, Command: "model.selection.update"})
	if e != nil || !lookup.Found || lookup.Receipt == nil || *lookup.Receipt != accepted {
		t.Fatal("old generic lookup of summary", e)
	}
	replay, e = v.service.UpdatePlatformSelection(testContext(t), old)
	if e != nil || replay != h.SelectionReceipt {
		t.Fatal("summary altered historical selection", e)
	}
	history()
}

func independentSummaryHTTP(t *testing.T) {
	v := newMeetingSummaryFixture(t, true)
	target := v.chat(t, true)
	v.setMemory(t, target)
	v.selectModel(t, target)
	path := "/api/v1/system/models/" + target.String() + "/deletion-impact"
	r := v.request(t, v.adminBrowser, http.MethodGet, path, "", nil).want(t, 200)
	fields := r.object(t)
	if fields["reference_count"] != "2" || fields["replacement_requirement"] != "required" {
		t.Fatal("dual HTTP impact")
	}
	groups := fields["reference_groups"].([]any)
	if len(groups) != 2 {
		t.Fatal("dual groups")
	}
	roles := map[string]bool{}
	for _, g := range groups {
		m := g.(map[string]any)
		if m["owner_kind"] != "platform_selector" || m["count"] != "1" {
			t.Fatal("group")
		}
		roles[m["role"].(string)] = true
	}
	if !roles["meeting_summary"] || !roles["memory"] {
		t.Fatal("role pair")
	}
	if h := v.request(t, v.adminBrowser, http.MethodHead, path, "", nil).want(t, 200); len(h.body) != 0 {
		t.Fatal("HEAD body")
	}
	dir := os.Getenv("AGENTEAM_MEETING_SUMMARY_EVIDENCE_DIR")
	s, e := os.Stat(dir)
	if e != nil || !s.IsDir() || s.Mode().Perm()&0077 != 0 {
		t.Fatal("private evidence directory")
	}
	sum := sha256.Sum256(r.body)
	if e = os.WriteFile(filepath.Join(dir, "independent-summary-memory.json"), r.body, 0600); e != nil {
		t.Fatal(e)
	}
	metadata := map[string]any{"status": r.status, "content_type": r.headers.Get("Content-Type"), "model_id": target.String(), "path": path, "method": "GET", "body_sha256": hex.EncodeToString(sum[:]), "producer_test": "TestIndependentSummaryB/same_http_body_summary_and_memory", "source_run": filepath.Base(filepath.Dir(dir))}
	if e = os.WriteFile(filepath.Join(dir, "independent-summary-memory-source.json"), summaryJSON(t, metadata), 0600); e != nil {
		t.Fatal(e)
	}
	t.Logf("same raw HTTP body exported sha256=%x", sum)
}
