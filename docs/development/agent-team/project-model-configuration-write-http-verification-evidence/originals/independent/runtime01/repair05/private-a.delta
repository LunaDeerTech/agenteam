+
+// Formal Login may retain Account response references. Compare every Model
+// fact and complete Model-consumer reference row before rebasing all references.
+func independentConfigurationIdentityUnchanged(t *testing.T, before, after []byte) {
+	t.Helper()
+	var left, right map[string]json.RawMessage
+	if json.Unmarshal(before, &left) != nil || json.Unmarshal(after, &right) != nil || len(left) != 6 || len(right) != 6 {
+		t.Fatal("private identity snapshot shape")
+	}
+	for _, key := range []string{"providers", "models", "commands", "audits", "events"} {
+		if len(left[key]) == 0 || !bytes.Equal(left[key], right[key]) {
+			t.Fatal("Model bucket changed during formal identity setup:", key)
+		}
+	}
+	modelRefs := func(raw json.RawMessage) []json.RawMessage {
+		var rows []json.RawMessage
+		if json.Unmarshal(raw, &rows) != nil {
+			t.Fatal("private reference snapshot shape")
+		}
+		selected := []json.RawMessage{}
+		for _, row := range rows {
+			var owner struct {
+				Consumer string `json:"consumer"`
+			}
+			if json.Unmarshal(row, &owner) != nil || owner.Consumer == "" {
+				t.Fatal("private reference owner missing")
+			}
+			if owner.Consumer == "model" {
+				selected = append(selected, row)
+			}
+		}
+		return selected
+	}
+	beforeRefs, afterRefs := modelRefs(left["refs"]), modelRefs(right["refs"])
+	if len(beforeRefs) != len(afterRefs) {
+		t.Fatal("Model Secret reference count changed during formal identity setup")
+	}
+	for i := range beforeRefs {
+		if !bytes.Equal(beforeRefs[i], afterRefs[i]) {
+			t.Fatal("Model Secret reference row changed during formal identity setup")
+		}
+	}
+}
