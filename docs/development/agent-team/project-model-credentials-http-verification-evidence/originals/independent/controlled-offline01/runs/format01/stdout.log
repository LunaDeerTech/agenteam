package model

// Private overlay draft. It has not been formatted, compiled or run.
// It consumes production02 and its frozen credentialTestHandler/request seam.
// No listener, database, browser, subprocess or network client is created here.

import (
	"bytes"
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"log/slog"
	"net/http"
	"net/http/httptest"
	"strings"
	"sync"
	"sync/atomic"
	"testing"
	"time"

	f "github.com/LunaDeerTech/agenteam/internal/central/foundation"
	"github.com/LunaDeerTech/agenteam/internal/central/httpapi"
	id "github.com/LunaDeerTech/agenteam/internal/central/identity/contract"
	sc "github.com/LunaDeerTech/agenteam/internal/central/secret/contract"
)

type ivCRWriter struct {
	*httptest.ResponseRecorder
	reads, writes, flushes atomic.Int32
	readHook, writeHook    func(int32, time.Time) error
}

func ivCRNewWriter() *ivCRWriter {
	return &ivCRWriter{ResponseRecorder: httptest.NewRecorder()}
}
func (w *ivCRWriter) SetReadDeadline(at time.Time) error {
	n := w.reads.Add(1)
	if w.readHook != nil {
		return w.readHook(n, at)
	}
	return nil
}
func (w *ivCRWriter) SetWriteDeadline(at time.Time) error {
	n := w.writes.Add(1)
	if w.writeHook != nil {
		return w.writeHook(n, at)
	}
	return nil
}
func (w *ivCRWriter) FlushError() error {
	w.flushes.Add(1)
	w.ResponseRecorder.Flush()
	return nil
}

type ivCRBody struct {
	reader    io.Reader
	closes    atomic.Int32
	closeHook func() error
}

func (b *ivCRBody) Read(p []byte) (int, error) { return b.reader.Read(p) }
func (b *ivCRBody) Close() error {
	b.closes.Add(1)
	if b.closeHook != nil {
		return b.closeHook()
	}
	return nil
}

type ivCRReturn struct{ aborted, foreignPanic bool }

func ivCRServe(h http.Handler, w http.ResponseWriter, r *http.Request) (out ivCRReturn) {
	defer func() {
		if value := recover(); value != nil {
			out.aborted = value == http.ErrAbortHandler
			out.foreignPanic = !out.aborted
		}
	}()
	h.ServeHTTP(w, r)
	return
}
func ivCRRequest(method, path string, data []byte) (*http.Request, *ivCRBody) {
	r := httptest.NewRequest(method, "https://independent-credentials.example"+path, bytes.NewReader(data))
	r.Header.Set("Content-Type", "application/json")
	r.Header.Set("Idempotency-Key", "original-key")
	b := &ivCRBody{reader: r.Body}
	r.Body = b
	return r, b
}
func ivCRTracked(h http.Handler, logs *bytes.Buffer) http.Handler {
	return httpapi.Handler(slog.New(slog.NewJSONHandler(logs, nil)), h)
}
func ivCRCode(t *testing.T, w *ivCRWriter, status int, code f.Code) {
	t.Helper()
	var result struct {
		Code f.Code `json:"code"`
	}
	if w.Code != status || json.Unmarshal(w.Body.Bytes(), &result) != nil || result.Code != code {
		t.Fatal("unexpected safe status/code")
	}
}
func ivCRLogCode(t *testing.T, data []byte, want f.Code) {
	t.Helper()
	var event struct {
		Event string `json:"event"`
		Code  string `json:"code"`
	}
	if json.Unmarshal(bytes.TrimSpace(data), &event) != nil || event.Event != "http_request" || event.Code != string(want) {
		t.Fatal("tracked writer lost safe request code")
	}
}
func ivCRWait(t *testing.T, done <-chan struct{}, stage string) {
	t.Helper()
	select {
	case <-done:
	case <-time.After(2 * time.Second):
		t.Fatal("controlled phase did not complete: " + stage)
	}
}

func TestIndependentProjectCredentialHTTPControls(t *testing.T) {
	t.Run("worst_65536_bytes_exact_raw_cap", func(t *testing.T) {
		value := make([]byte, sc.MaxValueBytes)
		defer clear(value)
		raw, err := json.Marshal(struct {
			Value string `json:"value"`
		}{string(value)})
		if err != nil {
			t.Fatal("encode failed")
		}
		defer clear(raw)
		if bytes.Count(raw, []byte(`\u0000`)) != sc.MaxValueBytes || len(raw) >= credentialMaterialBodyBytes {
			t.Fatal("actual worst-case representation exceeds body contract")
		}
		encodedBytes := len(raw)
		for _, extra := range []int{0, 1} {
			h, _, service := credentialTestHandler(t)
			var held sc.SecretMaterial
			service.execute = func(_ context.Context, request sc.WriteRequest) (sc.MutationResult, error) {
				held = request.Value
				if request.Kind != sc.Create || request.Identity.Key() != "original-key" {
					t.Fatal("create identity altered")
				}
				if err := request.Value.Use(func(got []byte) error {
					if len(got) != len(value) || !bytes.Equal(got, value) || got[len(got)-1] != value[len(value)-1] {
						return errors.New("complete material mismatch")
					}
					return nil
				}); err != nil {
					t.Fatal("complete material not delivered")
				}
				return sc.MutationResult{Metadata: sc.Metadata{CredentialRef: credentialTestRef(), Purpose: sc.Model, Version: 1}}, nil
			}
			padded := make([]byte, credentialMaterialBodyBytes+extra)
			copy(padded, raw)
			for i := len(raw); i < len(padded); i++ {
				padded[i] = ' '
			}
			r, body := ivCRRequest("POST", credentialTestCollection, padded)
			w := ivCRNewWriter()
			var logs bytes.Buffer
			returned := ivCRServe(ivCRTracked(h, &logs), w, r)
			clear(padded)
			if returned.aborted || returned.foreignPanic || body.closes.Load() != 1 {
				t.Fatal("raw cap ownership")
			}
			if extra == 0 {
				if w.Code != 200 || service.writes.Load() != 1 || service.reads.Load() != 0 || service.lookups.Load() != 0 {
					t.Fatal("exact raw cap rejected or extra service calls")
				}
				if held.Use(func([]byte) error { return nil }) == nil {
					t.Fatal("material survived response")
				}
			} else {
				ivCRCode(t, w, 413, f.PayloadTooLarge)
				if service.writes.Load()+service.reads.Load()+service.lookups.Load() != 0 {
					t.Fatal("oversized body reached service")
				}
			}
			if bytes.Contains(w.Body.Bytes(), []byte(`\u0000`)) || bytes.Contains(logs.Bytes(), []byte(`\u0000`)) || bytes.Contains(logs.Bytes(), []byte("original-key")) {
				t.Fatal("material/key entered safe output")
			}
		}
		t.Logf("material_bytes=%d encoded_body_bytes=%d accepted_raw_cap=%d rejected_raw_bytes=%d", len(value), encodedBytes, credentialMaterialBodyBytes, credentialMaterialBodyBytes+1)
	})

	t.Run("strict_presence_and_null_with_tracked_code", func(t *testing.T) {
		for _, test := range []struct{ name, method, path, body string }{
			{"create_missing", "POST", credentialTestCollection, `{}`},
			{"create_null", "POST", credentialTestCollection, `{"value":null}`},
			{"update_expected_null", "PUT", credentialTestDetail, `{"expected_version":null,"value":"v"}`},
			{"update_value_missing", "PUT", credentialTestDetail, `{"expected_version":"1"}`},
			{"delete_number", "DELETE", credentialTestDetail, `{"expected_version":1}`},
			{"lookup_create_null_ref", "POST", credentialTestLookup, `{"kind":"create","credential_id":null}`},
			{"lookup_update_missing_version", "POST", credentialTestLookup, `{"kind":"update","credential_id":"` + credentialTestID + `"}`},
			{"case_alias", "POST", credentialTestCollection, `{"Value":"v"}`},
		} {
			t.Run(test.name, func(t *testing.T) {
				h, _, service := credentialTestHandler(t)
				r, body := ivCRRequest(test.method, test.path, []byte(test.body))
				w := ivCRNewWriter()
				var logs bytes.Buffer
				returned := ivCRServe(ivCRTracked(h, &logs), w, r)
				if returned.aborted || returned.foreignPanic || body.closes.Load() != 1 {
					t.Fatal("strict input ownership")
				}
				ivCRCode(t, w, 400, f.InvalidArgument)
				ivCRLogCode(t, logs.Bytes(), f.InvalidArgument)
				if service.writes.Load()+service.reads.Load()+service.lookups.Load() != 0 {
					t.Fatal("strict input reached service")
				}
			})
		}
	})

	t.Run("delete_damaged_metadata_cannot_be_hidden_by_late_receipt", func(t *testing.T) {
		h, _, service := credentialTestHandler(t)
		service.lookup = func(_ context.Context, request sc.WriteCommandLookupRequest) (sc.WriteCommandObservation, error) {
			if service.lookups.Load() == 1 {
				return sc.WriteCommandObservation{}, nil
			}
			result := sc.MutationResult{Metadata: sc.Metadata{CredentialRef: request.Ref, Purpose: sc.Model, Version: request.ExpectedVersion + 1}, Deleted: true}
			return sc.WriteCommandObservation{Observed: true, Result: &result}, nil
		}
		service.metadata = func(context.Context, id.Actor, sc.CredentialRef) (sc.Metadata, error) {
			foreign, _ := sc.NewCredentialRef(credentialTestRef().Details().ID, id.SystemScope())
			return sc.Metadata{CredentialRef: foreign, Purpose: sc.Model, Version: 1}, nil
		}
		r, body := ivCRRequest("DELETE", credentialTestDetail, []byte(`{"expected_version":"1"}`))
		w := ivCRNewWriter()
		var logs bytes.Buffer
		returned := ivCRServe(ivCRTracked(h, &logs), w, r)
		if returned.aborted || returned.foreignPanic || body.closes.Load() != 1 {
			t.Fatal("metadata rejection ownership")
		}
		ivCRCode(t, w, 503, f.DependencyUnavailable)
		ivCRLogCode(t, logs.Bytes(), f.DependencyUnavailable)
		if service.lookups.Load() != 1 || service.reads.Load() != 1 || service.writes.Load() != 0 || bytes.Contains(w.Body.Bytes(), []byte("credential_id")) {
			t.Fatal("damaged metadata admitted candidate")
		}
	})

	t.Run("observed_still_executes_original_material_once_and_destroys", func(t *testing.T) {
		for _, mode := range []string{"unknown", "panic"} {
			t.Run(mode, func(t *testing.T) {
				h, _, service := credentialTestHandler(t)
				value := bytes.Repeat([]byte{'q'}, sc.MaxValueBytes)
				defer clear(value)
				const marker = "independent-material-tail-sentinel"
				copy(value[len(value)-len(marker):], marker)
				raw, err := json.Marshal(struct {
					Expected string `json:"expected_version"`
					Value    string `json:"value"`
				}{"1", string(value)})
				if err != nil {
					t.Fatal("encode failed")
				}
				defer clear(raw)
				var held sc.SecretMaterial
				service.lookup = func(_ context.Context, request sc.WriteCommandLookupRequest) (sc.WriteCommandObservation, error) {
					result := sc.MutationResult{Metadata: sc.Metadata{CredentialRef: request.Ref, Purpose: sc.Model, Version: 2}}
					return sc.WriteCommandObservation{Observed: true, Result: &result}, nil
				}
				service.execute = func(_ context.Context, request sc.WriteRequest) (sc.MutationResult, error) {
					held = request.Value
					if request.Kind != sc.Update || request.ExpectedVersion != 1 || request.Identity.Key() != "original-key" || !request.Ref.Equal(credentialTestRef()) {
						return sc.MutationResult{}, errors.New("original request changed")
					}
					if err := request.Value.Use(func(got []byte) error {
						if !bytes.Equal(got, value) {
							return errors.New("full material changed")
						}
						return nil
					}); err != nil {
						t.Error("full material not delivered")
					}
					for _, format := range []string{"%v", "%+v", "%#v"} {
						if strings.Contains(fmt.Sprintf(format, request), marker) {
							t.Error("format leaked material")
						}
						if fmt.Sprintf(format, request.Value) != "secret_material" {
							t.Error("material format is not a safe marker")
						}
					}
					encoded, e := json.Marshal(request)
					if e != nil || bytes.Contains(encoded, []byte(marker)) {
						t.Error("safe JSON leaked material")
					}
					encodedMaterial, e := json.Marshal(request.Value)
					if e != nil || string(encodedMaterial) != `"secret_material"` {
						t.Error("material JSON is not a safe marker")
					}
					if mode == "panic" {
						panic(marker)
					}
					return sc.MutationResult{}, f.NewFault(f.CommitUnknown, f.Unknown).WithCause(errors.New(marker))
				}
				r, body := ivCRRequest("PUT", credentialTestDetail, raw)
				w := ivCRNewWriter()
				var logs bytes.Buffer
				returned := ivCRServe(ivCRTracked(h, &logs), w, r)
				if returned.foreignPanic || returned.aborted != (mode == "panic") || body.closes.Load() != 1 {
					t.Fatal("material error/panic ownership")
				}
				if service.lookups.Load() != 1 || service.reads.Load() != 0 || service.writes.Load() != 1 {
					t.Fatal("observation bypassed write or caused implicit retry")
				}
				if held.Use(func([]byte) error { return nil }) == nil {
					t.Fatal("material survived error/panic")
				}
				if mode == "unknown" {
					ivCRCode(t, w, 503, f.CommitUnknown)
					ivCRLogCode(t, logs.Bytes(), f.CommitUnknown)
				}
				if bytes.Contains(w.Body.Bytes(), []byte(marker)) || bytes.Contains(logs.Bytes(), []byte(marker)) || bytes.Contains(logs.Bytes(), []byte("original-key")) {
					t.Fatal("material/key escaped into output or log")
				}
			})
		}
	})

	t.Run("callback_read_setter_panic_and_close_panic_still_join", func(t *testing.T) {
		h, _, service := credentialTestHandler(t)
		ctx, cancel := context.WithCancel(context.Background())
		entered, release, closeAttempted, done := make(chan struct{}), make(chan struct{}), make(chan struct{}), make(chan struct{})
		var releaseOnce sync.Once
		var returned ivCRReturn
		w := ivCRNewWriter()
		w.readHook = func(n int32, _ time.Time) error {
			if n == 2 {
				close(entered)
				<-release
				panic("private setter diagnostic")
			}
			return nil
		}
		service.metadata = func(context.Context, id.Actor, sc.CredentialRef) (sc.Metadata, error) {
			cancel()
			select {
			case <-entered:
			case <-time.After(time.Second):
			}
			return sc.Metadata{}, context.Canceled
		}
		r, body := ivCRRequest("GET", credentialTestDetail, nil)
		r = r.WithContext(ctx)
		body.closeHook = func() error { close(closeAttempted); panic("private Close diagnostic") }
		var logs bytes.Buffer
		t.Cleanup(func() {
			releaseOnce.Do(func() { close(release) })
			cancel()
			select {
			case <-done:
			case <-time.After(2 * time.Second):
				t.Error("controlled handler failed actual join")
			}
		})
		go func() { defer close(done); returned = ivCRServe(ivCRTracked(h, &logs), w, r) }()
		ivCRWait(t, entered, "cancel callback entered")
		ivCRWait(t, closeAttempted, "owned Close attempted")
		select {
		case <-done:
			t.Fatal("handler returned while callback was blocked")
		case <-time.After(20 * time.Millisecond):
		}
		releaseOnce.Do(func() { close(release) })
		ivCRWait(t, done, "handler returned after callback")
		if !returned.aborted || returned.foreignPanic || body.closes.Load() != 1 || w.writes.Load() < 3 || w.Body.Len() != 0 || w.flushes.Load() != 0 {
			t.Fatal("callback panic skipped other setter/Close/join or published response")
		}
		if bytes.Contains(logs.Bytes(), []byte("private")) {
			t.Fatal("panic diagnostic leaked")
		}
	})

	t.Run("start_read_panic_still_owns_body_and_other_setter", func(t *testing.T) {
		h, boundary, service := credentialTestHandler(t)
		w := ivCRNewWriter()
		w.readHook = func(int32, time.Time) error { panic("private setter diagnostic") }
		r, body := ivCRRequest("GET", credentialTestDetail, nil)
		var logs bytes.Buffer
		returned := ivCRServe(ivCRTracked(h, &logs), w, r)
		if !returned.aborted || returned.foreignPanic || body.closes.Load() != 1 || w.writes.Load() < 2 || boundary.auths.Load() != 0 || service.reads.Load()+service.writes.Load()+service.lookups.Load() != 0 || w.Body.Len() != 0 {
			t.Fatal("start panic skipped independent setter or owned Close")
		}
	})

	t.Run("committed_response_cannot_gain_problem_suffix", func(t *testing.T) {
		h, boundary, service := credentialTestHandler(t)
		boundary.check = func(w http.ResponseWriter, _ *http.Request) error {
			w.WriteHeader(http.StatusAccepted)
			return f.NewFault(f.InvalidArgument, f.NotStarted)
		}
		w := ivCRNewWriter()
		r, body := ivCRRequest("GET", credentialTestDetail, nil)
		var logs bytes.Buffer
		returned := ivCRServe(ivCRTracked(h, &logs), w, r)
		if !returned.aborted || returned.foreignPanic || w.Code != http.StatusAccepted || w.Body.Len() != 0 || body.closes.Load() != 1 || service.reads.Load()+service.writes.Load()+service.lookups.Load() != 0 {
			t.Fatal("opaque writer lost committed state")
		}
	})

	t.Run("reset_write_panic_aborts_after_completed_response", func(t *testing.T) {
		h, _, _ := credentialTestHandler(t)
		w := ivCRNewWriter()
		var readResets atomic.Int32
		w.readHook = func(_ int32, at time.Time) error {
			if at.IsZero() {
				readResets.Add(1)
			}
			return nil
		}
		w.writeHook = func(_ int32, at time.Time) error {
			if at.IsZero() {
				panic("private reset diagnostic")
			}
			return nil
		}
		r, body := ivCRRequest("GET", credentialTestDetail, nil)
		var logs bytes.Buffer
		returned := ivCRServe(ivCRTracked(h, &logs), w, r)
		if !returned.aborted || returned.foreignPanic || body.closes.Load() != 1 || readResets.Load() != 1 || w.flushes.Load() != 1 || w.Code != 200 {
			t.Fatal("reset failure falsely returned reusable connection")
		}
		if bytes.Contains(logs.Bytes(), []byte("private reset")) {
			t.Fatal("reset panic diagnostic leaked")
		}
	})
}
