for p in before:
 dest=out/'source'/p;dest.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(w/p,dest)
(out/'input-before.json').write_text(json.dumps(before,sort_keys=True,indent=2)+'\n')
env=os.environ.copy();env.update({'GOTOOLCHAIN':'local','GOENV':'off','GOWORK':'off','GOPROXY':'off','GOSUMDB':'off','GOMODCACHE':'/workspace/scratch/agenteam-d27-directory-author-EvHmqxns/modcache','GOCACHE':str(s/'gocache'),'TMPDIR':str(s/'compile-tmp'),'GOFLAGS':'-mod=readonly -buildvcs=false -p=1','CGO_ENABLED':'1'})
(s/'compile-tmp').mkdir(exist_ok=True)
record={'argv':cmd,'cwd':str(w/relative),'env':{k:env[k] for k in ['PATH','GOTOOLCHAIN','GOENV','GOWORK','GOPROXY','GOSUMDB','GOMODCACHE','GOCACHE','TMPDIR','GOFLAGS','CGO_ENABLED']},'started_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'real_resource_execution':False}
(out/'command.json').write_text(json.dumps(record,sort_keys=True,indent=2)+'\n')
start=time.monotonic()
with (out/'raw.log').open('w') as log:
 child=subprocess.Popen(cmd,cwd=w/relative,env=env,stdout=log,stderr=subprocess.STDOUT);code=child.wait()
