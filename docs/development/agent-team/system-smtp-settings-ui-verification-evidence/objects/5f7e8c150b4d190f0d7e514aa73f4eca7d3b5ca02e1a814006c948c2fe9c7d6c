 for p,h in web['files'].items():assert sha(w/p)==h,('web frozen',p)
 for p,h in web['dist'].items():assert sha(w/p)==h,('dist frozen',p)
 for p,row in go['files'].items():
  if p not in allowed:assert sha(w/p)==row['sha256'],('fixed Go baseline',p)
 return {p:sha(w/p) for p in allowed if (w/p).is_file()}
