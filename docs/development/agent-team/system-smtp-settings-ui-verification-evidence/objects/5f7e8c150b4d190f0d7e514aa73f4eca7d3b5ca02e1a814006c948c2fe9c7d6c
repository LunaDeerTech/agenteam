result={'exit_code':code,'actual_wait':True,'duration_seconds':round(time.monotonic()-start,3),'child_pid':child.pid,'input_unchanged':before==after,'raw_sha256':sha(out/'raw.log'),'command_sha256':sha(out/'command.json'),'ended_utc':datetime.datetime.now(datetime.timezone.utc).isoformat()}
(out/'result.json').write_text(json.dumps(result,sort_keys=True,indent=2)+'\n');print(json.dumps(result));sys.exit(code)
