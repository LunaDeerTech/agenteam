	return map[string]any{"version": version, "host": "mail.example.com", "port": 587, "encryption": "starttls", "username": "", "sender_email": "sender@example.com", "sender_name": label, "credential_action": "keep", "auto_retry_count": "3", "retry_interval_seconds": "60"}
}
func (f *smtpSettingsWebFixture) awaitPreparedDeliveries(ctx context.Context) {
	bounded, cancel := context.WithTimeout(ctx, 15*time.Second)
	defer cancel()
	tick := time.NewTicker(20 * time.Millisecond)
	defer tick.Stop()
	for {
		conn, closeConnection := invitationsWebConnect(f.t, bounded, f.db)
		var ready, pending int
		err := conn.QueryRow(bounded, `SELECT
   (SELECT count(*) FROM agenteam_account.invitations i JOIN agenteam_account.delivery_intents d ON d.link_id=i.id AND d.kind='invitation' JOIN agenteam_account.commands c ON c.id=d.id AND c.phase='committed' JOIN agenteam_account.mail_jobs j ON j.id=d.job_id JOIN agenteam_account.mail_attempts a ON a.id=j.current_attempt_id WHERE i.created_by=$1 AND i.email IN ($2,$3) AND j.phase='sent' AND a.channel='log' AND a.result='sent' AND a.terminal AND a.io_joined),
   (SELECT count(*) FROM agenteam_account.mail_jobs WHERE phase IN ('pending','processing')),
   (SELECT count(*) FROM agenteam_account.delivery_intents),
   (SELECT count(*) FROM agenteam_account.mail_jobs)`, f.admin.UserID, f.member.Email, f.second.Email).Scan(&ready, &pending, &f.baselineIntents, &f.baselineJobs)
		closeConnection()
		if err != nil {
			f.t.Fatal("owned prepared delivery terminal query failed", err)
		}
		if ready == 2 && pending == 0 && f.baselineIntents == f.baselineJobs {
			return
		}
		select {
		case <-bounded.Done():
			f.t.Fatal("owned prepared deliveries did not actually join before configuration")
		case <-tick.C:
		}
	}
}
func (f *smtpSettingsWebFixture) shouldFailRead(path string) bool {
	return path == "/api/v1/system/smtp" && f.failRead.CompareAndSwap(true, false)
}
func (f *smtpSettingsWebFixture) controlResponse(response *http.Response) error {
	r := response.Request
	if r == nil || response.StatusCode != 200 || !(r.Method == "PUT" && r.URL.Path == "/api/v1/system/smtp" || r.Method == "POST" && r.URL.Path == "/api/v1/system/smtp/unconfigure") {
		return nil
	}
	f.mu.Lock()
	defer f.mu.Unlock()
	key := r.Header.Get("Idempotency-Key")
	var attempt smtpSettingsWebAttempt
	for n := len(f.attempts) - 1; n >= 0; n-- {
		if f.attempts[n].key == key {
			attempt = f.attempts[n]
			break
		}
	}
	if f.lostKey != "" && key == f.lostKey {
		f.replayed++
		f.sameOriginal = f.sameOriginal && attempt.body == f.lostBody && attempt.csrf == f.lostCSRF && attempt.method == f.lostMethod && attempt.path == f.lostPath
	}
	if !f.dropNext {
		return nil
	}
	f.dropNext = false
	raw, err := io.ReadAll(io.LimitReader(response.Body, 600001))
	closeErr := response.Body.Close()
	defer clear(raw)
	var result map[string]any
	if err != nil || closeErr != nil || len(raw) > 600000 || len(raw) < 2 || json.Unmarshal(raw, &result) != nil || len(result) != 2 {
		return errors.New("owned response cut requires complete formal SMTP result")
	}
	settings, ok := result["settings"].(map[string]any)
	if !ok || len(settings) != 12 || settings["id"] != f.singletonID || result["applied_version"] == nil {
		return errors.New("owned response cut requires strict SMTP result")
	}
	f.lostKey, f.lostBody, f.lostCSRF, f.lostMethod, f.lostPath, f.lostResult = key, attempt.body, attempt.csrf, attempt.method, attempt.path, result
	f.dropped++
	return &modelsResponseLost{header: response.Header.Clone(), prefix: append([]byte(nil), raw[:len(raw)/2]...), length: len(raw)}
}
func (f *smtpSettingsWebFixture) smtpFacts(ctx context.Context) map[string]any {
	conn, closeConnection := invitationsWebConnect(f.t, ctx, f.db)
	defer closeConnection()
	var version, host, encryption, username, email, name, retries, interval, ref string
	var configured bool
	var port int
	if err := conn.QueryRow(ctx, `SELECT version::text,configured,coalesce(host,''),coalesce(port,0),coalesce(tls_mode,''),coalesce(auth_username,''),coalesce(from_address,''),sender_name,auto_retry_count::text,retry_interval_seconds::text,coalesce(password_ref::text,'') FROM agenteam_account.smtp_settings WHERE singleton AND id=$1`, f.singletonID).Scan(&version, &configured, &host, &port, &encryption, &username, &email, &name, &retries, &interval, &ref); err != nil {
		f.t.Fatal("owned SMTP snapshot unavailable", err)
	}
	f.mu.Lock()
	key := f.lostKey
	f.mu.Unlock()
	identityDigest := ""
	if key != "" {
		identity, err := foundation.NewCommandIdentity("account.smtp", []string{f.admin.UserID}, "smtp-settings-update", foundation.IdempotencyKey(key))
		if err != nil {
			f.t.Fatal("owned SMTP command identity invalid")
		}
		digest := sha256.Sum256([]byte(identity.Canonical()))
		identityDigest = "sha256:" + hex.EncodeToString(digest[:])
	}
	var commands, audits, originalCommands, originalAudits, intents, jobs, referenceCount int
	if err := conn.QueryRow(ctx, `SELECT
 (SELECT count(*) FROM agenteam_account.commands WHERE namespace='account.smtp' AND command_name='smtp-settings-update' AND resource_id=$1 AND owner_id IN ($2,$3) AND phase='committed'),
 (SELECT count(*) FROM agenteam_audit.audit_records WHERE scope='system' AND producer='account' AND action='smtp.settings.update' AND resource_kind='smtp_settings' AND resource_id=$1 AND user_id IN ($2,$3) AND outcome='success' AND ordinal=0),
 (SELECT count(*) FROM agenteam_account.commands WHERE namespace='account.smtp' AND command_name='smtp-settings-update' AND resource_id=$1 AND owner_id=$2 AND identity_digest=$4 AND phase='committed'),
 (SELECT count(*) FROM agenteam_audit.audit_records WHERE scope='system' AND producer='account' AND action='smtp.settings.update' AND resource_kind='smtp_settings' AND resource_id=$1 AND user_id=$2 AND outcome='success' AND ordinal=0 AND cause_ref IN (SELECT id::text FROM agenteam_account.commands WHERE namespace='account.smtp' AND command_name='smtp-settings-update' AND resource_id=$1 AND owner_id=$2 AND identity_digest=$4 AND phase='committed')),
 (SELECT count(*) FROM agenteam_account.delivery_intents),(SELECT count(*) FROM agenteam_account.mail_jobs),
 (SELECT count(*) FROM agenteam_secret.secret_references WHERE owner_id=$1 AND consumer='smtp' AND scope='system')`, f.singletonID, f.admin.UserID, f.second.UserID, identityDigest).Scan(&commands, &audits, &originalCommands, &originalAudits, &intents, &jobs, &referenceCount); err != nil {
		f.t.Fatal("owned SMTP command reference and audit facts unavailable", err)
	}
	currentValid, oldCleanup := ref == "", true
	if ref != "" {
		if err := conn.QueryRow(ctx, `SELECT EXISTS(SELECT 1 FROM agenteam_secret.secret_references r JOIN agenteam_secret.secrets s ON s.id=r.credential_id WHERE r.credential_id=$1 AND r.owner_id=$2 AND r.consumer='smtp' AND r.scope='system' AND s.purpose='smtp')`, ref, f.singletonID).Scan(&currentValid); err != nil {
			f.t.Fatal("owned SMTP current reference fact unavailable", err)
		}
	}
	if f.previousReference != "" && f.previousReference != ref {
		if err := conn.QueryRow(ctx, `SELECT EXISTS(SELECT 1 FROM agenteam_account.material_cleanup WHERE owner_kind='smtp_settings' AND owner_id=$1 AND credential_id=$2 AND purpose='smtp')`, f.singletonID, f.previousReference).Scan(&oldCleanup); err != nil {
			f.t.Fatal("owned SMTP cleanup registration unavailable", err)
		}
	}
	same := f.previousReference == ref
	f.previousReference = ref
	return map[string]any{"settings": map[string]any{"id": f.singletonID, "version": version, "configured": configured, "host": host, "port": port, "encryption": encryption, "username": username, "sender_email": email, "sender_name": name, "credential_present": ref != "", "auto_retry_count": retries, "retry_interval_seconds": interval}, "commands": commands, "audits": audits, "original_commands": originalCommands, "original_audits": originalAudits, "reference_count": referenceCount, "current_reference_valid": currentValid, "same_reference": same, "previous_cleanup_registered": oldCleanup, "delivery_unchanged": intents == f.baselineIntents && jobs == f.baselineJobs, "forbidden_calls": f.forbiddenCalls.Load()}
}

type smtpSettingsWebIPC struct {
	Sequence  int    `json:"sequence"`
	Action    string `json:"action"`
	UserID    string `json:"user_id"`
	SessionID string `json:"session_id"`
}

func (f *smtpSettingsWebFixture) smtpIPC(ctx context.Context, r smtpSettingsWebIPC) map[string]any {
	out := map[string]any{"ok": true, "sequence": r.Sequence}
	switch r.Action {
	case "facts":
		out["facts"] = f.smtpFacts(ctx)
	case "compete-configure", "compete-disable":
		observed := f.setup.setupRequest(ctx, f.secondClient, "GET", "/api/v1/system/smtp", nil, "", false, 200)
		if r.Action == "compete-disable" {
			body := map[string]any{"version": observed["version"], "auto_retry_count": observed["auto_retry_count"], "retry_interval_seconds": observed["retry_interval_seconds"]}
			out["result"] = f.setup.setupRequest(ctx, f.secondClient, "POST", "/api/v1/system/smtp/unconfigure", body, f.secondCSRF, true, 200)
		} else {
			body := f.configuration(observed["version"], "second administrator")
			body["username"] = "second-auth"
			body["password"] = f.passwords[1]
			out["result"] = f.setup.setupRequest(ctx, f.secondClient, "PUT", "/api/v1/system/smtp", body, f.secondCSRF, true, 200)
		}
	case "arm-drop":
		f.mu.Lock()
		f.dropNext = true
		f.lostKey = ""
		f.lostResult = nil
		f.dropped = 0
		f.replayed = 0
		f.sameOriginal = true
		f.mu.Unlock()
		out["armed"] = true
	case "drop-facts":
		f.mu.Lock()
		out["dropped"], out["replayed"], out["same_original"], out["result"], out["armed"] = f.dropped, f.replayed, f.sameOriginal, f.lostResult, f.dropNext
		f.mu.Unlock()
	case "arm-get-fail":
		f.failRead.Store(true)
		out["armed"] = true
	case "arm-session-fail":
		f.failSession.Store(true)
		out["armed"] = true
	case "failure-facts":
		out["read_failures"], out["session_failures"] = f.readFailures.Load(), f.sessionFailures.Load()
	case "attempt-facts":
		f.mu.Lock()
		keys := map[string]bool{}
		for _, attempt := range f.attempts {
			keys[attempt.key] = true
		}
		out["attempts"], out["distinct_keys"] = len(f.attempts), len(keys)
		f.mu.Unlock()
	case "demote", "promote", "revoke-session":
		if f.mode != "authority" || r.UserID != f.admin.UserID {
			f.t.Fatal("exact SMTP settings authority target rejected")
		}
		if _, err := foundation.ParseID[struct{}](r.SessionID); err != nil {
			f.t.Fatal("exact SMTP settings Session invalid")
		}
		conn, closeConnection := invitationsWebConnect(f.t, ctx, f.db)
		defer closeConnection()
		var exists bool
		if err := conn.QueryRow(ctx, `SELECT EXISTS(SELECT 1 FROM agenteam_account.sessions WHERE id=$1 AND user_id=$2 AND revoked_at IS NULL)`, r.SessionID, r.UserID).Scan(&exists); err != nil || !exists {
			f.t.Fatal("exact active SMTP settings Session absent", err)
		}
		if r.Action == "revoke-session" {
			tag, err := conn.Exec(ctx, `UPDATE agenteam_account.sessions SET revoked_at=clock_timestamp(),revoked_reason='administrative' WHERE id=$1 AND user_id=$2 AND revoked_at IS NULL`, r.SessionID, r.UserID)
			if err != nil || tag.RowsAffected() != 1 {
				f.t.Fatal("exact Session revoke failed", err)
			}
		} else {
			role, previous := "user", "admin"
			if r.Action == "promote" {
				role, previous = "admin", "user"
			}
			tag, err := conn.Exec(ctx, `UPDATE agenteam_account.users SET role=$1,version=version+1,updated_at=clock_timestamp() WHERE id=$2 AND role=$3`, role, r.UserID, previous)
			if err != nil || tag.RowsAffected() != 1 {
				f.t.Fatal("exact owned role transition failed", err)
			}
		}
	default:
		f.t.Fatal("unknown SMTP settings IPC action")
	}
	return out
}

func (f *smtpSettingsWebFixture) browserSMTPSettings(ctx context.Context) map[string]any {
	f.t.Helper()
	root, e := filepath.Abs("../account-captcha-web")
	if e != nil {
		f.t.Fatal(e)
	}
	cmd := exec.CommandContext(ctx, "node", filepath.Join(root, "node_modules/@playwright/test/cli.js"), "test", "--config", filepath.Join(root, "system-smtp-settings.config.js"))
	cmd.Dir = root
	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
	cmd.Cancel = func() error { return syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL) }
	cmd.WaitDelay = time.Second
	for _, value := range os.Environ() {
		if !strings.HasPrefix(value, "TMPDIR=") && !strings.HasPrefix(value, "AGENTEAM_AUTH_WEB_") && !strings.HasPrefix(value, "AGENTEAM_SMTP_SETTINGS_WEB_") && !strings.HasPrefix(value, "PLAYWRIGHT_NO_COPY_PROMPT=") && !strings.HasPrefix(value, "DEBUG=") && !strings.HasPrefix(value, "PWDEBUG=") {
			cmd.Env = append(cmd.Env, value)
		}
	}
	cmd.Env = append(cmd.Env, "TMPDIR="+f.directory, "AGENTEAM_AUTH_WEB_ORIGIN="+f.origin, "AGENTEAM_SMTP_SETTINGS_WEB_CASE="+f.mode, "AGENTEAM_AUTH_WEB_PRIVATE="+f.directory, "AGENTEAM_AUTH_WEB_CHROMIUM=/usr/bin/chromium", "PLAYWRIGHT_NO_COPY_PROMPT=1")
	if images := os.Getenv("AGENTEAM_AUTH_WEB_IMAGES"); images != "" {
		if !filepath.IsAbs(images) {
			f.t.Fatal("SMTP settings image path must be absolute")
		}
		cmd.Env = append(cmd.Env, "AGENTEAM_AUTH_WEB_IMAGES="+images)
	}
	var output bytes.Buffer
	cmd.Stdout, cmd.Stderr = &output, &output
	if e = cmd.Start(); e != nil {
		f.t.Fatal("locked SMTP settings browser runner could not start")
	}
	done := make(chan error, 1)
	go func() { done <- cmd.Wait() }()
	joined := false
	defer func() {
		if !joined {
			_ = cmd.Cancel()
			<-done
		}
		_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
		cmd.Env = nil
	}()
	tick := time.NewTicker(20 * time.Millisecond)
	defer tick.Stop()
	sequence := 0
	var runErr error
wait:
	for {
		select {
		case runErr = <-done:
			joined = true
			break wait
		case <-tick.C:
			raw, err := os.ReadFile(filepath.Join(f.directory, "smtp-settings-ipc.json"))
			if errors.Is(err, os.ErrNotExist) {
				continue
			}
			var request smtpSettingsWebIPC
			decode := json.Unmarshal(raw, &request)
			clear(raw)
			if err != nil || decode != nil || request.Sequence < 1 || request.Sequence > 128 {
				f.t.Error("private SMTP settings IPC rejected")
				_ = cmd.Cancel()
				continue
			}
			if request.Sequence <= sequence {
				continue
			}
			if request.Sequence != sequence+1 {
				f.t.Error("private SMTP settings IPC sequence invalid")
				_ = cmd.Cancel()
				continue
			}
			reply := f.smtpIPC(ctx, request)
			sequence = request.Sequence
			f.private("smtp-settings-ack-"+strconv.Itoa(sequence)+".json", reply)
		}
	}
	safe := output.String()
	for _, secret := range f.secrets {
		if secret != "" {
			safe = strings.ReplaceAll(safe, secret, "[redacted]")
		}
	}
	f.mu.Lock()
	if f.lostKey != "" {
		safe = strings.ReplaceAll(safe, f.lostKey, "[redacted]")
	}
	for _, attempt := range f.attempts {
		if attempt.key != "" {
			safe = strings.ReplaceAll(safe, attempt.key, "[redacted]")
		}
	}
	f.mu.Unlock()
	f.t.Log(safe)
	if runErr != nil {
		f.t.Fatalf("actual SMTP settings production browser failed: %v", runErr)
	}
	raw, e := os.ReadFile(filepath.Join(f.directory, "smtp-settings-result.json"))
	if e != nil {
		f.t.Fatal("safe SMTP settings browser result missing")
	}
	defer clear(raw)
	var result map[string]any
	if json.Unmarshal(raw, &result) != nil || result["completed"] != true {
		f.t.Fatal("safe SMTP settings browser result invalid")
	}
	return result
}
