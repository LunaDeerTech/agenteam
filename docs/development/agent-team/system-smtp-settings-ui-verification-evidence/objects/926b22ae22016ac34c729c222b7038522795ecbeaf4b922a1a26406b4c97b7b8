import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
import { flushPromises, mount, type VueWrapper } from '@vue/test-utils'
import { createMemoryHistory, createRouter, isNavigationFailure } from 'vue-router'
import type { SessionController } from '../composables/useSession'
const injection = vi.hoisted(() => ({ auth: null as SessionController | null }))
vi.mock('../composables/useSession', async (original) => ({
  ...(await original<typeof import('../composables/useSession')>()),
  useSession: () => injection.auth!,
}))
import { createSessionController } from '../composables/useSession'
import { createAccountAPI } from '../api/account'
import { createSystemAccountAPI } from '../api/system-account'
import { createSystemInvitationAPI } from '../api/system-invitations'
import { createSystemProviderAPI } from '../api/system-providers'
import { createSystemModelAPI } from '../api/system-models'
import { createSystemModelSelectionAPI } from '../api/system-model-selection'
import { createSystemAccountSecurityAPI } from '../api/system-account-security'
import { createSystemSMTPSettingsAPI } from '../api/system-smtp-settings'
import type { Fetch } from '../api/client'
import { installAuthentication } from '../router/auth'
import { useTheme } from '../composables/useTheme'
import App from '../App.vue'
import HomeView from '../views/HomeView.vue'
import LoginView from '../views/auth/LoginView.vue'
import SystemSettingsView from '../views/system/SystemSettingsView.vue'
import SystemSMTPSettingsView from '../views/system/SystemSMTPSettingsView.vue'

const id = (n: number) => '01900000-0000-7000-8000-' + n.toString(16).padStart(12, '0')
const instant = '2026-10-06T12:00:00.000001Z'
const identity = (sessionID = 2) => ({
  user: { id: id(1), email: 'admin@example.test', username: 'admin', display_name: 'Admin', role: 'admin', theme: 'system', version: '1', initial_password_suggestion: false },
  session: { id: id(sessionID), issued_at: instant, idle_expires_at: instant, absolute_expires_at: instant },
  csrf_token: 'S'.repeat(43),
})
const settings = (version = '10', configured = true) => ({
  id: id(10), version, configured,
  host: configured ? 'mail.example.test' : '', port: configured ? 587 : 0,
  encryption: configured ? 'starttls' : '', username: '',
  sender_email: configured ? 'sender@example.test' : '', sender_name: '', credential_present: false,
  auto_retry_count: '3', retry_interval_seconds: '60',
})
const json = (value: unknown, status = 200) => new Response(JSON.stringify(value), { status, headers: { 'Content-Type': status >= 400 ? 'application/problem+json' : 'application/json', 'X-Request-ID': id(9) } })
const problem = () => json({ type: 'urn:agenteam:problem:independent', title: 'Failure', status: 503, code: 'UNAVAILABLE', detail: 'safe', instance: '/api/v1/system/smtp', request_id: id(9), commit_state: 'not_started' }, 503)
function deferred<T>() { let resolve!: (v: T) => void; const promise = new Promise<T>(r => { resolve = r }); return { promise, resolve } }
let wrapper: VueWrapper | undefined
const release: (() => void)[] = []
beforeEach(() => {
  vi.stubGlobal('matchMedia', vi.fn((media: string) => ({ media, matches: false, addEventListener: vi.fn(), removeEventListener: vi.fn() })))
  // Explicit jsdom layout premise: these tests prove DOM/state, never native layout/Tab.
  vi.spyOn(HTMLElement.prototype, 'getClientRects').mockImplementation(() => [new DOMRect(0, 0, 80, 24)] as unknown as DOMRectList)
})
afterEach(async () => {
  for (const done of release.splice(0)) done()
  wrapper?.unmount(); wrapper = undefined
  injection.auth?.leave(); injection.auth = null
  await flushPromises()
  document.body.innerHTML = ''
  useTheme().setTheme('system')
  vi.unstubAllGlobals(); vi.restoreAllMocks()
})
async function boot() {
  let session = identity(), sessionRead: Fetch = async () => json(session)
  let read: Fetch = async () => json(settings())
  let write: Fetch = async () => { throw new Error('Unarmed independent mutation') }
  const transport = vi.fn<Fetch>(async (path, request) => {
    if (path === '/api/v1/session') return sessionRead(path, request)
    if (path === '/api/v1/system/smtp' || path === '/api/v1/system/smtp/unconfigure') return request.method === 'GET' ? read(path, request) : write(path, request)
    throw new Error('Unexpected independent request endpoint')
  })
  const auth = createSessionController(createAccountAPI(transport), createSystemAccountAPI(transport), createSystemInvitationAPI(transport), createSystemProviderAPI(transport), createSystemModelAPI(transport), createSystemModelSelectionAPI(transport), createSystemAccountSecurityAPI(transport), createSystemSMTPSettingsAPI(transport))
  injection.auth = auth
  const router = createRouter({ history: createMemoryHistory(), routes: [
    { path: '/', component: HomeView, meta: { authentication: true, protected: true } },
    { path: '/login', component: LoginView, meta: { authentication: true } },
    { path: '/system', component: SystemSettingsView, meta: { authentication: true, protected: true, systemAdmin: true }, children: [
      { path: 'smtp', component: SystemSMTPSettingsView },
      ...['users', 'invitations', 'providers', 'models', 'model-selection', 'account-security'].map(path => ({ path, component: { template: '<h1>Unexercised accepted leaf</h1>' } })),
    ] },
  ] })
  installAuthentication(router, auth)
  await router.push('/system/smtp'); await router.isReady()
  const host = document.createElement('div'); host.id = 'app'; document.body.append(host)
  wrapper = mount(App, { attachTo: host, global: { plugins: [router] } })
  await flushPromises()
  expect(field('SMTP 主机').value).toBe('mail.example.test')
  return { auth, router, transport, setRead(v: Fetch) { read = v }, setWrite(v: Fetch) { write = v }, setSessionRead(v: Fetch) { sessionRead = v }, restoreSession(n = 2) { session = identity(n); sessionRead = async () => json(session) }, writes() { return transport.mock.calls.filter(([p, r]) => p.startsWith('/api/v1/system/smtp') && r.method !== 'GET') } }
}
function name(node: Element) {
  const explicit = node.getAttribute('aria-label'); if (explicit) return explicit
  const copy = node.cloneNode(true) as Element
  copy.querySelectorAll('[aria-hidden="true"]').forEach(n => n.remove())
  return copy.textContent?.trim() ?? ''
}
function button(label: string, root: ParentNode = document) {
  const found = [...root.querySelectorAll<HTMLButtonElement>('button')].filter(n => name(n) === label)
  expect(found.length, `exact button ${label}`).toBe(1)
  return found[0]!
}
function field(label: string) {
  const found = [...document.querySelectorAll<HTMLLabelElement>('label')].find(n => n.textContent?.replace(/\s*\*$/, '').trim() === label)
  expect(!!found, `exact field ${label}`).toBe(true)
  return document.getElementById(found!.htmlFor) as HTMLInputElement
}
async function click(label: string, root: ParentNode = document) { const b = button(label, root); expect(b.disabled).toBe(false); b.click(); await flushPromises() }
async function edit(label: string, value: string) { const f = field(label); expect(f.disabled).toBe(false); f.value = value; f.dispatchEvent(new Event('input', { bubbles: true })); await flushPromises() }
async function submit(label = '保存 SMTP 配置') { const b = button(label); expect(b.disabled).toBe(false); b.form!.dispatchEvent(new SubmitEvent('submit', { bubbles: true, cancelable: true, submitter: b })); await flushPromises() }
function layers(count: number) {
  const all = [...document.querySelectorAll<HTMLElement>('[role="dialog"]')]
  expect(all.length).toBe(count)
  if (count) { expect(all.at(-1)!.inert).toBe(false); expect(all.at(-1)!.getAttribute('aria-hidden')).toBeNull() }
  for (const lower of all.slice(0, -1)) { expect(lower.inert).toBe(true); expect(lower.getAttribute('aria-hidden')).toBe('true') }
  return all
}
function exactHeading(label: string) { return [...document.querySelectorAll('h1,h2,h3')].filter(n => name(n) === label).length }

describe('independent SMTP fixed App consumer combinations', () => {
  it('retires private material through actual public discard and requires explicit successful read before a new editor', async () => {
    const f = await boot(), material = ' independent private input '
    await edit('认证用户名', 'smtp-user'); await edit('新密码（仅写入）', material)
    expect(f.auth.system.smtp.material.present).toBe(true)
    expect(document.body.innerHTML.includes(material)).toBe(false)
    expect(JSON.stringify(f.auth.system.smtp).includes(material)).toBe(false)
    f.setWrite(async () => problem())
    await submit()
    expect(f.writes().length).toBe(1)
    expect(f.auth.system.smtp.progress?.phase).toBe('uncertain')
    expect(field('新密码（仅写入）').value === '').toBe(true)
    expect(f.auth.system.smtp.material.present).toBe(true)
    expect(exactHeading('请求结果未确认')).toBe(1)
    await click('放弃本次操作')
    const confirm = layers(1)[0]!
    expect(name(confirm.querySelector('h2')!) === '放弃本次操作的追踪？').toBe(true)
    const count = f.transport.mock.calls.length
    await click('放弃修改', confirm)
    layers(0)
    expect(f.auth.system.smtp.material.present).toBe(false)
    expect(f.auth.system.smtp.progress).toBeNull()
    expect(document.querySelector('form[aria-label="修改 SMTP 配置"]')).toBeNull()
    expect(f.transport.mock.calls.length).toBe(count)
    await flushPromises()
    expect(f.transport.mock.calls.length).toBe(count)
    f.setRead(async () => problem())
    await click('读取当前配置')
    expect(exactHeading('SMTP 配置读取失败')).toBe(1)
    expect(document.querySelector('form[aria-label="修改 SMTP 配置"]')).toBeNull()
    expect(f.transport.mock.calls.length).toBe(count + 1)
    f.setRead(async () => json(settings('12', false)))
    await click('读取当前配置')
    expect(button('保存重试策略').disabled).toBe(true)
    expect(document.querySelector('input[type="password"]')).toBeNull()
    expect(f.transport.mock.calls.length).toBe(count + 2)
    expect(f.writes().length).toBe(1)
    await click('配置 SMTP')
    expect(field('SMTP 主机').value).toBe('')
    expect(field('新密码（仅写入）').value).toBe('')
    expect(f.auth.system.smtp.material.present).toBe(false)
    expect(button('保存 SMTP 配置').disabled).toBe(true)
    expect(f.writes().length).toBe(1)
    expect(localStorage.length + sessionStorage.length).toBe(0)
  })

  it('keeps both decisions pending through real App checking, separates unconfigure feedback, and rejects old decisions after identity change', async () => {
    const f = await boot()
    await edit('自动重试次数', '0')
    await click('停用并清除配置')
    await click('放弃修改', layers(1)[0]!)
    expect(layers(1)[0]!.textContent?.includes('保留自动重试 3 次')).toBe(true)
    const pending = f.router.push('/system/users'); await flushPromises()
    layers(2)
    const oldHeading = document.querySelector('h1')!
    const held = deferred<Response>(); release.push(() => held.resolve(problem()))
    f.setSessionRead(() => held.promise)
    const before = f.transport.mock.calls.length
    window.dispatchEvent(new Event('pageshow')); await flushPromises()
    expect(document.querySelector('.session-check') !== null).toBe(true)
    expect(document.querySelectorAll('.ui-overlay').length).toBe(0)
    expect(oldHeading.isConnected).toBe(false)
    expect(f.transport.mock.calls.slice(before).map(([p]) => p)).toEqual(['/api/v1/session'])
    held.resolve(problem()); await flushPromises()
    expect(exactHeading('会话尚未确认')).toBe(1)
    layers(0)
    expect(button('检查当前会话').disabled).toBe(false)
    expect(f.writes().length).toBe(0)
    f.restoreSession()
    const recovery = f.transport.mock.calls.length
    await click('检查当前会话')
    expect(f.transport.mock.calls.slice(recovery).filter(([p]) => p === '/api/v1/session').length).toBe(1)
    expect(f.auth.personalContext.identity?.sessionID).toBe(id(2))
    const restored = layers(2)
    expect(restored[1]!.contains(document.activeElement)).toBe(true)
    await click('继续编辑', restored[1]!)
    expect(isNavigationFailure(await pending)).toBe(true)
    const lower = layers(1)[0]!
    expect(lower.contains(document.activeElement)).toBe(true)
    f.setWrite(async () => json({ applied_version: '11', settings: settings('14', false) }))
    await click('确认停用并清除', lower)
    layers(0)
    expect(f.writes().length).toBe(1)
    const [path, request] = f.writes()[0]!
    expect(path).toBe('/api/v1/system/smtp/unconfigure')
    expect(JSON.parse(String(request.body))).toEqual({ version: '10', auto_retry_count: '3', retry_interval_seconds: '60' })
    expect(document.querySelector('[aria-label="本次原操作的历史确认"]')?.textContent?.includes('11')).toBe(true)
    expect(document.querySelector('[aria-label="当前读取的 SMTP 配置"]')?.textContent?.includes('14')).toBe(true)
    expect(button('保存重试策略').getAttribute('aria-label')).toBeNull()
    expect(button('保存重试策略').disabled).toBe(true)
    await edit('自动重试次数', '1')
    expect(button('保存重试策略').disabled).toBe(false)
    expect(button('保存重试策略').getAttribute('aria-label')).toBeNull()
    expect(f.writes().length).toBe(1)
    // No 2400ms advancement: a new edit must not inherit prior operation success.
    await click('取消修改'); await click('放弃修改', layers(1)[0]!)
    f.setRead(async () => problem())
    await click('读取当前配置')
    expect(exactHeading('原操作已确认，当前配置读取失败')).toBe(1)
    expect(f.writes().length).toBe(1)
    f.setRead(async () => json(settings('15', true)))
    await click('读取当前配置')
    await click('停用并清除配置')
    const invalidated = f.router.push('/system/users'); await flushPromises(); layers(2)
    f.restoreSession(3)
    window.dispatchEvent(new Event('pageshow')); await flushPromises()
    expect(isNavigationFailure(await invalidated)).toBe(true)
    layers(0)
    expect(f.auth.personalContext.identity?.sessionID).toBe(id(3))
    expect(f.router.currentRoute.value.path).toBe('/system/smtp')
    expect(f.writes().length).toBe(1)
    expect(f.auth.system.smtp.material.present).toBe(false)
  })
})
