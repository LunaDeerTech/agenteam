 candidates=json.loads(DELIVERY.read_text())['files']
 assert len(candidates)==28 and all(sha(REPO/n)==h for n,h in candidates.items())
 raw=read(['git','ls-tree','-r','-z',BASE]);tree={}
 for row in raw.split(b'\0'):
  if row:
   info,n=row.split(b'\t',1);mode,kind,oid=info.decode().split();tree[n.decode()]={'mode':mode,'kind':kind,'git_blob':oid}
 goenv=json.loads(read([GO,'env','-json','GOVERSION','GOROOT','GOOS','GOARCH','CC','CXX','CGO_CFLAGS','CGO_CPPFLAGS','CGO_CXXFLAGS','CGO_LDFLAGS']))
