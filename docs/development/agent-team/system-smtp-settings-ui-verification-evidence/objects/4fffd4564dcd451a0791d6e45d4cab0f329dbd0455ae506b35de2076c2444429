  text=read(argv).decode();offset=0
  profile_records.append({'name':name,'argv':argv})
  while offset<len(text):
   while offset<len(text) and text[offset].isspace():offset+=1
   if offset==len(text):break
   p,offset=decoder.raw_decode(text,offset)
   assert not p.get('Error') and not p.get('DepsErrors'),p.get('ImportPath')
   packages.add(p['ImportPath']);module=p.get('Module',{})
   if module and not module.get('Main'):
    assert not module.get('Replace')
    modules[module['Path']]={k:module.get(k) for k in ['Version','Dir','GoMod','Sum','GoModSum']}
    external.add(Path(module['GoMod']))
   directory=Path(p.get('Dir',str(REPO)))
   for field in FIELDS:
    for n in p.get(field,[]):
     path=(directory/n).resolve()
     if path.is_relative_to(REPO):local.add(str(path.relative_to(REPO)))
     elif path.is_relative_to(GOCACHE) or path.is_relative_to(ROOT/'tmp'):
      assert p['ImportPath'].endswith('.test');generated.add(p['ImportPath'])
     else:
      assert path.is_relative_to(goroot) or path.is_relative_to(MODCACHE),str(path)
      external.add(path)
 for tool in ['compile','link','asm','cgo','vet']:external.add(goroot/'pkg/tool/linux_amd64'/tool)
