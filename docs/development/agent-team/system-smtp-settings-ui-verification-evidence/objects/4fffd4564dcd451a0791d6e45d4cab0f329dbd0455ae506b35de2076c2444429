  p=REPO/n;assert p.is_file() and not p.is_symlink()
  data=p.read_bytes();h=hashlib.sha256(data).hexdigest();local_hashes[n]=h
  if n in candidates:assert h==candidates[n]
  else:
   assert n in tree and tree[n]['kind']=='blob' and tree[n]['mode']!='120000',n
