async function visitIndependent(page: Page, harness: Harness, query: string) {
  await page.goto(harness.origin + '/?' + query)
  await expect(page.locator('meta[name="harness-nonce"]')).toHaveAttribute('content', harness.nonce)
}
async function closed(page: Page) {
  await expect(page.locator('.ui-overlay')).toHaveCount(0)
  await expect(page.locator('#app')).toHaveJSProperty('inert', false)
  await expect(page.locator('body')).toHaveCSS('overflow', 'auto')
}
async function remountIndependent(page: Page) {
  await page.getByTestId('open').click()
  await expect(page.getByTestId('captured')).toHaveText('true')
  await expect(page.getByTestId('inside')).toBeFocused()
  const oldTrigger = await page.getByTestId('open').elementHandle()
  await page.getByTestId('remount').click()
  await expect(page.getByTestId('generation')).toHaveText('1:true')
  expect(await oldTrigger!.evaluate(node => node.isConnected)).toBe(false)
  await expect(page.getByTestId('inside')).toBeFocused()
  await expect(page.getByTestId('focuses')).toHaveText('0:0')
  return oldTrigger!
}

test('independent latest ref after whole-page remount keeps the old candidate connected', async ({ page, harness }) => {
  await page.setViewportSize({ width: 390, height: 900 })
  await page.emulateMedia({ reducedMotion: 'reduce' })
  await visitIndependent(page, harness, 'mode=remount')
  const oldTrigger = await remountIndependent(page)
  const previousCandidate = await page.getByTestId('first').elementHandle()
  await page.getByTestId('latest').click()
  expect(await previousCandidate!.evaluate(node => node.isConnected)).toBe(true)
  await page.getByTestId('close').click()
  await closed(page)
  await expect(page.getByTestId('second')).toBeFocused()
  await expect(page.getByTestId('focuses')).toHaveText('0:1')
  expect(await oldTrigger.evaluate(node => node.isConnected)).toBe(false)
  await page.keyboard.press('Tab')
  await expect(page.getByTestId('open')).toBeFocused()
  await page.getByTestId('after').click()
  await expect(page.getByTestId('after')).toBeFocused()
  await previousCandidate!.dispose()
  await oldTrigger.dispose()
})

test('independent actual focus success controls fallback and unmount stays separate', async ({ page, harness }, testInfo) => {
  await page.setViewportSize({ width: 1440, height: 900 })
  await visitIndependent(page, harness, 'mode=focus')
  const native = await page.getByTestId('native-proof').evaluate(node => {
    const target = node as HTMLElement
    const before = document.activeElement
    target.focus({ preventScroll: true })
    return { inheritedEditable: target.isContentEditable, explicitTabindex: target.hasAttribute('tabindex'), selfActive: document.activeElement === target, priorUnchanged: document.activeElement === before }
  })
  await testInfo.attach('native-focus-prerequisite', { body: Buffer.from(JSON.stringify(native)), contentType: 'application/json' })
  expect(native).toEqual({ inheritedEditable: true, explicitTabindex: false, selfActive: false, priorUnchanged: true })
  await page.getByTestId('open').click()
  await expect(page.getByTestId('captured')).toHaveText('true')
  await expect(page.getByTestId('inside')).toBeFocused()
  await page.getByTestId('noop').click()
  expect(await page.getByTestId('open').evaluate(node => ({ editable: (node as HTMLElement).isContentEditable, tabindex: node.getAttribute('tabindex'), connected: node.isConnected }))).toEqual({ editable: true, tabindex: null, connected: true })
  await page.getByTestId('close').click()
  await closed(page)
  await expect(page.getByTestId('first')).toBeFocused()
  await expect(page.getByTestId('focuses')).toHaveText('1:0')

  await visitIndependent(page, harness, 'mode=focus')
  await page.getByTestId('open').click()
  await expect(page.getByTestId('captured')).toHaveText('true')
  await expect(page.getByTestId('inside')).toBeFocused()
  await page.keyboard.press('Escape')
  await closed(page)
  await expect(page.getByTestId('open')).toBeFocused()
  await expect(page.getByTestId('focuses')).toHaveText('0:0')

  await visitIndependent(page, harness, 'mode=remount')
  const oldTrigger = await remountIndependent(page)
  await page.getByTestId('destroy').click()
  await closed(page)
  await expect(page.getByTestId('focuses')).toHaveText('0:0')
  await expect(page.getByTestId('first')).not.toBeFocused()
  await expect(page.getByTestId('second')).not.toBeFocused()
  await page.getByTestId('after').click()
  await expect(page.getByTestId('after')).toBeFocused()
  await oldTrigger.dispose()
})

test('independent remaining modal wins over page fallback and null target stays compatible', async ({ page, harness }) => {
  await page.setViewportSize({ width: 1440, height: 900 })
  await visitIndependent(page, harness, 'mode=layers')
  await page.getByTestId('lower-open').click()
  await expect(page.getByTestId('lower-input')).toBeFocused()
  await page.getByTestId('upper-open').click()
  await expect(page.getByTestId('upper-input')).toBeFocused()
  await page.getByTestId('disable-lower-trigger').click()
  await page.keyboard.press('Escape')
  const lower = page.getByRole('dialog', { name: 'Independent lower', exact: true })
  await expect(page.locator('.ui-overlay')).toHaveCount(1)
  await expect(lower.getByRole('button', { name: '关闭', exact: true })).toBeFocused()
  await expect(page.getByTestId('focuses')).toHaveText('0:0')
  await page.keyboard.press('Tab')
  expect(await lower.evaluate(node => node.contains(document.activeElement))).toBe(true)
  await page.keyboard.press('Escape')
  await closed(page)
  await expect(page.getByTestId('lower-open')).toBeFocused()

  await visitIndependent(page, harness, 'mode=remount&fallback=none')
  await page.getByTestId('open').click()
  await expect(page.getByTestId('inside')).toBeFocused()
  await page.getByTestId('close').click()
  await closed(page)
  await expect(page.getByTestId('open')).toBeFocused()
  await expect(page.getByTestId('focuses')).toHaveText('0:0')
})
