import ctypes
import hashlib
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time

root = Path(__file__).resolve().parent
name = 'browser01'
author = Path('/workspace/scratch/agenteam-dialog-fallback-author-1c9kb4lh')
run = root / 'runs' / name
run.mkdir(parents=True, exist_ok=False)
if ctypes.CDLL(None, use_errno=True).prctl(36, 1, 0, 0, 0) != 0:
    raise OSError(ctypes.get_errno(), 'PR_SET_CHILD_SUBREAPER')
tmp = Path(tempfile.mkdtemp(prefix='dfbi-', dir='/tmp'))
cwd = root / 'browser01'
cli = author / 'candidate/tests/account-captcha-web/node_modules/@playwright/test/cli.js'
node = Path('/opt/codex/runtimes/codex-primary-runtime/dependencies/node/bin/node')
env = dict(os.environ, CI='1', NO_COLOR='1', TMPDIR=str(tmp),
           AGENTEAM_DIALOG_WEB_ROOT=str(root / 'browser-web01/web'),
           AGENTEAM_DIALOG_RUN_DIR=str(run),
           AGENTEAM_DIALOG_CHROMIUM='/usr/lib/chromium/chromium')
argv = [str(node), str(cli), 'test', '--config', str(cwd / 'playwright.config.mjs'), '--max-failures=1']
budget = 180

def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def inputs():
    frozen = author / 'input01/manifest.json'
    assert sha(frozen) == '604a4738761e428b0bff3f8ea64319ae07f6e8e072b97dead925c309c09f6860'
    manifest = json.loads(frozen.read_text())
    runtime_path = author / 'runtime-dependencies.json'
    assert sha(runtime_path) == manifest['runtime_dependencies']['sha256']
    runtime = json.loads(runtime_path.read_text())
    for path, expected in runtime['files'].items():
        assert sha(author / 'candidate' / path) == expected, path
    for path, expected in runtime['symlinks'].items():
        assert os.readlink(author / 'candidate' / path) == expected, path
    result = {'author_manifest': sha(frozen), 'runtime_manifest': sha(runtime_path), 'runtime_verified_files': len(runtime['files']), 'runtime_verified_symlinks': len(runtime['symlinks'])}
    for path, expected in manifest['files'].items():
        value = sha(author / 'input01/source' / path)
        assert value == expected, path
        result[str(author / 'input01/source' / path)] = value
    for path, expected in manifest['browser_closure'].items():
        actual = root / 'browser-web01' / path
        value = sha(actual)
        assert value == expected, path
        result[str(actual)] = value
    for path in list(cwd.glob('*')) + [Path(__file__), node, cli, Path(env['AGENTEAM_DIALOG_CHROMIUM']), root / 'browser-web01/web/package.json', root / 'browser-web01/web/package-lock.json']:
        if path.is_file():
            result[str(path)] = sha(path)
    return result

before = inputs()
(run / 'input-before.json').write_text(json.dumps(before, sort_keys=True, indent=2) + '\n')
for absolute in before:
    path = Path(absolute)
    if not path.is_absolute():
        continue
    if path.is_relative_to(root) and 'node_modules' not in path.parts:
        target = run / 'source' / path.relative_to(root)
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(path, target)

def processes():
    result = {}
    for directory in Path('/proc').iterdir():
        if not directory.name.isdigit():
            continue
        try:
            stat = (directory / 'stat').read_text().rsplit(')', 1)[1].split()
            result[int(directory.name)] = {
                'pid': int(directory.name), 'ppid': int(stat[1]), 'state': stat[0],
                'session': int(stat[3]), 'starttime': int(stat[19]),
                'comm': (directory / 'comm').read_text().strip(),
                'command': (directory / 'cmdline').read_bytes().replace(b'\0', b' ').decode(errors='replace'),
            }
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            pass
    return result

def safe(row):
    return {key: value for key, value in row.items() if key != 'command'}

def ports():
    return subprocess.run(['ss', '-lntp'], check=True, capture_output=True, text=True).stdout

baseline = processes()
baseline_ports = ports()
historical = [safe(row) for row in baseline.values()
              if row['comm'] in ('chromium', 'chrome_crashpad', 'esbuild')]
(run / 'baseline-resources.json').write_text(json.dumps({
    'ports': baseline_ports, 'browser_processes_not_owned': historical,
}, indent=2) + '\n')
command = {'argv': argv, 'cwd': str(cwd), 'outer_budget_seconds': budget,
           'playwright_realpath': str(cli.resolve()), 'node_realpath': str(node.resolve()),
           'subreaper_enabled_before_launch': True,
           'env': {key: env[key] for key in ('CI', 'NO_COLOR', 'TMPDIR',
                   'AGENTEAM_DIALOG_WEB_ROOT', 'AGENTEAM_DIALOG_RUN_DIR', 'AGENTEAM_DIALOG_CHROMIUM')}}
(run / 'command.json').write_text(json.dumps(command, indent=2) + '\n')
tracked = {}
adopted = []
signals = []
timed_out = False
started = time.monotonic()
with (run / 'raw.log').open('wb') as raw:
    process = subprocess.Popen(argv, cwd=cwd, env=env, stdout=raw,
                               stderr=subprocess.STDOUT, start_new_session=True)
    (run / 'pid.json').write_text(json.dumps({'driver': os.getpid(), 'child': process.pid}) + '\n')

    def observe():
        current = processes()
        owned = {process.pid, os.getpid()} | set(tracked)
        for _ in range(16):
            added = {pid for pid, row in current.items()
                     if row['ppid'] in owned or row['session'] == process.pid or str(tmp) in row['command']}
            if added <= owned:
                break
            owned |= added
        for pid in owned:
            if pid in current and (pid not in baseline or current[pid]['starttime'] != baseline[pid]['starttime']):
                tracked[pid] = current[pid]
        return current

    while process.poll() is None:
        observe()
        if time.monotonic() - started > budget:
            timed_out = True
            os.killpg(process.pid, signal.SIGTERM)
            break
        time.sleep(.06)
    try:
        code = process.wait(timeout=10)
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGKILL)
        code = process.wait(timeout=10)
    observe()

def remaining():
    return [safe(row) for pid, row in observe().items()
            if (pid in tracked and row['starttime'] == tracked[pid]['starttime']) or str(tmp) in row['command']]

def reap():
    while True:
        try:
            pid, status = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            return
        if not pid:
            return
        adopted.append({'pid': pid, 'status': status, 'tracked_starttime': tracked.get(pid, {}).get('starttime')})

for index in range(160):
    observe()
    reap()
    live = remaining()
    if not live:
        break
    if index in (60, 120):
        sig = signal.SIGTERM if index == 60 else signal.SIGKILL
        for row in live:
            if row['state'] != 'Z':
                try:
                    os.kill(row['pid'], sig)
                    signals.append({'pid': row['pid'], 'starttime': row['starttime'], 'signal': int(sig)})
                except ProcessLookupError:
                    pass
    time.sleep(.05)
first = remaining()
time.sleep(.25)
reap()
second = remaining()
contents = [str(path.relative_to(tmp)) for path in tmp.rglob('*')]
if not first and not second:
    shutil.rmtree(tmp)
after = inputs()
(run / 'input-after.json').write_text(json.dumps(after, sort_keys=True, indent=2) + '\n')
servers = [json.loads(path.read_text()) for path in run.glob('server-*.json')]
ports_after = ports()
cleanup = {'actual_wait_completed': True, 'subreaper_enabled_before_launch': True,
           'adopted_waits': adopted, 'owned_processes': [safe(row) for row in tracked.values()],
           'remaining_first': first, 'remaining_second': second, 'cleanup_signals': signals,
           'tmpdir': str(tmp), 'tmp_contents_before_cleanup': contents, 'tmp_absent': not tmp.exists(),
           'servers': servers, 'server_all_closed': bool(servers) and all(server['closed'] for server in servers),
           'ports_unchanged': ports_after == baseline_ports, 'ports_after': ports_after,
           'historical_baseline_not_owned': historical}
clean = not first and not second and not tmp.exists() and cleanup['server_all_closed'] and cleanup['ports_unchanged']
result = {'exit': code, 'actual_wait_completed': True, 'timed_out': timed_out,
          'elapsed_seconds': round(time.monotonic() - started, 3), 'inputs_unchanged': before == after,
          'clean': clean, 'raw_sha256': sha(run / 'raw.log')}
(run / 'cleanup.json').write_text(json.dumps(cleanup, indent=2) + '\n')
(run / 'result.json').write_text(json.dumps(result, indent=2) + '\n')
print(json.dumps(result, indent=2), flush=True)
sys.exit(code if code else int(not clean or before != after))
