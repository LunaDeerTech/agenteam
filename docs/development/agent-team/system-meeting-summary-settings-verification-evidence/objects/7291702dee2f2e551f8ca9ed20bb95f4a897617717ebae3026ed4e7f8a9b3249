#!/usr/bin/env python3
"""Read-only static runtime inventory. Does not execute Node/Chromium/Go.

This is an input inventory, not a claim that DT_NEEDED covers every dlopen.
The apikeys conffile is read only for the parent-authorized package digest check;
its bytes are never decoded, copied, or emitted.
"""
import hashlib
import json
import os
from pathlib import Path
import struct

HERE = Path(__file__).resolve().parent
REPO = Path('/workspace/agenteam')
NODE = Path('/opt/codex/runtimes/codex-primary-runtime/dependencies/node/bin/node')
PUBLIC_TREES = ['/usr/lib/chromium', '/usr/share/fonts', '/etc/fonts', '/usr/share/fontconfig', '/usr/share/chromium/extensions']
EXCLUDE = {'/etc/chromium.d/apikeys'}


def sha(p):
    h = hashlib.sha256()
    with Path(p).open('rb') as f:
        for block in iter(lambda: f.read(1 << 20), b''):
            h.update(block)
    return h.hexdigest()


def elf(p):
    # ELF64 LE program headers; never run the binary or its loader.
    with Path(p).open('rb') as f:
        header = f.read(64)
        if header[:4] != b'\x7fELF':
            return None
        if header[4:6] != b'\x02\x01':
            raise RuntimeError('unsupported static ELF type: ' + str(p))
        phoff = struct.unpack_from('<Q', header, 32)[0]
        phsize, phnum = struct.unpack_from('<HH', header, 54)
        segments, interpreter = [], None
        for i in range(phnum):
            f.seek(phoff + i * phsize)
            values = struct.unpack('<IIQQQQQQ', f.read(56))
            kind, _, offset, address, _, size, _, _ = values
            segments.append((kind, offset, address, size))
            if kind == 3:
                f.seek(offset)
                interpreter = f.read(size).rstrip(b'\0').decode()
        dynamic = []
        for kind, offset, _, size in segments:
            if kind == 2:
                f.seek(offset)
                data = f.read(size)
                for start in range(0, len(data), 16):
                    tag, value = struct.unpack_from('<qQ', data, start)
                    if tag == 0:
                        break
                    dynamic.append((tag, value))
        table = next((value for tag, value in dynamic if tag == 5), None)
        table_size = next((value for tag, value in dynamic if tag == 10), None)
        strings = b''
        if table is not None:
            segment = next((s for s in segments if s[0] == 1 and s[2] <= table < s[2] + s[3]), None)
            if segment is None or table_size is None:
                raise RuntimeError('invalid string table: ' + str(p))
            f.seek(segment[1] + table - segment[2])
            strings = f.read(table_size)
        def string(index):
            return strings[index:strings.index(b'\0', index)].decode()
        return {
            'needed': [string(value) for tag, value in dynamic if tag == 1],
            'rpath': [string(value) for tag, value in dynamic if tag in (15, 29)],
            'interpreter': interpreter,
        }


def main():
    files, links, trees = {}, {}, {}
    def add(p):
        p = Path(p)
        if str(p) in EXCLUDE:
            return
        if p.is_symlink():
            links[str(p)] = os.readlink(p)
        if p.is_file():
            files[str(p)] = sha(p)
    for directory in PUBLIC_TREES:
        root = Path(directory)
        entries = sorted(root.rglob('*')) if root.exists() else []
        trees[directory] = [str(p.relative_to(root)) for p in entries if p.is_file() or p.is_symlink()]
        for p in entries:
            add(p)
    for p in Path('/etc/chromium.d').iterdir():
        add(p)
    trees['/etc/chromium.d'] = sorted(p.name for p in Path('/etc/chromium.d').iterdir())
    for path in ['/usr/bin/chromium', '/bin/sh', '/usr/bin/uname', '/usr/bin/grep', '/usr/bin/expr', '/usr/bin/ls', '/usr/bin/tr', '/usr/bin/cut', '/usr/bin/findmnt', '/usr/bin/find', '/usr/bin/rm', '/usr/bin/env', '/etc/ld.so.cache', '/etc/nsswitch.conf']:
        add(path)
    add(NODE)
    seeds = [str(NODE)] + [p for p in files if p.startswith('/usr/lib/chromium/') and not '/locales/' in p]
    seeds += [p for p in files if p.startswith('/usr/bin/') or p == '/bin/sh']
    graph, unresolved, queue = {}, [], seeds.copy()
    while queue:
        name = queue.pop()
        canonical = str(Path(name).resolve())
        if canonical in graph:
            continue
        info = elf(canonical)
        if info is None:
            continue
        add(canonical)
        resolved = {}
        search = [str(Path(canonical).parent)]
        for rpath in info['rpath']:
            search.extend(part.replace('${ORIGIN}', str(Path(canonical).parent)).replace('$ORIGIN', str(Path(canonical).parent)) for part in rpath.split(':'))
        search += ['/lib/x86_64-linux-gnu', '/usr/lib/x86_64-linux-gnu', '/lib', '/usr/lib']
        for needed in info['needed']:
            found = next((Path(directory) / needed for directory in search if (Path(directory) / needed).is_file()), None)
            if found is None:
                unresolved.append({'object': canonical, 'needed': needed})
                continue
            add(found)
            resolved[needed] = str(found.resolve())
            queue.append(str(found))
        if info['interpreter']:
            add(info['interpreter'])
            queue.append(info['interpreter'])
        graph[canonical] = {**info, 'resolved': resolved}
    recovery = Path('/workspace/scratch/summary-browser-dependency-recovery/archive-verification.json')
    recovered = json.loads(recovery.read_text())
    nm = REPO / 'tests/account-captcha-web/node_modules'
    node_files_match = all(sha(nm / path) == row['sha256'] for path, row in recovered['files'].items())
    actual_node_files = sorted(str(p.relative_to(nm)) for p in nm.rglob('*') if p.is_file())
    expected_node_files = sorted(recovered['files'])
    dpkg = {}
    for stanza in Path('/var/lib/dpkg/status').read_text().split('\n\n'):
        if stanza.startswith('Package: chromium\n') or stanza.startswith('Package: chromium-common\n') or stanza.startswith('Package: chromium-sandbox\n'):
            lines = stanza.splitlines()
            name = lines[0].split(': ', 1)[1]
            dpkg[name] = {'version': next(l.split(': ', 1)[1] for l in lines if l.startswith('Version: ')),
                          'public_conffile_metadata': [l.strip() for l in lines if l.startswith(' /etc/chromium.d/')]}
    package_digest_checks = {}
    for name, metadata in dpkg.items():
        for line in metadata['public_conffile_metadata']:
            path, expected_md5, *_ = line.split()
            if path.startswith('/etc/chromium.d/'):
                data = Path(path).read_bytes()
                actual_md5 = hashlib.md5(data).hexdigest()
                actual_sha256 = hashlib.sha256(data).hexdigest()
                del data
                package_digest_checks[path] = {'package': name, 'expected_md5': expected_md5, 'actual_md5': actual_md5, 'matches_package': actual_md5 == expected_md5, 'sha256': actual_sha256}
                files[path] = actual_sha256
    wrapper_md5_file = Path('/var/lib/dpkg/info/chromium.md5sums')
    for line in wrapper_md5_file.read_text().splitlines():
        expected_md5, path = line.split(maxsplit=1)
        if path == 'usr/bin/chromium':
            actual_md5 = hashlib.md5(Path('/' + path).read_bytes()).hexdigest()
            package_digest_checks['/' + path] = {'package': 'chromium', 'expected_md5': expected_md5, 'actual_md5': actual_md5, 'matches_package': actual_md5 == expected_md5, 'sha256': sha('/' + path)}
    result = {
        'status': 'STATIC inventory only; no process/version/browser launch or Go execution',
        'inventory_script_sha256': sha(__file__), 'files': files, 'links': links, 'tree_file_sets': trees,
        'elf_graph': graph, 'unresolved_static_DT_NEEDED': unresolved, 'dpkg_metadata': dpkg,
        'node_runtime': {'path': str(NODE), 'sha256': sha(NODE)},
        'playwright': {'recovery': {'path': str(recovery), 'sha256': sha(recovery)}, 'locked_files': len(recovered['files']),
                       'all_hashes_match': node_files_match, 'exact_tree_matches': actual_node_files == expected_node_files,
                       'imports': ['@playwright/test/cli.js -> playwright/lib/program', '@playwright/test/index.mjs -> playwright/test.mjs -> test.js', 'playwright -> playwright-core 1.56.1', 'specs: node:fs and node:path'],
                       'execution_observed_import_graph': False},
        'digest_only_no_content_output': sorted(EXCLUDE), 'distribution_package_checks': package_digest_checks,
        'limits': ['DT_NEEDED is a static ELF closure; dynamic dlopen/version/launch/rendering remain unverified.',
                   'System font data/config inventory is fixed; no personal font/config directory was opened.',
                   'Chromium apikeys conffile read only for parent-authorized distribution digest comparison; no contents were decoded, copied, or emitted.',
                   'Node package trees are locked complete runtime packages, not a claim every file was dynamically imported.'],
    }
    (HERE / 'runtime-input01.json').write_text(json.dumps(result, indent=2, sort_keys=True) + '\n')
    print(json.dumps({'files': len(files), 'elf_objects': len(graph), 'unresolved': unresolved, 'playwright_files': len(recovered['files']), 'playwright_hashes_match': node_files_match, 'playwright_tree_matches': actual_node_files == expected_node_files, 'distribution_checks': package_digest_checks, 'sha256': sha(HERE / 'runtime-input01.json')}))


if __name__ == '__main__':
    main()
