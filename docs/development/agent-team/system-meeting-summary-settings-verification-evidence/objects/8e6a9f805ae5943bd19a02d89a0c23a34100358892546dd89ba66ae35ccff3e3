def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def load_bound(row):
    path = Path(row['path'])
    if sha(path) != row['sha256']:
        raise RuntimeError('bound manifest mismatch: ' + str(path))
    return json.loads(path.read_text())


def digest(rows):
    return hashlib.sha256(json.dumps(rows, sort_keys=True, separators=(',', ':')).encode()).hexdigest()


def source_input(require_published=False):
    # Consume the already executed final graph plus its explicit conservative
    # input delta. Generated TestMain outputs remain provenance, not source.
    union = load_bound(FROZEN['joint_union'])
    delta = load_bound(FROZEN['joint_delta'])
    if union['provenance']['delta'] != FROZEN['joint_delta']:
        raise RuntimeError('joint union/delta provenance mismatch')
    base = load_bound(delta['base_conservative_input'])
    expected = {path: row['sha256'] for path, row in base['files'].items()}
    for name in delta['removed'] + delta['excluded']:
        if name not in expected:
            raise RuntimeError('joint delta removes unknown input: ' + name)
        del expected[name]
    for field in ['changed', 'new']:
        for name, row in delta[field].items():
            if (field == 'changed') != (name in expected):
                raise RuntimeError('joint delta membership mismatch: ' + name)
            if field == 'changed' and expected[name] != row['before_sha256']:
                raise RuntimeError('joint delta old hash mismatch: ' + name)
            expected[name] = row['sha256']
    for name, row in union['sources'].items():
        if row['actual'] != name or expected.get(name) != row['sha256']:
            raise RuntimeError('actual graph differs from final input: ' + name)
    sets = dict(base['effective_package_sets'])
    for directory, row in delta['source_directory_set_delta'].items():
        if sets[directory]['names'] != row['before']:
            raise RuntimeError('joint source set old names mismatch: ' + directory)
        sets[directory] = {**sets[directory], 'names': row['after']}
    runtime = load_bound(FROZEN['runtime_inventory'])
    expected.update(runtime['files'])
    recovery = load_bound(runtime['playwright']['recovery'])
    nm = REPO / 'tests/account-captcha-web/node_modules'
    expected.update({str(nm / path): row['sha256'] for path, row in recovery['files'].items()})
    delivery = load_bound(FROZEN['frontend_delivery'])
    browser = load_bound(delivery['browser_static_frozen'])
    expected.update({str(REPO / path): value for path, value in browser['source_and_config'].items()})
    expected.update({str(REPO / path): value for path, value in delivery['owned16'].items()})
    expected.update(FROZEN['runtime_files'])
    missing, actual = [], {}
    for path in sorted(expected):
        try: actual[path] = sha(path)
        except OSError: missing.append(path)
    mismatch = [path for path in actual if actual[path] != expected[path]]
    changed_sets = []
    for directory, row in sets.items():
        names = sorted(p.name for p in Path(directory).iterdir() if p.is_file() and (p.suffix in GO_INPUT_SUFFIXES or row['embed_directory']))
        if names != row['names']: changed_sets.append(directory)
    for directory, names in runtime['tree_file_sets'].items():
        root = Path(directory)
        current = sorted(str(p.relative_to(root)) for p in root.rglob('*') if p.is_file() or p.is_symlink()) if root.exists() else []
        if current != names: changed_sets.append(directory)
    for path, target in runtime['links'].items():
        if not Path(path).is_symlink() or os.readlink(path) != target: mismatch.append(path + ' symlink')
    node_names = sorted(str(p.relative_to(nm)) for p in nm.rglob('*') if p.is_file())
    if node_names != sorted(recovery['files']): changed_sets.append(str(nm))
    assets = load_bound(FROZEN['assets'])
    staged = Path(FROZEN['dist'])
    actual_assets = {str(p.relative_to(staged)): sha(p) for p in staged.rglob('*') if p.is_file()}
    if actual_assets != assets['candidate']['files']: mismatch.append('frozen browser dist')
    published = REPO / 'web/dist'
    published_assets = {str(p.relative_to(published)): sha(p) for p in published.rglob('*') if p.is_file()}
    published_matches = published_assets == actual_assets
    if require_published and not published_matches: mismatch.append('temporary web/dist asset exchange incomplete')
    minio_ok = actual.get(MINIO) == 'dc5298474f0bc87a068f0b1135c583bb1278c17c11c512212ed7644a238c89c8'
    docker_ok = actual.get(DOCKER) == DOCKER_SHA256
    return {'files_count': len(expected), 'actual_digest': digest(actual), 'expected_digest': digest(expected),
            'missing': missing, 'mismatches': mismatch, 'package_set_changes': changed_sets,
            'joint_union_sha256': FROZEN['joint_union']['sha256'], 'joint_delta_sha256': FROZEN['joint_delta']['sha256'],
            'card_rev3_sha256': FROZEN['card_rev3_sha256'], 'dist_files': len(actual_assets),
            'published_dist_matches': published_matches, 'published_required': require_published,
            'minio_matches': minio_ok, 'docker_path_and_hash_match': docker_ok,
            'accepted': not (missing or mismatch or changed_sets) and minio_ok and docker_ok}


