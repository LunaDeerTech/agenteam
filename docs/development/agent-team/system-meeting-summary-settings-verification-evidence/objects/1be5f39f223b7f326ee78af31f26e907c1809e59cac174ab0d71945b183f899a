from pathlib import Path
import ctypes, hashlib, json, os, signal, subprocess, sys, time
from input import BASE, WEB, NODE, OWNED, snapshot

name, mode, frozen_name = sys.argv[1:]
frozen_path = BASE/frozen_name
frozen = json.loads(frozen_path.read_text())
out = BASE/name
out.mkdir(exist_ok=False)
commands = {
    'format-write': [NODE, str(WEB/'node_modules/prettier/bin/prettier.cjs'), '--write', *[p.removeprefix('web/') for p in OWNED]],
    'format': [NODE, str(WEB/'node_modules/prettier/bin/prettier.cjs'), '--check', *[p.removeprefix('web/') for p in OWNED]],
    'type': [NODE, str(WEB/'node_modules/vue-tsc/bin/vue-tsc.js'), '--noEmit'],
    'pure': [NODE, str(BASE/'tools.mjs'), 'pure'],
    'component': [NODE, str(BASE/'tools.mjs'), 'component'],
    'state': [NODE, str(BASE/'tools.mjs'), 'state'],
    'owners': [NODE, str(BASE/'tools.mjs'), 'owners'],
    'build': [NODE, str(BASE/'tools.mjs'), 'build'],
}

command = commands[mode]
before = snapshot()
if before != frozen:
    (out/'input-mismatch.json').write_text(json.dumps(before, indent=2)+'\n')
    raise RuntimeError('frozen input mismatch; no command spawned')
libc = ctypes.CDLL(None, use_errno=True)
if libc.prctl(36, 1, 0, 0, 0) != 0:
    raise RuntimeError('subreaper setup failed')
subreaper = ctypes.c_int()
if libc.prctl(37, ctypes.byref(subreaper), 0, 0, 0) != 0 or subreaper.value != 1:
    raise RuntimeError('subreaper readback failed')
(out/'tmp').mkdir()
env = {'PATH': str(Path(NODE).parent)+':/usr/bin:/bin', 'HOME': '/home/agent',
       'TMPDIR': str(out/'tmp'), 'SUMMARY_FRONTEND_OUTPUT': str(out), 'CI': '1',
       'NO_COLOR': '1', 'TZ': 'UTC', 'LANG': 'C.UTF-8', 'npm_config_offline': 'true'}
record = {'command': command, 'cwd': str(WEB), 'env': env, 'subreaper': True,
          'budget_seconds': 45, 'frozen': str(frozen_path),
          'frozen_sha256': hashlib.sha256(frozen_path.read_bytes()).hexdigest(), 'started': time.time()}
(out/'command.json').write_text(json.dumps(record, indent=2)+'\n')
started = time.monotonic()
deadline = started + 45
p = None
code = None
adopted = []
forced = False
failure = None

def remaining():
    return max(0, deadline - time.monotonic())

def signal_group(sig):
    if p is None: return
    try: os.killpg(p.pid, sig)
    except ProcessLookupError: pass

def tail():
    found = []
    for stat in Path('/proc').glob('[0-9]*/stat'):
        try:
            parts = stat.read_text().rsplit(')', 1)[1].split()
            if int(parts[1]) == os.getpid() or (p and int(parts[2]) == p.pid):
                found.append({'pid': int(stat.parent.name), 'state': parts[0], 'starttime': parts[19]})
        except (FileNotFoundError, ProcessLookupError): pass
    return found

with (out/'raw.log').open('wb') as log:
    try:
        p = subprocess.Popen(command, cwd=WEB, env=env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
        record['pid'] = p.pid
        try:
            record['pid_starttime'] = Path(f'/proc/{p.pid}/stat').read_text().rsplit(')', 1)[1].split()[19]
        except (FileNotFoundError, ProcessLookupError):
            record['starttime_unavailable_after_fast_exit'] = True
        code = p.wait(timeout=min(42, remaining()))
    except subprocess.TimeoutExpired:
        record['command_budget_exhausted'] = True
    except BaseException as error:
        failure = type(error).__name__
    finally:
        if p and code is None:
            signal_group(signal.SIGTERM)
            try: code = p.wait(timeout=min(1, remaining()))
            except subprocess.TimeoutExpired:
                signal_group(signal.SIGKILL)
                try: code = p.wait(timeout=max(0, remaining() - .3))
                except subprocess.TimeoutExpired: record['direct_unjoined'] = True
        if code is not None:
            while remaining() > .15:
                try: child, status = os.waitpid(-1, os.WNOHANG)
                except ChildProcessError: break
                if child:
                    adopted.append({'pid': child, 'wait_status': status})
                    continue
                # Surviving descendants are task-owned even after the direct command exits.
                forced = True
                signal_group(signal.SIGKILL)
                for member in tail():
                    if member['state'] != 'Z':
                        try: os.kill(member['pid'], signal.SIGKILL)
                        except ProcessLookupError: pass
                time.sleep(min(.01, max(0, remaining() - .15)))
first = tail()
if remaining() > .1: time.sleep(.1)
second = tail()
process_finished = time.monotonic()
after = snapshot()
allowed_format = False
if mode == 'format-write':
    (out/'after.json').write_text(json.dumps(after, indent=2)+'\n')
    expected = json.loads(json.dumps(before))
    for path in OWNED:
        expected['source_and_config'][path] = after['source_and_config'][path]
        expected['owned_web_eleven'][path] = after['owned_web_eleven'][path]
    allowed_format = expected == after
record.update(exit=code, finished=time.time(), process_elapsed=process_finished-started,
              subreaper_readback=subreaper.value, adopted_waits=adopted,
              forced_descendants=forced, failure=failure, first_tail=first, second_tail=second,
              inputs_unchanged=after==before, expected_format_only=allowed_format)
(out/'command.json').write_text(json.dumps(record, indent=2)+'\n')
print(json.dumps({'path': str(out), 'exit': code, 'elapsed': record['process_elapsed'],
                  'inputs_unchanged': after==before, 'tails': [first,second], 'adopted': adopted,
                  'failure': failure}))
if first or second or (before!=after and not allowed_format) or record.get('command_budget_exhausted') or record.get('direct_unjoined') or forced or failure or process_finished > deadline:
    sys.exit(125)
sys.exit(code if code is not None and code>=0 else 125)
