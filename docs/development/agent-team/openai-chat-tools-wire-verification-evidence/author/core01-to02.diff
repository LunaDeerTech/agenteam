+func TestToolsInvalidNameIsBoundedBeforePolicyClone(t *testing.T) {
+	r, o := toolsUnitInput(t)
+	r.Tools[0].Name = strings.Repeat("x", 1<<20)
+	measured := testing.Benchmark(func(b *testing.B) {
+		for i := 0; i < b.N; i++ {
+			req, _, err := prepare(r, o)
+			if req != nil || err == nil {
+				b.Fatal("invalid name encoded")
+			}
+		}
+	})
+	if measured.AllocedBytesPerOp() >= int64(len(r.Tools[0].Name)/2) {
+		t.Fatal("invalid tool name copied before its bounded validation", measured.AllocedBytesPerOp())
+	}
+	t.Logf("invalid_name_bytes=%d allocated_bytes_per_prepare=%d", len(r.Tools[0].Name), measured.AllocedBytesPerOp())
+}
