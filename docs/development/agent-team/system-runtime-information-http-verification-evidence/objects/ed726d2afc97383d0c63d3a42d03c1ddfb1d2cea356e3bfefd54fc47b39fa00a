+func TestRuntimeInformationDeadlineAndActualTail(t *testing.T) {
+	for _, earlier := range []bool{false, true} {
+		name, parentBudget := "local-three-seconds", 10*time.Second
+		if earlier {
+			name, parentBudget = "earlier-parent", 75*time.Millisecond
+		}
+		t.Run(name, func(t *testing.T) {
+			service, store, actor := testService(t)
+			parent, cancel := context.WithTimeout(context.Background(), parentBudget)
+			parentDeadline, _ := parent.Deadline()
+			entry := make(chan context.Context, 1)
+			expired, releaseSource, atTxTail, releaseTx, joined := make(chan struct{}), make(chan struct{}), make(chan struct{}), make(chan struct{}), make(chan struct{})
+			var sourceOnce, txOnce sync.Once
+			var sourceActive atomic.Int32
+			service.source = sourceFunc(func(ctx context.Context) (Snapshot, error) {
+				store.snapshots.Add(1)
+				sourceActive.Add(1)
+				defer sourceActive.Add(-1)
+				entry <- ctx
+				<-ctx.Done()
+				close(expired)
+				<-releaseSource
+				return Snapshot{}, ctx.Err()
+			})
+			store.tail = func(context.Context) { close(atTxTail); <-releaseTx }
+			type result struct {
+				value Snapshot
+				err   error
+			}
+			done := make(chan result, 1)
+			t.Cleanup(func() {
+				cancel()
+				sourceOnce.Do(func() { close(releaseSource) })
+				txOnce.Do(func() { close(releaseTx) })
+				<-joined
+			})
+			before := time.Now()
+			go func() {
+				defer close(joined)
+				value, err := service.GetSystem(parent, actor)
+				done <- result{value, err}
+			}()
+			var observed context.Context
+			select {
+			case observed = <-entry:
+			case <-time.After(time.Second):
+				t.Fatal("Source entry missing")
+			}
+			entered := time.Now()
+			deadline, ok := observed.Deadline()
+			if !ok || observed != store.ctx || earlier && !deadline.Equal(parentDeadline) || !earlier && (deadline.Before(before.Add(3*time.Second)) || deadline.After(entered.Add(3*time.Second)) || !deadline.Before(parentDeadline)) {
+				t.Fatal("local budget or earlier parent was restarted")
+			}
+			select {
+			case <-expired:
+			case <-time.After(4 * time.Second):
+				t.Fatal("natural deadline did not expire")
+			}
+			if observed.Err() != context.DeadlineExceeded || !earlier && parent.Err() != nil {
+				t.Fatal("natural deadline did not preserve parent semantics")
+			}
+			if sourceActive.Load() != 1 || store.active.Load() != 1 {
+				t.Fatal("deadline pretended active work had ended")
+			}
+			select {
+			case <-done:
+				t.Fatal("returned before Source tail")
+			default:
+			}
+			sourceOnce.Do(func() { close(releaseSource) })
+			select {
+			case <-atTxTail:
+			case <-time.After(time.Second):
+				t.Fatal("transaction tail missing")
+			}
+			if sourceActive.Load() != 0 || store.active.Load() != 1 {
+				t.Fatal("Source/transaction tail ownership collapsed")
+			}
+			select {
+			case <-done:
+				t.Fatal("returned before transaction tail")
+			default:
+			}
+			txOnce.Do(func() { close(releaseTx) })
+			got := <-done
+			<-joined
+			wantFault(t, got.value, got.err, foundation.DependencyUnavailable, foundation.NotCommitted)
+			if !errors.Is(got.err, context.DeadlineExceeded) || store.started.Load() != 1 || store.snapshots.Load() != 1 || store.active.Load() != 0 || sourceActive.Load() != 0 {
+				t.Fatal("deadline cause, no-retry or actual join lost")
+			}
+			t.Logf("natural deadline elapsed=%s earlier_parent=%t source_calls=%d transaction_calls=%d active=0", time.Since(before), earlier, store.snapshots.Load(), store.started.Load())
+		})
+	}
+}
