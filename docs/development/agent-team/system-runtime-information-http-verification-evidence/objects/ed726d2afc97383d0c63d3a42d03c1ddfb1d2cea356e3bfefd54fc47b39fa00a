+			wantFault(t, value, err, code, state)
+			if store.started.Load() != starts || store.snapshots.Load() != 0 || store.active.Load() != 0 {
+				t.Fatal("rejection observed Source or retained transaction")
+			}
+			if strings.HasPrefix(name, "cancel-") && !errors.Is(err, context.Canceled) {
+				t.Fatal("lost original cancellation cause")
+			}
+		})
+	}
+}
