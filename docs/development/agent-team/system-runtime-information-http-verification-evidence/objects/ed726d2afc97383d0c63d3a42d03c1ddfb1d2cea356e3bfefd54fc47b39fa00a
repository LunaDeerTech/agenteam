+func TestRuntimeInformationTransactionFailures(t *testing.T) {
+	for _, name := range []string{"unknown", "zero-result", "not-committed", "not-committed-nil-fault", "skipped-callback", "committed-source-error", "repeat-callback", "source-error", "cancel-after-source", "cancel-at-transaction-tail"} {
+		t.Run(name, func(t *testing.T) {
+			service, store, actor := testService(t)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			code, state, calls := foundation.DependencyUnavailable, foundation.NotCommitted, int32(1)
+			privateCause := errors.New("runtime-private-error-canary")
+			switch name {
+			case "unknown":
+				id, err := foundation.NewID[foundation.TransactionAttempt]()
+				if err != nil {
+					t.Fatal(err)
+				}
+				cause, err := foundation.NewRecoveryCause("test", id.String(), "")
+				if err != nil {
+					t.Fatal(err)
+				}
+				result := foundation.UnknownResult(id, cause)
+				store.result = &result
+				code, state = foundation.CommitUnknown, foundation.Unknown
+			case "zero-result":
+				store.result = &foundation.CommitResult{}
+				code, state = foundation.CommitUnknown, foundation.Unknown
+			case "not-committed":
+				fault := foundation.NewFault(foundation.Forbidden, foundation.NotStarted).WithCause(privateCause)
+				fault.SafeMessage, fault.RetryHint = "safe denial", "none"
+				result := foundation.NotCommittedResult(fault)
+				store.result = &result
+				code = foundation.Forbidden
+			case "not-committed-nil-fault":
+				result := foundation.NotCommittedResult(nil)
+				store.result = &result
+				code = foundation.InternalError
+			case "skipped-callback":
+				store.skip, calls, state = true, 0, foundation.NotStarted
+			case "committed-source-error", "source-error":
+				service.source = sourceFunc(func(context.Context) (Snapshot, error) { store.snapshots.Add(1); return validSnapshot(t), privateCause })
+				if name == "committed-source-error" {
+					result := foundation.CommittedResult()
+					store.result = &result
+					state = foundation.NotStarted
+				}
+			case "repeat-callback":
+				store.repeat = true
+				result := foundation.CommittedResult()
+				store.result = &result
+				state = foundation.NotStarted
+			case "cancel-after-source":
+				original := service.source
+				service.source = sourceFunc(func(ctx context.Context) (Snapshot, error) {
+					value, err := original.Snapshot(ctx)
+					cancel()
+					return value, err
+				})
+			case "cancel-at-transaction-tail":
+				store.tail = func(context.Context) { cancel() }
+				state = foundation.NotStarted
+			}
+			got, err := service.GetSystem(ctx, actor)
+			fault := wantFault(t, got, err, code, state)
+			if store.started.Load() != 1 || store.snapshots.Load() != calls || store.active.Load() != 0 {
+				t.Fatal("transaction failed without zeroing observation or joining")
+			}
+			if name == "not-committed" && (!errors.Is(err, privateCause) || fault.SafeMessage != "safe denial" || fault.RetryHint != "none") {
+				t.Fatal("original typed transaction fault lost")
+			}
+			if name == "source-error" && !errors.Is(err, privateCause) {
+				t.Fatal("private source cause lost")
+			}
+			if strings.Contains(fmt.Sprintf("%v %#v", err, err), privateCause.Error()) {
+				t.Fatal("private error escaped safe formatting")
+			}
+		})
+	}
+}
