+package runtimeinfo
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"reflect"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/LunaDeerTech/agenteam/internal/central/foundation"
+	identity "github.com/LunaDeerTech/agenteam/internal/central/identity/contract"
+)
+
+type sessionFunc func(context.Context, foundation.Tx, identity.Actor) error
+
+func (f sessionFunc) RequireCurrentSession(ctx context.Context, tx foundation.Tx, actor identity.Actor) error {
+	return f(ctx, tx, actor)
+}
+
+type systemFunc func(context.Context, foundation.Tx, identity.Actor, identity.AccessIntent) (identity.AccessGrant, error)
+
+func (f systemFunc) AuthorizeSystem(ctx context.Context, tx foundation.Tx, actor identity.Actor, intent identity.AccessIntent) (identity.AccessGrant, error) {
+	return f(ctx, tx, actor, intent)
+}
+
+type sourceFunc func(context.Context) (Snapshot, error)
+
+func (f sourceFunc) Snapshot(ctx context.Context) (Snapshot, error) { return f(ctx) }
+
+type readStore struct {
+	t                          *testing.T
+	tx                         foundation.Tx
+	ctx                        context.Context
+	held                       bool
+	steps                      []string
+	causes                     []foundation.TransactionCause
+	acquireErr                 error
+	afterAcquire, tail         func(context.Context)
+	result                     *foundation.CommitResult
+	skip, zeroTx, repeat       bool
+	started, active, snapshots atomic.Int32
+}
+
+func (s *readStore) WithinTx(ctx context.Context, cause foundation.TransactionCause, fn func(context.Context, foundation.Tx) error) foundation.CommitResult {
+	s.started.Add(1)
+	s.active.Add(1)
+	defer s.active.Add(-1)
+	s.ctx, s.tx, s.held = ctx, foundation.NewTx(), false
+	if s.zeroTx {
+		s.tx = foundation.Tx{}
+	}
+	d := cause.Details()
+	if cause.Validate() != nil || d.Kind != foundation.RecoveryCause || d.Owner != "runtimeinfo.system-read" || d.Primary.Validate() == nil || len(d.Related) != 0 || d.CheckpointRef != "" {
+		s.t.Error("unexpected read transaction cause")
+	}
+	if _, err := foundation.ParseID[readAttempt](d.RecoveryRunID); err != nil {
+		s.t.Error("read has no fresh typed attempt ID")
+	}
+	s.causes = append(s.causes, cause)
+	s.steps = append(s.steps, "begin")
+	var err error
+	if !s.skip {
+		err = fn(ctx, s.tx)
+		if s.repeat {
+			err = fn(ctx, s.tx)
+		}
+	}
+	s.steps = append(s.steps, "callback-ended")
+	if s.tail != nil {
+		s.tail(ctx)
+	}
+	s.steps = append(s.steps, "transaction-ended")
+	if s.result != nil {
+		return *s.result
+	}
+	if err != nil {
+		var fault *foundation.Fault
+		if !errors.As(err, &fault) {
+			fault = foundation.NewFault(foundation.InternalError, foundation.NotStarted).WithCause(err)
+		}
+		return foundation.NotCommittedResult(fault)
+	}
+	return foundation.CommittedResult()
+}
+
+func (s *readStore) Acquire(ctx context.Context, tx foundation.Tx, key foundation.LockKey, mode foundation.LockMode) error {
+	want, err := foundation.UserLock("01900000-0000-7000-8000-000000000001")
+	if err != nil || ctx != s.ctx || !tx.Valid() || tx != s.tx || foundation.CompareLockKeys(key, want) != 0 || mode != foundation.Shared {
+		s.t.Error("read did not acquire the exact User shared lock in its transaction")
+	}
+	s.steps = append(s.steps, "user-shared")
+	s.held = s.acquireErr == nil
+	if s.afterAcquire != nil {
+		s.afterAcquire(ctx)
+	}
+	return s.acquireErr
+}
+
+func (s *readStore) authorizedStep(ctx context.Context, tx foundation.Tx, name string) {
+	if ctx != s.ctx || !tx.Valid() || tx != s.tx || !s.held {
+		s.t.Errorf("%s did not share the current transaction and held User lock", name)
+	}
+	s.steps = append(s.steps, name)
+}
+
+func validSnapshot(t *testing.T) Snapshot {
+	t.Helper()
+	at, err := foundation.NewInstant(time.Date(2026, 10, 6, 1, 2, 3, 123456000, time.UTC))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return Snapshot{
+		ObservedAt: at,
+		Database: DatabaseSnapshot{Status: Available, LastSuccess: DatabaseSuccess{
+			CheckedAt: at, ReceivedAt: at, PostgreSQLVersion: "17.8", PGVectorVersion: "0.8.2",
+		}},
+		ObjectStorage: ObjectStorageSnapshot{Status: Available, LastSuccessReceivedAt: at},
+		Readiness:     foundation.DependencyUnbound,
+	}
+}
+
+func testService(t *testing.T) (*Service, *readStore, identity.Actor) {
+	t.Helper()
+	user, err := foundation.ParseID[identity.User]("01900000-0000-7000-8000-000000000001")
+	if err != nil {
+		t.Fatal(err)
+	}
+	session, err := foundation.ParseID[identity.Session]("01900000-0000-7000-8000-000000000002")
+	if err != nil {
+		t.Fatal(err)
+	}
+	actor, err := identity.NewHuman(user, session)
+	if err != nil {
+		t.Fatal(err)
+	}
+	store := &readStore{t: t}
+	snapshot := validSnapshot(t)
+	service, err := New(store,
+		sessionFunc(func(ctx context.Context, tx foundation.Tx, got identity.Actor) error {
+			store.authorizedStep(ctx, tx, "session")
+			if !got.Equal(actor) {
+				t.Error("Session principal changed")
+			}
+			return nil
+		}),
+		systemFunc(func(ctx context.Context, tx foundation.Tx, got identity.Actor, intent identity.AccessIntent) (identity.AccessGrant, error) {
+			store.authorizedStep(ctx, tx, "administrator")
+			if !got.Equal(actor) || intent != identity.Read {
+				t.Error("System principal or intent changed")
+			}
+			return identity.NewAccessGrant(got, identity.SystemScope(), intent, snapshot.ObservedAt, 1)
+		}),
+		sourceFunc(func(ctx context.Context) (Snapshot, error) {
+			store.authorizedStep(ctx, store.tx, "snapshot")
+			store.snapshots.Add(1)
+			return snapshot, nil
+		}),
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return service, store, actor
+}
+
+func wantFault(t *testing.T, value Snapshot, err error, code foundation.Code, state foundation.CommitState) *foundation.Fault {
+	t.Helper()
+	var fault *foundation.Fault
+	if value != (Snapshot{}) || !errors.As(err, &fault) || fault == nil || fault.Code != code || fault.CommitState != state {
+		t.Fatalf("expected zero snapshot and %s/%s, got zero=%t error=%v", code, state, value == (Snapshot{}), err)
+	}
+	return fault
+}
+
+func TestRuntimeInformationConstructionAndBindings(t *testing.T) {
+	service, store, actor := testService(t)
+	if store.started.Load() != 0 || store.snapshots.Load() != 0 || len(store.steps) != 0 {
+		t.Fatal("constructor performed I/O")
+	}
+	for _, name := range []string{"nil-store", "typed-store", "nil-session", "typed-session", "nil-system", "typed-system", "nil-source", "typed-source"} {
+		t.Run(name, func(t *testing.T) {
+			var db Store = store
+			sessions, system, source := service.sessions, service.system, service.source
+			switch name {
+			case "nil-store":
+				db = nil
+			case "typed-store":
+				db = (*readStore)(nil)
+			case "nil-session":
+				sessions = nil
+			case "typed-session":
+				sessions = sessionFunc(nil)
+			case "nil-system":
+				system = nil
+			case "typed-system":
+				system = systemFunc(nil)
+			case "nil-source":
+				source = nil
+			case "typed-source":
+				source = sourceFunc(nil)
+			}
+			got, err := New(db, sessions, system, source)
+			wantFault(t, Snapshot{}, err, foundation.DependencyUnbound, foundation.NotStarted)
+			if got != nil || store.started.Load() != 0 {
+				t.Fatal("missing binding constructed a service or performed I/O")
+			}
+		})
+	}
+	for _, missing := range []*Service{nil, {}} {
+		got, err := missing.GetSystem(context.Background(), actor)
+		wantFault(t, got, err, foundation.DependencyUnbound, foundation.NotStarted)
+	}
+}
+
+func TestRuntimeInformationTransactionPublication(t *testing.T) {
+	service, store, actor := testService(t)
+	entered, release, joined := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	store.tail = func(context.Context) { close(entered); <-release }
+	type result struct {
+		value Snapshot
+		err   error
+	}
+	done := make(chan result, 1)
+	t.Cleanup(func() { once.Do(func() { close(release) }); <-joined })
+	go func() {
+		defer close(joined)
+		value, err := service.GetSystem(context.Background(), actor)
+		done <- result{value, err}
+	}()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("transaction tail missing")
+	}
+	select {
+	case <-done:
+		t.Fatal("candidate escaped before actual transaction return")
+	default:
+	}
+	if store.active.Load() != 1 || store.snapshots.Load() != 1 {
+		t.Fatal("read ownership or single observation lost")
+	}
+	once.Do(func() { close(release) })
+	got := <-done
+	<-joined
+	if got.err != nil || got.value != validSnapshot(t) || store.active.Load() != 0 {
+		t.Fatal("committed complete observation missing", got.err)
+	}
+	want := []string{"begin", "user-shared", "session", "administrator", "snapshot", "callback-ended", "transaction-ended"}
+	if !reflect.DeepEqual(store.steps, want) || store.started.Load() != 1 {
+		t.Fatal("authorization/Source/terminal ordering changed", store.steps)
+	}
+	// A second call reads the current Source value, with no cached candidate or
+	// shared mutable DTO. Both technical attempts remain distinct from commands.
+	store.tail = nil
+	next := validSnapshot(t)
+	next.Database.LastSuccess.PostgreSQLVersion = "18.1"
+	service.source = sourceFunc(func(context.Context) (Snapshot, error) { store.snapshots.Add(1); return next, nil })
+	got.value.Database.LastSuccess.PostgreSQLVersion = "caller-only"
+	value, err := service.GetSystem(context.Background(), actor)
+	if err != nil || value != next || store.snapshots.Load() != 2 || len(store.causes) != 2 || store.causes[0].Details().RecoveryRunID == store.causes[1].Details().RecoveryRunID {
+		t.Fatal("observation cached, aliased or attempt identity reused", err)
+	}
+}
