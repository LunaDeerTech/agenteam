+func TestRuntimeInformationCancellationWaitsForLateCall(t *testing.T) {
+	for _, inSource := range []bool{false, true} {
+		name := "authorization"
+		if inSource {
+			name = "source"
+		}
+		t.Run(name, func(t *testing.T) {
+			service, store, actor := testService(t)
+			ctx, cancel := context.WithCancel(context.Background())
+			entered, release, joined := make(chan struct{}), make(chan struct{}), make(chan struct{})
+			var once sync.Once
+			var active atomic.Int32
+			block := func() { active.Add(1); defer active.Add(-1); close(entered); <-release }
+			if inSource {
+				original := service.source
+				service.source = sourceFunc(func(ctx context.Context) (Snapshot, error) { block(); return original.Snapshot(ctx) })
+			} else {
+				original := service.sessions
+				service.sessions = sessionFunc(func(ctx context.Context, tx foundation.Tx, got identity.Actor) error {
+					block()
+					return original.RequireCurrentSession(ctx, tx, got)
+				})
+			}
+			type result struct {
+				value Snapshot
+				err   error
+			}
+			done := make(chan result, 1)
+			t.Cleanup(func() { cancel(); once.Do(func() { close(release) }); <-joined })
+			go func() { defer close(joined); value, err := service.GetSystem(ctx, actor); done <- result{value, err} }()
+			select {
+			case <-entered:
+			case <-time.After(time.Second):
+				t.Fatal("controlled call did not start")
+			}
+			cancel()
+			if active.Load() != 1 || store.active.Load() != 1 {
+				t.Fatal("active call lost before release")
+			}
+			select {
+			case <-done:
+				t.Fatal("cancellation escaped the actual call")
+			default:
+			}
+			once.Do(func() { close(release) })
+			got := <-done
+			<-joined
+			wantFault(t, got.value, got.err, foundation.DependencyUnavailable, foundation.NotCommitted)
+			wantCalls := int32(0)
+			if inSource {
+				wantCalls = 1
+			}
+			if !errors.Is(got.err, context.Canceled) || active.Load() != 0 || store.active.Load() != 0 || store.snapshots.Load() != wantCalls || store.started.Load() != 1 {
+				t.Fatal("late success escaped or call did not join")
+			}
+		})
+	}
