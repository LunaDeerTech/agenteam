+func TestRuntimeInformationSnapshotValidation(t *testing.T) {
+	for _, name := range []string{"zero-observed", "zero-checked", "zero-db-received", "zero-object-received", "bad-db-status", "bad-object-status", "bad-readiness", "empty-postgresql", "empty-pgvector", "long-postgresql", "long-pgvector", "tab", "newline", "nul", "del", "non-ascii", "invalid-utf8"} {
+		t.Run(name, func(t *testing.T) {
+			service, store, actor := testService(t)
+			value := validSnapshot(t)
+			switch name {
+			case "zero-observed":
+				value.ObservedAt = foundation.Instant{}
+			case "zero-checked":
+				value.Database.LastSuccess.CheckedAt = foundation.Instant{}
+			case "zero-db-received":
+				value.Database.LastSuccess.ReceivedAt = foundation.Instant{}
+			case "zero-object-received":
+				value.ObjectStorage.LastSuccessReceivedAt = foundation.Instant{}
+			case "bad-db-status":
+				value.Database.Status = "unknown"
+			case "bad-object-status":
+				value.ObjectStorage.Status = "unknown"
+			case "bad-readiness":
+				value.Readiness = foundation.InternalError
+			case "empty-postgresql":
+				value.Database.LastSuccess.PostgreSQLVersion = ""
+			case "empty-pgvector":
+				value.Database.LastSuccess.PGVectorVersion = ""
+			case "long-postgresql":
+				value.Database.LastSuccess.PostgreSQLVersion = strings.Repeat("x", 257)
+			case "long-pgvector":
+				value.Database.LastSuccess.PGVectorVersion = strings.Repeat("x", 257)
+			case "tab":
+				value.Database.LastSuccess.PostgreSQLVersion = "17\t8"
+			case "newline":
+				value.Database.LastSuccess.PostgreSQLVersion = "17.8\n"
+			case "nul":
+				value.Database.LastSuccess.PostgreSQLVersion = "17\x008"
+			case "del":
+				value.Database.LastSuccess.PostgreSQLVersion = "17\x7f8"
+			case "non-ascii":
+				value.Database.LastSuccess.PostgreSQLVersion = "版本17"
+			case "invalid-utf8":
+				value.Database.LastSuccess.PostgreSQLVersion = "17\xff8"
+			}
+			service.source = sourceFunc(func(context.Context) (Snapshot, error) { store.snapshots.Add(1); return value, nil })
+			got, err := service.GetSystem(context.Background(), actor)
+			wantFault(t, got, err, foundation.DependencyUnavailable, foundation.NotCommitted)
+			if store.snapshots.Load() != 1 || store.active.Load() != 0 {
+				t.Fatal("invalid observation not consumed exactly once")
+			}
+		})
+	}
+	// All printable bytes, including leading/trailing spaces and escaping, are
+	// retained verbatim. No display-time ordering is inferred from wall clocks.
+	var printable strings.Builder
+	for b := byte(0x20); b <= 0x7e; b++ {
+		printable.WriteByte(b)
+	}
+	for _, status := range []Status{Available, Unavailable, Stale} {
+		for _, reason := range []foundation.Code{foundation.DependencyUnavailable, foundation.DependencyUnbound} {
+			service, _, actor := testService(t)
+			value := validSnapshot(t)
+			value.Database.Status, value.ObjectStorage.Status, value.Readiness = status, status, reason
+			value.Database.LastSuccess.PostgreSQLVersion = " "
+			value.Database.LastSuccess.PGVectorVersion = strings.Repeat(printable.String(), 3)[:256]
+			later, err := foundation.NewInstant(value.ObservedAt.Time().Add(time.Hour))
+			if err != nil {
+				t.Fatal(err)
+			}
+			value.Database.LastSuccess.CheckedAt, value.ObjectStorage.LastSuccessReceivedAt = later, later
+			service.source = sourceFunc(func(context.Context) (Snapshot, error) { return value, nil })
+			got, err := service.GetSystem(context.Background(), actor)
+			if err != nil || got != value {
+				t.Fatal("valid historical observation was changed or rejected", err)
+			}
+		}
+	}
+}
