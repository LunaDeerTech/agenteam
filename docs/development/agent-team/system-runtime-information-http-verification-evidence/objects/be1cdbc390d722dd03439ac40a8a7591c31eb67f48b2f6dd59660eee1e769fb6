+func (w *budgetWriter) SetWriteDeadline(at time.Time) error {
+	if w.setWrite != nil {
+		if err := w.setWrite(at); err != nil {
+			return err
+		}
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	w.writes = append(w.writes, at)
+	return nil
+}
+func (w *budgetWriter) Write(p []byte) (int, error) {
+	if w.write != nil {
+		return w.write(p)
+	}
+	if w.short {
+		return len(p) - 1, nil
+	}
+	return w.ResponseRecorder.Write(p)
+}
+func (w *budgetWriter) FlushError() error {
+	w.flushes++
+	if w.flush != nil {
+		return w.flush()
+	}
+	return w.flushErr
+}
+func aborts(run func()) (aborted bool) {
+	defer func() {
+		if value := recover(); value != nil {
+			if value != http.ErrAbortHandler {
+				panic(value)
+			}
+			aborted = true
+		}
+	}()
+	run()
+	return false
+}
