+func (w *budgetWriter) SetReadDeadline(at time.Time) error {
+	if w.setRead != nil {
+		if err := w.setRead(at); err != nil {
+			return err
+		}
+	}
+	w.mu.Lock()
+	w.reads = append(w.reads, at)
+	w.mu.Unlock()
+	return nil
