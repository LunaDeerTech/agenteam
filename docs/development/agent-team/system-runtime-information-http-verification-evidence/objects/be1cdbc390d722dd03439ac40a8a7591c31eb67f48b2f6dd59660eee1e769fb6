+func TestRuntimeInformationHTTPPureActualIOTails(t *testing.T) {
+	for _, phase := range []string{"read", "service", "write", "flush", "close"} {
+		t.Run(phase, func(t *testing.T) {
+			parent, cancel := context.WithCancel(context.Background())
+			entered, release, joined := make(chan struct{}), make(chan struct{}), make(chan struct{})
+			var once sync.Once
+			var active atomic.Int32
+			block := func() { active.Add(1); defer active.Add(-1); close(entered); <-release }
+			body := &closeBody{Reader: strings.NewReader("")}
+			w := newBudgetWriter()
+			reader := &testReader{}
+			switch phase {
+			case "read":
+				body.Reader = readFunc(func([]byte) (int, error) { block(); return 0, io.EOF })
+			case "service":
+				reader.get = func(context.Context) (runtimeinfo.Snapshot, error) { block(); return sampleSnapshot() }
+			case "write":
+				w.write = func([]byte) (int, error) { block(); return 0, io.ErrClosedPipe }
+			case "flush":
+				w.flush = func() error { block(); return io.ErrClosedPipe }
+			case "close":
+				body.close = func() error { block(); return nil }
+			}
+			r := httptest.NewRequest("GET", runtimePath, nil).WithContext(parent)
+			r.Body = body
+			done := make(chan bool, 1)
+			t.Cleanup(func() { cancel(); once.Do(func() { close(release) }); <-joined })
+			go func() {
+				defer close(joined)
+				done <- aborts(func() { (&systemHTTP{reader, &testBoundary{}}).ServeHTTP(w, r) })
+			}()
+			select {
+			case <-entered:
+			case <-time.After(time.Second):
+				t.Fatal("owned I/O stage not reached")
+			}
+			cancel()
+			if active.Load() != 1 {
+				t.Fatal("active I/O disappeared on cancellation")
+			}
+			select {
+			case <-done:
+				t.Fatal("handler returned before actual I/O tail")
+			default:
+			}
+			once.Do(func() { close(release) })
+			if !<-done {
+				t.Fatal("cancelled tail returned normally")
+			}
+			<-joined
+			if active.Load() != 0 || body.closed.Load() != 1 || phase == "read" && reader.calls.Load() != 0 || phase != "read" && reader.calls.Load() != 1 {
+				t.Fatal("actual calls/Close were not joined")
+			}
+			if (phase == "read" || phase == "service") && (w.Body.Len() != 0 || w.flushes != 0) {
+				t.Fatal("late call published a candidate")
+			}
+			w.mu.Lock()
+			defer w.mu.Unlock()
+			if !w.reads[len(w.reads)-1].IsZero() || !w.writes[len(w.writes)-1].IsZero() {
+				t.Fatal("retired callback left a connection deadline")
+			}
+		})
+	}
+}
