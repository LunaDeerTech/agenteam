+func TestRuntimeInformationHTTPPureProjectionAndEncodedBudget(t *testing.T) {
+	value := testSnapshot(t)
+	value.Database.Status = runtimeinfo.Unavailable
+	value.ObjectStorage.Status = runtimeinfo.Unavailable
+	value.Readiness = foundation.DependencyUnavailable
+	value.Database.LastSuccess.PostgreSQLVersion = strings.Repeat("&", 256)
+	value.Database.LastSuccess.PGVectorVersion = strings.Repeat("<", 256)
+	body, err := encodeSnapshot(value)
+	if err != nil || len(body) > 3690 || len(body) > successBytes || bytes.Count(body, []byte(`\u0026`)) != 256 || bytes.Count(body, []byte(`\u003c`)) != 256 {
+		t.Fatal("maximum legal default JSON escaping", len(body), err)
+	}
+	dto, err := projectSnapshot(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dto.Database.LastSuccess.PostgreSQLVersion = ""
+	dto.Database.LastSuccess.PGVectorVersion = ""
+	shell, err := json.Marshal(dto)
+	if err != nil || len(shell) != 618 || len(body) != len(shell)+2*256*6 {
+		t.Fatal("fixed shell/3690B conservative arithmetic", len(shell), len(body), err)
+	}
+	var decoded map[string]any
+	if json.Unmarshal(body, &decoded) != nil || len(decoded) != 5 {
