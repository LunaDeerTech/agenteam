+func constructionCore(t *testing.T) *account.Service {
+	t.Helper()
+	key := func(b byte) string { return base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{b}, 32)) }
+	page, err := cursor.LoadKeyring(fmt.Sprintf(`{"format":1,"current_kid":"p","keys":[{"kid":"p","key_b64":%q}]}`, key(1)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	encryption, err := secret.LoadKeyring(fmt.Sprintf(`{"format":1,"current_version":"1","keys":[{"version":"1","key_b64":%q}]}`, key(2)), page)
+	if err != nil {
+		t.Fatal(err)
+	}
+	download, err := object.LoadDownloadKeyring(fmt.Sprintf(`{"format":1,"current_kid":"d","keys":[{"kid":"d","key_b64":%q}]}`, key(3)), page, encryption)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keys, err := account.LoadKeyring(fmt.Sprintf(`{"format":1,"current_kid":"a","keys":[{"kid":"a","key_b64":%q}]}`, key(4)), page, encryption, download)
+	if err != nil {
+		t.Fatal(err)
+	}
+	authority, err := account.NewAuthority(&noCallAccountStore{}, keys)
+	if err != nil {
+		t.Fatal(err)
+	}
+	catalog := event.NewCatalog()
+	sessions, err := ac.DefineSessionsRevoked(catalog)
+	if err != nil {
+		t.Fatal(err)
+	}
+	delivery, err := ac.DefineDeliveryRequested(catalog)
+	if err != nil {
+		t.Fatal(err)
+	}
+	process, err := foundation.ParseID[ac.Process](wireID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	core, err := account.New(account.Dependencies{Authority: authority, Audit: noCallAudit{}, Secrets: &secret.Service{}, Events: noCallEvents{}, Challenges: noCallChallenges{}, Processes: noCallProcesses{id: process}, RecoveryLog: &recoverylog.Sink{}, SessionsRevoked: sessions, DeliveryRequested: delivery})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return core
+}
