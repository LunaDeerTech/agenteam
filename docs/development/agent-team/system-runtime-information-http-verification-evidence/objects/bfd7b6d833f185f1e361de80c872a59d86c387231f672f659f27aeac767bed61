// Only Status may be called by these ports. Every other promoted method has a
// nil provider and would panic if a read accidentally started work or a probe.
type riSecrets struct {
	maintenance
	status func() secret.Status
}

func (s *riSecrets) Status() secret.Status { return s.status() }

type riOutbound struct {
	egress
	status func() outbound.PolicyStatus
}

func (s *riOutbound) Status() outbound.PolicyStatus { return s.status() }

type riObjects struct{ objectStorage }
type riOutbox struct{ outboxStorage }
type riAccounts struct{ accountStorage }

func riInstant(t *testing.T, value time.Time) foundation.Instant {
	t.Helper()
	instant, err := foundation.NewInstant(value)
	if err != nil || instant.Validate() != nil {
		t.Fatal("invalid test time", err)
	}
	return instant
}

func riMonitor(t *testing.T, now time.Time) *healthMonitor {
	t.Helper()
	return &healthMonitor{
		last: postgres.DatabaseHealth{PostgreSQL: true, PGVector: true, Migrations: true, ReadWrite: true,
			CheckedAt: riInstant(t, now.Add(-2*time.Second)), ServerVersion: "17.8 (original)", ExtensionVersion: "0.8.1"},
		received: now.Add(-time.Second), available: true,
		objectReceived: now.Add(-time.Second), objectAvailable: true,
		outboxReceived: now.Add(-time.Second), outboxAvailable: true,
		accountReceived: now.Add(-time.Second), accountAvailable: true, accountBound: true,
		timing: healthTiming{interval: 10 * time.Second, timeout: 2 * time.Second, stale: 20 * time.Second, now: func() time.Time { return now }},
	}
}

func riSource(t *testing.T, monitor *healthMonitor) *runtimeInformationSource {
	t.Helper()
	source, err := newRuntimeInformationSource(monitor,
		&riSecrets{status: func() secret.Status { return secret.Status{Available: true} }},
		&riOutbound{status: func() outbound.PolicyStatus { return outbound.PolicyStatus{Available: true} }},
		&riObjects{}, &riOutbox{}, &riAccounts{})
	if err != nil {
		t.Fatal(err)
	}
	return source
}

func riSnapshot(t *testing.T, source *runtimeInformationSource) runtimeinfo.Snapshot {
	t.Helper()
	snapshot, err := source.Snapshot(context.Background())
	if err != nil || snapshot.Validate() != nil {
		t.Fatal("snapshot rejected", err)
	}
	return snapshot
}

func riFault(t *testing.T, err error, code foundation.Code) {
	t.Helper()
	var fault *foundation.Fault
	if !errors.As(err, &fault) || fault.Code != code || fault.CommitState != foundation.NotStarted {
		t.Fatalf("wrong safe failure: %v", err)
	}
}

func TestRuntimeInformationRootPureObservationHistoryAndBoundaries(t *testing.T) {
	// All Add/Sub operations retain this actual monotonic component. Display
	// conversion truncates nanoseconds only after freshness has been decided.
	now := time.Now()
	for _, age := range []time.Duration{20*time.Second - time.Microsecond, 20 * time.Second, 20*time.Second + time.Nanosecond} {
		t.Run(age.String(), func(t *testing.T) {
			monitor := riMonitor(t, now)
			monitor.received, monitor.objectReceived = now.Add(-age), now.Add(-age)
			before := monitor.last
			snapshot := riSnapshot(t, riSource(t, monitor))
			want, readiness := runtimeinfo.Available, foundation.DependencyUnbound
			if age > 20*time.Second {
				want, readiness = runtimeinfo.Stale, foundation.DependencyUnavailable
			}
			if snapshot.Database.Status != want || snapshot.ObjectStorage.Status != want || snapshot.Readiness != readiness || snapshot.ObservedAt != riInstant(t, now) || snapshot.Database.LastSuccess.CheckedAt != before.CheckedAt || snapshot.Database.LastSuccess.ReceivedAt != riInstant(t, now.Add(-age)) {
				t.Fatal("freshness boundary or historical sample changed", snapshot)
			}
			if monitor.last != before || monitor.received != now.Add(-age) || monitor.objectReceived != now.Add(-age) || !monitor.available || !monitor.objectAvailable {
				t.Fatal("read mutated the cached sample")
			}
		})
	}
	monitor := riMonitor(t, now)
	source := riSource(t, monitor)
	original := riSnapshot(t, source)
	monitor.mu.Lock()
	monitor.available = false // Represent a published failure, not a new success.
	monitor.timing.now = func() time.Time { return now.Add(time.Hour) }
	monitor.mu.Unlock()
	failed := riSnapshot(t, source)
	if failed.Database.Status != runtimeinfo.Unavailable || failed.ObjectStorage.Status != runtimeinfo.Stale || failed.Readiness != foundation.DependencyUnavailable || failed.Database.LastSuccess != original.Database.LastSuccess || failed.ObjectStorage.LastSuccessReceivedAt != original.ObjectStorage.LastSuccessReceivedAt {
		t.Fatal("failure became stale-only, changed historical facts, or blamed Object")
	}
	monitor.mu.Lock()
	monitor.objectAvailable = false
	monitor.mu.Unlock()
	if got := riSnapshot(t, source); got.ObjectStorage.Status != runtimeinfo.Unavailable || got.ObjectStorage.LastSuccessReceivedAt != original.ObjectStorage.LastSuccessReceivedAt {
		t.Fatal("old object failure became only stale")
	}
	// A later successful writer publication supplies its own version/time.
	fresh := now.Add(time.Hour)
	monitor.mu.Lock()
	monitor.last.ServerVersion = "18.0"
	monitor.last.CheckedAt = riInstant(t, fresh.Add(-time.Second))
	monitor.received, monitor.objectReceived, monitor.outboxReceived, monitor.accountReceived = fresh, fresh, fresh, fresh
	monitor.available, monitor.objectAvailable = true, true
	monitor.mu.Unlock()
	recovered := riSnapshot(t, source)
	if recovered.Database.Status != runtimeinfo.Available || recovered.ObjectStorage.Status != runtimeinfo.Available || recovered.Readiness != foundation.DependencyUnbound || recovered.Database.LastSuccess.PostgreSQLVersion != "18.0" || recovered.Database.LastSuccess.ReceivedAt != riInstant(t, fresh) {
		t.Fatal("new successful publication did not restore current availability")
	}
	// Wall-clock display order is not an extra validity/freshness rule.
	monitor.mu.Lock()
	monitor.timing.now = func() time.Time { return now }
	monitor.mu.Unlock()
	if got := riSnapshot(t, source); got.Database.Status != runtimeinfo.Available || !got.ObservedAt.Time().Before(got.Database.LastSuccess.ReceivedAt.Time()) {
		t.Fatal("a wall-clock reversal was rejected or silently repaired")
	}
}

func TestRuntimeInformationRootPureCompletenessAndReadiness(t *testing.T) {
	now := time.Now()
	for _, component := range []string{"healthy", "database", "object", "outbox", "account", "secret", "outbound"} {
		t.Run(component, func(t *testing.T) {
			monitor := riMonitor(t, now)
			source := riSource(t, monitor)
			switch component {
			case "database":
				monitor.available = false
			case "object":
				monitor.objectAvailable = false
			case "outbox":
				monitor.outboxAvailable = false
			case "account":
				monitor.accountAvailable = false
			case "secret":
				source.secrets = &riSecrets{status: func() secret.Status { return secret.Status{Available: false} }}
			case "outbound":
				source.outbound = &riOutbound{status: func() outbound.PolicyStatus { return outbound.PolicyStatus{Available: false} }}
			}
			snapshot := riSnapshot(t, source)
			want := foundation.DependencyUnavailable
			if component == "healthy" {
				want = foundation.DependencyUnbound
			}
			if snapshot.Readiness != want {
				t.Fatal("wrong six-item readiness", component, snapshot.Readiness)
			}
			if component != "database" && snapshot.Database.Status != runtimeinfo.Available {
				t.Fatal("other failure changed DB fact")
			}
			if component != "object" && snapshot.ObjectStorage.Status != runtimeinfo.Available {
				t.Fatal("other failure changed Object fact")
			}
			for _, method := range []string{"GET", "HEAD"} {
				var logs bytes.Buffer
				w := httptest.NewRecorder()
				httpapi.Handler(slog.New(slog.NewJSONHandler(&logs, nil)), diagnosticRouter(monitor, true, source.secrets, source.outbound)).ServeHTTP(w, httptest.NewRequest(method, "http://localhost/readyz", nil))
				if w.Code != 503 || len(w.Header().Values("X-Request-ID")) != 1 {
					t.Fatal("ready response changed")
				}
				if method == "HEAD" {
					if w.Body.Len() != 0 {
						t.Fatal("ready HEAD gained a body")
					}
				} else if !strings.Contains(w.Body.String(), `"code":"`+string(want)+`"`) {
					t.Fatal("old ready predicate differs", w.Body.String())
				}
			}
		})
	}
	for _, component := range []string{"database", "object", "outbox", "account"} {
		t.Run(component+" stale", func(t *testing.T) {
			monitor := riMonitor(t, now)
			old := now.Add(-20*time.Second - time.Nanosecond)
			switch component {
			case "database":
				monitor.received = old
			case "object":
				monitor.objectReceived = old
			case "outbox":
				monitor.outboxReceived = old
			case "account":
				monitor.accountReceived = old
			}
			if riSnapshot(t, riSource(t, monitor)).Readiness != foundation.DependencyUnavailable {
				t.Fatal("stale base remained unbound-only")
			}
		})
	}
	invalid := map[string]func(*healthMonitor){
		"zero observed":         func(m *healthMonitor) { m.timing.now = func() time.Time { return time.Time{} } },
		"missing clock":         func(m *healthMonitor) { m.timing.now = nil },
		"zero checked":          func(m *healthMonitor) { m.last.CheckedAt = foundation.Instant{} },
		"zero DB received":      func(m *healthMonitor) { m.received = time.Time{} },
		"zero object received":  func(m *healthMonitor) { m.objectReceived = time.Time{} },
		"zero outbox received":  func(m *healthMonitor) { m.outboxReceived = time.Time{} },
		"zero account received": func(m *healthMonitor) { m.accountReceived = time.Time{} },
		"out of range received": func(m *healthMonitor) { m.received = time.Date(10000, 1, 1, 0, 0, 0, 0, time.UTC) },
		"PostgreSQL incomplete": func(m *healthMonitor) { m.last.PostgreSQL = false },
		"pgvector incomplete":   func(m *healthMonitor) { m.last.PGVector = false },
		"migrations incomplete": func(m *healthMonitor) { m.last.Migrations = false },
		"readwrite incomplete":  func(m *healthMonitor) { m.last.ReadWrite = false },
		"empty version":         func(m *healthMonitor) { m.last.ServerVersion = "" },
		"long version":          func(m *healthMonitor) { m.last.ExtensionVersion = strings.Repeat("v", 257) },
		"nonASCII version":      func(m *healthMonitor) { m.last.ServerVersion = "PostgreSQL\u00e9" },
		"control version":       func(m *healthMonitor) { m.last.ExtensionVersion = "0.8\n" },
		"account not bound":     func(m *healthMonitor) { m.accountBound = false },
	}
	for name, change := range invalid {
		t.Run(name, func(t *testing.T) {
			monitor := riMonitor(t, now)
			change(monitor)
			snapshot, err := riSource(t, monitor).Snapshot(context.Background())
			riFault(t, err, foundation.DependencyUnavailable)
			if snapshot != (runtimeinfo.Snapshot{}) {
				t.Fatal("invalid source published a partial value")
			}
		})
	}
	// Preserve the accepted partial diagnostic-test shape; it is not a valid
	// management source and must not acquire the latter's stricter validation.
	partial := riMonitor(t, now)
	partial.last.ServerVersion, partial.last.ExtensionVersion = "", ""
	partial.last.CheckedAt = foundation.Instant{}
	partial.accountBound = false
	source := riSource(t, partial)
	w := httptest.NewRecorder()
	diagnosticRouter(partial, true, source.secrets, source.outbound).ServeHTTP(w, httptest.NewRequest("GET", "http://localhost/readyz", nil))
	if w.Code != 503 || !strings.Contains(w.Body.String(), `"code":"DEPENDENCY_UNBOUND"`) {
		t.Fatal("strict management validation leaked into legacy ready predicate")
	}
}

func TestRuntimeInformationRootPureSingleCopyAndActualReturn(t *testing.T) {
	now := time.Now()
	monitor := riMonitor(t, now)
	var clocks, secrets, outboundCalls atomic.Int32
	monitor.timing.now = func() time.Time {
		if monitor.mu.TryLock() {
			monitor.mu.Unlock()
			t.Error("time sampled outside monitor read lock")
		}
		clocks.Add(1)
		return now
	}
	source := riSource(t, monitor)
	source.secrets = &riSecrets{status: func() secret.Status {
		if !monitor.mu.TryLock() {
			t.Error("secret status read while monitor lock held")
		} else {
			monitor.mu.Unlock()
		}
		secrets.Add(1)
		return secret.Status{Available: true}
	}}
	source.outbound = &riOutbound{status: func() outbound.PolicyStatus { outboundCalls.Add(1); return outbound.PolicyStatus{Available: true} }}
	riSnapshot(t, source)
	if clocks.Load() != 1 || secrets.Load() != 1 || outboundCalls.Load() != 1 {
		t.Fatal("one read used repeated observations")
	}
	// RLock is an owned synchronous call: cancellation cannot make a waiting
	// Snapshot appear returned while a writer still owns the actual mutex.
	ctx, cancel := context.WithCancel(context.Background())
	monitor.mu.Lock()
	locked := true
	entered, returned := make(chan struct{}), make(chan struct{})
	var got runtimeinfo.Snapshot
	var err error
	go func() { close(entered); got, err = source.Snapshot(ctx); close(returned) }()
	t.Cleanup(func() {
		cancel()
		if locked {
			monitor.mu.Unlock()
		}
		await(t, returned)
	})
	await(t, entered)
	select {
	case <-returned:
		t.Fatal("read escaped a held monitor lock")
	case <-time.After(15 * time.Millisecond):
	}
	cancel()
	select {
	case <-returned:
		t.Fatal("cancel confused with actual RLock return")
	case <-time.After(15 * time.Millisecond):
	}
	monitor.mu.Unlock()
	locked = false
	await(t, returned)
	riFault(t, err, foundation.DependencyUnavailable)
	if got != (runtimeinfo.Snapshot{}) || !errors.Is(err, context.Canceled) {
		t.Fatal("cancelled copy escaped as a candidate")
	}
	// A previously cancelled read does not take even the first observation.
	before := clocks.Load()
	if got, err := source.Snapshot(ctx); err == nil || got != (runtimeinfo.Snapshot{}) || clocks.Load() != before {
		t.Fatal("cancelled caller triggered another observation")
	}
}

func TestRuntimeInformationRootPureBoundDependencies(t *testing.T) {
	for _, missing := range []string{"monitor", "secret", "outbound", "object", "outbox", "account"} {
		for _, typed := range []bool{false, true} {
			name := missing
			if typed {
				name += " typed nil"
			}
			t.Run(name, func(t *testing.T) {
				monitor := riMonitor(t, time.Now())
				var secrets maintenance = &riSecrets{}
				var outboundService egress = &riOutbound{}
				var objects objectStorage = &riObjects{}
				var deliveries outboxStorage = &riOutbox{}
				var accounts accountStorage = &riAccounts{}
				switch missing {
				case "monitor":
					monitor = nil
				case "secret":
