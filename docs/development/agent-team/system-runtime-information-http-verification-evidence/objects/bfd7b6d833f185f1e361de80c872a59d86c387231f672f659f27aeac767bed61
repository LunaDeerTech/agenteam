func TestRuntimeInformationRootPureFactoryHandoffAndFailedStartup(t *testing.T) {
	t.Run("initialize returns the local factory", func(t *testing.T) {
		f := riStartup(t)
		owned := &resources{}
		var calls int
		var captured *runtimeInformationSource
		factory := runtimeInformationFactory(func(source runtimeinfo.Source) (http.Handler, error) {
			calls++
			captured = source.(*runtimeInformationSource)
			return http.NotFoundHandler(), nil
		})
		f.deps.bind = func(ctx context.Context, _ config.Config, db database, owner *resources, deps *dependencies) error {
			if db != f.db || owner != owned || !owner.addAccounts(ctx, f.accounts) {
				t.Fatal("lost startup owner")
			}
			deps.runtimeInformation = factory
			return nil
		}
		t.Cleanup(func() { cleanupResources(context.Background(), owned, nil); await(t, f.maintenanceReturned) })
		logger, _ := logging.New(logging.Central, slog.LevelInfo, io.Discard)
		initial := initialize(context.Background(), testConfig(t, "1s"), logger, f.deps, owned)
		if initial.err != nil || initial.runtimeInformation == nil || f.deps.runtimeInformation != nil || calls != 0 || f.listener.accepts.Load() != 0 || owned.listener() != f.listener {
			t.Fatal("factory was lost across value-copy initialize or ran before monitor", initial.err)
		}
		monitor := newHealthMonitor(initial.health, f.deps.health)
		monitor.received, monitor.objectReceived, monitor.outboxReceived, monitor.accountReceived = initial.sampled, initial.objectSampled, initial.outboxSampled, initial.accountSampled
		monitor.objectAvailable, monitor.outboxAvailable, monitor.accountAvailable, monitor.accountBound = initial.objectAvailable, initial.outboxAvailable, initial.accountAvailable, true
		handler, err := bindRuntimeInformation(initial.runtimeInformation, monitor, owned)
		if err != nil || handler == nil || calls != 1 || captured.monitor != monitor || captured.secrets != f.secrets || captured.outbound != f.outbound || f.secretStatuses.Load() != 0 {
			t.Fatal("post-monitor factory was not pure/once or captured different instances", err)
		}
		if monitor.received != f.times[0] || monitor.objectReceived != f.times[2] || monitor.accountReceived != f.times[3] || monitor.outboxReceived != f.times[4] {
			t.Fatal("startup sample age was renewed")
		}
		snapshot := riSnapshot(t, captured)
		if snapshot.Database.LastSuccess.ReceivedAt != riInstant(t, initial.sampled) || f.dbChecks.Load() != 1 || f.objects.checks.Load() != 1 || f.outboxChecks.Load() != 1 || f.accounts.checks.Load() != 1 {
			t.Fatal("reading launched another check or rewrote historical time")
		}
	})
	for _, failure := range []string{"missing factory", "factory error", "typed nil handler", "missing secret", "missing outbound", "missing object", "missing outbox", "missing account"} {
		t.Run(failure, func(t *testing.T) {
			f := riStartup(t)
			cause := errors.New("private-runtime-construction-canary")
			calls := 0
			var captured *runtimeInformationSource
			factory := runtimeInformationFactory(func(source runtimeinfo.Source) (http.Handler, error) {
				calls++
				captured = source.(*runtimeInformationSource)
				if failure == "typed nil handler" {
					return (*riTypedNilHandler)(nil), nil
				}
				return nil, foundation.NewFault(foundation.DependencyUnavailable, foundation.NotStarted).WithCause(cause)
			})
			f.deps.bind = func(ctx context.Context, _ config.Config, _ database, owner *resources, deps *dependencies) error {
				if failure != "missing account" && !owner.addAccounts(ctx, f.accounts) {
					return context.Canceled
				}
				if failure != "missing factory" {
					deps.runtimeInformation = factory
				}
				return nil
			}
			switch failure {
			case "missing secret":
				f.deps.secret = func(context.Context, config.Config, database, *audit.Service) (maintenance, error) { return nil, nil }
			case "missing outbound":
				f.deps.outbound = func(context.Context, config.Config, database, *audit.Service) (egress, error) { return nil, nil }
			case "missing object":
				f.deps.objects = func(context.Context, config.Config, database, *audit.Service) (objectStorage, error) { return nil, nil }
			case "missing outbox":
				f.deps.outbox = func(config.Config, database, *audit.Service, objectStorage) (outboxStorage, error) { return nil, nil }
			}
			logs := newEventLog()
			logger, _ := logging.New(logging.Central, slog.LevelInfo, logs)
			err := run(context.Background(), testConfig(t, "1s"), logger, nil, f.deps)
			if failure != "missing secret" {
				await(t, f.maintenanceReturned)
			}
			if lifecycle.CodeOf(err) != lifecycle.InitializationFailed || f.listener.closed.Load() != 1 || f.listener.accepts.Load() != 0 || f.dbClosed.Load() != 1 || f.dbChecks.Load() != 1 {
				t.Fatal("post-binding error escaped the original startup cleanup or started serving/health", err)
			}
			if strings.Contains(logs.String(), "canary") || strings.Contains(logs.String(), `"phase":"diagnostic_serving"`) || strings.Contains(logs.String(), `"event":"listening"`) {
				t.Fatal("failed binding served or leaked its cause")
			}
			wantCalls := 0
			if failure == "factory error" || failure == "typed nil handler" {
				wantCalls = 1
			}
			if calls != wantCalls || f.secretStatuses.Load() != 0 {
				t.Fatal("pure construction observed/probed or called factory incorrectly")
			}
			if wantCalls == 1 {
				m := captured.monitor
				if m.received != f.times[0] || m.objectReceived != f.times[2] || m.accountReceived != f.times[3] || m.outboxReceived != f.times[4] || !m.accountBound || captured.secrets != f.secrets || captured.outbound != f.outbound {
					t.Fatal("run renewed samples or replaced original providers")
				}
			}
			if failure == "factory error" && !errors.Is(err, cause) {
				t.Fatal("typed failure lost internal cause")
			}
			if failure != "missing object" && (f.objects.starts.Load() != 1 || f.objects.checks.Load() != 1 || f.objects.forces.Load() != 1) {
				t.Fatal("controlled object owner was skipped or checked again")
			}
			if failure != "missing outbox" && (f.outboxChecks.Load() != 1 || !f.outbox.Joined()) {
				t.Fatal("controlled outbox cleanup not joined")
			}
			if failure != "missing account" && (f.accounts.starts.Load() != 1 || f.accounts.checks.Load() != 1 || f.accounts.forces.Load() != 1 || !f.accounts.Joined()) {
				t.Fatal("controlled account owner not joined")
			}
		})
	}
}

