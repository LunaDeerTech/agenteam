func TestRuntimeInformationRootPureConcurrentWholeObservation(t *testing.T) {
	now := time.Now()
	monitor := riMonitor(t, now)
	monitor.last.ServerVersion, monitor.last.ExtensionVersion = "frame A", "frame A"
	source := riSource(t, monitor)
	start := make(chan struct{})
	var joined sync.WaitGroup
	joined.Add(9)
	go func() {
		defer joined.Done()
		<-start
		for i := range 1000 {
			label, received := "frame A", now.Add(-time.Second)
			if i%2 != 0 {
				label, received = "frame B", now.Add(-2*time.Second)
			}
			monitor.mu.Lock()
			monitor.last.ServerVersion, monitor.last.ExtensionVersion = label, label
			monitor.received, monitor.objectReceived = received, received
			monitor.outboxReceived, monitor.accountReceived = received, received
			monitor.mu.Unlock()
		}
	}()
	for range 8 {
		go func() {
			defer joined.Done()
			<-start
			for range 100 {
				value, err := source.Snapshot(context.Background())
				if err != nil || value.Database.LastSuccess.PostgreSQLVersion != value.Database.LastSuccess.PGVectorVersion || value.Database.LastSuccess.ReceivedAt != value.ObjectStorage.LastSuccessReceivedAt || value.Readiness != foundation.DependencyUnbound {
					t.Error("one observation mixed independently published monitor frames")
					return
				}
			}
		}()
	}
	close(start)
	joined.Wait()
}

// This listener is an ownership witness only. It never opens a socket, and
// Accept must not be reached by a failed post-initialization constructor.
type riOwnedListener struct {
	closed  atomic.Int32
	accepts atomic.Int32
}

func (l *riOwnedListener) Accept() (net.Conn, error) {
	l.accepts.Add(1)
	return nil, errors.New("unexpected controlled Accept")
}
func (l *riOwnedListener) Close() error   { l.closed.Add(1); return nil }
func (l *riOwnedListener) Addr() net.Addr { return &net.TCPAddr{} }

type riStartupAccounts struct {
	checks, starts, forces atomic.Int32
	stopped                atomic.Bool
}

func (a *riStartupAccounts) Start(context.Context) error { a.starts.Add(1); return nil }
func (a *riStartupAccounts) Check(context.Context) error { a.checks.Add(1); return nil }
func (a *riStartupAccounts) StopAdmission()              { a.stopped.Store(true) }
func (a *riStartupAccounts) Drain(context.Context) error { a.StopAdmission(); return nil }
func (a *riStartupAccounts) Force(context.Context) error {
	a.forces.Add(1)
	a.StopAdmission()
	return nil
}
func (a *riStartupAccounts) Joined() bool        { return a.stopped.Load() }
func (*riStartupAccounts) Handler() http.Handler { return http.NotFoundHandler() }

type riStartupObjects struct {
	checks, starts, forces atomic.Int32
	stopped                atomic.Bool
}

func (o *riStartupObjects) StartMaintenance(context.Context) error { o.starts.Add(1); return nil }
func (o *riStartupObjects) Check(context.Context) error            { o.checks.Add(1); return nil }
func (o *riStartupObjects) StopAdmission()                         { o.stopped.Store(true) }
func (o *riStartupObjects) Drain(context.Context) error            { o.StopAdmission(); return nil }
func (o *riStartupObjects) Force(context.Context) error {
	o.forces.Add(1)
	o.StopAdmission()
	return nil
}

