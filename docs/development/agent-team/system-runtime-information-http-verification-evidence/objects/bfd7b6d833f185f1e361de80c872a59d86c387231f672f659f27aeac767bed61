func TestRuntimeInformationRootPureRoutesAndFormalBoundary(t *testing.T) {
	store, authority, core := riConstructionCore(t)
	source := riSource(t, riMonitor(t, time.Now()))
	handler, err := runtimeInformationHandlerFactory(store, authority, core, "http://localhost:8080")(source)
	if err != nil {
		t.Fatal(err)
	}
	for _, tc := range []struct {
		path, raw, method, origin, host string
		status                          int
		code                            string
	}{
		{runtimeInformationPath, "", "GET", "", "", 401, "UNAUTHENTICATED"},
		{runtimeInformationPath, "", "POST", "", "", 405, "METHOD_NOT_ALLOWED"},
		{runtimeInformationPath, "", "HEAD", "", "", 405, "METHOD_NOT_ALLOWED"},
		{runtimeInformationPath + "/", "", "GET", "", "", 400, "INVALID_ARGUMENT"},
		{runtimeInformationPath + "//child", "", "GET", "", "", 400, "INVALID_ARGUMENT"},
		{runtimeInformationPath + "/../session", "", "GET", "", "", 400, "INVALID_ARGUMENT"},
		{runtimeInformationPath + "/child", runtimeInformationPath + "%2fchild", "GET", "", "", 400, "INVALID_ARGUMENT"},
		{runtimeInformationPath + "/child", "", "GET", "", "", 404, "NOT_FOUND"},
		{runtimeInformationPath + "/", "", "GET", "http://other.invalid", "", 403, "ORIGIN_DENIED"},
		{runtimeInformationPath + "/", "", "GET", "", "other.invalid", 403, "ORIGIN_DENIED"},
	} {
		t.Run(tc.method+tc.path+tc.raw+tc.origin+tc.host, func(t *testing.T) {
			r := httptest.NewRequest(tc.method, "http://localhost:8080"+tc.path, nil)
			r.URL.RawPath = tc.raw
			if tc.origin != "" {
				r.Header.Set("Origin", tc.origin)
			}
			if tc.host != "" {
				r.Host = tc.host
			}
			url, original, originalHost := r.URL, *r.URL, r.Host
			var logs bytes.Buffer
			w := &riBudgetWriter{httptest.NewRecorder()}
			httpapi.Handler(slog.New(slog.NewJSONHandler(&logs, nil)), systemRuntimeInformationRoutes(http.NotFoundHandler(), handler)).ServeHTTP(w, r)
			if w.Code != tc.status || r.URL != url || *r.URL != original || r.Host != originalHost || w.Header().Get("Location") != "" || len(w.Header().Values("X-Request-ID")) != 1 || strings.Count(logs.String(), `"event":"http_request"`) != 1 {
				t.Fatal("root boundary/routing contract changed", w.Code, w.Body.String())
			}
			if tc.status == 405 && w.Header().Get("Allow") != "GET" {
				t.Fatal("wrong method set")
			}
			if tc.method == "HEAD" {
				if w.Body.Len() != 0 {
					t.Fatal("HEAD error body")
				}
			} else if !strings.Contains(w.Body.String(), `"code":"`+tc.code+`"`) {
				t.Fatal("wrong exact boundary error", w.Body.String())
			}
		})
	}
	for _, tc := range []struct{ path, owner string }{
		{runtimeInformationPath, "runtime"}, {runtimeInformationPath + "/child", "runtime"},
		{runtimeInformationPath + "x", "account"}, {runtimeInformationPath + "-other", "account"},
		{"/api/v1/session", "account"}, {"/api/v1/me", "account"}, {"/api/v1/system/smtp-settings", "account"}, {"/api/v1/system/mail-jobs", "account"},
		{"/api/v1/system/model-providers", "model"}, {"/api/v1/system/models/child", "model"}, {"/api/v1/system/model-selection", "model"},
		{"/api/v1/system/outbound-policy", "outbound"}, {"/api/v1/system/audit", "audit"},
	} {
		t.Run("dispatch "+tc.path, func(t *testing.T) {
			r := httptest.NewRequest("PATCH", "http://localhost:8080"+tc.path+"?private=query-canary", strings.NewReader("body-canary"))
			body, url, header := r.Body, r.URL, r.Header
			r.Header.Set("Cookie", "cookie-canary")
			type key struct{}
			r = r.WithContext(context.WithValue(r.Context(), key{}, "context-canary"))
			calls := 0
			child := func(owner string) http.Handler {
				return http.HandlerFunc(func(w http.ResponseWriter, got *http.Request) {
					calls++
					if owner != tc.owner || got.URL != url || got.Body != body || !reflect.DeepEqual(got.Header, header) || got.Context().Value(key{}) != "context-canary" || got.Host != "localhost:8080" || got.Method != "PATCH" || httpapi.RequestID(got.Context()).Validate() != nil {
						t.Error("dispatch changed request identity/material")
					}
					data, err := io.ReadAll(got.Body)
					if err != nil || string(data) != "body-canary" {
						t.Error("body was consumed before owner")
					}
					w.WriteHeader(204)
				})
			}
			chain := systemRuntimeInformationRoutes(systemAuditRoutes(systemOutboundPolicyRoutes(systemModelRoutes(child("account"), child("model")), child("outbound")), child("audit")), child("runtime"))
			var logs bytes.Buffer
			w := httptest.NewRecorder()
			httpapi.Handler(slog.New(slog.NewJSONHandler(&logs, nil)), chain).ServeHTTP(w, r)
			if calls != 1 || w.Code != 204 || len(w.Header().Values("X-Request-ID")) != 1 || strings.Count(logs.String(), `"event":"http_request"`) != 1 {
				t.Fatal("more than one owner or middleware")
			}
			for _, private := range []string{"query-canary", "body-canary", "cookie-canary", "context-canary"} {
				if strings.Contains(logs.String(), private) {
					t.Fatal("ordinary log disclosed request input")
				}
			}
		})
	}
}

func TestRuntimeInformationRootPureSameInstanceConstructionGraph(t *testing.T) {
	file, err := parser.ParseFile(token.NewFileSet(), "account.go", nil, 0)
	if err != nil {
		t.Fatal(err)
	}
	is := func(expr ast.Expr, name string) bool { id, ok := expr.(*ast.Ident); return ok && id.Name == name }
	var bind *ast.FuncDecl
	for _, decl := range file.Decls {
		if f, ok := decl.(*ast.FuncDecl); ok && f.Name.Name == "bindAccounts" {
			bind = f
		}
	}
	if bind == nil {
		t.Fatal("missing real Account assembly")
	}
	assertions, captures := 0, 0
	ast.Inspect(bind, func(node ast.Node) bool {
		if cast, ok := node.(*ast.TypeAssertExpr); ok {
			if name, ok := cast.Type.(*ast.SelectorExpr); ok && is(name.X, "runtimeinfo") && name.Sel.Name == "Store" {
				assertions++
				if !is(cast.X, "db") {
					t.Error("runtime read uses a different Store")
				}
			}
		}
		if call, ok := node.(*ast.CallExpr); ok && is(call.Fun, "runtimeInformationHandlerFactory") {
			captures++
			if len(call.Args) != 4 || !is(call.Args[0], "runtimeStore") || !is(call.Args[1], "authority") || !is(call.Args[2], "core") {
				t.Error("runtime factory replaced the Account identity providers")
			}
		}
		return true
	})
	if assertions != 1 || captures != 1 {
		t.Fatal("missing/duplicate pure runtime capture", assertions, captures)
	}
	// This static identity binding is not real Account authentication evidence.
	// Concrete constructor behavior and route boundary are exercised above;
	// actual authenticated root behavior belongs to the separate resource group.
}

func TestRuntimeInformationRootPureLegacyDiagnosticsRemainSeparate(t *testing.T) {
	monitor := riMonitor(t, time.Now())
	source := riSource(t, monitor)
	router := diagnosticRouter(monitor, true, source.secrets, source.outbound)
	for _, method := range []string{"GET", "HEAD"} {
		for _, path := range []string{"/livez", "/diagnostics"} {
			w := httptest.NewRecorder()
			router.ServeHTTP(w, httptest.NewRequest(method, "http://localhost"+path, nil))
			if w.Code != 200 {
				t.Fatal("legacy diagnostic status changed")
			}
			if method == "HEAD" {
				if w.Body.Len() != 0 {
					t.Fatal("legacy HEAD changed")
				}
				continue
			}
			if path == "/livez" {
				if w.Body.String() != `{"status":"alive"}` {
					t.Fatal("liveness changed")
				}
				continue
			}
			var value diagnostics
			if json.Unmarshal(w.Body.Bytes(), &value) != nil || value.Ready || value.Database == nil || value.Database.ServerVersion != monitor.last.ServerVersion || value.Secret == nil || value.Outbound == nil || len(value.Capabilities) != 20 {
				t.Fatal("legacy diagnostic DTO changed")
			}
			if strings.Contains(w.Body.String(), "build_version_not_recorded") {
				t.Fatal("management DTO replaced diagnostics")
			}
		}
	}
}
