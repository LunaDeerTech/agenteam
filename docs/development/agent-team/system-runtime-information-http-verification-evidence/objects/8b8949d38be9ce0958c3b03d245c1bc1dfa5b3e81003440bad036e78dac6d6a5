+const runtimeHTTPPath = "/api/v1/system/runtime-information"
+
+type runtimeHTTPTrace struct {
+	locks                        []foundation.LockRequest
+	sessions, authority, sources int
+	state                        foundation.CommitState
+}
+
+type runtimeHTTPTxKey struct{}
+
+// The observer delegates every operation and terminal to the actual PG Store.
+// Its Source is intentionally an in-memory collaborator, not a health probe.
+type runtimeHTTPStore struct {
+	*postgres.Store
+	mu                  sync.Mutex
+	reads               map[foundation.Tx]*runtimeHTTPTrace
+	before, after, tail func(context.Context, foundation.Tx) error
+	active              atomic.Int32
+	last                foundation.CommitResult
+}
+
+func (s *runtimeHTTPStore) WithinTx(ctx context.Context, cause foundation.TransactionCause, fn func(context.Context, foundation.Tx) error) foundation.CommitResult {
+	if cause.Details().Owner != "runtimeinfo.system-read" {
+		return s.Store.WithinTx(ctx, cause, fn)
+	}
+	s.active.Add(1)
+	defer s.active.Add(-1)
+	trace := &runtimeHTTPTrace{}
+	result := s.Store.WithinTx(ctx, cause, func(ctx context.Context, tx foundation.Tx) error {
+		s.mu.Lock()
+		s.reads[tx] = trace
+		s.mu.Unlock()
+		err := fn(context.WithValue(ctx, runtimeHTTPTxKey{}, tx), tx)
+		s.mu.Lock()
+		tail := s.tail
+		s.mu.Unlock()
+		if err == nil && tail != nil {
+			return tail(ctx, tx)
+		}
+		return err
+	})
+	s.mu.Lock()
+	trace.state, s.last = result.State(), result
+	s.mu.Unlock()
+	return result
+}
+
+func (s *runtimeHTTPStore) Acquire(ctx context.Context, tx foundation.Tx, key foundation.LockKey, mode foundation.LockMode) error {
+	s.mu.Lock()
+	trace := s.reads[tx]
+	before, after := s.before, s.after
+	if trace != nil {
+		trace.locks = append(trace.locks, foundation.LockRequest{Key: key, Mode: mode})
+	}
+	s.mu.Unlock()
+	if trace == nil {
+		return errors.New("runtime read lock outside owned transaction")
+	}
+	if before != nil {
+		if err := before(ctx, tx); err != nil {
+			return err
+		}
+	}
+	if err := s.Store.Acquire(ctx, tx, key, mode); err != nil {
+		return err
+	}
+	if after != nil {
+		return after(ctx, tx)
+	}
+	return nil
+}
+
+func (s *runtimeHTTPStore) hooks(before, after, tail func(context.Context, foundation.Tx) error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.before, s.after, s.tail = before, after, tail
+}
+
+func (s *runtimeHTTPStore) sourceCount() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	count := 0
+	for _, trace := range s.reads {
+		count += trace.sources
+	}
+	return count
+}
+
+type runtimeHTTPAuthority struct {
+	*account.Authority
+	store *runtimeHTTPStore
+}
+
+func (a runtimeHTTPAuthority) RequireCurrentSession(ctx context.Context, tx foundation.Tx, actor identity.Actor) error {
+	key, err := foundation.UserLock(actor.Details().UserID)
+	if err != nil {
+		return err
+	}
+	a.store.mu.Lock()
+	trace := a.store.reads[tx]
+	valid := tx.Valid() && trace != nil && len(trace.locks) == 1 && trace.locks[0].Mode == foundation.Shared && foundation.CompareLockKeys(trace.locks[0].Key, key) == 0
+	if valid {
+		trace.sessions++
+	}
+	a.store.mu.Unlock()
+	if !valid {
+		return errors.New("runtime Session not in same User SH transaction")
+	}
+	if err = a.store.Store.RequireHeldLocks(ctx, tx, []foundation.LockRequest{{Key: key, Mode: foundation.Shared}}); err != nil {
+		return err
+	}
+	return a.Authority.RequireCurrentSession(ctx, tx, actor)
+}
+
+func (a runtimeHTTPAuthority) AuthorizeSystem(ctx context.Context, tx foundation.Tx, actor identity.Actor, intent identity.AccessIntent) (identity.AccessGrant, error) {
+	a.store.mu.Lock()
+	trace := a.store.reads[tx]
+	valid := trace != nil && trace.sessions == 1 && intent == identity.Read
+	if valid {
+		trace.authority++
+	}
+	a.store.mu.Unlock()
+	if !valid {
+		return identity.AccessGrant{}, errors.New("runtime current authority has wrong transaction or order")
+	}
+	return a.Authority.AuthorizeSystem(ctx, tx, actor, intent)
+}
+
+type runtimeHTTPSource struct {
+	store *runtimeHTTPStore
+	value runtimeinfo.Snapshot
+}
+
+func (s runtimeHTTPSource) Snapshot(ctx context.Context) (runtimeinfo.Snapshot, error) {
+	tx, ok := ctx.Value(runtimeHTTPTxKey{}).(foundation.Tx)
+	s.store.mu.Lock()
+	trace := s.store.reads[tx]
+	valid := ok && tx.Valid() && trace != nil && trace.sessions == 1 && trace.authority == 1 && trace.sources == 0
+	if valid {
+		trace.sources++
+	}
+	s.store.mu.Unlock()
+	if !valid {
+		return runtimeinfo.Snapshot{}, errors.New("runtime Source preceded same-transaction current authority")
+	}
+	return s.value, ctx.Err()
+}
