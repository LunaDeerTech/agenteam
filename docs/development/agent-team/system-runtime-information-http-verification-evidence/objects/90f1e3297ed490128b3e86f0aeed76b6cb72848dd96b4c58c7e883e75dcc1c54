const runtimeHTTPPath = "/api/v1/system/runtime-information"

type runtimeHTTPTrace struct {
	locks                        []foundation.LockRequest
	sessions, authority, sources int
	state                        foundation.CommitState
}

type runtimeHTTPTxKey struct{}

// The observer delegates every operation and terminal to the actual PG Store.
// Its Source is intentionally an in-memory collaborator, not a health probe.
type runtimeHTTPStore struct {
	*postgres.Store
	mu                  sync.Mutex
	reads               map[foundation.Tx]*runtimeHTTPTrace
	before, after, tail func(context.Context, foundation.Tx) error
	active              atomic.Int32
	last                foundation.CommitResult
}

func (s *runtimeHTTPStore) WithinTx(ctx context.Context, cause foundation.TransactionCause, fn func(context.Context, foundation.Tx) error) foundation.CommitResult {
	if cause.Details().Owner != "runtimeinfo.system-read" {
		return s.Store.WithinTx(ctx, cause, fn)
	}
	s.active.Add(1)
	defer s.active.Add(-1)
	trace := &runtimeHTTPTrace{}
	result := s.Store.WithinTx(ctx, cause, func(ctx context.Context, tx foundation.Tx) error {
		s.mu.Lock()
		s.reads[tx] = trace
		s.mu.Unlock()
		err := fn(context.WithValue(ctx, runtimeHTTPTxKey{}, tx), tx)
		s.mu.Lock()
		tail := s.tail
		s.mu.Unlock()
		if err == nil && tail != nil {
			return tail(ctx, tx)
		}
		return err
	})
	s.mu.Lock()
	trace.state, s.last = result.State(), result
	s.mu.Unlock()
	return result
}

func (s *runtimeHTTPStore) Acquire(ctx context.Context, tx foundation.Tx, key foundation.LockKey, mode foundation.LockMode) error {
	s.mu.Lock()
	trace := s.reads[tx]
	before, after := s.before, s.after
	if trace != nil {
		trace.locks = append(trace.locks, foundation.LockRequest{Key: key, Mode: mode})
	}
	s.mu.Unlock()
	if trace == nil {
		return errors.New("runtime read lock outside owned transaction")
	}
	if before != nil {
		if err := before(ctx, tx); err != nil {
			return err
		}
	}
	if err := s.Store.Acquire(ctx, tx, key, mode); err != nil {
		return err
	}
	if after != nil {
		return after(ctx, tx)
	}
	return nil
}

func (s *runtimeHTTPStore) hooks(before, after, tail func(context.Context, foundation.Tx) error) {
	s.mu.Lock()
	defer s.mu.Unlock()
	s.before, s.after, s.tail = before, after, tail
}

func (s *runtimeHTTPStore) sourceCount() int {
	s.mu.Lock()
	defer s.mu.Unlock()
	count := 0
	for _, trace := range s.reads {
		count += trace.sources
	}
	return count
}

type runtimeHTTPAuthority struct {
	*account.Authority
	store *runtimeHTTPStore
}

func (a runtimeHTTPAuthority) RequireCurrentSession(ctx context.Context, tx foundation.Tx, actor identity.Actor) error {
	key, err := foundation.UserLock(actor.Details().UserID)
	if err != nil {
		return err
	}
	a.store.mu.Lock()
	trace := a.store.reads[tx]
	valid := tx.Valid() && trace != nil && len(trace.locks) == 1 && trace.locks[0].Mode == foundation.Shared && foundation.CompareLockKeys(trace.locks[0].Key, key) == 0
	if valid {
		trace.sessions++
	}
	a.store.mu.Unlock()
	if !valid {
		return errors.New("runtime Session not in same User SH transaction")
	}
	if err = a.store.Store.RequireHeldLocks(ctx, tx, []foundation.LockRequest{{Key: key, Mode: foundation.Shared}}); err != nil {
		return err
	}
	return a.Authority.RequireCurrentSession(ctx, tx, actor)
}

func (a runtimeHTTPAuthority) AuthorizeSystem(ctx context.Context, tx foundation.Tx, actor identity.Actor, intent identity.AccessIntent) (identity.AccessGrant, error) {
	a.store.mu.Lock()
	trace := a.store.reads[tx]
	valid := trace != nil && trace.sessions == 1 && intent == identity.Read
	if valid {
		trace.authority++
	}
	a.store.mu.Unlock()
	if !valid {
		return identity.AccessGrant{}, errors.New("runtime current authority has wrong transaction or order")
	}
	return a.Authority.AuthorizeSystem(ctx, tx, actor, intent)
}

type runtimeHTTPSource struct {
	store *runtimeHTTPStore
	value runtimeinfo.Snapshot
}

func (s runtimeHTTPSource) Snapshot(ctx context.Context) (runtimeinfo.Snapshot, error) {
	tx, ok := ctx.Value(runtimeHTTPTxKey{}).(foundation.Tx)
	s.store.mu.Lock()
	trace := s.store.reads[tx]
	valid := ok && tx.Valid() && trace != nil && trace.sessions == 1 && trace.authority == 1 && trace.sources == 0
	if valid {
		trace.sources++
	}
	s.store.mu.Unlock()
	if !valid {
		return runtimeinfo.Snapshot{}, errors.New("runtime Source preceded same-transaction current authority")
	}
	return s.value, ctx.Err()
}

func TestSystemRuntimeInformationCurrentAuthorityAndTerminal(t *testing.T) {
	started := time.Now()
	b02 := newB02Account(t)
	f := b02.fixture
	password := f.bootstrap(t)
	store := &runtimeHTTPStore{Store: f.store, reads: map[foundation.Tx]*runtimeHTTPTrace{}}
	authority := runtimeHTTPAuthority{f.authority, store}
	instant, err := foundation.NewInstant(time.Now())
	if err != nil {
		t.Fatal(err)
	}
	value := runtimeinfo.Snapshot{
		ObservedAt: instant,
		Database: runtimeinfo.DatabaseSnapshot{Status: runtimeinfo.Available, LastSuccess: runtimeinfo.DatabaseSuccess{
			CheckedAt: instant, ReceivedAt: instant, PostgreSQLVersion: "controlled source PG", PGVectorVersion: "controlled source vector",
		}},
		ObjectStorage: runtimeinfo.ObjectStorageSnapshot{Status: runtimeinfo.Available, LastSuccessReceivedAt: instant},
		Readiness: foundation.DependencyUnbound,
	}
	service, err := runtimeinfo.New(store, authority, authority, runtimeHTTPSource{store, value})
	if err != nil {
		t.Fatal(err)
	}
	handler, err := runtimehttp.NewSystemHTTPHandler(service, f.service, runtimehttp.SystemHTTPOptions{PublicOrigin: httpOrigin})
	if err != nil {
		t.Fatal(err)
	}
	handler = httpapi.Handler(nil, handler)
	login := func(t *testing.T, password sc.SecretMaterial, email string) (identity.Actor, string) {
		t.Helper()
		req, _ := loginRequest(t, f, password, email)
		response, err := f.service.Login(ctxFor(t), req)
		if err != nil {
			t.Fatal("formal login failed", safeFailure(err))
		}
		cookie := useCookie(t, response)
		if err = response.Close(ctxFor(t)); err != nil {
			t.Fatal(err)
		}
		actor, err := f.service.Authenticate(ctxFor(t), cookie)
		if err != nil {
			t.Fatal(err)
		}
		var raw string
		if err = cookie.Use(func(b []byte) error { raw = string(b); return nil }); err != nil {
			t.Fatal(err)
		}
		return actor, raw
	}
	request := func(t *testing.T, ctx context.Context, cookie string) *http.Request {
		t.Helper()
		r, err := http.NewRequestWithContext(ctx, http.MethodGet, httpOrigin+runtimeHTTPPath, nil)
		if err != nil {
			t.Fatal(err)
		}
		r.Header.Set("Origin", httpOrigin)
		if cookie != "" {
			r.AddCookie(&http.Cookie{Name: "agenteam_local_session", Value: cookie})
		}
		return r
	}
	gate := func() (<-chan struct{}, func()) {
		release := make(chan struct{})
		var once sync.Once
		return release, func() { once.Do(func() { close(release) }) }
	}
	wait := func(t *testing.T, entered <-chan struct{}) {
		t.Helper()
		select {
		case <-entered:
		case <-time.After(time.Second):
			t.Fatal("runtime read barrier not reached")
		}
	}
	zero := func(t *testing.T, got outboundHTTPCall, before int) {
		t.Helper()
		if bytes.Contains(got.response.data, []byte(`"observed_at"`)) || store.sourceCount() != before || store.active.Load() != 0 {
			t.Fatal("rejected read exposed a candidate, called Source, or returned before terminal")
		}
	}
	t.Run("formal_invited_user_and_anonymous_rejected", func(t *testing.T) {
		admin, _ := login(t, password, "admin@mail.com")
		_, userPassword := invitedMailUser(t, b02, admin, "runtime-member@example.test")
		_, memberCookie := login(t, userPassword, "runtime-member@example.test")
		for _, tc := range []struct { cookie string; status int; code string }{{"", 401, "UNAUTHENTICATED"}, {memberCookie, 403, "FORBIDDEN"}} {
			before := store.sourceCount()
			got := outboundHTTPJoin(t, outboundHTTPStart(t, handler, request(t, ctxFor(t), tc.cookie)))
			if got.aborted { t.Fatal("live authority denial aborted") }
			got.response.problem(t, tc.status, tc.code)
			zero(t, got, before)
		}
	})
	t.Run("preauthenticated_then_formally_revoked", func(t *testing.T) {
		actor, cookie := login(t, password, "admin@mail.com")
		before := store.sourceCount()
		entered := make(chan struct{})
		release, finish := gate()
		defer finish()
		store.hooks(func(ctx context.Context, _ foundation.Tx) error {
			close(entered)
			select { case <-release: return nil; case <-ctx.Done(): return ctx.Err() }
		}, nil, nil)
		defer store.hooks(nil, nil, nil)
		done := outboundHTTPStart(t, handler, request(t, ctxFor(t), cookie))
		wait(t, entered)
		if err := f.service.Logout(ctxFor(t), account.LogoutRequest{Actor: actor, Key: foundation.IdempotencyKey(id[struct{}](t).String())}); err != nil { t.Fatal("formal Logout", err) }
		finish()
		got := outboundHTTPJoin(t, done)
		if got.aborted { t.Fatal("live revoked request aborted") }
		got.response.problem(t, 401, "SESSION_REVOKED")
		zero(t, got, before)
	})
	t.Run("held_shared_serializes_logout_until_actual_terminal", func(t *testing.T) {
		actor, cookie := login(t, password, "admin@mail.com")
		entered := make(chan uint32, 1)
		release, finish := gate()
		defer finish()
		store.hooks(nil, func(ctx context.Context, tx foundation.Tx) error {
			key, _ := foundation.UserLock(actor.Details().UserID)
			if err := f.store.RequireHeldLocks(ctx, tx, []foundation.LockRequest{{Key: key, Mode: foundation.Shared}}); err != nil { return err }
			executor, err := f.store.InTx(tx)
			if err != nil { return err }
			var pid uint32
			if err = executor.QueryRow(ctx, `SELECT pg_backend_pid()`).Scan(&pid); err != nil { return err }
			entered <- pid
			select { case <-release: return nil; case <-ctx.Done(): return ctx.Err() }
		}, nil)
		defer store.hooks(nil, nil, nil)
		done := outboundHTTPStart(t, handler, request(t, ctxFor(t), cookie))
		var pid uint32
		select { case pid = <-entered: case <-time.After(time.Second): t.Fatal("User SH not observed") }
		revokeCtx, cancel := context.WithCancel(ctxFor(t))
		revoked, joined := make(chan error, 1), make(chan struct{})
		revoke := account.LogoutRequest{Actor: actor, Key: foundation.IdempotencyKey(id[struct{}](t).String())}
		t.Cleanup(func() {
			cancel(); finish()
			select { case <-joined: case <-time.After(2*time.Second): t.Error("formal Logout did not actually join") }
		})
		go func() { defer close(joined); revoked <- f.service.Logout(revokeCtx, revoke) }()
		outboundHTTPWaitBlocked(t, f.store, pid)
		select { case <-revoked: t.Fatal("Logout passed held User SH"); default: }
		finish()
		got := outboundHTTPJoin(t, done)
		got.response.want(t, 200)
		store.mu.Lock(); state := store.last.State(); store.mu.Unlock()
		if got.aborted || state != foundation.Committed || store.active.Load() != 0 { t.Fatal("successful read lacked actual committed terminal") }
		select { case err := <-revoked: if err != nil { t.Fatal(err) }; case <-time.After(2*time.Second): t.Fatal("Logout did not complete after read") }
		<-joined
		cancel()
		store.hooks(nil, nil, nil)
		before := store.sourceCount()
		next := outboundHTTPJoin(t, outboundHTTPStart(t, handler, request(t, ctxFor(t), cookie)))
		next.response.problem(t, 401, "SESSION_REVOKED")
		zero(t, next, before)
	})
	t.Run("complete_candidate_waits_for_real_transaction_terminal", func(t *testing.T) {
		_, cookie := login(t, password, "admin@mail.com")
		entered := make(chan struct{})
		release, finish := gate()
		defer finish()
		store.hooks(nil, nil, func(ctx context.Context, tx foundation.Tx) error {
			store.mu.Lock(); trace := store.reads[tx]; valid := trace != nil && trace.sources == 1; store.mu.Unlock()
			if !valid { return errors.New("terminal barrier precedes complete Source") }
			close(entered)
			select { case <-release: return nil; case <-ctx.Done(): return ctx.Err() }
		})
		defer store.hooks(nil, nil, nil)
		done := outboundHTTPStart(t, handler, request(t, ctxFor(t), cookie))
		wait(t, entered)
		if store.active.Load() != 1 { t.Fatal("real transaction no longer owned") }
		select { case <-done: t.Fatal("candidate returned before actual transaction terminal"); default: }
		finish()
		got := outboundHTTPJoin(t, done)
		got.response.want(t, 200)
		store.mu.Lock(); state := store.last.State(); store.mu.Unlock()
		if got.aborted || state != foundation.Committed || store.active.Load() != 0 { t.Fatal("actual committed terminal missing") }
		if object := got.response.object(t); len(object) != 5 || object["observed_at"] != instant.String() { t.Fatal("controlled Source projection missing") }
	})
	if f.db.Config(t, nil).LockTimeout() != time.Second { t.Fatal("fixture DB lock budget changed") }
	for _, early := range []bool{false, true} {
		name := "earlier_database_lock_timeout"
		if early { name = "earlier_parent_deadline" }
		t.Run(name, func(t *testing.T) {
			actor, cookie := login(t, password, "admin@mail.com")
			before := store.sourceCount()
			conn := f.db.Connect(t)
			holder, err := conn.Begin(ctxFor(t))
			if err != nil { t.Fatal(err) }
			defer func() { ctx, cancel := context.WithTimeout(context.Background(), time.Second); defer cancel(); if err := holder.Rollback(ctx); err != nil { t.Error("lock-only holder rollback failed", err) } }()
			entered := make(chan context.Context, 1)
			release, finish := gate()
			defer finish()
			store.hooks(func(ctx context.Context, _ foundation.Tx) error {
				entered <- ctx
				select { case <-release: return nil; case <-ctx.Done(): return ctx.Err() }
			}, nil, nil)
			defer store.hooks(nil, nil, nil)
			budget := 5*time.Second
			if early { budget = 250*time.Millisecond }
			ctx, cancel := context.WithTimeout(context.Background(), budget)
			defer cancel()
			start := time.Now()
			done := outboundHTTPStart(t, handler, request(t, ctx, cookie))
			var actual context.Context
			select { case actual = <-entered: case <-time.After(time.Second): t.Fatal("HTTP preauthentication did not reach read Tx") }
			arrival := time.Now()
			actualDeadline, ok := actual.Deadline()
			parentDeadline, _ := ctx.Deadline()
			if !ok || early && !actualDeadline.Equal(parentDeadline) || !early && (actualDeadline.Before(start.Add(3*time.Second)) || actualDeadline.After(arrival.Add(3*time.Second)) || !actualDeadline.Before(parentDeadline)) { t.Fatal("read did not inherit min(local, parent) deadline") }
			// Lock only after preauthentication so the measured wait belongs to
			// this read transaction, not the older Account precheck.
			key, _ := foundation.UserLock(actor.Details().UserID)
			if _, err = holder.Exec(ctxFor(t), `SELECT pg_advisory_xact_lock($1)`, key.AdvisoryKey()); err != nil { t.Fatal(err) }
			finish()
			outboundHTTPWaitBlocked(t, f.store, conn.PgConn().PID())
			got := outboundHTTPJoin(t, done)
			elapsed := time.Since(start)
			store.mu.Lock(); result := store.last; store.mu.Unlock()
			var dbError *postgres.Error
			if result.State() != foundation.NotCommitted || result.Fault() == nil || !errors.As(result.Fault(), &dbError) || dbError.Code() != postgres.LockFailed { t.Fatal("lock failure lost formal typed terminal") }
			zero(t, got, before)
			if early {
				if ctx.Err() != context.DeadlineExceeded || !got.aborted || len(got.response.data) != 0 || elapsed > budget+500*time.Millisecond { t.Fatal("earlier parent failed budget/abort/join", elapsed) }
			} else {
				if ctx.Err() != nil || got.aborted || dbError.SQLState() != "55P03" || elapsed > 3*time.Second { t.Fatal("DB1s failure confused with local3s expiry", elapsed) }
				got.response.problem(t, 500, "INTERNAL_ERROR")
			}
			t.Logf("earlier_parent=%t terminal=%s DB_code=%s SQLSTATE=%s elapsed=%s Source_delta=%d actual_active=%d", early, result.State(), dbError.Code(), dbError.SQLState(), elapsed, store.sourceCount()-before, store.active.Load())
		})
	}
	store.mu.Lock()
	for _, trace := range store.reads {
		if len(trace.locks) != 1 || trace.locks[0].Mode != foundation.Shared { t.Error("read did not request exactly one User SH") }
		if trace.state == foundation.Committed && (trace.sessions != 1 || trace.authority != 1 || trace.sources != 1) { t.Error("committed read lacked one same-Tx authorization and Source") }
	}
	store.mu.Unlock()
	if time.Since(started) > 2*time.Minute { t.Fatal("scenario exceeded two-minute budget") }
	t.Log("real PG/current Account authority and terminal; controlled memory Source/writer; native I/O and root health provenance are separate groups")
}
