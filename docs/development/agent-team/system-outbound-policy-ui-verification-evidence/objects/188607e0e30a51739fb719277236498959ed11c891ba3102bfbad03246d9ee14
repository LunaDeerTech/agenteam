  it('does not clear a synchronously started successor after confirmation publication', async () => {
    const f = await fixture(),
      p = f.auth.system.outboundPolicy,
      held = barrier<Response>()
    let calls = 0,
      successor: Promise<unknown> | null = null
    f.setOutbound(async () => (++calls === 1 ? json(receipt()) : held.promise))
    const stop = watch(
      () => p.progress?.phase,
      (phase) => {
        if (phase === 'confirmed' && !successor) {
          p.abandon()
          successor = p.startUpdate({ ...input(), expected_version: '2' })
        }
      },
      { flush: 'sync' },
    )
    try {
      await p.startUpdate(input()).catch(() => undefined)
      await flushPromises()
      expect(f.writes()).toHaveLength(2)
      expect(p.progress?.phase).toBe('submitting')
      held.resolve(json(receipt('3')))
      await successor
      expect(p.progress).toMatchObject({ phase: 'confirmed', receipt: { version: '3' } })
    } finally {
      stop()
      held.resolve(json(receipt('3')))
    }
  })
