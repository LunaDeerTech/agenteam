                  !rule ||
                  !closed(rule, ["cidr", "ports", "allow_http"]) ||
                  typeof rule.cidr !== "string" ||
                  rule.cidr.length < 3 ||
                  rule.cidr.length > 43 ||
                  !/^[a-f0-9.:]+\/[0-9]{1,3}$/.test(rule.cidr) ||
                  typeof rule.allow_http !== "boolean"
                )
                  return;
                const ports = rule.ports;
                if (
                  ports !== "all" &&
                  (!Array.isArray(ports) ||
                    ports.length < 1 ||
                    ports.length > 256 ||
                    !ports.every(
                      (v, i) =>
                        typeof v === "number" &&
                        Number.isSafeInteger(v) &&
                        v >= 1 &&
                        v <= 65535 &&
                        (i === 0 || ports[i - 1] < v),
                    ))
                )
                  return;
                rules.push({
                  cidr: rule.cidr,
                  ports: ports === "all" ? "all" : ([...ports] as number[]),
                  allow_http: rule.allow_http,
                });
              }
              const canonical = rules.map((rule) => JSON.stringify(rule));
              if (
                canonical.some(
                  (rule, index) => index > 0 && canonical[index - 1]! >= rule,
                )
              )
                return;
