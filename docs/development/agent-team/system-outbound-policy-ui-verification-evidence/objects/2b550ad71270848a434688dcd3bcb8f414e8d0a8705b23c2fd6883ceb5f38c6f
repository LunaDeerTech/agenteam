      void original
        .then(
          (response) => {
            fact.status = response.status;
            if (!(
              fact.path === "/api/v1/session" ||
              fact.path === "/api/v1/system/outbound-policy" ||
              fact.path === "/api/v1/system/smtp"
            ))
              return;
