                    "SESSION_REVOKED",
                    "CSRF_FAILED",
                    "FORBIDDEN",
                    "VERSION_CONFLICT",
                    "INVALID_ARGUMENT",
                    "RESOURCE_BUSY",
                    "INTERNAL_ERROR",
                    "UNAVAILABLE",
                    "DEPENDENCY_UNAVAILABLE",
                    "INVALID_STATE",
                    "NOT_FOUND",
                    "IDEMPOTENCY_KEY_REUSED",
                    "COMMIT_UNKNOWN",
                  ].includes(value.code)
