              const nativeGet = body.getReader;
              Object.defineProperty(body, "getReader", {
                configurable: true,
                writable: true,
                value: function (
                  this: ReadableStream<Uint8Array>,
                  ...args: unknown[]
                ) {
                  const reader = Reflect.apply(
                    nativeGet,
                    this,
                    args,
                  ) as ReadableStreamDefaultReader<Uint8Array>;
                  try {
                    Object.defineProperty(body, "getReader", {
                      value: nativeGet,
                    });
                    const nativeRead = reader.read;
                    Object.defineProperty(reader, "read", {
                      configurable: true,
                      writable: true,
                      value: function (
                        this: ReadableStreamDefaultReader<Uint8Array>,
                        ...args: unknown[]
                      ) {
                        const original = Reflect.apply(
                          nativeRead,
                          this,
                          args,
                        ) as Promise<ReadableStreamReadResult<Uint8Array>>;
                        void original
                          .then(
                            ({ done, value }) => {
                              try {
                                if (value) {
                                  fact.bytes += value.byteLength;
                                  if (fact.bytes > 600000) {
                                    text = "";
                                    collect = false;
                                  } else if (collect)
                                    text += decoder.decode(value, {
                                      stream: true,
                                    });
                                }
                                if (done) {
                                  fact.eof = true;
                                  fact.ended = true;
                                  try {
                                    project();
                                  } finally {
                                    text = "";
                                    collect = false;
                                  }
                                }
                              } catch {
                                text = "";
                                collect = false;
                              }
                            },
                            () => {
                              text = "";
                              collect = false;
                              fact.ended = true;
                            },
                          )
                          .catch(() => {
                            text = "";
                            collect = false;
                          });
                        return original;
                      },
                    });
                  } catch {
                    text = "";
                    collect = false;
                  }
                  return reader;
                },
              });
            } catch {
              text = "";
              collect = false;
            }
          },
          () => {
            fact.ended = true;
          },
        )
        .catch(() => undefined);
    } catch {
      /* Observation failures cannot change the native result. */
    }
    return original;
  };
}
const button = (page: Page, name: string) =>
  page.getByRole("button", { name, exact: true });
const title = (page: Page, name: string) =>
  page.getByRole("heading", { name, exact: true });
const form = (page: Page) =>
  page.getByRole("form", { name: "编辑出站规则", exact: true });
const top = (page: Page) => page.getByRole("dialog");
const cidr = (page: Page, n = 1) =>
  page.getByRole("textbox", { name: `规则 ${n} CIDR`, exact: true });
const ports = (page: Page, n = 1) =>
  page.getByRole("textbox", { name: `规则 ${n} 指定端口`, exact: true });
const facts = (page: Page) =>
  page.evaluate(() => (window as ObservedWindow).__outboundFacts ?? []);
const seq = (page: Page) =>
  page.evaluate(() => (window as ObservedWindow).__outboundSequence ?? 0);
async function writes(page: Page) {
  return (await facts(page)).filter(
    (f) => f.path === endpoint && f.method === "PUT",
  );
}
async function factAfter(
  page: Page,
  after: number,
  predicate: (fact: Fact) => boolean,
) {
  let found: Fact | undefined;
  await expect
    .poll(async () => {
      found = (await facts(page)).find(
        (f) => f.sequence > after && predicate(f),
      );
      return !!found;
    })
    .toBe(true);
  return found!;
}
async function session(page: Page) {
  let value: Fact["session"];
  await expect
    .poll(async () => {
      value = (await facts(page))
        .filter(
          (f) => f.path === "/api/v1/session" && f.status === 200 && f.ended,
        )
        .at(-1)?.session;
      return !!value;
    })
    .toBe(true);
  return value!;
}
function same(a: unknown, b: unknown): boolean {
  const canonical = (value: any): string =>
    JSON.stringify(value, (_, v) =>
      v && typeof v === "object" && !Array.isArray(v)
        ? Object.fromEntries(
            Object.entries(v).sort(([a], [b]) => a.localeCompare(b)),
          )
        : v,
    );
  return canonical(a) === canonical(b);
}
async function login(page: Page, who: "admin" | "member" = "admin") {
  const data = material()[who],
    after = await seq(page);
  await page.locator("#login-email").fill(data.email);
  try {
    await page.locator("#login-password").fill(data.password);
  } catch {
    throw new Error("private owned login input failed");
  }
  await button(page, "登录").click();
  await factAfter(
    page,
    after,
    (f) =>
      f.path === "/api/v1/session" &&
      f.status === 200 &&
      f.ended &&
      f.session?.user_id === data.user_id &&
      f.session.role === (who === "admin" ? "admin" : "user"),
  );
  await expect(button(page, "退出登录")).toBeEnabled();
  await expect(page).not.toHaveURL(/\/login(?:\?|$)/);
}
async function setup(page: Page, who: "admin" | "member" = "admin") {
  await page.addInitScript(observeNative);
  await page.goto("/system/outbound-policy");
  await login(page, who);
  if (who === "admin") await currentRead(page, 0);
}
async function currentRead(page: Page, after: number) {
  const read = await factAfter(
    page,
    after,
    (f) =>
      f.path === endpoint &&
      f.method === "GET" &&
      f.status === 200 &&
      f.ended &&
      !!f.policy,
  );
  await expect(button(page, "读取当前规则")).toBeEnabled();
  return read.policy!;
}
async function dbFacts() {
  return (await ipc("facts")).facts as {
    policy: Policy;
    original_receipts: number;
    original_audits: number;
    exact_semantic: boolean;
    exact_historical: boolean;
  };
}
async function matchesObserved(page: Page, value: Policy) {
  const observed = page.getByRole("region", {
    name: "最近完整读取的出站规则",
    exact: true,
  });
  await expect
    .poll(async () => {
      const projected = await observed.evaluate((region) => ({
        version: region.querySelector("p code")?.textContent ?? "",
        rows: [...region.querySelectorAll("tbody tr")].map((row) =>
          [...row.querySelectorAll("td")].map(
            (cell) => cell.textContent?.trim() ?? "",
          ),
        ),
      }));
      return (
        projected.version === value.version &&
        projected.rows.length === value.rules.length &&
        projected.rows.every(
          (row, i) =>
            row[0] === value.rules[i]!.cidr &&
            row[1] ===
              (value.rules[i]!.ports === "all"
                ? "全部端口（all）"
                : value.rules[i]!.ports.join(", ")) &&
            row[2] === (value.rules[i]!.allow_http ? "允许" : "不允许"),
        )
      );
    })
    .toBe(true);
}
async function matchesEditor(page: Page, value: Policy) {
  await expect
    .poll(async () => {
      const view = await form(page).evaluate((node) => ({
        version: node.querySelector("p code")?.textContent ?? "",
        rows: [...node.querySelectorAll("fieldset")].map((row) => ({
          cidr:
            row.querySelector<HTMLInputElement>("input:not([type=checkbox])")
              ?.value ?? "",
          ports:
            row.querySelector<HTMLInputElement>('input[inputmode="numeric"]')
              ?.value ?? null,
          allow:
            row.querySelector<HTMLInputElement>('input[type="checkbox"]')
              ?.checked ?? false,
          mode:
            row
              .querySelector<HTMLElement>(".ui-select button")
              ?.textContent?.trim() ?? "",
        })),
      }));
      return (
        view.version === value.version &&
        view.rows.length === value.rules.length &&
        view.rows.every(
          (row, i) =>
            row.cidr === value.rules[i]!.cidr &&
            row.ports ===
              (value.rules[i]!.ports === "all"
                ? null
                : value.rules[i]!.ports.join(", ")) &&
            row.allow === value.rules[i]!.allow_http,
        )
      );
    })
    .toBe(true);
}
async function addRule(
  page: Page,
  network = "10.71.0.0/16",
  specified = "443",
  all = false,
) {
  const n = (await form(page).locator("fieldset").count()) + 1;
  await button(page, "添加规则").click();
  await expect(cidr(page, n)).toBeFocused();
  await cidr(page, n).fill(network);
  if (all) {
    await button(page, `规则 ${n} 端口范围`).click();
    await page
      .getByRole("option", { name: "全部端口（all）", exact: true })
      .click();
    await expect(ports(page, n)).toHaveCount(0);
  } else await ports(page, n).fill(specified);
  return n;
}
async function save(page: Page) {
  const after = await seq(page),
    version = await form(page).locator("p code").first().textContent(),
    count = await form(page).locator("fieldset").count();
  await button(page, "保存规则").click();
  const written = await factAfter(
    page,
    after,
    (f) =>
      f.path === endpoint &&
      f.method === "PUT" &&
      f.status === 200 &&
      f.ended &&
      !!f.receipt,
  );
  expect(
    BigInt(written.receipt!.version) === BigInt(version!) + 1n &&
      written.receipt!.rule_count === String(count),
  ).toBe(true);
  const current = await currentRead(page, written.sequence);
  await matchesObserved(page, current);
  await matchesEditor(page, current);
  return written.receipt!;
}
async function refresh(page: Page) {
  const after = await seq(page);
  await button(page, "读取当前规则").click();
  return currentRead(page, after);
}
async function discard(page: Page) {
  await button(page, "取消修改").click();
  await expect(top(page)).toHaveAccessibleName("放弃未保存的规则？");
  await top(page)
    .getByRole("button", { name: "放弃修改", exact: true })
    .click();
  await expect(page.locator(".ui-overlay")).toHaveCount(0);
}
async function cutSave(page: Page) {
  await ipc("arm-drop");
  const after = await seq(page);
  await button(page, "保存规则").click();
  await factAfter(
    page,
    after,
    (f) =>
      f.path === endpoint &&
      f.method === "PUT" &&
      f.status === 200 &&
      f.ended &&
      !f.receipt,
  );
  await expect(title(page, "请求结果未确认")).toBeVisible();
  await expect(button(page, "检查当前会话与规则")).toBeEnabled();
  const dropped = await ipc("drop-facts");
  expect(
    dropped.dropped === 1 && dropped.replayed === 0 && dropped.armed === false,
  ).toBe(true);
  return dropped.receipt as Receipt;
}
async function cancelledRead(page: Page) {
  const before = (await facts(page)).filter(
    (f) => f.path === endpoint && f.method === "GET",
  ).length;
  await ipc("arm-hold-read");
  await button(page, "读取当前规则").click();
  await expect
    .poll(async () => {
      const held = await ipc("hold-facts");
      return held.entered === held.joined + 1;
    })
    .toBe(true);
  await expect(button(page, "取消读取")).toBeEnabled();
  await button(page, "取消读取").click();
  await expect(title(page, "出站规则读取失败")).toBeVisible();
  await ipc("release-read");
  await expect
    .poll(async () => {
      const held = await ipc("hold-facts");
      return held.entered > 0 && held.entered === held.joined;
    })
    .toBe(true);
  await expect(button(page, "读取当前规则")).toBeEnabled();
  expect(
    (await facts(page)).filter((f) => f.path === endpoint && f.method === "GET")
      .length,
  ).toBe(before + 1);
  // This is an explicit read after actual server control completion. Owner native
  // cancel-tail semantics are separately covered by the fixed controlled tests.
  await refresh(page);
}

