  const sequence = ++ipcSequence,
    request = join(directory, "outbound-policy-ipc.json"),
    ack = join(directory, `outbound-policy-ack-${sequence}.json`);
  writeFileSync(
    request + ".tmp",
    JSON.stringify({ sequence, action, ...fields }),
    { mode: 0o600 },
  );
  renameSync(request + ".tmp", request);
