"""Owned no-resource orphan solely tests the private runner's real wait cleanup."""
import os, subprocess, sys, time
if len(sys.argv)>1:
 os.write(int(sys.argv[1]),b'1')
 os.close(int(sys.argv[1]))
 time.sleep(2)
 os._exit(0)
read_fd,write_fd=os.pipe()
child=subprocess.Popen([sys.executable,__file__,str(write_fd)],pass_fds=(write_fd,))
os.close(write_fd)
if os.read(read_fd,1)!=b'1':os._exit(2)
os.close(read_fd)
os._exit(0)
