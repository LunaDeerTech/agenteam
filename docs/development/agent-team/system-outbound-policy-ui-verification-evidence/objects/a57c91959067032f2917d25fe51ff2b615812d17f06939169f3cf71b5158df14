import { AccountFailure, accountTransport, shape, string, uuid7, type Fetch } from './client'
import type { WriteOptions } from './account'
import { parseSystemInstant } from './system-account'
import { captureOutboundRules, parseOutboundRules, type OutboundRule } from './outbound-rules'

export type OutboundPolicy = Readonly<{ version: string; rules: readonly OutboundRule[] }>
export type OutboundPolicyUpdate = Readonly<{
  expected_version: string
  rules: readonly OutboundRule[]
}>
export type OutboundPolicyReceipt = Readonly<{
  version: string
  rule_count: string
  audit_id: string
  created_at: string
}>
export interface SystemOutboundPolicyAPI {
  getPolicy(signal: AbortSignal): Promise<OutboundPolicy>
  updatePolicy(input: OutboundPolicyUpdate, options: WriteOptions): Promise<OutboundPolicyReceipt>
}
export const outboundMaximumVersion = '9223372036854775807'
const encoder = new TextEncoder()
function requireValue(value: boolean) {
  if (!value) throw new AccountFailure('invalid-response')
}
function version(value: unknown, writable = false) {
  const result = string(value, 1, 19)
  requireValue(/^[1-9][0-9]*$/.test(result))
  requireValue(BigInt(result) <= BigInt(outboundMaximumVersion) - (writable ? 1n : 0n))
  return result
}
function input<T>(work: () => T): T {
  try { return work() } catch { throw new AccountFailure('invalid-input') }
}

export function captureOutboundPolicyUpdate(value: unknown): OutboundPolicyUpdate {
  return input(() => {
    const v = shape(value, ['expected_version', 'rules'])
    const captured = Object.freeze({
      expected_version: version(v.expected_version, true),
      rules: captureOutboundRules(v.rules),
    })
    requireValue(encoder.encode(JSON.stringify(captured.rules)).byteLength <= 512 * 1024)
    requireValue(encoder.encode(JSON.stringify(captured)).byteLength <= 1024 * 1024)
    return captured
  })
}

export function createSystemOutboundPolicyAPI(fetcher?: Fetch): SystemOutboundPolicyAPI {
  const request = accountTransport(fetcher)
  return {
    async getPolicy(signal) {
      return request('getOutboundPolicy', (value) => {
        const v = shape(value, ['version', 'rules'])
        return Object.freeze({ version: version(v.version), rules: parseOutboundRules(v.rules) })
      }, { signal })
    },
    async updatePolicy(value, write) {
      const captured = captureOutboundPolicyUpdate(value)
      const options = input(() => {
        const v = shape(write, ['csrfToken', 'key'], ['signal'])
        const csrf = string(v.csrfToken, 43, 43), key = string(v.key, 1, 128)
        requireValue(/^[A-Za-z0-9_-]{43}$/.test(csrf) && /^[A-Za-z0-9._:/-]{1,128}$/.test(key))
        return { csrf, key, signal: write.signal ?? new AbortController().signal }
      })
      return request('updateOutboundPolicy', (value) => {
        const v = shape(value, ['version', 'rule_count', 'audit_id', 'created_at'])
        const next = version(v.version), count = string(v.rule_count, 1, 3), audit = string(v.audit_id, 36, 36)
        requireValue(BigInt(next) === BigInt(captured.expected_version) + 1n)
        requireValue(/^(0|[1-9][0-9]{0,2})$/.test(count) && Number(count) === captured.rules.length)
        requireValue(uuid7.test(audit))
        return Object.freeze({ version: next, rule_count: count, audit_id: audit, created_at: parseSystemInstant(v.created_at) })
      }, { ...options, body: captured })
    },
  }
}
