  await router.isReady()
  const host = document.createElement('div')
  host.id = 'app'
  document.body.append(host)
  wrapper = mount(App, { attachTo: host, global: { plugins: [router] } })
  await flushPromises()
  return { ...f, router, wrapper }
}
function button(label: string, root: ParentNode = document) {
  const value = [...root.querySelectorAll<HTMLButtonElement>('button')].find(
    (node) =>
      (
        node.querySelector('.button-label[aria-hidden="false"]')?.textContent ?? node.textContent
      )?.trim() === label || node.getAttribute('aria-label') === label,
  )
  expect(value, `button ${label}`).toBeTruthy()
  return value!
}
async function click(label: string, root: ParentNode = document) {
  button(label, root).click()
  await flushPromises()
}
function field(label: string) {
  const node = [...document.querySelectorAll<HTMLLabelElement>('label')].find(
    (value) => value.textContent?.replace(/\s*\*$/, '') === label,
  )
  expect(node, `field ${label}`).toBeTruthy()
  return document.getElementById(node!.htmlFor) as HTMLInputElement
}
async function change(label: string, value: string) {
  const node = field(label)
  node.value = value
  node.dispatchEvent(new Event('input', { bubbles: true }))
  await flushPromises()
}
async function submit(label = '保存规则') {
  const submitter = button(label)
  submitter.form!.dispatchEvent(
    new SubmitEvent('submit', { bubbles: true, cancelable: true, submitter }),
  )
  await flushPromises()
}
function dialogs(count = 1) {
  const layers = [...document.querySelectorAll<HTMLElement>('[role="dialog"]')]
  expect(layers).toHaveLength(count)
  for (const layer of layers.slice(0, -1)) {
    expect(layer.inert).toBe(true)
    expect(layer.getAttribute('aria-hidden')).toBe('true')
  }
  const top = layers.at(-1)!
  expect(top.inert).toBe(false)
  expect(top.getAttribute('aria-hidden')).toBeNull()
  return { layers, top }
}

const safeFacts: Record<string, unknown> = {}
function record(group: string, value: unknown) {
  safeFacts[group] = value
  writeFileSync(process.env.INDEPENDENT_RUN + 'safe-facts.json', JSON.stringify(safeFacts, null, 2) + '\n')
}
function heading(text: string) {
  const nodes = [...document.querySelectorAll<HTMLElement>('h1,h2,h3')]
  return nodes.find(n => n.textContent?.replace(/^\s*!\s*/, '').trim() === text)
}

describe('Independent frozen Outbound App risk combinations', () => {
  it('A preserves a pending public decision through checking503 and same identity, but never grants it a later identity', async () => {
    const f = await app(), originalIdentity = f.auth.personalContext.identity
    expect(f.reads().length).toBe(1)
    await change('规则 1 指定端口', '8443')
    const oldHeading = heading('出站规则')!
    expect(oldHeading?.isConnected).toBe(true)
    let settled = false
    const navigation = f.router.push('/system/smtp').then(value => { settled = true; return value })
    await flushPromises()
    const oldDialog = dialogs().top
    expect(oldDialog.textContent?.includes('放弃未保存的规则？')).toBe(true)
    const held = barrier<Response>(), beforeSession = f.fetch.mock.calls.length
    f.setSessionRequest(() => held.promise)
    try {
      window.dispatchEvent(new Event('pageshow'))
      await flushPromises()
      expect(f.auth.personalContext.phase).toBe('checking')
      expect(settled).toBe(false)
      expect(document.querySelectorAll('.ui-overlay').length).toBe(0)
      expect(oldHeading.isConnected || oldDialog.isConnected).toBe(false)
      held.resolve(problem('DEPENDENCY_UNAVAILABLE', 503))
      await flushPromises()
      expect(heading('会话尚未确认')?.isConnected).toBe(true)
      expect(settled).toBe(false)
      expect(button('检查当前会话').disabled).toBe(false)
      expect(document.querySelectorAll('[role="dialog"]').length).toBe(0)
      f.resetSession()
      await click('检查当前会话')
      expect(f.auth.personalContext.identity).toEqual(originalIdentity)
      expect(f.fetch.mock.calls.slice(beforeSession).map(([p, i]) => [p, i.method])).toEqual([
        ['/api/v1/session', 'GET'], ['/api/v1/session', 'GET'],
      ])
      expect(settled).toBe(false)
      const currentHeading = heading('出站规则')!, top = dialogs().top
      expect(currentHeading.isConnected && currentHeading !== oldHeading).toBe(true)
      const dialog = f.wrapper.findComponent(SystemOutboundPolicyView).findComponent(UiDialog)
      expect(dialog.props('fallbackFocus') === currentHeading).toBe(true)
      expect(field('规则 1 指定端口').value).toBe('8443')
      await click('继续编辑', top)
      expect(isNavigationFailure(await navigation)).toBe(true)
      expect(f.router.currentRoute.value.path).toBe('/system/outbound-policy')
      expect(document.querySelectorAll('.ui-overlay').length).toBe(0)
      expect(f.writes().length).toBe(0)
    } finally {
      held.resolve(problem('DEPENDENCY_UNAVAILABLE', 503))
      if (!settled) {
        const remaining = document.querySelector<HTMLElement>('[role="dialog"]')
        if (remaining) await click('继续编辑', remaining)
        else f.auth.leave()
      }
      await navigation
      await flushPromises()
    }
    const stale = f.router.push('/settings/profile')
    await flushPromises()
    dialogs()
    const replacement = view()
    replacement.session.id = id(3)
    replacement.user.role = 'user'
    replacement.user.version = '2'
    f.setSession(replacement)
    window.dispatchEvent(new Event('pageshow'))
    await flushPromises()
    expect(isNavigationFailure(await stale)).toBe(true)
    expect(f.router.currentRoute.value.path).toBe('/system/outbound-policy')
    expect(heading('无权访问系统设置')?.isConnected).toBe(true)
    expect(document.querySelectorAll('.ui-overlay').length).toBe(0)
    expect(document.querySelector('[aria-label="编辑出站规则"]')).toBeNull()
    expect(f.auth.system.outboundPolicy.progress).toBeNull()
    expect(await f.router.push('/settings/profile')).toBeUndefined()
    await flushPromises()
    expect(f.router.currentRoute.value.path).toBe('/settings/profile')
    await click('退出登录')
    expect(f.router.currentRoute.value.path).toBe('/login')
    expect(button('登录').disabled).toBe(false)
    expect(f.fetch.mock.calls.filter(([p]) => p.endsWith('/logout')).length).toBe(1)
    expect(f.writes().length).toBe(0)
    record('A', { same_identity_decision_pending_through_503: true, recovery_exact_two_session_GETs: true,
      latest_connected_heading_fallback_prop: true, old_instance_detached: true,
      different_identity_old_navigation_cancelled: true, fresh_ordinary_leave_logout_reaches_login: true,
      outbound_PUT_count: 0, native_focus_claim: false })
  })

  it('B explicitly adopts conflict state, preserves a confirmed draft across failed GETs, and leaves other clean domains without new Cookie writes', async () => {
    const f = await app()
    await change('规则 1 指定端口', '8443')
    f.setOutbound(async () => problem('VERSION_CONFLICT', 409))
    await submit()
    expect(heading('需要核对最新规则')?.isConnected).toBe(true)
    expect(field('规则 1 指定端口').value).toBe('8443')
    const form = () => f.wrapper.get('[aria-label="编辑出站规则"]')
    expect(form().findAll('code')[0]!.text()).toBe('1')
    f.setOutbound(async () => json(policy('3')))
    await click('读取最新规则')
    expect(field('规则 1 指定端口').value).toBe('8443')
    expect(form().findAll('code')[0]!.text()).toBe('1')
    await click('采用最新值重新编辑')
    expect(dialogs().top.textContent?.includes('放弃草稿并采用最新规则？')).toBe(true)
    await click('继续编辑', dialogs().top)
    expect(field('规则 1 指定端口').value).toBe('8443')
    await click('采用最新值重新编辑')
    await click('放弃修改', dialogs().top)
    expect(form().findAll('code')[0]!.text()).toBe('3')
    expect(field('规则 1 指定端口').value).toBe('443')
    await change('规则 1 指定端口', '9443')
    f.setOutbound(async (_, init) => init.method === 'PUT' ? json(receipt('4')) : problem('DEPENDENCY_UNAVAILABLE', 503))
    await submit()
    expect(f.writes().length).toBe(2)
    expect(heading('保存已确认，当前规则读取失败')?.isConnected).toBe(true)
    expect(field('规则 1 指定端口').value).toBe('9443')
    expect(field('规则 1 指定端口').disabled).toBe(true)
    expect(form().findAll('code')[0]!.text()).toBe('3')
    expect(f.wrapper.get('[aria-label="本次保存的历史确认"]').text().includes('版本 4')).toBe(true)
    const reads = f.reads().length
    await click('读取当前规则')
    expect(document.querySelectorAll('[role="dialog"]').length).toBe(0)
    expect(f.reads().length).toBe(reads + 1)
    expect(f.writes().length).toBe(2)
    expect(field('规则 1 指定端口').value).toBe('9443')
    f.setOutbound(async () => json(policy('7')))
    await click('读取当前规则')
    expect(form().findAll('code')[0]!.text()).toBe('7')
    expect(f.wrapper.get('[aria-label="本次保存的历史确认"]').text().includes('版本 4')).toBe(true)
    await change('规则 1 指定端口', '7443')
    expect(button('保存规则').disabled).toBe(false)
    expect(button('保存规则').getAttribute('aria-busy')).not.toBe('true')
    expect(f.writes().length).toBe(2)
    await click('取消修改')
    await click('放弃修改', dialogs().top)
    const permissionWatermark = f.fetch.mock.calls.length
    let forbiddenOnce = true
    f.setOutbound(async (_, init) => {
      if (init.method === 'GET' && forbiddenOnce) {
        forbiddenOnce = false
        return problem('FORBIDDEN', 403)
      }
      return json(policy('7'))
    })
    await click('读取当前规则')
    expect(f.auth.system.denied).toBe(true)
    expect(heading('无权访问系统设置')?.isConnected).toBe(true)
    const deniedBeforeNavigation = f.auth.system.denied
    expect(await f.router.push('/system/smtp')).toBeUndefined()
    await flushPromises()
    record('B-permission-sequence', {
      denied_before_navigation: deniedBeforeNavigation,
      denied_after_navigation: f.auth.system.denied,
      requests: f.fetch.mock.calls.slice(permissionWatermark).map(([path, init]) => ({
        method: init.method, path: path.split('?')[0],
      })),
    })
    expect(heading('SMTP')?.isConnected).toBe(true)
    const outboundReads = f.reads().length
    // This domain is now inactive. Ordinary SMTP public controls remain authoritative.
    const smtpHost = [...document.querySelectorAll<HTMLInputElement>('input')].find(n => n.value === 'mail.example')!
    expect(!!smtpHost).toBe(true)
    smtpHost.value = 'changed.example'
    smtpHost.dispatchEvent(new Event('input', { bubbles: true }))
    await flushPromises()
    await click('测试与任务')
    const smtpConfirm = dialogs().top
    expect(smtpConfirm.textContent?.includes('放弃未保存修改？')).toBe(true)
    await click('继续编辑', smtpConfirm)
    expect(button('配置').getAttribute('aria-pressed')).toBe('true')
    await click('测试与任务')
    await click('放弃修改', dialogs().top)
    expect(button('测试与任务').getAttribute('aria-pressed')).toBe('true')
    expect(f.reads().length).toBe(outboundReads)
    expect(f.fetch.mock.calls.filter(([p, i]) => p.includes('/system/smtp') && i.method !== 'GET').length).toBe(0)
    await click('配置')
    const tail = barrier(), cancelled = barrier()
    let cancelFinished = false
    f.setConfiguration(async () => new Response(new ReadableStream<Uint8Array>({
      cancel() { cancelled.resolve(); return tail.promise.then(() => { cancelFinished = true }) },
    }), { headers: { 'Content-Type': 'application/json' } }))
    try {
      await click('读取当前配置')
      expect(f.auth.state.busy).toBe(true)
      expect(button('退出登录').disabled).toBe(true)
      const before = f.fetch.mock.calls.length
      expect(await f.router.push('/')).toBeUndefined()
      await flushPromises()
      await cancelled.promise
      expect(f.router.currentRoute.value.path).toBe('/')
      expect(f.auth.state.busy).toBe(true)
      expect(cancelFinished).toBe(false)
      expect(f.fetch.mock.calls.length).toBe(before)
      expect(f.reads().length).toBe(outboundReads)
    } finally {
      tail.resolve()
      await flushPromises()
    }
    expect(cancelFinished).toBe(true)
    expect(f.auth.state.busy).toBe(false)
    expect(f.writes().length).toBe(2)
    record('B', { explicit_conflict_adoption_only: true, confirmed_history4_current7_separate: true,
      failed_GET_preserves_draft_and_old_version: true, GET_retry_does_not_PUT: true,
      immediate_next_draft_normal_save_label: true, fresh_current403_leave: true,
      smtp_sections_single_confirmation: true, inactive_outbound_does_not_block_other_public_route: true,
      native_other_domain_cancel_tail_keeps_owner: true, actual_tail_joined: true })
  })
})
