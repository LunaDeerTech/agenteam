  await ipc("arm-get-fail");
  after = await seq(page);
  await button(page, "用原请求确认").click();
  const replay = await factAfter(page, after, f => f.path === endpoint && f.method === "PUT" && f.status === 200 && f.ended && f.eof === true && !!f.receipt);
  expect(same(replay.receipt, historical) && (await writes(page)).length === 2).toBe(true);
  // text/plain 503 is rejected and cancelled before a reader: no EOF is invented.
  await factAfter(page, replay.sequence, f => f.path === endpoint && f.method === "GET" && f.status === 503);
  await expect(title(page, "保存已确认，当前规则读取失败")).toBeVisible();
  await expect(page.getByLabel("本次保存的历史确认", { exact: true })).toBeVisible();
  expect((await form(page).locator("p code").first().textContent()) === capturedVersion && (await cidr(page).inputValue()) === draftCIDR && (await ports(page).inputValue()) === draftPorts).toBe(true);
  await expect(cidr(page)).toBeDisabled();
  await expect(form(page).locator('button[type="submit"]')).toBeDisabled();
  await expect(button(page, "用原请求确认")).toHaveCount(0);
  const drop = await ipc("drop-facts");
  expect(drop.dropped === 1 && drop.replayed === 1 && drop.same_original === true && drop.armed === false && same(drop.receipt, historical)).toBe(true);
  const readBack = await refresh(page);
  expect(same(readBack, newer) && (await writes(page)).length === 2).toBe(true);
  await matchesObserved(page, newer);
  await matchesEditor(page, newer);
  const final = await dbFacts();
  expect(final.original_receipts === 1 && final.original_audits === 1 && final.exact_semantic && final.exact_historical && same(final.policy, newer)).toBe(true);
  expect((await ipc("failure-facts")).read_failures === 1).toBe(true);
  expect(!(await facts(page)).some(f => f.path.includes("lookup") || f.path.startsWith("/api/v1/system/smtp"))).toBe(true);
