  const accepted = await dbFacts();
  expect(accepted.original_receipts === 1 && accepted.original_audits === 1 && accepted.exact_semantic && accepted.exact_historical && accepted.policy.version === historical.version).toBe(true);
  const advanced = await ipc("compete", { expected: historical.version });
  expect(advanced.distinct_administrator === true && advanced.expected === historical.version && BigInt(advanced.receipt.version) === BigInt(historical.version) + 1n).toBe(true);
  let after = await seq(page);
  await button(page, "检查当前会话与规则").click();
  const restored = await factAfter(page, after, f => f.path === "/api/v1/session" && f.status === 200 && f.ended && f.eof === true && same(f.session, originalSession));
  const newer = await currentRead(page, restored.sequence);
