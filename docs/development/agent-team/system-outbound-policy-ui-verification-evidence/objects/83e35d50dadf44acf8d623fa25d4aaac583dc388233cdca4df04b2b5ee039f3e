}
async function cancelledRead(page: Page) {
  const before = (await facts(page)).filter(
    (f) => f.path === endpoint && f.method === "GET",
  ).length;
  await ipc("arm-hold-read");
  await button(page, "读取当前规则").click();
  await expect
    .poll(async () => {
      const held = await ipc("hold-facts");
      return held.entered === held.joined + 1;
    })
    .toBe(true);
  await expect(button(page, "取消读取")).toBeEnabled();
  await button(page, "取消读取").click();
  await expect(title(page, "出站规则读取失败")).toBeVisible();
  await ipc("release-read");
  await expect
    .poll(async () => {
      const held = await ipc("hold-facts");
      return held.entered > 0 && held.entered === held.joined;
    })
    .toBe(true);
  await expect(button(page, "读取当前规则")).toBeEnabled();
  expect(
    (await facts(page)).filter((f) => f.path === endpoint && f.method === "GET")
      .length,
  ).toBe(before + 1);
  // This is an explicit read after actual server control completion. Owner native
  // cancel-tail semantics are separately covered by the fixed controlled tests.
  await refresh(page);
}

