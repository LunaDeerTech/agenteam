}

// Independent public-action compositions. Only safe booleans/counts reach output.
async function privateFill(control: Locator, value: string) {
  try { await control.fill(value); }
  catch { throw new Error("private independent input failed"); }
}
async function independentDraft(page: Page) {
  await button(page, "添加规则").click();
  await expect(cidr(page)).toBeFocused();
  await privateFill(cidr(page), "10.72.0.0/16");
  await privateFill(ports(page), "8443, 443");
}

test("[mutation] independent historical receipt remains distinct from newer current policy and failed post-replay read", async ({ page }) => {
  await setup(page);
  const originalSession = await session(page);
