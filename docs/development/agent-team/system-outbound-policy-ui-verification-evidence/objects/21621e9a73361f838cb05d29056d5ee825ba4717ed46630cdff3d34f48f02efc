+func (f *outboundPolicyWebFixture) shouldFailRead(path string) bool {
+	return path == outboundPolicyHTTPPath && f.failRead.CompareAndSwap(true, false)
+}
+func (f *outboundPolicyWebFixture) releaseRead() {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.holdRelease != nil {
+		f.holdReleaseOnce.Do(func() { close(f.holdRelease) })
+	}
+}
+func (f *outboundPolicyWebFixture) controlResponse(response *http.Response) error {
+	r := response.Request
+	if r == nil || r.URL.Path != outboundPolicyHTTPPath || response.StatusCode != 200 {
+		return nil
+	}
+	f.mu.Lock()
+	hold := r.Method == "GET" && f.holdNext
+	if hold {
+		f.holdNext = false
+		f.held++
+	}
+	release := f.holdRelease
+	f.mu.Unlock()
+	if hold {
+		raw, err := io.ReadAll(io.LimitReader(response.Body, 600001))
+		closeErr := response.Body.Close()
+		if err != nil || closeErr != nil || len(raw) > 600000 {
+			clear(raw)
+			return errors.New("owned read hold requires complete formal response")
+		}
+		select {
+		case <-r.Context().Done():
+			err = r.Context().Err()
+		case <-release:
+		}
+		f.mu.Lock()
+		f.holdJoined++
+		f.mu.Unlock()
+		if err != nil {
+			clear(raw)
+			return err
+		}
+		response.Body = io.NopCloser(bytes.NewReader(raw))
+		response.ContentLength = int64(len(raw))
+	}
+	if r.Method != "PUT" {
+		return nil
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	key := r.Header.Get("Idempotency-Key")
+	var attempt *outboundPolicyWebAttempt
+	for n := len(f.attempts) - 1; n >= 0; n-- {
+		if f.attempts[n].key == key {
+			attempt = &f.attempts[n]
+			break
+		}
+	}
+	if attempt == nil {
+		return errors.New("owned write observation missing")
+	}
+	if f.lostKey != "" && key == f.lostKey {
+		f.replayed++
+		f.sameOriginal = f.sameOriginal && bytes.Equal(attempt.body, f.lostBody) && attempt.csrf == f.lostCSRF
+	}
+	if !f.dropNext {
+		return nil
+	}
+	f.dropNext = false
+	raw, err := io.ReadAll(io.LimitReader(response.Body, 600001))
+	closeErr := response.Body.Close()
+	defer clear(raw)
+	var receipt map[string]any
+	if err != nil || closeErr != nil || len(raw) > 600000 || len(raw) < 2 || json.Unmarshal(raw, &receipt) != nil || len(receipt) != 4 {
+		return errors.New("owned response cut requires complete formal receipt")
+	}
+	for _, key := range []string{"version", "rule_count", "audit_id", "created_at"} {
+		if _, ok := receipt[key].(string); !ok {
+			return errors.New("owned formal receipt shape invalid")
+		}
+	}
+	f.lostKey = key
+	clear(f.lostBody)
+	f.lostBody = append([]byte(nil), attempt.body...)
+	f.lostCSRF = attempt.csrf
+	f.lostReceipt = receipt
+	f.dropped++
+	return &modelsResponseLost{header: response.Header.Clone(), prefix: append([]byte(nil), raw[:len(raw)/2]...), length: len(raw)}
+}
+func (f *outboundPolicyWebFixture) official(ctx context.Context, client *http.Client, method, key, csrf string, raw []byte) (int, map[string]any) {
+	request, err := http.NewRequestWithContext(ctx, method, f.origin+outboundPolicyHTTPPath, bytes.NewReader(raw))
+	if err != nil {
+		f.t.Fatal("owned formal policy request invalid")
+	}
+	request.Header.Set("Origin", f.origin)
+	request.Header.Set("Sec-Fetch-Site", "same-origin")
+	if method == "PUT" {
+		request.Header.Set("Content-Type", "application/json")
+		request.Header.Set("Idempotency-Key", key)
+		request.Header.Set("X-CSRF-Token", csrf)
+	}
+	response, err := client.Do(request)
+	if err != nil {
+		f.t.Fatal("owned formal policy HTTP failed")
+	}
+	body, readErr := io.ReadAll(io.LimitReader(response.Body, 600001))
+	closeErr := response.Body.Close()
+	defer clear(body)
+	var value map[string]any
+	if readErr != nil || closeErr != nil || len(body) > 600000 || json.Unmarshal(body, &value) != nil {
+		f.t.Fatal("owned formal policy response did not reach complete EOF")
+	}
+	return response.StatusCode, value
+}
+func (f *outboundPolicyWebFixture) putRules(ctx context.Context, client *http.Client, csrf, expected string, rawRules []byte) map[string]any {
+	rules, err := outbound.DecodeRules(rawRules)
+	if err != nil {
+		f.t.Fatal("owned formal Rules preparation invalid")
+	}
+	body, err := json.Marshal(struct {
+		Expected string          `json:"expected_version"`
+		Rules    json.RawMessage `json:"rules"`
+	}{expected, rules.JSON()})
+	if err != nil {
+		f.t.Fatal("owned policy body encoding failed")
+	}
+	defer clear(body)
+	status, receipt := f.official(ctx, client, "PUT", id[struct{}](f.t).String(), csrf, body)
+	if status != 200 {
+		f.t.Fatalf("owned formal policy update status=%d want=200", status)
+	}
+	return receipt
+}
+func (f *outboundPolicyWebFixture) policyFacts(ctx context.Context) map[string]any {
+	conn, closeConnection := invitationsWebConnect(f.t, ctx, f.db)
+	defer closeConnection()
+	var version string
+	var raw []byte
+	if err := conn.QueryRow(ctx, `SELECT version::text,rules FROM agenteam_outbound.outbound_policy WHERE singleton`).Scan(&version, &raw); err != nil {
+		f.t.Fatal("owned policy snapshot unavailable", err)
+	}
+	var rules any
+	if json.Unmarshal(raw, &rules) != nil {
+		f.t.Fatal("owned policy snapshot shape invalid")
+	}
+	f.mu.Lock()
+	key := f.lostKey
+	body := append([]byte(nil), f.lostBody...)
+	receipt := f.lostReceipt
