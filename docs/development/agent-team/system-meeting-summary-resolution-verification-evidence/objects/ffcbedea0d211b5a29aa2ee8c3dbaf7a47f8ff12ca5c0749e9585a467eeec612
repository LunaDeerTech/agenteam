   value=h(p)
   if obj['ImportPath'].endswith('.test') and str(p).startswith('/workspace/.cache/go-build/'):
    generated[actual]=value;continue
   files[virtual]={'actual':actual,'sha256':value,'field':field}
   if expected.get(actual)!=value:outside.append({'virtual':virtual,'actual':actual,'sha256':value})
