new={'probe':{'path':str(probe),'sha256':h(probe)},'overlay':{'path':str(B/'overlay.json'),'sha256':h(B/'overlay.json')},'base_closure':delta['base_closure'],'command_result':{'path':str(B/'offline/p06-race-graph/result.json'),'sha256':h(B/'offline/p06-race-graph/result.json')},'packages':[{'ImportPath':o['ImportPath'],'Dir':o['Dir'],'Standard':o.get('Standard',False)} for o in objects],'files':files,'generated_testmain_cache':generated,'outside_frozen_input':outside,'excluded_source_selected':excluded,'generated_main_has_no_custom_TestMain':True,'private_has_no_init_or_TestMain':not any(('func '+n+'(') in probe.read_text() for n in ['init','TestMain'])}
p=B/'offline/p06-race-graph/actual-graph.json';p.write_text(json.dumps(new,indent=2)+'\n')
summary={'actual_graph_sha256':h(p),'packages':len(objects),'files':len(files),'generated_testmain':len(generated),'outside_count':len(outside),'outside':outside,'excluded':excluded,'no_TestMain':True}
(B/'offline/p06-race-graph/graph-summary.json').write_text(json.dumps(summary,indent=2)+'\n')
print(json.dumps(summary));raise SystemExit(1 if outside or excluded else 0)
