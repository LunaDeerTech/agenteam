 assert not obj.get('Error') and not obj.get('DepsErrors'),obj.get('ImportPath')
 for field in ('GoFiles','CgoFiles','CFiles','CXXFiles','MFiles','HFiles','FFiles','SFiles','SwigFiles','SwigCXXFiles','SysoFiles','EmbedFiles'):
