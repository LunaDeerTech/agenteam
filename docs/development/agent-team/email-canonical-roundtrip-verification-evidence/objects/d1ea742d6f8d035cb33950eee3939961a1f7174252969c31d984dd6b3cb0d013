+			rcptMatches := state.RCPTToSHA == digest("RCPT TO:<"+tc.recipientWire+">\r\n")
+			bodyMatches := state.MessageSHA == digest(wantMessage)
+			if !mailMatches || !rcptMatches || !bodyMatches || state.MessageBytes != len(wantMessage) {
