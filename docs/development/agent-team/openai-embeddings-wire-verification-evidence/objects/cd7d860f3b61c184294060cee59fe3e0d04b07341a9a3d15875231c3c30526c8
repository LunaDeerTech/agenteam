+type embeddingEOFBarrier struct {
+	data    []byte
+	entered chan struct{}
+	release chan struct{}
+}
+
+func (r *embeddingEOFBarrier) Read(p []byte) (int, error) {
+	if len(r.data) > 0 {
+		n := copy(p, r.data)
+		r.data = r.data[n:]
+		return n, nil
+	}
+	close(r.entered)
+	<-r.release
+	return 0, io.EOF
+}
