+type embeddingTerminalReader struct {
+	data []byte
+	err  error
+}
+
+func (r *embeddingTerminalReader) Read(p []byte) (int, error) {
+	if len(r.data) > 0 {
+		n := copy(p, r.data)
+		r.data = r.data[n:]
+		if len(r.data) == 0 {
+			return n, r.err
+		}
+		return n, nil
+	}
+	return 0, r.err
+}
