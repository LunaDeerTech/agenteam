+func embeddingJSON(data, usage string) []byte {
+	if usage != "" {
+		usage = ",\"usage\":" + usage
+	}
+	return []byte("{\"object\":\"list\",\"model\":\"native-alias\",\"data\":" + data + usage + "}")
