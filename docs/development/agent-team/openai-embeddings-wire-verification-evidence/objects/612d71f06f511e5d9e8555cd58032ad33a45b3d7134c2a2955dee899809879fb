+	err = a.budget.admit(ctx, o.ProjectID, func() budgetWork {
+		x = newEmbeddingExchange(ctx, o.Limits.Overall, a.budget, o.Credential)
+		return x
+	})
+	if err != nil {
+		_ = prepared.request.Body.Close()
+		return nil, err
+	}
