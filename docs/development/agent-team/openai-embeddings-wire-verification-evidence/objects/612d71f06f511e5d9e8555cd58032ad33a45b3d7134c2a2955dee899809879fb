+func TestOpenAIEmbeddingsConstructorAndAdmission(t *testing.T) {
+	var resolver nilResolver
+	for _, tc := range []struct {
+		transport Transport
+		budget    *Budget
+	}{{Transport{}, nil}, {Transport{}, &Budget{}}, {Transport{Resolver: resolver}, NewBudget()}, {Transport{Policy: &outbound.PolicyService{}}, NewBudget()}} {
+		if a, err := NewOpenAIEmbeddings(tc.transport, tc.budget); a != nil || err == nil {
+			t.Fatal("invalid Embedding constructor")
+		}
+	}
+	// Bound system-root discovery to an empty owned file/directory. This only
+	// creates a formal TrustStore; it does not authorize any TLS endpoint.
+	dir := t.TempDir()
+	file := filepath.Join(dir, "roots.pem")
+	if err := os.WriteFile(file, nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("SSL_CERT_FILE", file)
+	t.Setenv("SSL_CERT_DIR", dir)
+	trust, err := outbound.LoadTrustStore("")
+	if err != nil {
+		t.Fatal("formal trust construction", err)
+	}
+	policy, err := outbound.NewPolicyService(&embeddingNoIOStore{}, &embeddingNoIOAudit{}, outbound.Authorizations{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	b := NewBudget()
+	a, err := NewOpenAIEmbeddings(Transport{Policy: policy, Trust: trust}, b)
+	if err != nil || a == nil || a.budget != b || a.transport.Policy != policy {
+		t.Fatal("formal constructor", err)
+	}
+	if active, _ := b.snapshot(); len(active) != 0 {
+		t.Fatal("constructor admitted work")
+	}
+	r, o := embeddingUnitInput(t)
+	var creates atomic.Int32
+	create := func() (embeddingClient, error) {
+		creates.Add(1)
+		return nil, nil
+	}
+	b.StopAdmission()
+	for _, name := range []string{"cancelled", "nil-context", "shape", "unsupported", "sealed"} {
+		t.Run(name, func(t *testing.T) {
+			input := r
+			ctx := context.Background()
+			switch name {
+			case "cancelled":
+				var cancel context.CancelFunc
+				ctx, cancel = context.WithCancel(ctx)
+				cancel()
+			case "nil-context":
+				ctx = nil
+			case "shape":
+				input.ExpectedDimensions = 0
+			case "unsupported":
+				input.Snapshot = input.Snapshot.Clone()
+				input.Snapshot.Parameters = json.RawMessage("{\"dimensions\":2}")
+			}
+			x, err := a.start(ctx, input, o, create)
+			if x != nil || err == nil || creates.Load() != 0 {
+				t.Fatal("pre-admission failure created a client or handle")
+			}
+			switch name {
+			case "cancelled":
+				requireModel(t, err, "cancelled", "wire_cancelled")
+			case "nil-context", "shape":
+				requireFault(t, err, f.InvalidArgument)
+			case "unsupported":
+				requireModel(t, err, "unsupported_feature", "wire_unsupported_feature")
+			case "sealed":
+				requireFault(t, err, f.ShuttingDown)
+			}
+		})
+	}
+	if active, _ := b.snapshot(); len(active) != 0 || !b.Joined() {
+		t.Fatal("preflight reserved a slot")
+	}
+	// The public Start shares that preflight/admission path and cannot reach
+	// a Client when the input is cancelled, unsupported or admission is sealed.
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	x, err := a.Start(ctx, r, o)
+	if x != nil {
+		t.Fatal("public cancelled Start returned a handle")
+	}
+	requireModel(t, err, "cancelled", "wire_cancelled")
+	var none *OpenAIEmbeddings
+	if x, err := none.Start(context.Background(), r, o); x != nil || err == nil {
+		t.Fatal("nil adapter")
+	}
