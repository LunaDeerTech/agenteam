 'tests/testsupport/outbound/cmd/server/main.go': 'existing wire path restriction, mode branching and original caps',
 'docs/development/backend/README.md': 'last documentation candidate existence and existing accepted scope',
}
files = {}
source_bytes = {}
for path, inspection in sources.items():
    data = git('show', f'{base}:{path}')
    source_bytes[path] = data
    files[path] = {'bytes': len(data), 'sha256': sha(data), 'inspection': inspection}

accepted = [
 'e6e94c4d5a42d3234a73954bc628930cac72350e',
 '9c72190fc1600f27c3607a3315854967ae008138',
 'be0bd07b1dc1fcd91ad217c9bdbfe5a14003ce74',
 'abf5c37fde852000a4fa3d17ca7b322c5cb1108e',
 'a94277982620f01dc15488b09ae6ea9064977b5a',
]
for commit in accepted:
    git('merge-base', '--is-ancestor', commit, base)

official = {}
records = json.loads((root/'official/fetch.json').read_text())['records'] + json.loads((root/'official/fetch-extra.json').read_text())['records']
for record in records:
    if record.get('status') == 200:
        path = 'official/' + record['file']
        data = (root/path).read_bytes()
        assert sha(data) == record['sha256'] and len(data) == record['bytes']
        official[path] = {'bytes': len(data), 'sha256': sha(data), 'revision': record['revision'], 'url': record['url'], 'actual_status': 200}
for path in ['official/fetch.json','official/fetch-extra.json','official/fetch-cookbook.json']:
    data = (root/path).read_bytes()
    official[path] = {'bytes': len(data), 'sha256': sha(data), 'kind': 'original public GET record; includes two unsuccessful proxy CONNECT attempts'}
assert len([r for r in records if r.get('status') == 200]) == 6
assert len([r for r in records if r.get('error_type')]) == 1
assert json.loads((root/'official/fetch-cookbook.json').read_text())['error_type'] == 'URLError'

raw = spec.read_bytes()
text = raw.decode('utf-8')
assert raw.endswith(b'\n') and b'\r' not in raw
assert all(line == line.rstrip() for line in text.splitlines())
assert re.findall(r'^## (\d+)\.', text, re.M) == [str(i) for i in range(1,8)]
paths = re.findall(r'^\| \d+ \| `([^`]+)` \|', text, re.M)
assert len(paths) == len(set(paths)) == 16
candidates = []
for path in paths:
    p = subprocess.run(['git','cat-file','-e',f'{base}:{path}'],cwd=repo,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    assert p.returncode in (0,128)
    old = p.returncode == 0
    candidates.append({'path': path, 'existing': old, 'base_sha256': sha(git('show',f'{base}:{path}')) if old else None})
assert sum(x['existing'] for x in candidates) == 4
assert {x['path'] for x in candidates if x['existing']} == {
 'internal/central/model/adapter/budget.go', 'internal/central/model/adapter/transport.go',
 'tests/testsupport/outbound/cmd/server/main.go', 'docs/development/backend/README.md'}
formal_dir = PurePosixPath('docs/development/work-items')
links = re.findall(r'\]\(([^)]+)\)', text)
resolved_links = []
for link in links:
    parts = []
    for part in (formal_dir/PurePosixPath(link)).parts:
        if part == '..': parts.pop()
        elif part != '.': parts.append(part)
    target = '/'.join(parts)
    git('cat-file','-e',f'{base}:{target}')
    resolved_links.append({'link':link,'fixed_git_target':target})
old_tops = [
 'TestModelOpenAIChatWireHTTP','TestModelOpenAIChatWireStream','TestModelOpenAIChatWireJoinAndBudget',
 'TestModelOpenAIChatStructuredHTTP','TestModelOpenAIChatStructuredStream','TestModelOpenAIChatStructuredCloseAndBudget']
top_sources = {}
for top in old_tops:
    found = [path for path,data in source_bytes.items() if path.startswith('tests/model/') and f'func {top}(t *testing.T)'.encode() in data]
    assert len(found) == 1, (top,found)
    top_sources[top] = found[0]
new_tops = ['TestModelOpenAIEmbeddingsWireHTTP','TestModelOpenAIEmbeddingsWireTerminal','TestModelOpenAIEmbeddingsWireBudget']
for top in new_tops:
    p = subprocess.run(['git','grep','-n',f'func {top}(',base,'--','tests/model'],cwd=repo,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    assert p.returncode == 1

tech = raw[raw.index(b'## 1.'):]
write('inputs.json', {'fixed_git':base,'files':files,'official':official,'accepted_dependencies_ancestor_checked':accepted,
 'scope':'Finite static references, not a product execution/compilation dependency closure; no source copies or cache copies.',
 'candidate_paths':candidates})
write('checks.json', {'scope':'document/source checks only; no implementation probe or product execution',
 'source_count':len(files),'official_source_count':6,'failed_public_GET_records':2,
 'candidate_count':len(candidates),'existing_candidates':4,'new_candidates':12,
 'utf8_lf_no_trailing_whitespace':True,'sections_1_to_7':True,'relative_links':resolved_links,
 'old_exact_tops':top_sources,'new_exact_tops_absent_in_base':new_tops,
 'parser_capacity_arithmetic':{'raw_max_bytes':16*1024*1024+1,'vectors_max_bytes':262144*8,'return_copy_max_bytes':262144*8,
 'aux_max_bytes':64*1024,'sum_bytes':16*1024*1024+1+2*262144*8+64*1024,'bound_bytes_exclusive':21*1024*1024},
 'full_sha256':sha(raw),'technical_sections_1_to_7_sha256':sha(tech),
 'product_checks_run':False,'resources_started':False,'main_or_git_writes':False})
