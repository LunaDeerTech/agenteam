 'AGENTS.md': 'accepted/stopped task and workflow clauses; inherited bounded review',
 '.agents/skills/agenteam-design/SKILL.md': 'design workflow',
 '.agents/skills/agenteam-go-development/SKILL.md': 'Go scope and future implementation checks',
