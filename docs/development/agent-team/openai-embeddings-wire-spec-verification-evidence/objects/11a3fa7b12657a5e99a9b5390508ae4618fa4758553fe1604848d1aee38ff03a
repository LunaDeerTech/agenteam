 'internal/central/model/adapter/transport_test.go': 'snapshot compatibility locator; no execution',
 'internal/central/model/adapter/structured_stream_test.go': 'snapshot compatibility locator; no execution',
 'internal/central/model/adapter/errors.go': 'safe error/request-ID and parser boundary helpers',
 'internal/central/outbound/profile.go': 'real body/time/header limits and origin credential binding',
