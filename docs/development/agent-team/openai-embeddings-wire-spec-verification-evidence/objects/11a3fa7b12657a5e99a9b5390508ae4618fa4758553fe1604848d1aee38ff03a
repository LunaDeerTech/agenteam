from pathlib import Path, PurePosixPath
import hashlib, json, re, subprocess

root = Path('/workspace/scratch/agenteam-openai-embeddings-spec-dszd_w7o')
repo = Path('/workspace/agenteam')
base = 'c1427fa4fb7fa118b12b2fb1f5d5f8917113ce2c'
spec = root / 'd09-openai-embeddings-wire.draft.md'

def sha(b): return hashlib.sha256(b).hexdigest()
def git(*args):
    return subprocess.run(['git', *args], cwd=repo, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE).stdout

def write(name, value):
    (root / name).write_text(json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + '\n')

