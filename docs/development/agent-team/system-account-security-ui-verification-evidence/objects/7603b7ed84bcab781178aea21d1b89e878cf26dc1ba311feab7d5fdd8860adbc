    expect(f.wrapper.text()).toContain(id(20))
    expect(f.wrapper.text()).not.toContain('embedding 20')
    expect(f.wrapper.text()).not.toContain('尚未配置平台模型用途')
    expect(f.wrapper.text()).not.toContain('untrusted detail')
    await dirty()
    expect(button('保存用途配置', dialog()).disabled).toBe(true)
    await click('保存用途配置', dialog())
    expect(f.writes()).toHaveLength(0)
    f.setProvider(async (path) => json(f.sources.get(path.split('/').at(-1)!)))
    await click('重读 Embedding', dialog())
    expect(button('保存用途配置', dialog()).disabled).toBe(false)
  })
  it('treats lookup as history, replays the exact original after current Model404, and keeps confirmation through failed GET', async () => {
    const f = await page()
    await dirty()
    f.setMutation(async () => {
      throw new Error('response lost')
    })
    await click('保存用途配置', dialog())
    const first = f.writes()[0]!
    expect(f.auth.system.selection.progress?.phase).toBe('uncertain')
    f.records.delete(id(20))
    f.setObserved({ id: id(100), version: '9', configured: { ...bindings(), embedding: id(25) } })
    f.setLookup(async () => json({ found: true, receipt: receipt() }))
    await click('检查原请求', dialog())
