function model(n: number, source: Provider): ProviderModel {
  const type = modelTypeForProtocol(source.input.protocol)
  return {
    id: id(n),
    provider_id: source.id,
    version: '1',
    created_at: time,
    updated_at: time,
    input: {
      name: `${type} ${n}`,
      provider_model_id: ` native ${n} `,
      type,
      enabled: true,
      parameters: {},
      request_overwrite: {},
      header_overwrite: {},
      capabilities: {
        tool_calls: false,
        parallel_tool_calls: false,
        streaming: false,
        reasoning: false,
        input_modalities: ['text'],
        output_modalities:
          type === 'reranker'
            ? []
            : [type === 'embedding' ? 'vector' : type === 'image_generation' ? 'image' : 'text'],
        reasoning_efforts: [],
        structured_output_modes: type === 'chat' ? ['json_schema'] : [],
        context_length: null,
        max_output: null,
      },
    },
  }
}
const bindings = () => ({ embedding: id(20), memory: id(21), reranker: id(22), image: id(23) })
const receipt = (version = '2') => ({
