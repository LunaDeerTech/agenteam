}


describe('independent account security fallback App', () => {
  it('checking/503 detaches the old View without heading fallback, then normal close uses the fresh same-identity title', async () => {
    const f = await screen()
    const oldView = f.wrapper.getComponent(SystemAccountSecurityView)
    const oldHeading = heading('账号安全') as HTMLElement
    expect(oldView.getComponent(UiDialog).props('fallbackFocus')).toBe(oldHeading)
    await edit('密码重置有效期（秒）', '3600')
    button('保存配置').focus()
    let finished = false
    const pending = f.router.push('/system/users').then(result => { finished = true; return result })
    await flushPromises(); dialog()
    const oldHeadingFocus = vi.spyOn(oldHeading, 'focus')
    const checking = gate<Response>(); f.sessionRequest(async () => checking.promise)
    const mark = f.calls.length
    window.dispatchEvent(new Event('pageshow')); await flushPromises()
    expect(document.querySelector('.session-check')).toBeTruthy()
    expect(f.wrapper.findComponent(SystemAccountSecurityView).exists()).toBe(false)
    expect(document.querySelectorAll('.ui-overlay')).toHaveLength(0)
    expect(oldHeading.isConnected).toBe(false)
    expect(oldHeadingFocus).not.toHaveBeenCalled()
    expect(finished).toBe(false)
    checking.resolve(problem('UNAVAILABLE')); await flushPromises()
    expect(heading('会话尚未确认')).toBeTruthy()
    expect(f.wrapper.findComponent(SystemAccountSecurityView).exists()).toBe(false)
    expect(oldHeadingFocus).not.toHaveBeenCalled()
    expect(button('检查当前会话').disabled).toBe(false)
    f.sessionRequest(async () => json(session())); await click('检查当前会话')
    const newView = f.wrapper.getComponent(SystemAccountSecurityView)
    const newHeading = heading('账号安全') as HTMLElement
    expect(newHeading).not.toBe(oldHeading)
    const newDialog = newView.getComponent(UiDialog)
    const dialogInstance = newDialog.vm
    expect(newDialog.props('fallbackFocus')).toBe(newHeading)
    const top = dialog()
    expect(top.contains(document.activeElement)).toBe(true)
    expect(field('密码重置有效期（秒）').value).toBe('3600')
    expect(f.calls.slice(mark).filter(c => c.path === '/api/v1/session')).toHaveLength(2)
    expect(finished).toBe(false); expect(f.writes()).toHaveLength(0)
    await click('继续编辑', top)
    expect(isNavigationFailure(await pending)).toBe(true)
    expect(f.router.currentRoute.value.path).toBe('/system/account-security')
    expect(document.querySelectorAll('.ui-overlay')).toHaveLength(0)
    expect(document.activeElement).toBe(newHeading)
    expect(newHeading.closest('[inert],[aria-hidden="true"]')).toBeNull()
    expect(newView.getComponent(UiDialog).vm).toBe(dialogInstance)
    expect(newView.getComponent(UiDialog).props('open')).toBe(false)
    expect(oldHeadingFocus).not.toHaveBeenCalled()
    expect(field('密码重置有效期（秒）').value).toBe('3600')
    expect(f.writes()).toHaveLength(0)
  })

  it('a new Session settles the prior confirmation false, destroys its View and lets only the new title receive mounted focus', async () => {
    const f = await screen()
    const oldView = f.wrapper.getComponent(SystemAccountSecurityView)
    const oldHeading = heading('账号安全') as HTMLElement
    const oldDialog = oldView.getComponent(UiDialog).vm
    await edit('密码重置有效期（秒）', '3600')
    button('保存配置').focus()
    const pending = f.router.push('/system/users'); await flushPromises(); dialog()
    const oldHeadingFocus = vi.spyOn(oldHeading, 'focus')
    const checking = gate<Response>(); f.sessionRequest(async () => checking.promise)
    window.dispatchEvent(new Event('pageshow')); await flushPromises()
    expect(f.wrapper.findComponent(SystemAccountSecurityView).exists()).toBe(false)
    expect(document.querySelectorAll('.ui-overlay')).toHaveLength(0)
    expect(oldHeading.isConnected).toBe(false)
    expect(oldHeadingFocus).not.toHaveBeenCalled()
    checking.resolve(json(session(3))); await flushPromises()
    expect(isNavigationFailure(await pending)).toBe(true)
    expect(f.router.currentRoute.value.path).toBe('/system/account-security')
    expect(f.auth.personalContext.identity?.sessionID).toBe(id(3))
    const currentView = f.wrapper.getComponent(SystemAccountSecurityView)
    const currentHeading = heading('账号安全') as HTMLElement
    expect(currentView.getComponent(UiDialog).vm).not.toBe(oldDialog)
    expect(currentView.getComponent(UiDialog).props('fallbackFocus')).toBe(currentHeading)
    expect(currentView.getComponent(UiDialog).props('open')).toBe(false)
    expect(currentHeading).not.toBe(oldHeading)
    expect(document.activeElement).toBe(currentHeading)
    expect(oldHeadingFocus).not.toHaveBeenCalled()
    expect(document.querySelectorAll('.ui-overlay')).toHaveLength(0)
    expect(field('密码重置有效期（秒）').value).toBe('300')
    expect(button('保存配置').disabled).toBe(true)
    expect(f.writes()).toHaveLength(0)
  })
})
