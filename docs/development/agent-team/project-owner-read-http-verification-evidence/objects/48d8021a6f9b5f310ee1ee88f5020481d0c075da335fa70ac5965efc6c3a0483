from pathlib import Path
import sys,json,hashlib
script=Path('/workspace/scratch/project-owner-read-http-verification/overlay02/check_real_body_schema.py')
opened=[]
def audit(event,args):
    if event=='open' and isinstance(args[0],str) and '/jsonschema_specifications/schemas/' in args[0]:
        opened.append(args[0])
sys.addaudithook(audit)
exec(compile(script.read_bytes(),str(script),'exec'),{'__name__':'frozen_schema_import','__file__':str(script)})
files={}
for module in list(sys.modules.values()):
    p=getattr(module,'__file__',None)
    if p and Path(p).is_file():
        files[str(Path(p).resolve())]=hashlib.sha256(Path(p).read_bytes()).hexdigest()
for p in opened:
    files[p]=hashlib.sha256(Path(p).read_bytes()).hexdigest()
print(json.dumps({'scope':'module import only; main not run; no body parsed or resources','files':files,'schema_data_opened':sorted(set(opened))},indent=2))
