// These observers neither replace SQL rows nor modify a physical CommitResult.
// The callback observer also sees failed callbacks, permitting a missing-target
// lock assertion before the original NotFound exits the real transaction.
type independentOwnerReadStore struct {
	*postgres.Store
	mu            sync.Mutex
	afterCallback func(context.Context, f.Tx, f.TransactionCause, error) error
	afterTerminal func(f.TransactionCause, f.CommitResult)
}

func (s *independentOwnerReadStore) WithinTx(ctx context.Context, cause f.TransactionCause, fn func(context.Context, f.Tx) error) f.CommitResult {
	s.mu.Lock()
	after, terminal := s.afterCallback, s.afterTerminal
	s.mu.Unlock()
	result := s.Store.WithinTx(ctx, cause, func(ctx context.Context, tx f.Tx) error {
		original := fn(ctx, tx)
		var observed error
		if after != nil {
			observed = after(ctx, tx, cause, original)
		}
		if original != nil {
			return original
		}
		return observed
	})
	if terminal != nil {
		terminal(cause, result)
	}
	return result
}

func (s *independentOwnerReadStore) observe(after func(context.Context, f.Tx, f.TransactionCause, error) error, terminal func(f.TransactionCause, f.CommitResult)) {
	s.mu.Lock()
	defer s.mu.Unlock()
	s.afterCallback, s.afterTerminal = after, terminal
}

func independentOwnerReadCause(cause f.TransactionCause, suffix string) bool {
	return cause.Kind() == f.RecoveryCause && cause.Details().Owner == "project."+suffix
}

func independentOwnerReadBind(t *testing.T, v *projectUsageHTTPFixture) (*project.Reader, *independentOwnerReadStore) {
