	t.Run("list-UserSH-before-formal-Logout", func(t *testing.T) {
		browser := v.login(t, v.ownerBrowser.email)
		user, _ := f.UserLock(browser.actor.Details().UserID)
		entered, release := make(chan struct{}), make(chan struct{})
		var once sync.Once
		unblock := func() { once.Do(func() { close(release) }) }
		var hit atomic.Bool
		observed.observe(func(ctx context.Context, tx f.Tx, cause f.TransactionCause, original error) error {
			if independentOwnerReadCause(cause, "list") && hit.CompareAndSwap(false, true) {
				if original != nil {
					return original
				}
				if err := v.raw.RequireHeldLocks(ctx, tx, []f.LockRequest{{Key: user, Mode: f.Shared}}); err != nil {
					return err
				}
				close(entered)
				select {
				case <-release:
					return nil
				case <-ctx.Done():
					return ctx.Err()
				}
			}
			return nil
		}, nil)
		ctx, cancel := context.WithCancel(testContext(t))
		flight := v.flight(ctx, browser, "/api/v1/projects?limit=1")
		defer func() { unblock(); cancel(); <-flight.done; observed.observe(nil, nil) }()
		waitSignal(t, entered)
		logoutCtx, logoutCancel := context.WithCancel(testContext(t))
		logoutDone := make(chan error, 1)
		key := f.IdempotencyKey(newID[struct{}](t).String())
		go func() { logoutDone <- v.core.Logout(logoutCtx, account.LogoutRequest{Actor: browser.actor, Key: key}) }()
		joined := false
		defer func() {
			unblock()
			logoutCancel()
			if !joined {
				<-logoutDone
			}
		}()
		managementWaitBlocked(t, &systemHTTPFixture{fixture: v.fixture}, user)
		if flight.writer.writeCount() != 0 {
			t.Fatal("list published before current Session transaction completed")
		}
		unblock()
		<-flight.done
		logoutErr := <-logoutDone
		joined = true
		if flight.aborted || logoutErr != nil {
			t.Fatal("actual read/logout completion", logoutErr)
		}
		flight.result().want(t, 200)
		observed.observe(nil, nil)
		v.request(t, browser, "GET", "/api/v1/projects?limit=1").problem(t, 401, f.SessionRevoked)
	})

	for _, missing := range []bool{false, true} {
		name := "detail-ProjectSH-through-terminal"
		if missing {
			name = "missing-detail-still-holds-ProjectSH"
		}
		t.Run(name, func(t *testing.T) {
			target := v.project.ID
			if missing {
				target = newID[id.Project](t)
			}
			independentOwnerProjectLock(t, v, observed, target, missing)
		})
	}

	t.Run("Committed-then-parent-cancel-drops-candidate", func(t *testing.T) {
		entered, release := make(chan struct{}), make(chan struct{})
		var once sync.Once
		unblock := func() { once.Do(func() { close(release) }) }
		var hit atomic.Bool
		var committed atomic.Bool
		observed.observe(nil, func(cause f.TransactionCause, result f.CommitResult) {
			if independentOwnerReadCause(cause, "get") && hit.CompareAndSwap(false, true) {
				committed.Store(result.State() == f.Committed)
				close(entered)
				<-release // returned physical result is never decorated
			}
		})
		ctx, cancel := context.WithTimeout(testContext(t), 150*time.Millisecond)
		flight := v.flight(ctx, v.ownerBrowser, independentOwnerReadPath(v.project.ID))
		defer func() { unblock(); cancel(); <-flight.done; observed.observe(nil, nil) }()
		waitSignal(t, entered)
		<-ctx.Done()
		if !errors.Is(ctx.Err(), context.DeadlineExceeded) || !committed.Load() {
			t.Fatal("real committed / earlier-parent ordering not reached")
		}
		select {
		case <-flight.done:
			t.Fatal("handler returned before actual terminal observer completed")
		default:
		}
		if flight.writer.writeCount() != 0 {
			t.Fatal("cancelled request published before terminal join")
		}
		unblock()
		<-flight.done
		if !flight.aborted || len(flight.writer.Body.Bytes()) != 0 {
			t.Fatal("committed but cancelled candidate was published")
		}
	})

	t.Run("actual-reader-COMMIT-ACK-loss", func(t *testing.T) {
		independentOwnerPhysicalUnknown(t, v)
	})
}

func independentOwnerProjectLock(t *testing.T, v *projectUsageHTTPFixture, observed *independentOwnerReadStore, target pc.ProjectID, missing bool) {
	t.Helper()
	user, _ := f.UserLock(v.ownerBrowser.actor.Details().UserID)
	key, _ := f.ProjectLock(target.String())
	entered, release := make(chan struct{}), make(chan struct{})
	var once sync.Once
	unblock := func() { once.Do(func() { close(release) }) }
	var hit atomic.Bool
	lockObserved := make(chan error, 1)
	observed.observe(func(ctx context.Context, tx f.Tx, cause f.TransactionCause, original error) error {
		if independentOwnerReadCause(cause, "get") && hit.CompareAndSwap(false, true) {
			err := v.raw.RequireHeldLocks(ctx, tx, []f.LockRequest{{Key: user, Mode: f.Shared}, {Key: key, Mode: f.Shared}})
			lockObserved <- err
			close(entered)
			select {
			case <-release:
				return err
			case <-ctx.Done():
				return ctx.Err()
			}
		}
		return nil
	}, nil)
	ctx, cancel := context.WithCancel(testContext(t))
	flight := v.flight(ctx, v.ownerBrowser, independentOwnerReadPath(target))
	defer func() { unblock(); cancel(); <-flight.done; observed.observe(nil, nil) }()
	waitSignal(t, entered)
	if err := <-lockObserved; err != nil {
		t.Fatal("detail/missing-target lock was not actually held", err)
	}
	writeCtx, writeCancel := context.WithCancel(testContext(t))
	writeDone := make(chan f.CommitResult, 1)
	cause := recoveryCause(t)
	go func() {
		writeDone <- v.raw.WithinTx(writeCtx, cause, func(ctx context.Context, tx f.Tx) error {
			return v.raw.AcquireAll(ctx, tx, []f.LockRequest{{Key: key, Mode: f.Exclusive}})
		})
	}()
	joined := false
	defer func() {
		unblock()
		writeCancel()
		if !joined {
			<-writeDone
		}
	}()
	managementWaitBlocked(t, &systemHTTPFixture{fixture: v.fixture}, key)
	if flight.writer.writeCount() != 0 {
		t.Fatal("detail published before actual SH owner terminal")
	}
	unblock()
	<-flight.done
	result := <-writeDone
	joined = true
	if flight.aborted || result.State() != f.Committed {
		t.Fatal("detail/EX actual terminal", result.Fault())
	}
	if missing {
		flight.result().problem(t, 404, f.NotFound)
	} else {
		flight.result().want(t, 200)
	}
}

func independentOwnerPhysicalUnknown(t *testing.T, v *projectUsageHTTPFixture) {
	t.Helper()
	trace := newProjectModelPGTrace(t, net.JoinHostPort("127.0.0.1", v.db.Fixture.Port))
	u, err := url.Parse(v.db.Fixture.URL(v.db.Name))
	if err != nil {
		t.Fatal("owned database URL parse")
	}
	u.Host = trace.listener.Addr().String()
	raw := openStore(t, v.db.Config(t, map[string]string{"URL": u.String(), "TLS_MODE": "disable"}))
	store := &independentOwnerReadStore{Store: raw}
	ak, ck, _ := testKeys(t)
	// A different physical Store needs its own real Account Authority. Existing
	// identities/sessions are read from the same persisted formal account rows.
	accounts, err := account.NewAuthority(store, ak)
	if err != nil {
		t.Fatal(err)
	}
	if err = accounts.Initialize(testContext(t)); err != nil {
		t.Fatal(err)
	}
	authority, err := project.NewAuthority(store, project.AuthorityDependencies{Sessions: accounts, Routes: accounts})
	if err != nil {
		t.Fatal(err)
	}
	reader, err := project.NewReader(store, authority, ck)
	if err != nil {
		t.Fatal(err)
	}
	user, _ := f.UserLock(v.ownerBrowser.actor.Details().UserID)
	key, _ := f.ProjectLock(v.project.ID.String())
	var armed atomic.Bool
	var original f.CommitResult
	store.observe(func(ctx context.Context, tx f.Tx, cause f.TransactionCause, callbackErr error) error {
		if !independentOwnerReadCause(cause, "get") || callbackErr != nil || !armed.CompareAndSwap(false, true) {
			return nil
		}
		if err := raw.RequireHeldLocks(ctx, tx, []f.LockRequest{{Key: user, Mode: f.Shared}, {Key: key, Mode: f.Shared}}); err != nil {
			return err
		}
		trace.dropCommitACK.Store(true)
		return nil
	}, func(cause f.TransactionCause, result f.CommitResult) {
		if independentOwnerReadCause(cause, "get") {
			original = result
		}
	})
	defer store.observe(nil, nil)
	ref, err := reader.GetProject(testContext(t), v.ownerBrowser.actor, v.project.ID)
	attempt, ok := project.UnknownAttempt(err)
	if !ok || !armed.Load() || original.State() != f.Unknown || attempt.AttemptID() != original.AttemptID() || !reflect.DeepEqual(attempt.Cause().Details(), original.Cause().Details()) || !reflect.DeepEqual(ref, pc.ProjectRef{}) {
		t.Fatal("physical Reader Unknown identity or zero candidate was lost")
	}
	select {
	case <-trace.ackDropped:
	default:
		t.Fatal("no actual COMMIT+idle ACK loss")
	}
	if !strings.Contains(strings.Join(trace.snapshot(), " "), "commit-idle-ack-dropped") {
		t.Fatal("missing safe PG protocol phase")
	}
	// A separate real EX acquisition proves the original read transaction no
	// longer owns the Project lock; it does not confirm/recover an Unknown read.
	result := v.raw.WithinTx(testContext(t), recoveryCause(t), func(ctx context.Context, tx f.Tx) error {
		return v.raw.AcquireAll(ctx, tx, []f.LockRequest{{Key: key, Mode: f.Exclusive}})
	})
	if result.State() != f.Committed {
		t.Fatal("original read transaction remained live", result.Fault())
	}
	t.Log("actual Reader COMMIT+idle ACK loss; original UnknownAttempt retained; no candidate; transaction lock released")
}

func TestIndependentProjectOwnerReadRootAndWire(t *testing.T) {
	v := newProjectUsageHTTPFixture(t)
	invocation := v.success(t, json.RawMessage(`{"prompt_tokens":17,"completion_tokens":0,"total_tokens":17}`), nil)
	root := startProjectUsageRoot(t, v) // actual default app.Run, no handler injection
	listPath := "/api/v1/projects?limit=1&lifecycle=active"
	detailPath := independentOwnerReadPath(v.project.ID)
	list := root.request(t, v.ownerBrowser, "GET", listPath, nil).want(t, 200)
	detail := root.request(t, v.ownerBrowser, "GET", detailPath, nil).want(t, 200)
	var page struct {
		Items []map[string]json.RawMessage `json:"items"`
		Next  json.RawMessage              `json:"next_cursor"`
	}
	if json.Unmarshal(list.body, &page) != nil || len(page.Items) != 1 || !bytes.Equal(page.Next, []byte("null")) {
		t.Fatal("real root list shell differs")
	}
	for _, field := range []string{"id", "name", "lifecycle", "version", "description"} {
		if page.Items[0][field] == nil {
			t.Fatal("missing active list field", field)
		}
	}
	if len(page.Items[0]) != 5 {
		t.Fatal("active list leaked hidden fields")
	}
	var object map[string]json.RawMessage
	if json.Unmarshal(detail.body, &object) != nil || len(object) != 11 || !bytes.Equal(object["current_sprint_id"], []byte("null")) || !bytes.Equal(object["archived_at"], []byte("null")) {
		t.Fatal("real detail nullable/closed projection differs")
	}
	for name, body := range map[string]json.RawMessage{"list-version": page.Items[0]["version"], "detail-version": object["version"]} {
		var version string
		if json.Unmarshal(body, &version) != nil || version == "" {
			t.Fatal(name, "was not a version string")
		}
	}
	for _, p := range []struct {
		path string
		get  systemHTTPResponse
	}{{listPath, list}, {detailPath, detail}} {
		head := root.request(t, v.ownerBrowser, "HEAD", p.path, nil).want(t, 200)
		if len(head.body) != 0 || head.headers.Get("Content-Length") != p.get.headers.Get("Content-Length") {
			t.Fatal("HEAD did not preserve full GET representation length")
		}
	}
	independentOwnerSaveBody(t, "owner-list", listPath, "", list)
	independentOwnerSaveBody(t, "owner-detail", detailPath, v.project.ID.String(), detail)

	oldResolve := projectUsageResolve(v.ownerName, v.project.Name)
	root.request(t, v.ownerBrowser, "GET", oldResolve, nil).want(t, 200)
	usagePath := projectUsagePath(v.project.ID) // accepted actual /model-usage spelling
	usage := root.request(t, v.ownerBrowser, "GET", usagePath, nil).want(t, 200)
	if !bytes.Contains(usage.body, []byte(invocation.event.Identity.Attempt.InvocationID.String())) {
		t.Fatal("nested old Usage handler did not read its actual ledger")
	}
	root.request(t, v.ownerBrowser, "GET", usagePath+"/summary?group_by=day", nil).want(t, 200)
	root.request(t, v.adminBrowser, "GET", detailPath, nil).problem(t, 404, f.NotFound)
	root.request(t, v.ownerBrowser, "GET", "/api/v1/projects/not-a-uuid", nil).problem(t, 400, f.InvalidArgument)
	for _, path := range []string{"/api/v1/projects/", detailPath + "/unowned-tail"} {
		response := root.request(t, v.ownerBrowser, "GET", path, nil)
		if response.status != 404 {
			t.Fatal("nonmatching path was claimed by new read dispatcher")
		}
	}
	method := root.request(t, v.ownerBrowser, "POST", detailPath, nil)
	if method.status != 405 || method.headers.Get("Allow") != "GET, HEAD" {
		t.Fatal("exact read route method boundary")
	}
	if root.connections.Load() != 1 {
		t.Fatal("sequential read/HEAD/old route responses lost keepalive")
	}
	root.stop(t)
	if !strings.Contains(root.logs.String(), `"outcome":"drained"`) {
		t.Fatal("default root did not actually drain")
	}
}

// Exact body bytes are written once, before any schema process sees them. Only
// safe source metadata is persisted; no complete HTTP header map is retained.
func independentOwnerSaveBody(t *testing.T, name, path, target string, response systemHTTPResponse) {
	t.Helper()
	dir := os.Getenv("AGENTEAM_D08_SAFE_HTTP_DIR")
	run := os.Getenv("AGENTEAM_D08_SOURCE_RUN")
	inputHash := os.Getenv("AGENTEAM_D08_FROZEN_INPUT_SHA256")
	if dir == "" || !filepath.IsAbs(dir) || run == "" || len(inputHash) != 64 {
		t.Fatal("explicit safe evidence binding missing")
	}
	if _, err := hex.DecodeString(inputHash); err != nil {
		t.Fatal("invalid frozen input hash")
	}
	info, err := os.Lstat(dir)
	if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
		t.Fatal("safe evidence directory must already exist")
	}
	if response.status != 200 || response.headers.Get("Content-Type") != "application/json" {
		t.Fatal("unexpected real source response")
	}
	write := func(suffix string, data []byte) {
		file, err := os.OpenFile(filepath.Join(dir, name+suffix), os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
		if err != nil {
			t.Fatal("safe evidence output already exists or cannot be opened")
		}
		_, writeErr := file.Write(data)
		closeErr := file.Close()
		if writeErr != nil || closeErr != nil {
			t.Fatal("safe evidence actual write/close failed")
		}
	}
	sum := sha256.Sum256(response.body)
	metadata := map[string]any{"method": "GET", "path": path, "target_id": target, "status": response.status, "content_type": response.headers.Get("Content-Type"), "content_length": response.headers.Get("Content-Length"), "body_sha256": hex.EncodeToString(sum[:]), "body_bytes": len(response.body), "source_run": run, "producer_test": t.Name(), "frozen_input_sha256": inputHash}
	raw, err := json.MarshalIndent(metadata, "", "  ")
	if err != nil {
		t.Fatal(err)
	}
	write(".json", response.body)
	write("-source.json", append(raw, '\n'))
}
