	defer observed.observe(nil, nil)

	t.Run("cursor-is-user-and-filter-bound-not-session-or-limit", func(t *testing.T) {
		refs := []pc.ProjectRef{v.project, v.createProject(t, v.owner), v.createProject(t, v.owner)}
