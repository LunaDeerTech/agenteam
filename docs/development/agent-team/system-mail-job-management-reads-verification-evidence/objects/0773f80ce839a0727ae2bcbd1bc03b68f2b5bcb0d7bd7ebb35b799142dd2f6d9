#!/usr/bin/env python3
import hashlib,json,os,pathlib,subprocess,sys,time
root=pathlib.Path(__file__).resolve().parent
work=root/'workspace'
name=sys.argv[1]; command=sys.argv[2:]
run=root/'runs'/name
run.mkdir()
paths=json.loads((root/'authorized-paths.json').read_text())
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def inputs():
 return {p:sha(work/p) if (work/p).is_file() else None for p in paths}
for p in paths:
 src=work/p
 if src.is_file():
  dest=run/'source'/p;dest.parent.mkdir(parents=True,exist_ok=True);dest.write_bytes(src.read_bytes())
env=os.environ.copy();env.update({'GOTOOLCHAIN':'local','GOPROXY':'off','GOSUMDB':'off','GOFLAGS':'-mod=readonly','GOENV':'off','GOWORK':'off','GOMODCACHE':'/workspace/scratch/agenteam-d27-directory-author-EvHmqxns/modcache','GOCACHE':str(root/'gocache'),'TMPDIR':str(root/'tmp')})
tracked={k:env[k] for k in ['GOTOOLCHAIN','GOPROXY','GOSUMDB','GOFLAGS','GOENV','GOWORK','GOMODCACHE','GOCACHE','TMPDIR']}
before=inputs();(run/'input-before.json').write_text(json.dumps(before,indent=2)+'\n')
(run/'command.json').write_text(json.dumps({'command':command,'cwd':str(work),'env':tracked},indent=2)+'\n')
start=time.monotonic()
with (run/'raw.log').open('wb') as log:
 p=subprocess.Popen(command,cwd=work,env=env,stdout=log,stderr=subprocess.STDOUT)
 code=p.wait()
after=inputs();(run/'input-after.json').write_text(json.dumps(after,indent=2)+'\n')
result={'exit_code':code,'actual_wait':True,'seconds':round(time.monotonic()-start,3),'input_unchanged':before==after,'raw_sha256':sha(run/'raw.log')}
(run/'result.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result));sys.exit(code)
