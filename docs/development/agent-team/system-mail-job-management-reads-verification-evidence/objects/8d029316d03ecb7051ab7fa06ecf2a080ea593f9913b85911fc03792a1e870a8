#!/usr/bin/env python3
"""Freeze already-stopped source and discover compiler inputs without fixtures."""
import difflib
import hashlib
import importlib.util
import json
from pathlib import Path
import sys

sys.dont_write_bytecode = True
root = Path(__file__).resolve().parent
driver = root / 'run-mail-management-fixture.py'
stage = root / 'driver-stage01'
stage.mkdir()
sha = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()
spec = importlib.util.spec_from_file_location('fixture_driver', driver)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
product = root / 'input02/manifest.json'
source = json.loads(product.read_text())
tree_raw, tree = module.fixed_tree()
selected = {name: row | {'sha256': source['dependencies'][name]}
            for name, row in tree.items() if name in source['dependencies']}
assert len(selected) == len(source['dependencies']) == 935
baseline = {'product_base': module.BASE,
            'git_tree_sha256': hashlib.sha256(tree_raw).hexdigest(), 'files': selected}
module.FROZEN = {'files': source['files'], 'accepted_baseline': baseline}
actual_baseline = module.accepted_baseline_input()
assert actual_baseline['accepted'], actual_baseline
runtime = module.runtime_input()
frozen = {'product_base': module.BASE,
          'product_manifest': {'path': str(product), 'sha256': sha(product)},
          'driver_sha256': sha(driver),
          'files': source['files'], 'accepted_baseline': baseline, 'runtime': runtime}
(stage / 'input.json').write_text(json.dumps(frozen, indent=2, sort_keys=True) + '\n')
(stage / 'driver.py.txt').write_bytes(driver.read_bytes())
previous = root / 'driver-selection-base.py.txt'
delta = ''.join(difflib.unified_diff(previous.read_text().splitlines(True), driver.read_text().splitlines(True),
                                    fromfile='accepted-selection-driver.py', tofile='mail-management-driver.py'))
(stage / 'driver.diff').write_text(delta)
print(json.dumps({'input_sha256': sha(stage / 'input.json'), 'driver_sha256': sha(driver),
                  'base_driver_sha256': sha(previous), 'diff_sha256': sha(stage / 'driver.diff'),
                  'source_count': len(frozen['files']), 'accepted_dependencies': len(selected),
                  'runtime_files': len(runtime['files']), 'runtime_packages': len(runtime['packages']),
                  'runtime_modules': len(runtime['modules']), 'resources_started': False}))
