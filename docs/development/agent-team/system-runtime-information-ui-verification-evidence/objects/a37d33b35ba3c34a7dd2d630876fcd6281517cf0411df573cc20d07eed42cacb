describe('Runtime Information is the optional twelfth API on the actual Cookie owner', () => {
  it('keeps eleven-position callers compatible and exposes only a fixed read and abandon', async () => {
    const f = await fixture(undefined, true),
      random = vi.spyOn(crypto, 'randomUUID')
    const value = await f.auth.system.runtimeInformation.get()
    expect(value.readiness.ready).toBe(false)
    expect(f.reads()).toHaveLength(1)
    const [path, init] = f.reads()[0]!
    expect(
      path === endpoint &&
        init.method === 'GET' &&
        init.body === undefined &&
        !new Headers(init.headers).has('X-CSRF-Token') &&
        !new Headers(init.headers).has('Idempotency-Key'),
    ).toBe(true)
    expect(Object.keys(f.auth.system.runtimeInformation).sort().join(',')).toBe('abandon,get')
    expect(random).not.toHaveBeenCalled()
    expect(f.writes()).toHaveLength(0)
  })

  it.each(domains)(
    'waits for $name actual native cancel and cannot abandon that owner',
    async (domain) => {
      const f = await fixture(),
        held = nativeHold('text/plain')
      let signal: AbortSignal | undefined
      const fetcher: Fetch = async (_path, init) => {
        signal = init.signal
        return held.response()
      }
      f.setOther(fetcher)
      f.setSMTP(fetcher)
      f.setOutbound(fetcher)
      const pending = resultOf(domain.read(f.auth))
      try {
        await held.entered.promise
        const count = f.fetcher.mock.calls.length
        await expect(f.auth.system.runtimeInformation.get()).rejects.toMatchObject({ kind: 'busy' })
        f.auth.system.runtimeInformation.abandon()
        expect(
          signal?.aborted === false &&
            f.auth.state.busy &&
            !held.joined() &&
            f.fetcher.mock.calls.length === count,
        ).toBe(true)
      } finally {
        held.release()
        await pending
        await flushPromises()
      }
      expect(held.joined() && !held.stream.locked && !f.auth.state.busy).toBe(true)
      await f.auth.system.runtimeInformation.get()
      expect(f.reads()).toHaveLength(1)
    },
  )

  it('blocks all eleven domains and auth entry while Runtime cancel is actually held', async () => {
    const f = await fixture(),
      held = nativeHold('text/plain')
    f.setRuntime(async () => held.response())
    const pending = resultOf(f.auth.system.runtimeInformation.get())
    try {
      await held.entered.promise
      const signal = f.reads()[0]![1].signal!,
        count = f.fetcher.mock.calls.length
      for (const domain of domains) {
        await expect(domain.read(f.auth)).rejects.toMatchObject({ kind: 'busy' })
        domain.abandon(f.auth)
        expect(signal.aborted).toBe(false)
      }
      await f.auth.restore()
      await f.auth.logout()
      await expect(f.auth.entry.prepare()).rejects.toMatchObject({ kind: 'busy' })
      expect(f.fetcher.mock.calls.length === count && f.auth.state.busy).toBe(true)
      f.auth.system.runtimeInformation.abandon()
      expect((await pending).error).toMatchObject({ kind: 'cancelled' })
      expect(signal.aborted && f.auth.state.busy && !held.joined()).toBe(true)
    } finally {
      held.release()
      await pending
      await flushPromises()
    }
    expect(held.joined() && !f.auth.state.busy).toBe(true)
  })

  it('keeps ownership after the virtual 30-second visible bound until real reader cancellation joins', async () => {
    const f = await fixture(),
      held = nativeHold('application/json', sample())
    vi.useFakeTimers({ toFake: ['setTimeout', 'clearTimeout'] })
    f.setRuntime(async () => held.response())
    const page = f.page()
    try {
      await flushPromises()
      expect(page.state.phase === 'loading' && page.state.observation === null).toBe(true)
      await vi.advanceTimersByTimeAsync(30_000)
      await held.entered.promise
      expect(
        page.state.phase === 'error' && page.blocked.value && f.auth.state.busy && !held.joined(),
      ).toBe(true)
      await expect(f.auth.system.audit.list({})).rejects.toMatchObject({ kind: 'busy' })
      await page.refresh()
      expect(f.reads()).toHaveLength(1)
    } finally {
      held.release()
      await flushPromises()
    }
    expect(
      held.joined() &&
        !held.stream.locked &&
        !f.auth.state.busy &&
        page.state.phase === 'error' &&
        f.reads().length === 1,
    ).toBe(true)
  })

  it('does not release a synchronous successor from the old actual finally', async () => {
    const f = await fixture(),
      first = nativeHold('application/json', sample()),
      second = nativeHold('text/plain')
    let calls = 0
    f.setRuntime(async () => (++calls === 1 ? first.response() : second.response()))
    const old = resultOf(f.auth.system.runtimeInformation.get())
    let next: ReturnType<typeof resultOf> | undefined
    const stop = watch(
      () => f.auth.state.busy,
      (busy) => {
        if (!busy && !next) next = resultOf(f.auth.system.runtimeInformation.get())
      },
      { flush: 'sync' },
    )
    try {
      await flushPromises()
      first.controller.close()
      await old
      await second.entered.promise
      expect(f.auth.state.busy && f.reads().length === 2 && !second.joined()).toBe(true)
      await expect(f.auth.system.audit.list({})).rejects.toMatchObject({ kind: 'busy' })
    } finally {
      stop()
      first.release()
      second.release()
      await old
      await next
      await flushPromises()
    }
    expect(second.joined() && !f.auth.state.busy).toBe(true)
  })

  it.each(['smtp-settings', 'outbound'] as const)(
    'preserves the original %s unknown material through Runtime reads and local abandonment',
    async (domain) => {
      const f = await fixture(),
        response = barrier<Response>()
      releases.push(() => response.resolve(problem('COMMIT_UNKNOWN', 503, 'unknown')))
      const oldFetch: Fetch = async (_p, init) =>
        init.method === 'GET'
          ? json(domain === 'smtp-settings' ? settings() : { version: '1', rules: [] })
          : response.promise
      if (domain === 'smtp-settings') f.setSMTP(oldFetch)
      else f.setOutbound(oldFetch)
      const random = vi.spyOn(crypto, 'randomUUID')
      const owner = domain === 'smtp-settings' ? f.auth.system.smtp : f.auth.system.outboundPolicy
      if (domain === 'smtp-settings') f.auth.system.smtp.setMaterial(' private synthetic password ')
      const pending = resultOf(
        domain === 'smtp-settings'
          ? f.auth.system.smtp.startUpdate({
              ...smtpFields(),
              username: 'smtp-user',
              version: '1',
              credential_action: 'keep',
            })
          : f.auth.system.outboundPolicy.startUpdate({ expected_version: '1', rules: [] }),
      )
      try {
        await flushPromises()
        const original = f.writes()[0]![1]
        f.auth.system.runtimeInformation.abandon()
        await expect(f.auth.system.runtimeInformation.get()).rejects.toMatchObject({ kind: 'busy' })
        expect(original.signal?.aborted === false && f.writes().length === 1).toBe(true)
        response.resolve(problem('COMMIT_UNKNOWN', 503, 'unknown'))
        await pending
        expect(owner.progress?.phase).toBe('uncertain')
        f.setRuntime(async () => problem('DEPENDENCY_UNAVAILABLE'))
        const page = f.page()
        await flushPromises()
        page.leave()
        page.dispose()
        f.auth.system.runtimeInformation.abandon()
        expect(owner.progress?.phase).toBe('uncertain')
        if (domain === 'smtp-settings') expect(f.auth.system.smtp.material.present).toBe(true)
        await owner.checkOriginal()
        expect(owner.progress?.canRetryOriginal).toBe(true)
        await resultOf(owner.retryOriginal())
        const writes = f.writes(),
          repeated = writes[1]![1]
        expect(
          writes.length === 2 &&
            original.method === repeated.method &&
            original.body === repeated.body &&
            new Headers(original.headers).get('Idempotency-Key') ===
              new Headers(repeated.headers).get('Idempotency-Key') &&
            new Headers(original.headers).get('X-CSRF-Token') ===
              new Headers(repeated.headers).get('X-CSRF-Token'),
        ).toBe(true)
        expect(random).toHaveBeenCalledTimes(1)
      } finally {
        response.resolve(problem('COMMIT_UNKNOWN', 503, 'unknown'))
        await pending
        await flushPromises()
      }
    },
  )
})

describe('Runtime identity and Problem qualification', () => {
  it.each(['UNAUTHENTICATED', 'SESSION_REVOKED'])(
    'clears the same identity for legal 401 %s',
    async (code) => {
      const f = await fixture()
      f.auth.system.smtp.setMaterial(' synthetic private value ')
      f.setRuntime(async () => problem(code, 401))
      const page = f.page()
      await flushPromises()
      expect(
        f.auth.state.phase === 'unavailable' &&
          f.auth.personalContext.identity === null &&
          page.state.phase === 'inactive' &&
          page.state.observation === null &&
          !f.auth.system.smtp.material.present &&
          !f.auth.state.busy,
      ).toBe(true)
      expect(f.writes()).toHaveLength(0)
    },
  )
  it('clears current system permission and private material for legal current 403 FORBIDDEN', async () => {
    const f = await fixture()
    f.auth.system.smtp.setMaterial(' synthetic private value ')
    f.setRuntime(async () => problem('FORBIDDEN', 403))
    const page = f.page()
    await flushPromises()
    expect(
      f.auth.state.phase === 'authenticated' &&
        f.auth.system.denied &&
        page.state.phase === 'forbidden' &&
        page.state.observation === null &&
        !f.auth.system.smtp.material.present &&
        !f.auth.state.busy,
    ).toBe(true)
    await expect(f.auth.system.runtimeInformation.get()).rejects.toMatchObject({
      kind: 'invalid-input',
    })
    expect(f.writes()).toHaveLength(0)
  })
  it.each([
    [401, 'FORBIDDEN'],
    [403, 'UNAUTHENTICATED'],
    [403, 'SESSION_REVOKED'],
    [403, 'CSRF_FAILED'],
    [401, 'UNRECOGNIZED'],
    [503, 'FORBIDDEN'],
  ] as const)(
    'treats %s/%s as read failure without inferring identity loss',
    async (status, code) => {
      const f = await fixture(),
        identity = f.auth.personalContext.identity
      f.setRuntime(async () => problem(code, status))
      const page = f.page()
      await flushPromises()
      expect(
        f.auth.state.phase === 'authenticated' &&
          f.auth.personalContext.identity === identity &&
          !f.auth.system.denied &&
          page.state.phase === 'error' &&
          page.state.observation === null &&
          !f.auth.state.busy,
      ).toBe(true)
      expect(f.writes()).toHaveLength(0)
    },
  )
  it('requires a validated Problem kind rather than an attached numeric status or code', async () => {
    const f = await fixture({
        get: async () => {
          throw new AccountFailure('transport', problemValue('FORBIDDEN', 403))
        },
      }),
      identity = f.auth.personalContext.identity
    await resultOf(f.auth.system.runtimeInformation.get())
    expect(f.auth.personalContext.identity === identity && !f.auth.system.denied).toBe(true)
  })
  it.each([401, 403] as const)(
    'handles an already-parsed late %s after local abandon by its own safety rule',
    async (status) => {
      const answer = barrier(),
        entered = barrier()
      releases.push(() => answer.resolve())
      const f = await fixture({
        get: async () => {
          entered.resolve()
          await answer.promise
          throw new AccountFailure(
            'problem',
            problemValue(status === 401 ? 'SESSION_REVOKED' : 'FORBIDDEN', status),
          )
        },
      })
      const page = f.page()
      try {
        await entered.promise
        page.cancel()
        expect(page.state.phase === 'error' && f.auth.state.busy).toBe(true)
      } finally {
        answer.resolve()
        await flushPromises()
      }
      expect(
        status === 401
          ? f.auth.state.phase === 'unavailable' && page.state.phase === 'inactive'
          : f.auth.state.phase === 'authenticated' &&
              !f.auth.system.denied &&
              page.state.phase === 'error',
      ).toBe(true)
      expect(page.state.observation === null && !f.auth.state.busy).toBe(true)
    },
  )
  it('keeps the old actual owner after global retirement and cannot clear the later Session', async () => {
    const answer = barrier(),
      entered = barrier()
    let calls = 0
    releases.push(() => answer.resolve())
    const f = await fixture({
      get: async () => {
        if (++calls === 1) {
          entered.resolve()
          await answer.promise
          throw new AccountFailure('problem', problemValue('SESSION_REVOKED', 401))
        }
        return createSystemRuntimeInformationAPI(async () => json(sample())).get(
          new AbortController().signal,
        )
      },
    })
    const old = f.page()
    try {
      await entered.promise
      f.auth.leave()
      f.setSession(view(id(20)))
      const before = f.fetcher.mock.calls.length
      await f.auth.restore()
      expect(
        f.auth.state.busy &&
          f.fetcher.mock.calls.length === before &&
          old.state.phase === 'inactive' &&
          old.state.observation === null,
      ).toBe(true)
    } finally {
      answer.resolve()
      await flushPromises()
    }
    await f.auth.restore()
    const next = f.page()
    await flushPromises()
    expect(
      f.auth.state.phase === 'authenticated' &&
        f.auth.personalContext.identity?.sessionID === id(20) &&
        !f.auth.system.denied &&
        next.state.phase === 'ready' &&
        old.state.phase === 'inactive',
    ).toBe(true)
  })
})

describe('Runtime observations belong to one page instance', () => {
  it('publishes only after EOF and clears the old observation on every new read and failure', async () => {
    const f = await fixture(),
      page = f.page()
    await flushPromises()
    expect(page.state.phase).toBe('ready')
    const held = nativeHold('application/json', sample())
    f.setRuntime(async () => held.response())
    const pending = page.refresh()
    try {
      await flushPromises()
      expect(
        page.state.phase === 'loading' && page.state.observation === null && f.auth.state.busy,
      ).toBe(true)
      held.controller.close()
      await pending
      expect(page.state.phase === 'ready' && page.state.observation !== null).toBe(true)
    } finally {
      held.release()
      await pending
    }
    f.setRuntime(async () => json({}))
    await page.refresh()
    expect(page.state.phase === 'error' && page.state.observation === null).toBe(true)
    const before = f.reads().length
    await flushPromises()
    expect(f.reads()).toHaveLength(before)
    f.setRuntime(async () => json(sample()))
    await page.refresh()
    expect(f.reads().length === before + 1 && page.state.phase === 'ready').toBe(true)
    expect(f.writes()).toHaveLength(0)
  })
  it('cancel before dispatch consumes initial eligibility without leaving a loading state', async () => {
    const f = await fixture(),
      page = f.page()
    page.cancel()
    expect(page.state.phase === 'error' && page.state.observation === null).toBe(true)
    await flushPromises()
    expect(f.reads().length === 0 && !f.auth.state.busy && page.state.phase === 'error').toBe(true)
    await page.refresh()
    expect(f.reads().length === 1 && page.state.phase === 'ready').toBe(true)
  })
  it('cancelled reading remains error after actual tail release and only an explicit read recovers', async () => {
    const f = await fixture(),
      held = nativeHold('application/json', sample())
    f.setRuntime(async () => held.response())
    const page = f.page()
    try {
      await flushPromises()
      page.cancel()
      expect(
        page.state.phase === 'error' && page.state.observation === null && page.blocked.value,
      ).toBe(true)
      await held.entered.promise
      await page.refresh()
      expect(f.reads().length === 1 && f.auth.state.busy && !held.joined()).toBe(true)
    } finally {
      held.release()
      await flushPromises()
    }
    expect(
      held.joined() && !held.stream.locked && !f.auth.state.busy && f.reads().length === 1,
    ).toBe(true)
    f.setRuntime(async () => json(sample()))
    await page.refresh()
    expect(page.state.phase === 'ready' && f.reads().length === 2).toBe(true)
  })
  it.each(['eligible', 'cancelled', 'disposed'] as const)(
    'a %s page waits for the old Audit tail without cancelling it',
    async (mode) => {
      const f = await fixture(),
        held = nativeHold('text/plain')
      let signal: AbortSignal | undefined
      f.setOther(async (_p, init) => {
        signal = init.signal
        return held.response()
      })
      const old = resultOf(f.auth.system.audit.list({}))
      let page: SystemRuntimeInformationController | undefined
      try {
        await held.entered.promise
        page = f.page()
        expect(page.state.phase === 'waiting' && f.reads().length === 0).toBe(true)
        if (mode === 'cancelled') page.cancel()
        if (mode === 'disposed') page.dispose()
        expect(signal?.aborted === false && f.auth.state.busy).toBe(true)
      } finally {
        held.release()
        await old
        await flushPromises()
      }
      expect(held.joined() && f.reads().length === (mode === 'eligible' ? 1 : 0)).toBe(true)
      if (mode === 'eligible') expect(page!.state.phase).toBe('ready')
      if (mode === 'cancelled') {
        expect(page!.state.phase).toBe('error')
        await page!.refresh()
        expect(f.reads()).toHaveLength(1)
      }
    },
  )
  it('waits across disposed Runtime instances and does not let the old continuation alter the new read', async () => {
    const f = await fixture(),
      first = nativeHold('application/json', sample()),
      second = nativeHold('application/json', sample())
    let count = 0
    f.setRuntime(async () => (++count === 1 ? first.response() : second.response()))
    const old = f.page()
    let next: SystemRuntimeInformationController | undefined
    try {
      await flushPromises()
      old.dispose()
      await first.entered.promise
      next = f.page()
      expect(next.state.phase === 'waiting' && f.reads().length === 1).toBe(true)
      first.release()
      await flushPromises()
      expect(
        first.joined() &&
          old.state.phase === 'inactive' &&
          old.state.observation === null &&
          next.state.phase === 'loading' &&
          f.reads().length === 2 &&
          f.auth.state.busy,
      ).toBe(true)
      old.cancel()
      old.dispose()
      await old.refresh()
      expect(f.reads()[1]![1].signal?.aborted).toBe(false)
      second.controller.close()
      await flushPromises()
      expect(next.state.phase === 'ready' && old.state.phase === 'inactive').toBe(true)
    } finally {
      first.release()
      second.release()
      next?.dispose()
      await flushPromises()
    }
  })
  it('checking and a failed Session permanently retire the old page; same-Session recovery needs a new instance', async () => {
    const f = await fixture(),
      page = f.page()
    await flushPromises()
    f.setSessionRequest(async () => problem('DEPENDENCY_UNAVAILABLE'))
    await f.auth.restore()
    expect(
      page.state.phase === 'inactive' && page.state.observation === null && !page.isCurrent(),
    ).toBe(true)
    const before = f.reads().length
    await page.refresh()
    f.setSessionRequest(async () => json(view()))
    await f.auth.restore()
    await flushPromises()
    expect(f.reads()).toHaveLength(before)
    const next = f.page()
    await flushPromises()
    expect(next.state.phase === 'ready' && f.reads().length === before + 1).toBe(true)
  })
  it('a non-admin instance never starts a GET and does not gain eligibility after role restoration', async () => {
    const f = await fixture()
    f.setSession(view(id(2), 'user'))
    await f.auth.restore()
    const page = f.page()
    expect(page.state.phase).toBe('forbidden')
    await page.refresh()
    f.setSession(view())
    await f.auth.restore()
    await page.refresh()
    expect(f.reads()).toHaveLength(0)
    const next = f.page()
    await flushPromises()
    expect(next.state.phase === 'ready' && f.reads().length === 1).toBe(true)
  })
  it('route-leave consumes eligibility and cancels synchronously, but a later blocked navigation allows explicit refresh', async () => {
    const f = await fixture(),
      held = nativeHold('application/json', sample())
    f.setRuntime(async () => held.response())
    const page = f.page()
    try {
      await flushPromises()
      page.leave()
      expect(
        page.state.phase === 'error' && page.state.observation === null && f.auth.state.busy,
      ).toBe(true)
      await held.entered.promise
    } finally {
      held.release()
      await flushPromises()
    }
    expect(held.joined() && f.reads().length === 1 && page.isCurrent()).toBe(true)
    f.setRuntime(async () => json(sample()))
    await page.refresh()
    expect(page.state.phase === 'ready' && f.reads().length === 2 && f.writes().length === 0).toBe(
      true,
    )
  })
