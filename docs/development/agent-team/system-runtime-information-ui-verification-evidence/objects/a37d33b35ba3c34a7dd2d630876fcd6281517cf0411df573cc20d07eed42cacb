function barrier<T = void>() {
  let resolve!: (value: T | PromiseLike<T>) => void
  const promise = new Promise<T>((r) => (resolve = r))
  return { promise, resolve }
}
const resultOf = (pending: Promise<unknown>) =>
  pending.then(
    (value) => ({ value, error: undefined }),
    (error: unknown) => ({ value: undefined, error }),
  )
const owners: SessionController[] = [],
  pages: SystemRuntimeInformationController[] = []
const releases: (() => void)[] = []
function nativeHold(media = 'application/json', body?: unknown) {
  const tail = barrier(),
    entered = barrier()
  let joined = false
  let controller!: ReadableStreamDefaultController<Uint8Array>
  const cancel = vi.fn(() => {
    entered.resolve()
    return tail.promise.then(() => {
      joined = true
    })
  })
  const stream = new ReadableStream<Uint8Array>({
    start(c) {
      controller = c
      if (body !== undefined) c.enqueue(new TextEncoder().encode(JSON.stringify(body)))
    },
    cancel,
  })
  const release = () => tail.resolve()
  releases.push(release)
  return {
    response: () => new Response(stream, { headers: { 'Content-Type': media } }),
    stream,
    controller,
    cancel,
    entered,
    release,
    joined: () => joined,
  }
}
async function fixture(runtimeOverride?: SystemRuntimeInformationAPI, defaultTwelfth = false) {
  let current = view(),
    session: Fetch = async () => json(current)
  let runtime: Fetch = async () => json(sample())
  let other: Fetch = async (path) =>
    path === '/api/v1/me'
      ? json({ user: current.user, avatar: null })
      : json({ items: [], next_cursor: null })
  let smtp: Fetch = async () => json(settings())
  let outbound: Fetch = async () => json({ version: '1', rules: [] })
  const fetcher = vi.fn<Fetch>(async (path, init) => {
    if (path === '/api/v1/session') return session(path, init)
    if (path === '/api/v1/auth/bootstrap')
      return json({
        csrf_token: 'A'.repeat(43),
        challenge_modes: ['rotate'],
        delivery_channel: 'backend_log',
      })
    if (path.endsWith('/logout')) return new Response(null, { status: 204 })
    if (path === endpoint) return runtime(path, init)
    if (path === '/api/v1/system/outbound-policy') return outbound(path, init)
    if (path.startsWith('/api/v1/system/smtp')) return smtp(path, init)
    return other(path, init)
  })
  const firstEleven = [
    createAccountAPI(fetcher),
    createSystemAccountAPI(fetcher),
    createSystemInvitationAPI(fetcher),
    createSystemProviderAPI(fetcher),
    createSystemModelAPI(fetcher),
    createSystemModelSelectionAPI(fetcher),
    createSystemAccountSecurityAPI(fetcher),
    createSystemSMTPSettingsAPI(fetcher),
    createSystemSMTPDeliveryAPI(fetcher),
    createSystemOutboundPolicyAPI(fetcher),
    createSystemAuditAPI(fetcher),
  ] as const
  if (defaultTwelfth) vi.stubGlobal('fetch', fetcher)
  const auth = defaultTwelfth
    ? createSessionController(...firstEleven)
    : createSessionController(
        ...firstEleven,
        runtimeOverride ?? createSystemRuntimeInformationAPI(fetcher),
      )
  owners.push(auth)
  await auth.restore()
  return {
    auth,
    fetcher,
    page() {
      const page = useSystemRuntimeInformation(auth)
      pages.push(page)
      return page
    },
    setRuntime(value: Fetch) {
      runtime = value
    },
    setOther(value: Fetch) {
      other = value
    },
    setSMTP(value: Fetch) {
      smtp = value
    },
    setOutbound(value: Fetch) {
      outbound = value
    },
    setSession(value: SessionView) {
      current = value
    },
    setSessionRequest(value: Fetch) {
      session = value
    },
    reads() {
      return fetcher.mock.calls.filter(([path]) => path === endpoint)
    },
    writes() {
      return fetcher.mock.calls.filter(([, init]) => init.method !== 'GET')
    },
  }
}
