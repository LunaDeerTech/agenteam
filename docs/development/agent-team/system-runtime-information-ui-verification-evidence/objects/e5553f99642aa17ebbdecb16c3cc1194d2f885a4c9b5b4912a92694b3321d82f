+async function refresh(page: Page) {
+  const after = await seq(page);
+  await button(page, "重新读取运行信息").click();
+  const value = await ready(page, after);
+  await compareSnapshot(page, value.snapshot!);
+  return value;
+}
+async function noSnapshot(page: Page) {
+  await expect(page.locator(".runtime-sections,.runtime-observed")).toHaveCount(
+    0,
+  );
+}
+async function joined() {
+  await expect
+    .poll(async () => {
+      const c = await ipc("counts");
+      return c.held === c.joined && c.server_started === c.server_finished;
+    })
+    .toBe(true);
+}
+async function hold(page: Page) {
+  const counts = await ipc("counts"),
+    after = await seq(page);
+  await ipc("arm-hold");
+  await button(page, "重新读取运行信息").click();
+  await expect
+    .poll(async () => (await ipc("counts")).held)
+    .toBe(counts.held + 1);
+  await factAfter(
+    page,
+    after,
+    (f) =>
+      f.path === endpoint &&
+      f.status === 200 &&
+      f.bytes > 0 &&
+      !f.eof &&
+      !f.ended,
+  );
+  await expect(heading(page, "正在读取运行信息")).toBeVisible();
+  await noSnapshot(page);
+  return after;
+}
+async function zeroWritesAndProbes(page: Page) {
+  const values = await facts(page);
