+type runtimeInformationWebHeldBody struct {
+	data    []byte
+	offset  int
+	ctx     context.Context
+	release <-chan struct{}
+	joined  func()
+	once    sync.Once
+}
+
+func (b *runtimeInformationWebHeldBody) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	if b.offset >= len(b.data) {
+		return 0, io.EOF
+	}
+	prefix := len(b.data) / 2
+	if b.offset >= prefix {
+		select {
+		case <-b.ctx.Done():
+			return 0, b.ctx.Err()
+		case <-b.release:
+		}
+	}
+	end := len(b.data)
+	if b.offset < prefix {
+		end = prefix
+	}
+	n := copy(p, b.data[b.offset:end])
+	b.offset += n
+	return n, nil
+}
+func (b *runtimeInformationWebHeldBody) Close() error {
+	b.once.Do(func() { clear(b.data); b.data = nil; b.joined() })
+	return nil
+}
