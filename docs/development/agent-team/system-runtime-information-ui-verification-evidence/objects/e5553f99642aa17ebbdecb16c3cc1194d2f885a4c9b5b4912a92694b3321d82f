+async function layout(page: Page, width: number) {
+  const geometry = await page
+    .locator(".runtime-information")
+    .evaluate((region, width) => {
+      const fail = (category: string, index = -1, a = 0, b = 0) => ({
+        ok: false,
+        category,
+        index,
+        a,
+        b,
+      });
+      if (document.documentElement.scrollWidth > innerWidth + 1)
+        return fail(
+          "document-overflow",
+          -1,
+          document.documentElement.scrollWidth,
+          innerWidth,
+        );
+      if (document.body.scrollWidth > innerWidth + 1)
+        return fail("body-overflow", -1, document.body.scrollWidth, innerWidth);
+      const bounds = region.getBoundingClientRect();
+      if (bounds.left < -1 || bounds.right > innerWidth + 1)
+        return fail("page-bounds", -1, bounds.left, bounds.right);
+      const sections = Array.from(region.querySelectorAll("section"));
+      if (sections.length !== 4)
+        return fail("section-count", -1, sections.length, 4);
+      for (const [index, node] of Array.from(
+        region.querySelectorAll("h1,h2,p,dt,dd,time,button"),
+      ).entries()) {
+        const rect = node.getBoundingClientRect();
+        if (
+          rect.width <= 0 ||
+          rect.height <= 0 ||
+          rect.left < bounds.left - 1 ||
+          rect.right > bounds.right + 1
+        )
+          return fail("field-bounds", index, rect.left, rect.right);
+        if (
+          node.scrollWidth > node.clientWidth + 1 &&
+          getComputedStyle(node).display !== "inline"
+        )
+          return fail(
+            "field-overflow",
+            index,
+            node.scrollWidth,
+            node.clientWidth,
+          );
+      }
+      if (
+        width <= 760 &&
+        sections.some(
+          (node) =>
+            Math.abs(
+              node.getBoundingClientRect().left -
+                sections[0]!.getBoundingClientRect().left,
+            ) > 1,
+        )
+      )
+        return fail("narrow-not-single-column");
+      return { ok: true, category: "none", index: -1, a: 0, b: 0 };
+    }, width);
+  if (!geometry.ok)
+    console.log("runtime-layout-safe-diagnostic", JSON.stringify(geometry));
+  expect(geometry.ok).toBe(true);
+}
