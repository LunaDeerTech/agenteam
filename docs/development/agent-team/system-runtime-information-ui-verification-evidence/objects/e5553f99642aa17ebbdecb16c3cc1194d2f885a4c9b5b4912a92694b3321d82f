+		return nil
+	}
+	if r.URL.Path != runtimeInformationWebPath || response.StatusCode != 200 {
+		return nil
+	}
+	f.mu.Lock()
+	hold, cut, release := f.hold, f.cut, f.release
+	if hold {
+		f.hold = false
+		f.held++
+	}
+	if cut {
+		f.cut = false
+		f.cuts++
+	}
+	f.mu.Unlock()
+	if !hold && !cut {
+		return nil
+	}
+	raw, err := io.ReadAll(io.LimitReader(response.Body, 16385))
+	closed := response.Body.Close()
+	if err != nil || closed != nil || len(raw) > 16384 || len(raw) < 2 {
+		clear(raw)
+		return errors.New("owned control requires complete formal Runtime response")
+	}
+	if cut {
+		defer clear(raw)
+		return &runtimeInformationWebCut{header: response.Header.Clone(), prefix: append([]byte(nil), raw[:len(raw)/2]...), length: len(raw)}
+	}
