+async function pageshowRecovery(page: Page) {
+  const current = (await facts(page)).filter((f) => f.session).at(-1)!.session!,
+    after = await seq(page);
+  await ipc("session-fail");
+  // Synthetic event invokes the real installed listener; this is not BFCache.
+  const checking = await page.evaluate(async () => {
+    let observer: MutationObserver | undefined;
+    try {
+      return await new Promise<boolean>((resolve) => {
+        observer = new MutationObserver(() => {
+          if (document.querySelector(".session-check"))
+            resolve(
+              !document.querySelector(
+                ".runtime-information,.runtime-sections,.runtime-observed",
+              ) &&
+                !document.querySelector(".ui-overlay") &&
+                document.body.style.overflow !== "hidden",
+            );
+        });
+        observer.observe(document.body, { childList: true, subtree: true });
+        window.dispatchEvent(new Event("pageshow"));
+      });
+    } finally {
+      observer?.disconnect();
+    }
+  });
+  expect(checking).toBe(true);
+  await expect(button(page, "检查当前会话")).toBeEnabled();
+  await noSnapshot(page);
+  expect(
+    (await runtimeFacts(page)).filter((f) => f.sequence > after).length,
+  ).toBe(0);
+  await button(page, "检查当前会话").click();
+  await factAfter(
+    page,
+    after,
+    (f) =>
+      f.path === "/api/v1/session" &&
+      f.status === 200 &&
+      f.eof &&
+      f.ended &&
+      f.session?.user_id === current.user_id &&
+      f.session.session_id === current.session_id &&
+      f.session.role === current.role,
+  );
+  const next = await ready(page, after);
+  await compareSnapshot(page, next.snapshot!);
+  expect(
+    (await runtimeFacts(page)).filter((f) => f.sequence > after).length,
+  ).toBe(1);
+  expect((await ipc("counts")).session_failures).toBe(1);
+}
