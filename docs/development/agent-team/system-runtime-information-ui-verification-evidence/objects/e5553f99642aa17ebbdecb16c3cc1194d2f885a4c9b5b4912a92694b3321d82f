+func (f *runtimeInformationWebFixture) browserRuntimeInformation(ctx context.Context) map[string]any {
+	root, err := filepath.Abs("../account-captcha-web")
+	if err != nil {
+		f.t.Fatal("locked browser root unavailable")
+	}
+	cmd := exec.CommandContext(ctx, "node", filepath.Join(root, "node_modules/@playwright/test/cli.js"), "test", "--config", filepath.Join(root, "system-runtime-information.config.js"))
+	cmd.Dir = root
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	cmd.Cancel = func() error { return syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL) }
+	cmd.WaitDelay = time.Second
+	for _, value := range os.Environ() {
+		if !strings.HasPrefix(value, "TMPDIR=") && !strings.HasPrefix(value, "AGENTEAM_AUTH_WEB_") && !strings.HasPrefix(value, "AGENTEAM_RUNTIME_INFORMATION_WEB_") && !strings.HasPrefix(value, "DEBUG=") && !strings.HasPrefix(value, "PWDEBUG=") && !strings.HasPrefix(value, "PLAYWRIGHT_NO_COPY_PROMPT=") {
+			cmd.Env = append(cmd.Env, value)
+		}
+	}
+	cmd.Env = append(cmd.Env, "TMPDIR="+f.directory, "AGENTEAM_AUTH_WEB_ORIGIN="+f.origin, "AGENTEAM_AUTH_WEB_PRIVATE="+f.directory, "AGENTEAM_AUTH_WEB_CHROMIUM=/usr/bin/chromium", "AGENTEAM_RUNTIME_INFORMATION_WEB_CASE="+f.mode, "PLAYWRIGHT_NO_COPY_PROMPT=1")
+	if images := os.Getenv("AGENTEAM_AUTH_WEB_IMAGES"); images != "" {
+		if !filepath.IsAbs(images) {
+			f.t.Fatal("owned Runtime information image directory must be absolute")
+		}
+		cmd.Env = append(cmd.Env, "AGENTEAM_AUTH_WEB_IMAGES="+images)
+	}
+	var output bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &output, &output
+	if cmd.Start() != nil {
+		f.t.Fatal("locked Runtime information browser runner could not start")
+	}
+	done := make(chan error, 1)
+	go func() { done <- cmd.Wait() }()
+	joined := false
+	defer func() {
+		f.releaseRead()
+		if !joined {
+			_ = cmd.Cancel()
+			<-done
+		}
+		_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
+		cmd.Env = nil
+	}()
+	tick := time.NewTicker(20 * time.Millisecond)
+	defer tick.Stop()
+	sequence := 0
+	var runErr error
+wait:
+	for {
+		select {
+		case runErr = <-done:
+			joined = true
+			break wait
+		case <-tick.C:
+			raw, e := os.ReadFile(filepath.Join(f.directory, "runtime-information-ipc.json"))
+			if errors.Is(e, os.ErrNotExist) {
+				continue
+			}
+			var request runtimeInformationWebIPC
+			decode := json.Unmarshal(raw, &request)
+			clear(raw)
+			if e != nil || decode != nil || request.Sequence < 1 || request.Sequence > 128 {
+				f.t.Error("private Runtime information IPC rejected")
+				_ = cmd.Cancel()
+				continue
+			}
+			if request.Sequence <= sequence {
+				continue
+			}
+			if request.Sequence != sequence+1 {
+				f.t.Error("private Runtime information sequence invalid")
+				_ = cmd.Cancel()
+				continue
+			}
+			reply := f.ipc(ctx, request)
+			sequence = request.Sequence
+			f.private("runtime-information-ack-"+strconv.Itoa(sequence)+".json", reply)
+		}
+	}
+	// Browser assertions compare only safe booleans/counts. Do not publish its
+	// raw output until all private material and captured Session tokens are masked.
+	safe := output.String()
+	for _, secret := range []string{f.admin.Password, f.member.Password, f.admin.Email, f.member.Email, f.csrf, f.memberCSRF} {
+		if secret != "" {
+			safe = strings.ReplaceAll(safe, secret, "[redacted]")
+		}
+	}
+	f.mu.Lock()
+	for sid, s := range f.sessions {
+		for _, secret := range []string{sid, s.cookie, s.csrf, s.user} {
+			if secret != "" {
+				safe = strings.ReplaceAll(safe, secret, "[redacted]")
+			}
+		}
+	}
+	f.mu.Unlock()
+	// Playwright can include a fill argument or an accessible-name locator in a
+	// failed action's call log. Retain the original error/line and safe booleans,
+	// but remove owned record/association IDs, timestamps and action arguments.
+	safe = regexp.MustCompile(`[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}`).ReplaceAllString(safe, "[owned-id]")
+	safe = regexp.MustCompile(`sha256:[0-9a-f]{64}`).ReplaceAllString(safe, "[owned-digest]")
+	safe = regexp.MustCompile(`[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+(?:Z|[+-][0-9]{2}:[0-9]{2})`).ReplaceAllString(safe, "[owned-instant]")
+	lines := strings.Split(safe, "\n")
+	for n, line := range lines {
+		if strings.Contains(line, "filling ") || strings.Contains(line, "selectOption(") {
+			lines[n] = "[owned field argument omitted]"
+		}
+	}
+	safe = strings.Join(lines, "\n")
+	f.t.Log(safe)
+	if runErr != nil {
+		f.t.Fatalf("actual Runtime information production browser failed: %v", runErr)
+	}
+	raw, err := os.ReadFile(filepath.Join(f.directory, "runtime-information-result.json"))
+	if err != nil {
+		f.t.Fatal("safe Runtime information result missing")
+	}
+	defer clear(raw)
+	var result map[string]any
+	if json.Unmarshal(raw, &result) != nil || result["completed"] != true {
+		f.t.Fatal("safe Runtime information result invalid")
+	}
+	return result
