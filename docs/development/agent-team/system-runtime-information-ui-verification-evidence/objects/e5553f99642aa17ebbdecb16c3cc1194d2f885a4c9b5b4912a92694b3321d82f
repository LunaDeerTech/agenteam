+func (f *runtimeInformationWebFixture) controlResponse(response *http.Response) error {
+	r := response.Request
+	if r == nil || r.Method != "GET" {
+		return nil
+	}
+	if r.URL.Path == "/api/v1/session" && response.StatusCode == 200 {
+		raw, err := io.ReadAll(io.LimitReader(response.Body, 600001))
+		closed := response.Body.Close()
+		defer clear(raw)
+		var value struct {
