def utc():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def write(path, value):
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + '\n')


def command(argv):
    result = subprocess.run(argv, cwd=REPO, capture_output=True, text=True, timeout=20)
    if result.returncode:
        raise RuntimeError('read command failed: ' + ' '.join(argv) + ': ' + result.stderr[:300])
    return result.stdout


def resources():
    result = {}
    for kind in ['container', 'network']:
        for resource_id in command(['docker', kind, 'ls', '-q', '--no-trunc'] if kind == 'network' else ['docker', kind, 'ls', '-aq', '--no-trunc']).split():
            label = '.Config.Labels' if kind == 'container' else '.Labels'
            mounts = '{{json .Mounts}}' if kind == 'container' else '[]'
            try:
                raw = command(['docker', kind, 'inspect', '--format', '{{json .Id}}\t{{json .Name}}\t{{json ' + label + '}}\t' + mounts, resource_id]).strip().split('\t')
            except RuntimeError as exc:
                if 'No such' in str(exc) or 'not found' in str(exc):
                    continue  # The fixture may remove an ID after the list call.
                raise
            value = dict(zip(['id', 'name', 'labels', 'mounts'], map(json.loads, raw)))
            value['kind'] = kind
            result[resource_id] = value
    return result


def canonical_resources(snapshot):
    """Compare Mounts as a full-object multiset; preserve fields and duplicates."""
    return {key: row | {'mounts': sorted(row['mounts'], key=lambda mount: json.dumps(mount, sort_keys=True, separators=(',', ':')))}
            for key, row in snapshot.items()}


def processes():
    result = {}
    for entry in Path('/proc').iterdir():
        if not entry.name.isdigit():
            continue
        try:
            stat = (entry / 'stat').read_text().rsplit(')', 1)[1].split()
            raw = (entry / 'cmdline').read_bytes()
            try:
                executable = Path(os.readlink(entry / 'exe')).name
            except OSError:
                executable = ''
            result[int(entry.name)] = {'ppid': int(stat[1]), 'starttime': stat[19],
                                      'state': stat[0], 'name': (entry / 'comm').read_text().strip(),
                                      'executable': executable, 'raw': raw}
        except (OSError, ValueError, IndexError):
            pass
    return result


def reap_adopted(observed, main_pid, waited):
    current = processes()
    for key, value in observed.items():
        pid = value['pid']
        row = current.get(pid)
        if pid == main_pid or not row or row['starttime'] != value['starttime'] or row['ppid'] != os.getpid() or row['state'] != 'Z':
            continue
        try:
            got, status = os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            continue
        if got == pid:
            waited.append({'pid': pid, 'starttime': value['starttime'], 'actual_wait': True, 'exit': os.waitstatus_to_exitcode(status), 'time': utc()})


# This private cwd contains only the compiled/runnable fixed closure plus candidates.
# All filesystem additions within it are rejected; dependencies are explicit locked links.
IGNORED_PATHS = {'web/node_modules', 'web/dist', 'tests/account-captcha-web/node_modules'}

def fixed_tree():
    raw = subprocess.check_output(['git', 'ls-tree', '-r', '-z', BASE], cwd=GIT_OBJECT_REPO, timeout=20)
    entries = {}
    for record in raw.split(b'\0'):
        if not record:
            continue
        header, name = record.split(b'\t', 1)
        mode, kind, oid = header.decode().split()
        entries[name.decode()] = {'mode': mode, 'kind': kind, 'git_blob': oid}
    return raw, entries


def accepted_baseline_input():
    expected = FROZEN['accepted_baseline']
    raw, tree = fixed_tree()
    tree_sha = hashlib.sha256(raw).hexdigest()
    if expected['product_base'] != BASE or expected['git_tree_sha256'] != tree_sha:
        raise RuntimeError('fixed accepted Git tree differs from frozen baseline')
    selected = expected['files']
    if any(name not in tree or any(row[key] != tree[name][key] for key in ['git_blob','mode','kind']) for name,row in selected.items()):
        raise RuntimeError('accepted input is not a file in the fixed product object')
    actual,errors=set(),[]
    for directory,directories,files in os.walk(REPO):
        directories[:] = [name for name in directories if str((Path(directory)/name).relative_to(REPO)) not in IGNORED_PATHS]
        for name in directories:
            path=Path(directory)/name
            if path.is_symlink():errors.append({'path':str(path.relative_to(REPO)),'reason':'symlink directory'})
        for name in files:
            relative=str((Path(directory)/name).relative_to(REPO))
            if relative not in FROZEN['files']:actual.add(relative)
    hashes,mismatches={},[]
    for name in sorted(set(selected)&actual):
        path=REPO/name
        if path.is_symlink() or not path.is_file():
            errors.append({'path':name,'reason':'nonregular accepted input'});continue
        data=path.read_bytes();sha=hashlib.sha256(data).hexdigest()
        oid=hashlib.sha1(b'blob '+str(len(data)).encode()+b'\0'+data).hexdigest()
        hashes[name]=sha
        if sha!=selected[name]['sha256'] or oid!=selected[name]['git_blob']:mismatches.append(name)
    missing,unexpected=sorted(set(selected)-actual),sorted(actual-set(selected))
    return {'product_base':BASE,'git_tree_sha256':tree_sha,'accepted_count':len(selected),'files':hashes,'missing':missing,'unexpected':unexpected,'mismatches':mismatches,'errors':errors,'accepted':not(missing or unexpected or mismatches or errors)}


def private_runtime_input():
    private = {name: hashlib.sha256(Path(name).read_bytes()).hexdigest() for name in FROZEN['private_files']}
    runtime = {name: {'realpath': str(Path(name).resolve(strict=True)), 'sha256': hashlib.sha256(Path(name).read_bytes()).hexdigest()}
               for name in FROZEN['runtime_files']}
    links = {name: os.readlink(name) for name in FROZEN['runtime_symlinks']}
    selected = {name: str(Path(shutil.which(name)).resolve(strict=True)) for name in FROZEN['selected_tools']}
    return {'private_files': private, 'runtime_files': runtime, 'runtime_symlinks': links, 'selected_tools': selected}


def source_input():
    def sha(path):
        if not path.is_file() or path.is_symlink() or any(parent.is_symlink() for parent in path.parents if parent!=REPO.parent):
            raise RuntimeError('nonregular candidate or artifact')
        return hashlib.sha256(path.read_bytes()).hexdigest()
    dependencies={}
    for name,expected in FROZEN['dependencies'].items():
        path=Path(name)
        dependencies[name]={'realpath':str(path.resolve(strict=True)),'sha256':hashlib.sha256(path.read_bytes()).hexdigest()}
    return {'product_base':BASE,'accepted_baseline':accepted_baseline_input(),'files':{name:sha(REPO/name) for name in FROZEN['files']},'dist':{str(path.relative_to(REPO)):sha(path) for path in sorted((REPO/'web/dist').rglob('*')) if path.is_file()},'dependencies':dependencies} | private_runtime_input()


