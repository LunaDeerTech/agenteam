               'resource_ownership_valid': all(row['nonce_present'] and row['mounts_within_task_runtime'] for row in ownership.values()),
               'expected_resources': expected_resource_count, 'observed_resources': len(observed_resources), 'observed_processes': len(observed_processes),
               'monitor_errors': len(errors), 'double_cleanup': clean, 'run_directory': str(run)}
    verification_unchanged = Path(__file__).read_bytes() == driver_bytes and args.frozen.read_bytes() == frozen_bytes and all(before[key] == after[key] == FROZEN[key] for key in ['private_files','runtime_files','runtime_symlinks','selected_tools'])
    summary['verification_inputs_unchanged'] = verification_unchanged
    tops = re.findall(r'^--- (PASS|FAIL|SKIP): (\S+)', (run / 'raw.log').read_text(errors='replace'), re.MULTILINE)
    summary['browser_processes'] = sum(row['name'] in {'chromium', 'chrome', 'chrome_crashpad'} for row in observed_processes.values())
    summary['node_processes'] = sum(row['executable'] in {'node', 'nodejs'} for row in observed_processes.values())
    summary['adopted_waits'] = len(adopted_waits)
    summary['browser_runtime_removed'] = not browser_runtime.exists()
    summary['top_levels'] = tops
    summary['selected_tests_passed'] = len(tops) == len(expected) and {name for state, name in tops if state == 'PASS'} == expected
    summary['historical_zombies_untouched'] = [{key: row[key] for key in ['ppid','starttime','state','name']} | {'pid':pid} for pid,row in baseline_processes.items() if row['ppid'] == 1 and row['state'] == 'Z' and not (pid==PRIOR_TASK_ORPHAN['pid'] and row['starttime']==PRIOR_TASK_ORPHAN['starttime'])]
    prior_now=baseline_processes.get(PRIOR_TASK_ORPHAN['pid'])
    summary['prior_task_owned_unreaped'] = PRIOR_TASK_ORPHAN | {'present_at_start': bool(prior_now and prior_now['starttime']==PRIOR_TASK_ORPHAN['starttime']), 'reaped_by_this_run':False}
    write(run / 'result.json', summary)
    print(json.dumps(summary), flush=True)
    return 0 if exit_code == 0 and clean and len(observed_resources) == expected_resource_count and not errors and summary['source_files_unchanged'] and verification_unchanged and summary['selected_tests_passed'] and summary['browser_processes'] and summary['node_processes'] and summary['browser_runtime_removed'] and summary['resource_ownership_valid'] else 1


