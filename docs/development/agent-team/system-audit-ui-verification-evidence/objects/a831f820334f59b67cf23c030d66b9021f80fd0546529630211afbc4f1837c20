def read_command(argv, allow_absent=False):
    start = time.monotonic()
    p = subprocess.run(argv, cwd=driver.REPO, capture_output=True, text=True, timeout=20)
    read_commands.append({'argv': argv, 'cwd': str(driver.REPO), 'exit': p.returncode,
                          'actual_wait': True, 'seconds': time.monotonic() - start,
                          'stdout': p.stdout, 'stderr': p.stderr})
    save('resource-read-commands.json', read_commands)
    if p.returncode and not allow_absent:
        raise RuntimeError('read-only resource command failed')
    return p


def driver_read_command(argv):
    return read_command(argv).stdout


