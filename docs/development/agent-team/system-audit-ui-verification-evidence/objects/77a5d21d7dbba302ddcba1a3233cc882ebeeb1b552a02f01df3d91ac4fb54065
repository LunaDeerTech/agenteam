	// Accepted Account avatar upload is the only MIME producer in this fixture.
	// No direct Object service or Audit Append call is made.
	png := avatarPNG(t, 29)
	request, err := http.NewRequestWithContext(ctx, "PUT", f.origin+"/api/v1/me/avatar", bytes.NewReader(png))
	if err != nil {
		t.Fatal("owned avatar request invalid")
	}
	request.Header.Set("Origin", f.origin)
	request.Header.Set("Sec-Fetch-Site", "same-origin")
	request.Header.Set("Content-Type", "image/png")
	request.Header.Set("If-Match", `"`+httpString(t, httpObject(t, profile, "user"), "version")+`"`)
	request.Header.Set("X-CSRF-Token", f.csrf)
	request.Header.Set("Idempotency-Key", id[struct{}](t).String())
	response, err := f.adminClient.Do(request)
	clear(png)
	if err != nil {
		t.Fatal("owned avatar HTTP failed")
	}
	raw, readErr := io.ReadAll(io.LimitReader(response.Body, 600001))
	closeErr := response.Body.Close()
	var uploaded map[string]any
	if response.StatusCode != 200 || readErr != nil || closeErr != nil || len(raw) > 600000 || json.Unmarshal(raw, &uploaded) != nil {
		clear(raw)
		t.Fatal("formal Account MIME preparation failed")
	}
	clear(raw)
	avatar := httpObject(t, uploaded, "avatar")
	f.mediaType = httpString(t, avatar, "media_type")
	conn, closeConnection := invitationsWebConnect(t, ctx, f.db)
	err = conn.QueryRow(ctx, `SELECT avatar_object_id::text FROM agenteam_account.users WHERE id=$1`, f.admin.UserID).Scan(&f.objectID)
	closeConnection()
	if err != nil || f.objectID == "" {
		t.Fatal("formal owned avatar reference missing")
	}
	f.private("audit-material.json", map[string]any{"admin": f.admin, "member": f.member, "media_type": f.mediaType, "object_id": f.objectID, "missing_id": id[struct{}](t).String()})
	t.Cleanup(func() {
		f.releaseRead()
		for _, secret := range []string{f.admin.Password, f.member.Password, f.csrf, f.memberCSRF} {
			if secret != "" && f.log.contains(secret) {
				t.Error("Audit setup material escaped restricted transfer")
			}
		}
		f.mu.Lock()
		clear(f.sessions)
		f.mu.Unlock()
		f.admin.Password, f.member.Password, f.csrf, f.memberCSRF = "", "", "", ""
	})
	return f
}

// Compare every wire field with the exact owned rows, including canonical typed
// metadata. The comparison is in private IPC memory; failures name no record ID.
func (f *auditWebFixture) snapshot(ctx context.Context, ids []string) []map[string]any {
	if len(ids) > 200 {
		f.t.Fatal("owned snapshot bound exceeded")
	}
	conn, closeConnection := invitationsWebConnect(f.t, ctx, f.db)
	defer closeConnection()
	result := make([]map[string]any, 0, len(ids))
	seen := map[string]bool{}
	for _, recordID := range ids {
		if _, err := foundation.ParseID[struct{}](recordID); err != nil || seen[recordID] {
			f.t.Fatal("owned snapshot ID rejected")
		}
		seen[recordID] = true
		var kind, user, service, cause, action, outcome, resourceKind, resourceID, metadata string
		var at time.Time
		var tool, request, runner, correlation, trace string
		err := conn.QueryRow(ctx, `SELECT created_at,actor_kind,coalesce(user_id::text,''),coalesce(service_name,''),coalesce(service_cause,''),action,outcome,resource_kind,coalesce(resource_id::text,''),metadata::text,coalesce(tool_id::text,''),coalesce(request_id::text,''),coalesce(runner_id::text,''),coalesce(correlation_id::text,''),coalesce(http_trace_id::text,'') FROM agenteam_audit.audit_records WHERE scope='system' AND id=$1`, recordID).Scan(&at, &kind, &user, &service, &cause, &action, &outcome, &resourceKind, &resourceID, &metadata, &tool, &request, &runner, &correlation, &trace)
		if err != nil {
			f.t.Fatal("exact owned Audit row unavailable")
		}
		typed, err := ac.DecodeMetadata(ac.Action(action), []byte(metadata))
		if err != nil {
			f.t.Fatal("exact owned Audit typed metadata rejected")
		}
		var projected map[string]any
		if json.Unmarshal(typed.JSON(), &projected) != nil {
			f.t.Fatal("exact owned typed projection invalid")
		}
		actor := map[string]any{"kind": kind}
		if kind == "human" {
			actor["id"] = user
		} else if kind == "service" {
			actor["service"] = service
			actor["cause_ref"] = cause
		} else {
			f.t.Fatal("unexpected owned System actor")
		}
		resource := map[string]any{"kind": resourceKind}
		if resourceID != "" {
			resource["id"] = resourceID
		}
		assoc := map[string]any{}
		for key, value := range map[string]string{"tool_id": tool, "request_id": request, "runner_id": runner, "correlation_id": correlation, "http_trace_id": trace} {
			if value != "" {
				assoc[key] = value
			}
		}
		summary := "Audit event"
		switch action {
		case "secret.master.register":
			summary = "Master key registered"
		case "secret.master.rotation.start":
			summary = "Master key rotation started"
		case "secret.master.rotation.complete":
			summary = "Master key rotation completed"
		case "secret.master.rotation.failed":
			summary = "Master key rotation failed"
		case "outbound.policy.update":
			summary = "Outbound policy updated"
		case "outbound.access.deny":
			summary = "Outbound access denied"
		case "secret.create":
			summary = "Secret created"
		case "secret.update":
			summary = "Secret updated"
		case "secret.delete":
			summary = "Secret deleted"
		case "secret.resolve":
			summary = "Secret use recorded"
		}
		instant, err := foundation.NewInstant(at)
		if err != nil {
			f.t.Fatal("owned Audit instant invalid")
		}
		result = append(result, map[string]any{"audit_id": recordID, "created_at": instant.String(), "scope": "system", "actor": actor, "action": action, "outcome": outcome, "resource": resource, "metadata": projected, "associations": assoc, "summary": summary})
	}
	return result
}

type auditWebIPC struct {
	Sequence  int      `json:"sequence"`
	Action    string   `json:"action"`
	Path      string   `json:"path"`
	IDs       []string `json:"ids"`
	SessionID string   `json:"session_id"`
}

func (f *auditWebFixture) ipc(ctx context.Context, r auditWebIPC) map[string]any {
	value := map[string]any{"sequence": r.Sequence, "ok": true}
	switch r.Action {
	case "snapshot":
		value["records"] = f.snapshot(ctx, r.IDs)
	case "arm-hold", "arm-cut":
		if !auditWebPath(r.Path) {
			f.t.Fatal("owned Audit control path rejected")
		}
		f.mu.Lock()
		if f.holdPath != "" || f.cutPath != "" || f.held != f.joined {
			f.mu.Unlock()
			f.t.Fatal("owned response control overlap")
		}
		if r.Action == "arm-hold" {
			f.holdPath = r.Path
			f.release = make(chan struct{})
			f.releaseOnce = sync.Once{}
		} else {
			f.cutPath = r.Path
		}
		f.mu.Unlock()
	case "release":
		f.releaseRead()
	case "counts":
		f.mu.Lock()
		value["held"], value["joined"], value["cuts"] = f.held, f.joined, f.cuts
		f.mu.Unlock()
		value["session_failures"] = f.sessionFailures.Load()
		value["server_started"], value["server_finished"] = f.serverStarted.Load(), f.serverFinished.Load()
	case "session-fail":
		f.failSession.Store(true)
	case "permissions":
		if len(r.IDs) != 1 {
			f.t.Fatal("owned permission target missing")
		}
		for _, path := range []string{systemAuditHTTPPath, systemAuditHTTPPath + "/" + r.IDs[0]} {
			problem := f.official(ctx, f.memberClient, "GET", path, nil, "", 403)
			if problem["code"] != "FORBIDDEN" {
				f.t.Fatal("formal ordinary Audit rejection mismatch")
			}
		}
		missing := f.official(ctx, f.adminClient, "GET", systemAuditHTTPPath+"/"+id[struct{}](f.t).String(), nil, "", 404)
		if missing["code"] != "NOT_FOUND" {
			f.t.Fatal("formal Audit detail absence mismatch")
		}
		value["ordinary_both_forbidden"], value["detail_missing"] = true, true
	case "logout":
		f.mu.Lock()
		session, ok := f.sessions[r.SessionID]
		f.mu.Unlock()
		if !ok || session.user != f.admin.UserID || session.cookie == "" {
			f.t.Fatal("exact owned browser Session unavailable")
		}
		request, err := http.NewRequestWithContext(ctx, "POST", f.origin+"/api/v1/sessions/logout", strings.NewReader(`{}`))
		if err != nil {
			f.t.Fatal("owned Logout request invalid")
		}
		request.Header.Set("Cookie", session.cookie)
		request.Header.Set("Origin", f.origin)
		request.Header.Set("Content-Type", "application/json")
		request.Header.Set("Sec-Fetch-Site", "same-origin")
		request.Header.Set("X-CSRF-Token", session.csrf)
		request.Header.Set("Idempotency-Key", id[struct{}](f.t).String())
		transport := &http.Transport{Proxy: nil}
		client := &http.Client{Transport: transport, Timeout: 10 * time.Second}
		response, err := client.Do(request)
		if err != nil {
			transport.CloseIdleConnections()
			f.t.Fatal("formal exact browser Logout failed")
		}
		raw, e := io.ReadAll(io.LimitReader(response.Body, 600001))
		closeErr := response.Body.Close()
		transport.CloseIdleConnections()
		complete := response.StatusCode == 204 && e == nil && closeErr == nil && len(raw) == 0
		clear(raw)
		if !complete {
			f.t.Fatal("formal exact browser Logout terminal mismatch")
		}
		conn, closeConnection := invitationsWebConnect(f.t, ctx, f.db)
		var revoked bool
		var audits int
		err = conn.QueryRow(ctx, `SELECT revoked_at IS NOT NULL AND revoked_reason='logout',(SELECT count(*) FROM agenteam_audit.audit_records WHERE action='account.logout' AND metadata->>'session_id'=$1::text AND outcome='success') FROM agenteam_account.sessions WHERE id=$1::uuid AND user_id=$2`, r.SessionID, session.user).Scan(&revoked, &audits)
		closeConnection()
		if err != nil || !revoked || audits != 1 {
			f.t.Fatalf("formal exact Session Logout facts missing: err_present=%t revoked=%t audit_count=%d", err != nil, revoked, audits)
		}
		value["revoked"], value["logout_audit"] = true, true
	default:
		f.t.Fatal("owned Audit IPC action rejected")
	}
	return value
}

func (f *auditWebFixture) browserAudit(ctx context.Context) map[string]any {
	root, err := filepath.Abs("../account-captcha-web")
	if err != nil {
		f.t.Fatal("locked browser root unavailable")
	}
	cmd := exec.CommandContext(ctx, "node", filepath.Join(root, "node_modules/@playwright/test/cli.js"), "test", "--config", "/workspace/scratch/agenteam-audit-ui-real-independent-urakt2fo/browser/independent.config.mjs")
	cmd.Dir = root
	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
	cmd.Cancel = func() error { return syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL) }
	cmd.WaitDelay = time.Second
	for _, value := range os.Environ() {
		if !strings.HasPrefix(value, "TMPDIR=") && !strings.HasPrefix(value, "AGENTEAM_AUTH_WEB_") && !strings.HasPrefix(value, "AGENTEAM_AUDIT_WEB_") && !strings.HasPrefix(value, "DEBUG=") && !strings.HasPrefix(value, "PWDEBUG=") && !strings.HasPrefix(value, "PLAYWRIGHT_NO_COPY_PROMPT=") {
			cmd.Env = append(cmd.Env, value)
		}
	}
	cmd.Env = append(cmd.Env, "TMPDIR="+f.directory, "AGENTEAM_AUTH_WEB_ORIGIN="+f.origin, "AGENTEAM_AUTH_WEB_PRIVATE="+f.directory, "AGENTEAM_AUTH_WEB_CHROMIUM=/usr/bin/chromium", "AGENTEAM_AUDIT_WEB_CASE="+f.mode, "PLAYWRIGHT_NO_COPY_PROMPT=1")
	if images := os.Getenv("AGENTEAM_AUTH_WEB_IMAGES"); images != "" {
		if !filepath.IsAbs(images) {
			f.t.Fatal("owned Audit image directory must be absolute")
		}
		cmd.Env = append(cmd.Env, "AGENTEAM_AUTH_WEB_IMAGES="+images)
	}
	var output bytes.Buffer
	cmd.Stdout, cmd.Stderr = &output, &output
	if cmd.Start() != nil {
		f.t.Fatal("locked Audit browser runner could not start")
	}
	done := make(chan error, 1)
	go func() { done <- cmd.Wait() }()
	joined := false
	defer func() {
		f.releaseRead()
		if !joined {
			_ = cmd.Cancel()
			<-done
		}
		_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
		cmd.Env = nil
	}()
	tick := time.NewTicker(20 * time.Millisecond)
	defer tick.Stop()
	sequence := 0
	var runErr error
wait:
	for {
		select {
		case runErr = <-done:
			joined = true
			break wait
		case <-tick.C:
			raw, e := os.ReadFile(filepath.Join(f.directory, "audit-ipc.json"))
			if errors.Is(e, os.ErrNotExist) {
				continue
			}
			var request auditWebIPC
			decode := json.Unmarshal(raw, &request)
			clear(raw)
			if e != nil || decode != nil || request.Sequence < 1 || request.Sequence > 128 {
				f.t.Error("private Audit IPC rejected")
				_ = cmd.Cancel()
				continue
			}
			if request.Sequence <= sequence {
				continue
			}
			if request.Sequence != sequence+1 {
				f.t.Error("private Audit sequence invalid")
				_ = cmd.Cancel()
				continue
			}
			reply := f.ipc(ctx, request)
			sequence = request.Sequence
			f.private("audit-ack-"+strconv.Itoa(sequence)+".json", reply)
		}
	}
	// Browser assertions compare only safe booleans/counts. Do not publish its
	// raw output until all private material and captured Session tokens are masked.
	safe := output.String()
	for _, secret := range []string{f.admin.Password, f.member.Password, f.admin.Email, f.member.Email, f.csrf, f.memberCSRF} {
		if secret != "" {
			safe = strings.ReplaceAll(safe, secret, "[redacted]")
		}
	}
	f.mu.Lock()
	for sid, s := range f.sessions {
		for _, secret := range []string{sid, s.cookie, s.csrf, s.user} {
			if secret != "" {
				safe = strings.ReplaceAll(safe, secret, "[redacted]")
			}
		}
	}
	f.mu.Unlock()
	// Playwright can include a fill argument or an accessible-name locator in a
	// failed action's call log. Retain the original error/line and safe booleans,
	// but remove owned record/association IDs, timestamps and action arguments.
	safe = regexp.MustCompile(`[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}`).ReplaceAllString(safe, "[owned-id]")
	safe = regexp.MustCompile(`sha256:[0-9a-f]{64}`).ReplaceAllString(safe, "[owned-digest]")
	safe = regexp.MustCompile(`[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+(?:Z|[+-][0-9]{2}:[0-9]{2})`).ReplaceAllString(safe, "[owned-instant]")
	lines := strings.Split(safe, "\n")
	for n, line := range lines {
		if strings.Contains(line, "filling ") || strings.Contains(line, "selectOption(") {
			lines[n] = "[owned field argument omitted]"
		}
	}
	safe = strings.Join(lines, "\n")
	f.t.Log(safe)
	if runErr != nil {
		f.t.Fatalf("actual Audit production browser failed: %v", runErr)
	}
	raw, err := os.ReadFile(filepath.Join(f.directory, "audit-result.json"))
	if err != nil {
		f.t.Fatal("safe Audit result missing")
	}
	defer clear(raw)
	var result map[string]any
	if json.Unmarshal(raw, &result) != nil || result["completed"] != true {
		f.t.Fatal("safe Audit result invalid")
	}
	return result
}
