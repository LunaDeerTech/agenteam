// This task owns its root, private IPC and same-origin dist server. Every Audit
// record comes from accepted Account/Profile/Outbound commands. SQL is read-only.
// Controls consume a complete formal response before holding or truncating it;
// they never manufacture a successful DTO, mutate authorization or bypass roots.
type auditWebSession struct{ cookie, csrf, user string }
type auditWebFixture struct {
	*authenticationWebFixture
	setup                                 *personalWebFixture
	mode                                  string
	admin, member                         personalWebCredential
	adminClient, memberClient             *http.Client
	csrf, memberCSRF, mediaType, objectID string
	sessions                              map[string]auditWebSession
	mu                                    sync.Mutex
	holdPath, cutPath                     string
	release                               chan struct{}
	releaseOnce                           sync.Once
	held, joined, cuts                    int
	failSession                           atomic.Bool
	sessionFailures                       atomic.Int64
	serverStarted                         atomic.Int64
	serverFinished                        atomic.Int64
}
type auditWebCut struct {
	header http.Header
	prefix []byte
	length int
}

func (*auditWebCut) Error() string { return "owned audit response intentionally truncated" }
func auditWebPath(path string) bool {
	if path == systemAuditHTTPPath {
		return true
	}
	if !strings.HasPrefix(path, systemAuditHTTPPath+"/") {
		return false
	}
	value := strings.TrimPrefix(path, systemAuditHTTPPath+"/")
	_, err := foundation.ParseID[struct{}](value)
	return err == nil
}

func (f *auditWebFixture) private(name string, value any) {
	raw, err := json.Marshal(value)
	if err != nil {
		f.t.Fatal("private Audit IPC encoding failed")
	}
	defer clear(raw)
	file := filepath.Join(f.directory, name)
	if os.WriteFile(file+".tmp", raw, 0600) != nil || os.Rename(file+".tmp", file) != nil {
		f.t.Fatal("private Audit IPC transfer failed")
	}
}

func (f *auditWebFixture) releaseRead() {
	f.mu.Lock()
	defer f.mu.Unlock()
	if f.release != nil {
		f.releaseOnce.Do(func() { close(f.release) })
	}
}

func (f *auditWebFixture) controlResponse(response *http.Response) error {
	r := response.Request
	if r == nil || r.Method != "GET" {
		return nil
	}
	if r.URL.Path == "/api/v1/session" && response.StatusCode == 200 {
		raw, err := io.ReadAll(io.LimitReader(response.Body, 600001))
		closeErr := response.Body.Close()
		defer clear(raw)
		var value struct {
			User struct {
				ID string `json:"id"`
			} `json:"user"`
			Session struct {
				ID string `json:"id"`
			} `json:"session"`
			CSRF string `json:"csrf_token"`
		}
		if err != nil || closeErr != nil || len(raw) > 600000 || json.Unmarshal(raw, &value) != nil || value.Session.ID == "" || value.CSRF == "" {
			return errors.New("owned Session observation invalid")
		}
		f.mu.Lock()
		f.sessions[value.Session.ID] = auditWebSession{cookie: r.Header.Get("Cookie"), csrf: value.CSRF, user: value.User.ID}
		f.mu.Unlock()
		response.Body = io.NopCloser(bytes.NewReader(append([]byte(nil), raw...)))
		return nil
	}
	if !auditWebPath(r.URL.Path) || response.StatusCode != 200 {
		return nil
	}
	f.mu.Lock()
	hold, cut := f.holdPath == r.URL.Path, f.cutPath == r.URL.Path
	release := f.release
	if hold {
		f.holdPath = ""
		f.held++
	}
	if cut {
		f.cutPath = ""
		f.cuts++
	}
	f.mu.Unlock()
	if !hold && !cut {
		return nil
	}
	raw, err := io.ReadAll(io.LimitReader(response.Body, (1<<20)+1))
	closeErr := response.Body.Close()
	if err != nil || closeErr != nil || len(raw) > 1<<20 || len(raw) < 2 {
		clear(raw)
		return errors.New("owned control requires complete formal Audit response")
	}
	if hold {
		select {
		case <-r.Context().Done():
			err = r.Context().Err()
		case <-release:
		}
		f.mu.Lock()
		f.joined++
		f.mu.Unlock()
		if err != nil {
			clear(raw)
			return err
		}
	}
	if cut {
		defer clear(raw)
		return &auditWebCut{header: response.Header.Clone(), prefix: append([]byte(nil), raw[:len(raw)/2]...), length: len(raw)}
	}
	response.Body = io.NopCloser(bytes.NewReader(raw))
	response.ContentLength = int64(len(raw))
	return nil
}

func (f *auditWebFixture) official(ctx context.Context, client *http.Client, method, path string, body any, csrf string, status int) map[string]any {
	var reader io.Reader
	raw, err := json.Marshal(body)
	if err != nil {
		f.t.Fatal("owned formal body encoding failed")
	}
	defer clear(raw)
	if body != nil {
		reader = bytes.NewReader(raw)
	}
	request, err := http.NewRequestWithContext(ctx, method, f.origin+path, reader)
	if err != nil {
		f.t.Fatal("owned formal request invalid")
	}
	request.Header.Set("Origin", f.origin)
	request.Header.Set("Sec-Fetch-Site", "same-origin")
	if body != nil {
		request.Header.Set("Content-Type", "application/json")
	}
	if method != "GET" {
		request.Header.Set("X-CSRF-Token", csrf)
		request.Header.Set("Idempotency-Key", id[struct{}](f.t).String())
	}
	response, err := client.Do(request)
	if err != nil {
		f.t.Fatal("owned formal HTTP failed")
	}
	data, readErr := io.ReadAll(io.LimitReader(response.Body, (1<<20)+1))
	closeErr := response.Body.Close()
	defer clear(data)
	if response.StatusCode != status || readErr != nil || closeErr != nil || len(data) > 1<<20 {
		f.t.Fatalf("owned formal HTTP terminal mismatch method=%s status=%d expected=%d", method, response.StatusCode, status)
	}
	if status == 204 {
		if len(data) != 0 {
			f.t.Fatal("owned empty receipt mismatch")
		}
		return nil
	}
	var value map[string]any
	if json.Unmarshal(data, &value) != nil {
		f.t.Fatal("owned formal JSON invalid")
	}
	return value
}

func (f *auditWebFixture) loginAs(ctx context.Context, who personalWebCredential) (*http.Client, string) {
	client := f.setup.setupClient()
	anon := f.official(ctx, client, "GET", "/api/v1/auth/bootstrap", nil, "", 200)
	f.official(ctx, client, "POST", "/api/v1/sessions/login", map[string]string{"email": who.Email, "password": who.Password}, httpString(f.t, anon, "csrf_token"), 200)
	current := f.official(ctx, client, "GET", "/api/v1/session", nil, "", 200)
	if httpString(f.t, httpObject(f.t, current, "user"), "id") != who.UserID {
		f.t.Fatal("owned formal login identity mismatch")
	}
	return client, httpString(f.t, current, "csrf_token")
}

