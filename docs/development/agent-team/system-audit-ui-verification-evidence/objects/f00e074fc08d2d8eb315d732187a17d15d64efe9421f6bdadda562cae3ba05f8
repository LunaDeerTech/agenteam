func actionSummary(action Action) (string, bool) {
	switch action {
	case SecretCreate:
		return "Secret created", true
	case SecretUpdate:
		return "Secret updated", true
	case SecretDelete:
		return "Secret deleted", true
	case SecretResolve:
		return "Secret use recorded", true
	case MasterRegister:
		return "Master key registered", true
	case RotationStart:
		return "Master key rotation started", true
	case RotationComplete:
		return "Master key rotation completed", true
	case RotationFailed:
		return "Master key rotation failed", true
	case PolicyUpdate:
		return "Outbound policy updated", true
	case AccessDeny:
		return "Outbound access denied", true
	case ObjectUploadComplete, ObjectUploadFailed, ObjectDelete, OutboxDeliveryRequeue:
		return "Audit event", true
	default:
		return "Audit event", AccountAction(action) || ModelAction(action)
	}
}
func AccountAction(a Action) bool {
	switch a {
	case AccountBootstrap, AccountLogin, AccountLogout, AccountInviteCreate, AccountInviteRevoke, AccountInviteRedeem, AccountPasswordChange, AccountPasswordResetRequest, AccountPasswordResetComplete, AccountProfileUpdate, AccountAvatarUpdate, AccountSettingsUpdate, SMTPSettingsUpdate, SMTPTestRequest, SMTPDelivery, SMTPDeliveryRetry:
