import copy
import difflib
import hashlib
import json
import shutil
from datetime import datetime, timezone
from pathlib import Path

S = Path(__file__).resolve().parent
W = S / 'workspace'
stage = S / 'web-stage02'
out = S / 'input07'
plan_path = S / 'startup-plan07.json'
assert not stage.exists() and not out.exists() and not plan_path.exists()


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def ref(path):
    return {'path': str(path), 'sha256': sha(path)}


def save(path, value):
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + '\n')


old_path = S / 'input06/manifest.json'
assert sha(old_path) == '420e50093fba526c37607b8c2fe4bbabf6cc91bf12dc6c62686e0a9dc1f953c8'
old = json.loads(old_path.read_text())
target = 'web/src/views/system/SystemAuditView.vue'
source = {path: sha(W / path) for path in old['files']}
assert [path for path in source if source[path] != old['files'][path]] == [target]
before = Path(old['source_archives'][target]['path']).read_text()
after = (W / target).read_text()
assert before.count('.sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n') == 1
expected = before.replace('.sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n', '.sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n', 1)
assert after == expected
for path, row in old['accepted_baseline']['files'].items():
    assert sha(W / path) == row['sha256'], path
for path, row in old['dependencies'].items():
    assert str(Path(path).resolve(strict=True)) == row['realpath'] and sha(Path(path)) == row['sha256'], path
for group in ['source_archives', 'dist_archives']:
    for row in old[group].values():
        assert sha(Path(row['path'])) == row['sha256']
assert sha(S / 'driver01.py') == old['driver_sha256']
assert sha(S / 'harness-stage07/manifest.json') == 'dc9fe49e77e1a8a7f973ac1b3934630c9071b4124ebd38dbab71440e9821dfef'
checks = {}
for name in ['web-stage02-format', 'web-stage02-page', 'web-stage02-build']:
    r = S / 'runs' / name
    result = json.loads((r / 'result.json').read_text())
    assert result['exit_code'] == 0 and result['actual_wait'] and not result['timed_out']
    assert result['owned_processes_double_empty'] and result['input_unchanged'] and result['readonly_dependencies_unchanged']
    checks[name] = {'directory': str(r), 'result': result, 'files': {p.name: sha(p) for p in r.iterdir() if p.is_file()}}
dist = {str(p.relative_to(W)): sha(p) for p in sorted((W / 'web/dist').rglob('*')) if p.is_file()}
assert len(dist) == 40
stage.mkdir()
archived = stage / 'source' / target
archived.parent.mkdir(parents=True)
shutil.copyfile(W / target, archived)
for path in dist:
    destination = stage / 'artifacts' / path
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(W / path, destination)
(stage / 'source.diff').write_text(''.join(difflib.unified_diff(before.splitlines(True), after.splitlines(True), fromfile='input06/' + target, tofile='web-stage02/' + target)))
prep = stage / 'preparation'
prep.mkdir()
for name in ['record_page02.py', 'freeze_web02_input07.py']:
    shutil.copyfile(S / name, prep / name)
original_navigation = {run: {name: ref(S / 'runs' / run / name) for name in ['command.json', 'raw.log', 'result.json', 'cleanup.json']} for run in ['navigation01', 'navigation02']}
(stage / 'report.md').write_text('''# Audit caption padding repair

Only SystemAuditView.vue's scoped .sr-only rule adds padding: 0. Caption markup, text, accessibility semantics, global CSS, browser predicates and thresholds are unchanged. The other 30 sources in accepted web-stage01, all four harness sources including harness-stage07, 943 accepted Git dependencies, 18 external tools and driver01 retain their input06 bytes. The changed View is a new product revision; the prior 31-source stage is not claimed wholly unchanged.

navigation01 remains the original Boolean layout failure with no failing field measurements and zero screenshots. navigation02 actually failed at light/1440/list with caption width 1 and height 8; table/caption were present, seven headers were present, and table scroll/client widths were both 798. Static global border-box plus caption padding-bottom: 8px explains the missing local padding reset. Neither round recorded computedStyle, and none is backfilled. Both original failures and their complete cleanup remain unchanged.

The changed file's Prettier check passed. The existing Audit visible-filters/inline-observations/local-focus group passed 12 tests, with the other eight tests explicitly skipped. Production build includes vue-tsc and Vite and passed. All three commands completed within the existing 45-second offline budget with actual waits, unchanged source/dependencies and empty owned-process double scans. These are offline regression/build results, not evidence that native caption geometry now passes. The full rebuilt 40-file dist is archived and individually hashed. No full 1763-test repetition, browser, service or database ran for this repair.

input07 and navigation03 are prepared for separate root review/resource authorization. Original input06 and all earlier sources, distributions, failures and cleanup records remain frozen.
''')
stage_manifest = {
    'stage': 'web-stage02 single-source scoped caption padding repair',
    'frozen_at_utc': datetime.now(timezone.utc).isoformat(),
    'previous_input': ref(old_path),
    'previous_accepted_web': ref(S / 'web-stage01/manifest.json'),
    'source': {target: source[target]},
    'current_all_source': source,
    'source_count': len(source),
    'unchanged_other_source_count': 34,
    'unchanged_accepted_web_source_count': 30,
    'harness07_unchanged': ref(S / 'harness-stage07/manifest.json'),
    'source_diff': ref(stage / 'source.diff'),
    'dist': dist,
    'checks': checks,
    'original_navigation': original_navigation,
    'report': ref(stage / 'report.md'),
    'preparation_sources': {p.name: sha(p) for p in prep.iterdir()},
    'resource_execution': False,
}
save(stage / 'manifest.json', stage_manifest)
manifest = copy.deepcopy(old)
manifest['stage'] = 'Audit real-startup input07; scoped caption padding repair; navigation03 not executed'
manifest['frozen_at_utc'] = datetime.now(timezone.utc).isoformat()
manifest['previous_manifest'] = ref(old_path)
manifest['files'] = source
manifest['source_archives'][target] = ref(archived)
manifest['dist'] = dist
manifest['dist_archives'] = {path: ref(stage / 'artifacts' / path) for path in dist}
manifest['stages']['C02'] = ref(stage / 'manifest.json')
manifest['original_navigation02'] = original_navigation['navigation02']
out.mkdir()
save(out / 'manifest.json', manifest)
shutil.copyfile(Path(__file__), out / 'freeze-source.py.txt')
shutil.copyfile(S / 'driver01.py', out / 'driver01.py')
save(out / 'delta.json', {
    'previous': ref(old_path), 'current': ref(out / 'manifest.json'),
    'changed_candidates': {target: {'before': old['files'][target], 'after': source[target]}},
    'candidate_diff': ref(stage / 'source.diff'), 'affected_checks': checks,
    'unchanged_candidate_count': 34, 'rebuilt_dist_count': len(dist),
    'unchanged_accepted_count': len(old['accepted_baseline']['files']),
    'unchanged_external_tool_count': len(old['dependencies']),
    'driver_unchanged_sha256': sha(S / 'driver01.py'),
    'resource_execution': False,
})
plan = json.loads((S / 'startup-plan06.json').read_text())
plan['status'] = 'navigation03 affected rerun plan only; separate root resource grant required'
plan['manifest'] = ref(out / 'manifest.json')
assert len(plan['plans']) == 1 and plan['plans'][0]['group'] == 'navigation'
plan['plans'][0]['name'] = 'navigation03'
args = plan['plans'][0]['argv']
args[args.index('--name') + 1] = 'navigation03'
args[args.index('--frozen') + 1] = 'input07/manifest.json'
save(plan_path, plan)
free = shutil.disk_usage(S).free
save(out / 'disk-preparation.json', {'utc': datetime.now(timezone.utc).isoformat(), 'free_bytes': free, 'required_for_actual_start': 5368709120, 'passes_now': free >= 5368709120, 'startup_must_repeat': True})
print(json.dumps({'web_manifest': sha(stage / 'manifest.json'), 'source_diff': sha(stage / 'source.diff'), 'view': source[target], 'input07': sha(out / 'manifest.json'), 'delta': sha(out / 'delta.json'), 'plan': sha(plan_path), 'source_count': len(source), 'dist_count': len(dist), 'free_bytes': free}, indent=2))
