const mimeVectors = [{"input": "text/plain", "accepted": true}, {"input": "text", "accepted": true}, {"input": "text/{json}", "accepted": true}, {"input": "{x}", "accepted": true}, {"input": "application/x{probe}", "accepted": true}, {"input": "text&x/plain", "accepted": true}, {"input": "text/plain; charset=utf-8", "accepted": true}, {"input": "text/plain; charset=us-ascii", "accepted": true}, {"input": "Text/Plain", "accepted": false}, {"input": "text/plain;charset=utf-8", "accepted": false}, {"input": "text/plain; charset=\"utf-8\"", "accepted": false}, {"input": "text/plain; charset=UTF-8", "accepted": false}, {"input": "text/plain; name=x", "accepted": false}, {"input": "text/plain; charset=latin-1", "accepted": false}, {"input": "text/", "accepted": false}, {"input": "text/plain/extra", "accepted": false}, {"input": "text/plain\n", "accepted": false}, {"input": "text/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "accepted": true}, {"input": "text/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "accepted": false}]
const encodingVectors = [{"value": "<>&\u2028\u2029", "bytes": 42}, {"value": "&", "bytes": 18}, {"value": "\u00e9", "bytes": 14}, {"value": "\\u2028", "bytes": 19}, {"value": "\n\t\"\\", "bytes": 20}]
describe('formal Go MIME and metadata encoding bounds', () => {
  it.each(mimeVectors.map((vector,index)=>({...vector,index})))('matches typed MIME vector $index', ({input,accepted}) => {
    let actual=false; try {actual=auditMediaType(input)===input} catch { /* expected closed rejection */ }
    expect(actual===accepted).toBe(true)
  })
  it.each(encodingVectors.map((vector,index)=>({...vector,index})))('counts Go default escaping vector $index', ({value,bytes})=> {
    expect(auditMetadataJSONBytes({value})===bytes).toBe(true)
  })
  it('retains each HTML escape in the 4096-byte budget without treating literal escapes as characters', () => {
    expect(auditMetadataJSONBytes({value:'a'.repeat(4084)})).toBe(4096)
    expect(auditMetadataJSONBytes({value:'a'.repeat(4085)})).toBe(4097)
    expect(auditMetadataJSONBytes({value:'&'.repeat(680)})).toBe(4092)
    expect(auditMetadataJSONBytes({value:'&'.repeat(681)})).toBe(4098)
