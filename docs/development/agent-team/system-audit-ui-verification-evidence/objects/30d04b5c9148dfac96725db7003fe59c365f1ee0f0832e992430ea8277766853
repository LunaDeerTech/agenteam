+func (f *auditWebFixture) ipc(ctx context.Context, r auditWebIPC) map[string]any {
+	value := map[string]any{"sequence": r.Sequence, "ok": true}
+	switch r.Action {
+	case "snapshot":
+		value["records"] = f.snapshot(ctx, r.IDs)
+	case "arm-hold", "arm-cut":
+		if !auditWebPath(r.Path) {
+			f.t.Fatal("owned Audit control path rejected")
+		}
+		f.mu.Lock()
+		if f.holdPath != "" || f.cutPath != "" || f.held != f.joined {
+			f.mu.Unlock()
+			f.t.Fatal("owned response control overlap")
+		}
+		if r.Action == "arm-hold" {
+			f.holdPath = r.Path
+			f.release = make(chan struct{})
+			f.releaseOnce = sync.Once{}
+		} else {
+			f.cutPath = r.Path
+		}
+		f.mu.Unlock()
+	case "release":
+		f.releaseRead()
+	case "counts":
+		f.mu.Lock()
+		value["held"], value["joined"], value["cuts"] = f.held, f.joined, f.cuts
+		f.mu.Unlock()
+		value["session_failures"] = f.sessionFailures.Load()
+		value["server_started"], value["server_finished"] = f.serverStarted.Load(), f.serverFinished.Load()
+	case "session-fail":
+		f.failSession.Store(true)
+	case "permissions":
+		if len(r.IDs) != 1 {
+			f.t.Fatal("owned permission target missing")
+		}
+		for _, path := range []string{systemAuditHTTPPath, systemAuditHTTPPath + "/" + r.IDs[0]} {
+			problem := f.official(ctx, f.memberClient, "GET", path, nil, "", 403)
+			if problem["code"] != "FORBIDDEN" {
+				f.t.Fatal("formal ordinary Audit rejection mismatch")
+			}
+		}
+		missing := f.official(ctx, f.adminClient, "GET", systemAuditHTTPPath+"/"+id[struct{}](f.t).String(), nil, "", 404)
+		if missing["code"] != "NOT_FOUND" {
+			f.t.Fatal("formal Audit detail absence mismatch")
+		}
+		value["ordinary_both_forbidden"], value["detail_missing"] = true, true
+	case "logout":
+		f.mu.Lock()
+		session, ok := f.sessions[r.SessionID]
+		f.mu.Unlock()
+		if !ok || session.user != f.admin.UserID || session.cookie == "" {
+			f.t.Fatal("exact owned browser Session unavailable")
+		}
+		request, err := http.NewRequestWithContext(ctx, "POST", f.origin+"/api/v1/sessions/logout", nil)
+		if err != nil {
+			f.t.Fatal("owned Logout request invalid")
+		}
+		request.Header.Set("Cookie", session.cookie)
+		request.Header.Set("Origin", f.origin)
+		request.Header.Set("Sec-Fetch-Site", "same-origin")
+		request.Header.Set("X-CSRF-Token", session.csrf)
+		request.Header.Set("Idempotency-Key", id[struct{}](f.t).String())
+		transport := &http.Transport{Proxy: nil}
+		client := &http.Client{Transport: transport, Timeout: 10 * time.Second}
+		response, err := client.Do(request)
+		if err != nil {
+			transport.CloseIdleConnections()
+			f.t.Fatal("formal exact browser Logout failed")
+		}
+		raw, e := io.ReadAll(io.LimitReader(response.Body, 600001))
+		closeErr := response.Body.Close()
+		transport.CloseIdleConnections()
+		complete := response.StatusCode == 204 && e == nil && closeErr == nil && len(raw) == 0
+		clear(raw)
+		if !complete {
+			f.t.Fatal("formal exact browser Logout terminal mismatch")
+		}
+		conn, closeConnection := invitationsWebConnect(f.t, ctx, f.db)
+		var revoked bool
+		var audits int
+		err = conn.QueryRow(ctx, `SELECT revoked_at IS NOT NULL AND revoked_reason='logout',(SELECT count(*) FROM agenteam_audit.audit_records WHERE action='account.logout' AND metadata->>'session_id'=$1 AND outcome='success') FROM agenteam_account.sessions WHERE id=$1 AND user_id=$2`, r.SessionID, session.user).Scan(&revoked, &audits)
+		closeConnection()
+		if err != nil || !revoked || audits != 1 {
+			f.t.Fatal("formal exact Session Logout facts missing")
+		}
+		value["revoked"], value["logout_audit"] = true, true
+	default:
+		f.t.Fatal("owned Audit IPC action rejected")
+	}
+	return value
+}
