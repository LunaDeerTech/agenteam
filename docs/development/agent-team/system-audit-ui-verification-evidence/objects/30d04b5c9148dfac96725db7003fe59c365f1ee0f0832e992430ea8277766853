+func (*auditWebCut) Error() string { return "owned audit response intentionally truncated" }
+func auditWebPath(path string) bool {
+	if path == systemAuditHTTPPath {
+		return true
+	}
+	if !strings.HasPrefix(path, systemAuditHTTPPath+"/") {
+		return false
+	}
+	value := strings.TrimPrefix(path, systemAuditHTTPPath+"/")
+	_, err := foundation.ParseID[struct{}](value)
