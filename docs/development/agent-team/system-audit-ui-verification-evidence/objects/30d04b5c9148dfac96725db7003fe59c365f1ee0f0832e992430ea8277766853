+func (f *auditWebFixture) controlResponse(response *http.Response) error {
+	r := response.Request
+	if r == nil || r.Method != "GET" {
+		return nil
+	}
+	if r.URL.Path == "/api/v1/session" && response.StatusCode == 200 {
+		raw, err := io.ReadAll(io.LimitReader(response.Body, 600001))
+		closeErr := response.Body.Close()
+		defer clear(raw)
+		var value struct {
+			User struct {
+				ID string `json:"id"`
+			} `json:"user"`
+			Session struct {
+				ID string `json:"id"`
+			} `json:"session"`
+			CSRF string `json:"csrf_token"`
+		}
+		if err != nil || closeErr != nil || len(raw) > 600000 || json.Unmarshal(raw, &value) != nil || value.Session.ID == "" || value.CSRF == "" {
+			return errors.New("owned Session observation invalid")
+		}
+		f.mu.Lock()
+		f.sessions[value.Session.ID] = auditWebSession{cookie: r.Header.Get("Cookie"), csrf: value.CSRF, user: value.User.ID}
+		f.mu.Unlock()
+		response.Body = io.NopCloser(bytes.NewReader(append([]byte(nil), raw...)))
+		return nil
+	}
+	if !auditWebPath(r.URL.Path) || response.StatusCode != 200 {
+		return nil
+	}
+	f.mu.Lock()
+	hold, cut := f.holdPath == r.URL.Path, f.cutPath == r.URL.Path
+	release := f.release
+	if hold {
+		f.holdPath = ""
+		f.held++
+	}
+	if cut {
+		f.cutPath = ""
+		f.cuts++
+	}
+	f.mu.Unlock()
+	if !hold && !cut {
+		return nil
+	}
+	raw, err := io.ReadAll(io.LimitReader(response.Body, (1<<20)+1))
+	closeErr := response.Body.Close()
+	if err != nil || closeErr != nil || len(raw) > 1<<20 || len(raw) < 2 {
+		clear(raw)
+		return errors.New("owned control requires complete formal Audit response")
+	}
+	if hold {
+		select {
+		case <-r.Context().Done():
+			err = r.Context().Err()
+		case <-release:
+		}
+		f.mu.Lock()
+		f.joined++
+		f.mu.Unlock()
+		if err != nil {
+			clear(raw)
+			return err
+		}
+	}
+	if cut {
+		defer clear(raw)
+		return &auditWebCut{header: response.Header.Clone(), prefix: append([]byte(nil), raw[:len(raw)/2]...), length: len(raw)}
+	}
+	response.Body = io.NopCloser(bytes.NewReader(raw))
+	response.ContentLength = int64(len(raw))
+	return nil
+}
