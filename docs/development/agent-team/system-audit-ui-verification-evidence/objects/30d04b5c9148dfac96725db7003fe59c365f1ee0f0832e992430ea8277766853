+      button(page, detailMode ? "重新读取详情" : "重试读取"),
+    ).toBeEnabled();
+    expect(
+      (await auditFacts(page)).filter((f) => f.sequence > after).length,
+    ).toBe(1);
+    expect(
+      (await auditFacts(page)).filter((f) => f.sequence > ended.sequence)
