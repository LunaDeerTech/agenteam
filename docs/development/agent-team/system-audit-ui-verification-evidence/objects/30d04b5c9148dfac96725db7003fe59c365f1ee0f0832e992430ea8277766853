+              f.path === endpoint
+                ? "list"
+                : f.path.startsWith(endpoint + "/")
+                  ? "detail"
+                  : "other",
+            status: f.status,
+            ended: f.ended,
+            eof: f.eof,
+            code: f.code ?? null,
+          })),
+      ),
+    );
+    throw error;
+  }
