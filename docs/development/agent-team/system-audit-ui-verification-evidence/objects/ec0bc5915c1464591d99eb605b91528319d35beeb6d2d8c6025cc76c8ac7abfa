  f.setAudit(async()=>problem('DEPENDENCY_UNAVAILABLE',503));await p.next();const target=f.reads().at(-1)![0]
  await p.retry();expect(f.reads().at(-1)![0]===target&&p.state.list.phase==='error').toBe(true)
  f.setAudit(async()=>problem('CURSOR_INVALID',400));await p.retry();expect(p.state.list.cursorInvalid&&p.state.list.items.length===0).toBe(true)
  const before=f.reads().length;await p.retry();await p.previous();expect(f.reads().length).toBe(before)
  f.setAudit(async()=>json(page()));await p.refresh();expect(!new URL(f.reads().at(-1)![0],'https://local.invalid').searchParams.has('cursor')).toBe(true)
 })
 it.each(['cancel','timeout'] as const)('turns %s into a stable error and does not reread after actual tail release',async(mode)=>{
  const f=await fixture(),held=nativeHold('application/json',page(1));f.setAudit(async()=>held.response())
  vi.useFakeTimers({toFake:['setTimeout','clearTimeout']});const p=f.page();await flushPromises()
  try{
   if(mode==='cancel')p.cancel();else await vi.advanceTimersByTimeAsync(30000)
   await held.entered.promise;await flushPromises()
   expect(p.state.list.phase==='error'&&p.state.list.items.length===0&&f.auth.state.busy).toBe(true)
   const before=f.reads().length;await p.retry();await p.refresh();expect(f.reads().length).toBe(before)
  }finally{held.release();await flushPromises()}
  expect(!f.auth.state.busy&&p.state.list.phase==='error'&&f.reads().length===1).toBe(true)
  f.setAudit(async()=>json(page()));await p.retry();expect(f.reads().length===2&&p.state.list.phase==='empty').toBe(true)
 })
 it.each(['new-page','disposed-page','cancelled-wait','identity-retired'] as const)('consumes initial eligibility exactly for %s after an old native tail',async(mode)=>{
  const f=await fixture(),held=nativeHold('text/plain');f.setAudit(async()=>held.response())
  const old=resultOf(f.auth.system.audit.list({}));await held.entered.promise;f.auth.system.audit.abandon();await old
  const p=f.page();expect(p.state.list.phase).toBe('waiting')
  if(mode==='disposed-page')p.dispose();if(mode==='cancelled-wait')p.cancel();if(mode==='identity-retired')f.auth.leave()
  f.setAudit(async()=>json(page()))
  try{expect(f.reads().length===1&&f.auth.state.busy).toBe(true)}finally{held.release();await old;await flushPromises()}
  expect(f.reads().length).toBe(mode==='new-page'?2:1)
  if(mode==='new-page')expect(p.state.list.phase).toBe('empty')
  if(mode==='cancelled-wait'){expect(p.state.list.phase).toBe('error');await p.refresh();expect(f.reads().length).toBe(2)}
 })
 it('retires old state through checking/503 and only a new same-Session instance starts the default page',async()=>{
  const f=await fixture(),p=f.page();await flushPromises();p.updateFilter('action','secret.create');await p.apply();p.updateFilter('tool_id',id(4))
  f.setSessionRequest(async()=>problem('DEPENDENCY_UNAVAILABLE',503));await f.auth.restore();await flushPromises()
  expect(p.state.list.phase==='inactive'&&p.draft.action===''&&p.draft.tool_id===''&&p.state.detail.target===null&&!p.isCurrent()).toBe(true)
  const before=f.reads().length;await p.refresh();expect(f.reads().length).toBe(before)
  f.setSessionRequest(async()=>json(view()));await f.auth.restore();await flushPromises();expect(f.reads().length).toBe(before)
  const next=f.page();await flushPromises();expect(next.state.list.phase==='empty'&&f.reads().length===before+1).toBe(true)
  const q=new URL(f.reads().at(-1)![0],'https://local.invalid').searchParams;expect(q.size===1&&q.get('limit')==='50').toBe(true)
 })
 it('route-leave cancels synchronously but keeps a surviving instance explicitly refreshable',async()=>{
  const f=await fixture(),p=f.page();await flushPromises();p.updateFilter('action','secret.create');await p.apply()
  const held=nativeHold('application/json',page(1));f.setAudit(async()=>held.response());const pending=p.refresh();await flushPromises()
  try {p.leave();expect(p.state.list.phase==='error'&&p.state.list.items.length===0&&p.state.applied.action==='secret.create'&&f.auth.state.busy).toBe(true);await held.entered.promise}finally{held.release();await pending;await flushPromises()}
  const before=f.reads().length;await flushPromises();expect(f.reads().length).toBe(before)
  f.setAudit(async()=>json(page()));await p.refresh();expect(f.reads().length===before+1&&p.state.list.phase==='empty').toBe(true)
 })
