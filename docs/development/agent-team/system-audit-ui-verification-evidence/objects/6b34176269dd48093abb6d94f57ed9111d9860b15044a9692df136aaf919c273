test('A: actual owner tails, cross-domain isolation and read-only safety classification', { timeout: 15000 }, async t => {
  const s = scope(t), f = await fixture(s), a = f.auth
  assert.deepEqual(Object.keys(a.system.audit).sort(), ['abandon', 'get', 'list'])
  const h = hold(s, undefined, 'text/plain')
  let signal, deadline
  f.handlers.audit = async (_path, init) => { signal = init.signal; return h.response() }
  const realSetTimeout = globalThis.setTimeout, realClearTimeout = globalThis.clearTimeout
  const timer = { virtual: 30000 }
  globalThis.setTimeout = (fn, ms, ...args) => { if (ms === 30000) { assert.equal(deadline, undefined); deadline = () => fn(...args); return timer } return realSetTimeout(fn, ms, ...args) }
  globalThis.clearTimeout = value => { if (value !== timer) realClearTimeout(value) }
  let auditTask
  try {
    auditTask = caught(a.system.audit.list({}))
    await h.cancelEntered.promise
    const before = f.calls.length
    for (const [_name, read, abandon] of domains(a)) { abandon(); await failure(read(), 'busy') }
    await a.restore()
    assert.equal(f.calls.length, before)
    assert.equal(signal.aborted, false)
    assert.equal(a.state.busy, true)
    assert.equal(typeof deadline, 'function')
    deadline()
    assert.equal((await auditTask).error?.kind, 'cancelled')
    assert.equal(signal.aborted, true)
    assert.equal(a.state.busy && !h.joined, true)
    await failure(a.personal.getProfile(), 'busy')
    h.release()
    await until(() => !a.state.busy, 'Audit actual cancel finally released owner')
    assert.equal(h.joined && h.cancels === 1 && !h.stream.locked, true)
  } finally { globalThis.setTimeout = realSetTimeout; globalThis.clearTimeout = realClearTimeout; h.release(); if (auditTask) await auditTask }

  // Four old-domain native tails; the remaining six scoped branches are statically
  // checked and retain the author's actual native assertions, not re-labelled here.
  for (const [name, read, abandon, channel] of domains(a).filter(d => ['personal', 'smtp', 'delivery', 'outbound'].includes(d[0]))) {
    const h = hold(s, undefined, 'text/plain'), previous = f.handlers[channel]
    let ownerSignal
    f.handlers[channel] = async (_path, init) => { ownerSignal = init.signal; return h.response() }
    const pending = caught(read())
    try {
      await h.cancelEntered.promise
      const before = f.calls.length
      a.system.audit.abandon()
      await failure(a.system.audit.get(id(100)), 'busy')
      assert.equal(!ownerSignal.aborted && a.state.busy && f.calls.length === before, true, name)
      abandon()
      assert.equal((await pending).error?.kind, 'cancelled')
      assert.equal(a.state.busy && !h.joined, true)
    } finally { h.release(); await pending; await until(() => !a.state.busy, name + ' actual cancel joined'); f.handlers[channel] = previous }
    assert.equal(h.joined && h.cancels === 1 && !h.stream.locked, true)
  }

  await a.system.smtp.get()
  a.system.smtp.setMaterial('private value kept solely inside fixture process')
  const unknown = async () => problem(503, 'COMMIT_UNKNOWN', 'unknown')
  f.handlers.smtp = f.handlers.delivery = f.handlers.outbound = unknown
  await failure(a.system.smtp.startUpdate({ version: '1', ...smtpFields(), username: 'smtp-user', credential_action: 'keep' }), 'problem')
  await failure(a.system.smtpDelivery.startTest({ recipient: 'target@example.test' }), 'problem')
  await failure(a.system.outboundPolicy.startUpdate({ expected_version: '1', rules: [] }), 'problem')
  const retained = () => a.system.smtp.material.present && [a.system.smtp, a.system.smtpDelivery, a.system.outboundPolicy].every(op => op.progress?.phase === 'uncertain')
  assert.equal(retained(), true)
  const writes = f.writes().length
  for (const [status, code] of [[503, 'COMMIT_UNKNOWN'], [503, 'FORBIDDEN'], [401, 'FORBIDDEN'], [403, 'SESSION_REVOKED'], [403, 'CSRF_FAILED']]) {
    f.handlers.audit = async () => problem(status, code, code === 'COMMIT_UNKNOWN' ? 'unknown' : 'not_started')
    await failure(a.system.audit.list({}), 'problem')
    a.system.audit.abandon()
    assert.equal(a.state.phase === 'authenticated' && !a.system.denied && retained() && f.writes().length === writes && !a.state.canRetryOriginal, true)
  }
  for (const { init } of f.reads()) assert.equal(init.method === 'GET' && init.body === undefined && !new Headers(init.headers).has('Idempotency-Key') && !new Headers(init.headers).has('X-CSRF-Token'), true)
  f.handlers.audit = async () => problem(403, 'FORBIDDEN', 'unknown')
  await caught(a.system.audit.list({}))
  await until(() => !a.state.busy, '403 actual tail joined')
  assert.equal(a.state.phase === 'authenticated' && a.system.denied && !a.system.smtp.material.present && [a.system.smtp, a.system.smtpDelivery, a.system.outboundPolicy].every(op => op.progress === null), true)
  const g = await fixture(s)
  g.auth.system.smtp.setMaterial('private current-session field')
  g.handlers.audit = async () => problem(401, 'SESSION_REVOKED', 'unknown')
  await caught(g.auth.system.audit.get(id(100)))
  await until(() => !g.auth.state.busy, '401 actual tail joined')
  assert.equal(g.auth.personalContext.identity === null && g.auth.state.phase === 'unavailable' && !g.auth.system.smtp.material.present, true)
  t.diagnostic('10 old domains blocked/scoped abandon; 4 reverse native cancel tails; virtual 30000 ms visible boundary with actual cancel finally; read Unknown preserved 3 old intents; lawful current 403/401 cleared safely. No 30-second wall-clock claim.')
})

test('B: recoverable page cancellation, permanent retirement and a single new-instance read', { timeout: 15000 }, async t => {
  const s = scope(t), f = await fixture(s), a = f.auth, p = f.page()
  await until(() => p.state.list.phase === 'ready' && !a.state.busy, 'initial list ready')
  p.updateFilter('action', 'secret.create')
  const held = hold(s, page())
  f.handlers.audit = async () => held.response()
  const applied = p.apply()
  await until(() => f.reads().length === 2, 'filter read dispatched')
  assert.equal(p.state.list.phase === 'loading' && p.state.list.items.length === 0, true)
  p.cancel()
  await held.cancelEntered.promise
  const beforeCancel = f.reads().length
  assert.equal(p.state.list.phase === 'error' && p.state.list.items.length === 0 && a.state.busy, true)
  await p.retry(); assert.equal(f.reads().length, beforeCancel)
  held.release(); await applied; await until(() => !a.state.busy, 'cancel actual join')
  assert.equal(f.reads().length, beforeCancel)
  f.handlers.audit = async () => json(page())
  await p.retry()
  assert.equal(p.state.list.phase === 'ready' && f.reads().length === beforeCancel + 1, true)
  assert.equal(new URL(f.reads().at(-1).path, 'https://local.invalid').searchParams.get('action'), 'secret.create')

  const detail = hold(s, record())
  f.handlers.audit = async () => detail.response()
  const opened = p.openDetail(id(100))
  await until(() => p.state.detail.phase === 'loading' && a.state.busy && f.reads().at(-1).path.endsWith('/' + id(100)), 'detail read dispatched')
  p.leave(); await detail.cancelEntered.promise
  const beforeLeave = f.reads().length
  assert.equal(p.state.mode === 'list' && p.state.list.phase === 'error' && p.state.detail.record === null && p.state.detail.target === null && p.state.applied.action === 'secret.create' && p.isCurrent(), true)
  detail.release(); await opened; await until(() => !a.state.busy, 'leave actual join')
  assert.equal(f.reads().length, beforeLeave)
  f.handlers.audit = async () => json(page())
  await p.refresh()
  assert.equal(p.state.list.phase === 'ready' && f.reads().length === beforeLeave + 1, true)

  const retiring = hold(s, page())
  f.handlers.audit = async () => retiring.response()
  const oldRead = p.refresh()
  const oldCount = f.reads().length
  await until(() => f.reads().length > oldCount, 'old instance read entered transport')
  p.dispose(); await retiring.cancelEntered.promise
  f.handlers.audit = async () => json(page())
  const fresh = f.page(), beforeFresh = f.reads().length
  assert.equal(fresh.state.list.phase === 'waiting' && a.state.busy && p.state.list.phase === 'inactive', true)
  retiring.release(); await oldRead
  await until(() => !a.state.busy && fresh.state.list.phase === 'ready', 'new instance waits old actual tail then reads once')
  assert.equal(f.reads().length, beforeFresh + 1)
  await p.refresh(); await turn(); assert.equal(f.reads().length, beforeFresh + 1)
  assert.equal(new URL(f.reads().at(-1).path, 'https://local.invalid').search, '?limit=50')

  fresh.updateFilter('tool_id', id(4))
  const checking = deferred(); s.releases.push(() => checking.resolve(problem(503, 'DEPENDENCY_UNAVAILABLE')))
  f.handlers.session = async () => checking.promise
  const restore = a.restore()
  await until(() => a.state.phase === 'checking', 'checking starts')
  assert.equal(!fresh.isCurrent() && fresh.draft.tool_id === '' && fresh.state.list.items.length === 0 && fresh.state.list.phase === 'inactive', true)
  const beforeRestore = f.reads().length
  checking.resolve(problem(503, 'DEPENDENCY_UNAVAILABLE')); await restore
  await fresh.refresh(); assert.equal(f.reads().length, beforeRestore)
  f.handlers.session = async () => json(session())
  await a.restore(); await turn()
  assert.equal(f.reads().length, beforeRestore)
  const sameIdentityNew = f.page()
  await until(() => !a.state.busy && sameIdentityNew.state.list.phase === 'ready', 'same Session only a new page reads')
  assert.equal(f.reads().length, beforeRestore + 1)
  assert.equal(!fresh.isCurrent() && p.state.list.phase === 'inactive', true)

  // Controlled already-parsed API failure, not a claim about native post-abort parsing.
  const parsed = deferred(), entered = deferred()
  let first = true
  s.releases.push(() => parsed.reject(new AccountFailure('cancelled')))
  const late = await fixture(s, { list() { if (first) { first = false; entered.resolve(); return parsed.promise } return Promise.resolve({ items: [], next_cursor: null }) }, get: () => Promise.reject(new AccountFailure('invalid-input')) })
  const pending = caught(late.auth.system.audit.list({}))
  await entered.promise
  late.auth.leave()
  assert.equal(late.auth.personalContext.identity === null && late.auth.state.busy, true)
  const beforeBlockedRestore = late.calls.length
  await late.auth.restore(); assert.equal(late.calls.length, beforeBlockedRestore)
  parsed.reject(new AccountFailure('problem', problemValue(401, 'SESSION_REVOKED')))
  await pending; await until(() => !late.auth.state.busy, 'retired parsed failure actual tail joined')
  assert.equal(late.auth.state.phase, 'checking')
  late.setSession(session(id(77))); await late.auth.restore()
  assert.equal(late.auth.state.session?.id === id(77) && !late.auth.system.denied, true)
  assert.equal(f.writes().length + late.writes().length, 0)
  t.diagnostic('Native JSON bytes without EOF never published; cancel/leave stable error with explicit reread; disposed/checking instances never revived; successor waited actual tail and issued one default read; old parsed 401 retired before new identity. Controller only, no App or native focus.')
})
