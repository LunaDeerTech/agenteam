def run(name, argv):
    folder = ROOT / name
    folder.mkdir()
    before = stamp()
    write(folder / 'input-before.json', before)
    baseline = processes()
    write(folder / 'process-baseline.json', {str(p): {k:r[k] for k in ['ppid','starttime','state','name','executable']} for p,r in baseline.items()})
    record = {'argv': argv, 'cwd': str(REPO), 'env': SAFE_ENV, 'limit_seconds':45, 'started_utc':previous.utc(), 'main_head':HEAD}
    write(folder / 'command.json', record)
    observed, waited, timed_out = {}, [], False
    started = time.monotonic()
    with (folder / 'raw.log').open('wb') as raw:
        child = subprocess.Popen(argv, cwd=REPO, env=env, stdout=raw, stderr=subprocess.STDOUT, start_new_session=True)
        print(json.dumps({'check':name,'pid':child.pid,'argv':argv}), flush=True)
        while True:
            current = processes()
            owned = {child.pid} | {p for p,r in current.items() if r['ppid'] == os.getpid()}
            for _ in range(12):
                larger = owned | {p for p,r in current.items() if r['ppid'] in owned}
                if larger == owned: break
                owned = larger
            for p in owned:
                if p in current:
                    r = current[p]
                    observed[str(p)+':'+r['starttime']] = {'pid':p, **{k:r[k] for k in ['ppid','starttime','state','name','executable']}}
            reap_adopted(observed, child.pid, waited)
            if child.poll() is not None: break
            if time.monotonic()-started >= 45 and not timed_out:
                timed_out = True
                os.killpg(child.pid, signal.SIGTERM)
            if timed_out and time.monotonic()-started >= 46:
                os.killpg(child.pid, signal.SIGKILL)
            time.sleep(.025)
        code = child.wait()
    record.update({'exit':code,'seconds':round(time.monotonic()-started,3),'actual_wait_completed':True,'ended_utc':previous.utc(),'timed_out':timed_out})
    write(folder / 'command.json', record)
    cleanups = []
    for _ in range(2):
        reap_adopted(observed, child.pid, waited)
        current = processes()
        remaining = [r for r in observed.values() if r['pid'] in current and current[r['pid']]['starttime'] == r['starttime']]
        cleanups.append({'time':previous.utc(),'owned_processes':remaining,'runtime_entries':sorted(p.name for p in (ROOT/'tmp').iterdir())})
        time.sleep(.15)
    write(folder / 'cleanup.json', cleanups)
    write(folder / 'observed-processes.json', observed)
    write(folder / 'adopted-waits.json', waited)
    after = stamp()
    write(folder / 'input-after.json', after)
    clean = all(not r['owned_processes'] and not r['runtime_entries'] for r in cleanups)
    result = {'exit':code,'seconds':record['seconds'],'actual_wait_completed':True,'timed_out':timed_out,'input_unchanged':before==after,'double_cleanup':clean,'observed_processes':len(observed),'adopted_waits':len(waited),'raw_sha256':sha(folder/'raw.log'),'command_sha256':sha(folder/'command.json')}
    write(folder / 'result.json', result)
    print(json.dumps({'check':name, **result}),flush=True)
    if code or timed_out or before != after or not clean:
        raise RuntimeError('check failed; stopped without retry: '+name)
    return folder

