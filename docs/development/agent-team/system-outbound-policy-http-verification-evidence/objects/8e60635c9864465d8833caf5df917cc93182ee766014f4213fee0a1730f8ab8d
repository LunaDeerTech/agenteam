from pathlib import Path
import ctypes
import datetime
import hashlib
import json
import os
import signal
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent
name = sys.argv[1]
run = ROOT / 'runs' / name
run.mkdir(parents=True)
GO = '/workspace/toolchains/go1.27.1/bin/go'
command = [GO, 'test', '-p=2', '-race', '-count=1', '-timeout=45s',
           './internal/central/outbound/http', '-run', '^TestIndependentPolicy', '-v']
fixed_env = {'GOTOOLCHAIN': 'local', 'GOPROXY': 'off', 'GOSUMDB': 'off',
             'GOFLAGS': '-mod=readonly -buildvcs=false', 'GOENV': 'off', 'GOWORK': 'off',
             'GOMODCACHE': '/workspace/scratch/agenteam-d27-directory-author-EvHmqxns/modcache',
             'GOCACHE': str(ROOT / 'gocache'), 'TMPDIR': str(ROOT / 'tmp'),
             'GOMAXPROCS': '2', 'CGO_ENABLED': '1'}
for key in ['GOCACHE', 'TMPDIR']:
    Path(fixed_env[key]).mkdir(exist_ok=True)
env = {**os.environ, **fixed_env}
probe = 'internal/central/outbound/http/independent_risk_test.go'
files = list(json.loads((ROOT / 'fixed-input.json').read_text())['files']) + [probe]
def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()
def fingerprint():
    return {p: digest(ROOT / 'source' / p) for p in files}
before = fingerprint()
(run / 'input-before.json').write_text(json.dumps(before, indent=2) + '\n')
(run / 'probe.go.txt').write_bytes((ROOT / 'source' / probe).read_bytes())
(run / 'driver.py.txt').write_bytes(Path(__file__).read_bytes())
metadata = {'argv': command, 'cwd': str(ROOT / 'source'), 'env': fixed_env,
            'go_binary_sha256': digest(Path(GO)), 'outer_compile_and_test_budget_seconds': 180,
            'test_timeout_seconds': 45, 'scope': 'offline and owned loopback only; no PG/Docker/SMTP',
            'started_utc': datetime.datetime.now(datetime.timezone.utc).isoformat()}
(run / 'command.json').write_text(json.dumps(metadata, indent=2) + '\n')
assert ctypes.CDLL(None, use_errno=True).prctl(36, 1, 0, 0, 0) == 0
def group(pgid):
    result = []
    for p in Path('/proc').glob('[0-9]*/stat'):
        try:
            d = p.read_text().rsplit(')', 1)[1].split()
            if int(d[2]) == pgid:
                result.append({'pid': int(p.parent.name), 'starttime': int(d[19]), 'state': d[0]})
        except (FileNotFoundError, ProcessLookupError):
            pass
    return sorted(result, key=lambda x: (x['pid'], x['starttime']))

start = time.monotonic()
seen = {}
adopted = []
timed_out = False
with (run / 'raw.log').open('wb') as output:
    child = subprocess.Popen(command, cwd=ROOT / 'source', env=env,
                             stdout=output, stderr=subprocess.STDOUT, start_new_session=True)
    while child.poll() is None:
        for row in group(child.pid):
            seen[(row['pid'], row['starttime'])] = row
        if time.monotonic() - start > 180:
            timed_out = True
            os.killpg(child.pid, signal.SIGTERM)
            try:
                child.wait(timeout=1)
            except subprocess.TimeoutExpired:
                os.killpg(child.pid, signal.SIGKILL)
            break
        time.sleep(0.05)
    exit_code = child.wait()
    child_seconds = round(time.monotonic() - start, 3)
for _ in range(40):
    while True:
        try:
            pid, status = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            break
        if pid == 0:
            break
        adopted.append({'pid': pid, 'status': status})
    if not group(child.pid):
        break
    time.sleep(0.05)
first = group(child.pid)
time.sleep(0.15)
second = group(child.pid)
after = fingerprint()
(run / 'input-after.json').write_text(json.dumps(after, indent=2) + '\n')
result = {'actual_exit': exit_code, 'actual_wait_completed': True, 'seconds': child_seconds,
          'timed_out': timed_out, 'child_pid': child.pid, 'observed_owned': list(seen.values()),
          'actual_adopted_waits': adopted, 'cleanup_first': first, 'cleanup_second': second,
          'input_unchanged': before == after, 'raw_sha256': digest(run / 'raw.log'),
          'ended_utc': datetime.datetime.now(datetime.timezone.utc).isoformat()}
(run / 'result.json').write_text(json.dumps(result, indent=2) + '\n')
print(json.dumps({k: v for k, v in result.items() if k != 'observed_owned'} | {'owned_count': len(seen)}))
print((run / 'raw.log').read_text())
sys.exit(exit_code if exit_code else 1 if first or second or before != after else 0)
