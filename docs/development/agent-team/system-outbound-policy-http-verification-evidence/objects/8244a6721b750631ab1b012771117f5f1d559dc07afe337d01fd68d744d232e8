// Author helpers are used only to construct opaque typed actors/policies via
// their public constructors. All observations and assertions below are private.
type independentPolicy struct {
	get func(context.Context, identity.Actor) (outbound.Policy, error)
	put func(context.Context, identity.Actor, outbound.CommandMeta, outbound.Rules) (outbound.UpdateResult, error)
}

func (p independentPolicy) GetPolicy(c context.Context, a identity.Actor) (outbound.Policy, error) {
	return p.get(c, a)
}
func (p independentPolicy) UpdatePolicy(c context.Context, a identity.Actor, m outbound.CommandMeta, r outbound.Rules) (outbound.UpdateResult, error) {
	return p.put(c, a, m, r)
}

type independentBoundary struct {
	auth func(*http.Request, identity.AccessIntent) (identity.Actor, error)
}

func (b independentBoundary) CheckRequest(w http.ResponseWriter, _ *http.Request) error {
	w.Header().Set("Cache-Control", "no-store")
	return nil
}
func (b independentBoundary) RequireSystem(r *http.Request, i identity.AccessIntent) (identity.Actor, error) {
	return b.auth(r, i)
}
func (independentBoundary) WriteProblem(w http.ResponseWriter, r *http.Request, err error) {
	httpapi.WriteProblem(w, r, err)
}

type independentWriter struct {
	*httptest.ResponseRecorder
	mu                sync.Mutex
	read, write       time.Time
	writeDeadlineHook func(time.Time)
}

func (w *independentWriter) SetReadDeadline(at time.Time) error {
	w.mu.Lock()
	w.read = at
	w.mu.Unlock()
	return nil
}
func (w *independentWriter) SetWriteDeadline(at time.Time) error {
	w.mu.Lock()
	w.write = at
	hook := w.writeDeadlineHook
	w.mu.Unlock()
	if hook != nil {
		hook(at)
	}
	return nil
}
func (w *independentWriter) clean() bool {
	w.mu.Lock()
	defer w.mu.Unlock()
	return w.read.IsZero() && w.write.IsZero()
}

func independentWait[T any](t *testing.T, c <-chan T) T {
	t.Helper()
	select {
	case value := <-c:
		return value
	case <-time.After(5 * time.Second):
		t.Fatal("private observation timed out")
		var zero T
		return zero
	}
}

func TestIndependentPolicyWireAndUnknownReceipt(t *testing.T) {
	actor := testActor(t)
	for _, raw := range []string{
		`{"expected_version":"1","rules":[],"\u0072ules":[]}`,
		`{"Expected_version":"1","rules":[]}`,
		`{"expected_version":"1","rules":[{"cidr":"10.0.0.0/8","ports":[443],"allow_http":false,"\u0061llow_http":true}]}`,
		`{"expected_version":"1","rules":[{"cidr":"10.0.0.0/8","ports":[4.43e2]}]}`,
		`{"expected_version":"1","rules":[{"cidr":"10.0.0.0/8","ports":[443],"allow_http":null}]}`,
		`{"expected_version":"1e0","rules":[]}`,
	} {
		_, _, err := decodeUpdate(httptest.NewRecorder(), updateRequest(raw), actor)
		var f *foundation.Fault
		if !errors.As(err, &f) || f.Code != foundation.InvalidArgument || f.CommitState != foundation.NotStarted {
			t.Fatal("ambiguous wire did not fail with original safe input classification")
		}
	}
	var called atomic.Int32
	var remaining time.Duration
	h := &systemHTTP{boundary: independentBoundary{auth: func(r *http.Request, intent identity.AccessIntent) (identity.Actor, error) {
		d, ok := r.Context().Deadline()
		if !ok || intent != identity.Mutate {
			return identity.Actor{}, errors.New("bad boundary intent/deadline")
		}
		remaining = time.Until(d)
		return actor, nil
	}}, policy: independentPolicy{put: func(c context.Context, a identity.Actor, m outbound.CommandMeta, rules outbound.Rules) (outbound.UpdateResult, error) {
		called.Add(1)
		if m.Identity.Namespace() != "outbound-policy" || m.Identity.Command() != "update" || m.ExpectedVersion != 1 || string(rules.JSON()) != "[]" {
			return outbound.UpdateResult{}, errors.New("bad command")
		}
		return outbound.UpdateResult{}, foundation.NewFault(foundation.CommitUnknown, foundation.Unknown).WithCause(errors.New("private-address-10.3.0.0-secret"))
	}}}
	w := &independentWriter{ResponseRecorder: httptest.NewRecorder()}
	h.ServeHTTP(w, updateRequest(`{"expected_version":"1","rules":[]}`))
	if called.Load() != 1 || remaining < 29*time.Second || remaining > 30*time.Second || w.Code != 503 || !w.clean() {
		t.Fatal("original PUT budget/result/cleanup mismatch")
	}
	for _, token := range []string{`"commit_state":"unknown"`, `"retry_hint":"lookup"`} {
		if !strings.Contains(w.Body.String(), token) {
			t.Fatal("original Unknown projection changed")
		}
	}
	if strings.Contains(w.Body.String(), "private-address") || strings.Contains(w.Body.String(), `"rules"`) {
		t.Fatal("Unknown leaked a cause or candidate")
	}
}

func TestIndependentPolicyCancellationWaitsWriteCallback(t *testing.T) {
	actor := testActor(t)
	rules, err := outbound.NewRules()
	if err != nil {
		t.Fatal(err)
	}
	p := samplePolicy(t, rules)
	serviceEntered, serviceRelease := make(chan struct{}), make(chan struct{})
	callbackEntered, callbackRelease := make(chan struct{}), make(chan struct{})
	var serviceOnce, callbackOnce sync.Once
	releaseService := func() { serviceOnce.Do(func() { close(serviceRelease) }) }
	releaseCallback := func() { callbackOnce.Do(func() { close(callbackRelease) }) }
	defer releaseService()
	defer releaseCallback()
	w := &independentWriter{ResponseRecorder: httptest.NewRecorder()}
	var enteredOnce sync.Once
	w.writeDeadlineHook = func(at time.Time) {
		if !at.IsZero() && !at.After(time.Now()) {
			enteredOnce.Do(func() { close(callbackEntered) })
			<-callbackRelease
		}
	}
	h := &systemHTTP{boundary: independentBoundary{auth: func(*http.Request, identity.AccessIntent) (identity.Actor, error) { return actor, nil }}, policy: independentPolicy{get: func(c context.Context, _ identity.Actor) (outbound.Policy, error) {
		close(serviceEntered)
		<-serviceRelease
		return p, nil
	}}}
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	done := make(chan any, 1)
	go func() {
		defer func() { done <- recover() }()
		h.ServeHTTP(w, httptest.NewRequest("GET", "https://example.test"+policyPath, nil).WithContext(ctx))
	}()
	independentWait(t, serviceEntered)
	cancel()
	independentWait(t, callbackEntered)
	releaseService()
	select {
	case <-done:
		t.Fatal("owner returned while native cancellation callback still running")
	case <-time.After(25 * time.Millisecond):
	}
	releaseCallback()
	if independentWait(t, done) != http.ErrAbortHandler || w.Body.Len() != 0 || !w.clean() {
		t.Fatal("late successful read published, callback not joined, or deadlines remain")
	}
}

func TestIndependentPolicyNativeMixedReuseAndBudgets(t *testing.T) {
	actor := testActor(t)
	rules, err := outbound.NewRules()
	if err != nil {
		t.Fatal(err)
	}
	policy := samplePolicy(t, rules)
	receipt := testReceipt(t)
	var puts, active, hits atomic.Int32
	var mu sync.Mutex
	connections := map[net.Conn]struct{}{}
	getEntered, getExpired, getRelease := make(chan struct{}), make(chan struct{}), make(chan struct{})
	var releaseOnce sync.Once
	release := func() { releaseOnce.Do(func() { close(getRelease) }) }
	defer release()
	var naturalBudget atomic.Int64
	h := &systemHTTP{boundary: independentBoundary{auth: func(r *http.Request, intent identity.AccessIntent) (identity.Actor, error) {
		if r.Header.Get("X-Independent-Natural") == "yes" {
			d, ok := r.Context().Deadline()
			if !ok || intent != identity.Read {
				return identity.Actor{}, errors.New("no native GET budget")
			}
			naturalBudget.Store(int64(time.Until(d)))
			close(getEntered)
			<-r.Context().Done()
			close(getExpired)
			<-getRelease
		}
		return actor, nil
	}}, policy: independentPolicy{get: func(context.Context, identity.Actor) (outbound.Policy, error) { return policy, nil }, put: func(context.Context, identity.Actor, outbound.CommandMeta, outbound.Rules) (outbound.UpdateResult, error) {
		puts.Add(1)
		return receipt, nil
	}}}
	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		active.Add(1)
		hits.Add(1)
		defer active.Add(-1)
		if r.Header.Get("X-Independent-Short") == "yes" {
			ctx, cancel := context.WithTimeout(r.Context(), 120*time.Millisecond)
			defer cancel()
			r = r.WithContext(ctx)
		}
		httpapi.Handler(nil, h).ServeHTTP(w, r)
	}))
	server.Config.ConnState = func(c net.Conn, state http.ConnState) {
		mu.Lock()
		defer mu.Unlock()
		if state == http.StateClosed || state == http.StateHijacked {
			delete(connections, c)
		} else {
			connections[c] = struct{}{}
		}
	}
	server.Start()
	defer func() { release(); server.CloseClientConnections(); server.Close() }()
	addr := server.Listener.Addr().String()
	host, _, err := net.SplitHostPort(addr)
	if err != nil || host != "127.0.0.1" {
		t.Fatal("native listener escaped owned loopback")
	}
	dial := func() net.Conn {
		c, e := net.DialTimeout("tcp", addr, time.Second)
		if e != nil {
			t.Fatal(e)
		}
		t.Cleanup(func() { _ = c.Close() })
		_ = c.SetDeadline(time.Now().Add(6 * time.Second))
		return c
	}
	c := dial()
	reader := bufio.NewReader(c)
	for _, tc := range []struct {
		method, body string
		status       int
	}{
		{"GET", "", 200}, {"PUT", `{"expected_version":"1","rules":null}`, 400},
		{"PUT", `{"expected_version":"1","rules":[]}`, 200}, {"GET", "", 200},
	} {
		_, err = fmt.Fprintf(c, "%s %s HTTP/1.1\r\nHost: example.test\r\nContent-Type: application/json\r\nIdempotency-Key: fixed-native\r\nContent-Length: %d\r\n\r\n%s", tc.method, policyPath, len(tc.body), tc.body)
		if err != nil {
			t.Fatal(err)
		}
		r, e := http.ReadResponse(reader, &http.Request{Method: tc.method})
		if e != nil {
			t.Fatal("native error/success cleanup poisoned keep-alive", e)
		}
		body, e := io.ReadAll(r.Body)
		closeErr := r.Body.Close()
		if e != nil || closeErr != nil || r.StatusCode != tc.status || len(r.Header.Values("X-Request-ID")) != 1 {
			t.Fatal("native complete response failed")
		}
		if tc.method == "GET" && !bytes.Contains(body, []byte(`"rules":[]`)) {
			t.Fatal("native GET projection differs")
		}
	}
	_ = c.Close()
	if puts.Load() != 1 {
		t.Fatal("invalid body dispatched a write or valid body dispatched twice")
	}
	slow := dial()
	start := time.Now()
	_, err = fmt.Fprintf(slow, "PUT %s HTTP/1.1\r\nHost: example.test\r\nX-Independent-Short: yes\r\nContent-Type: application/json\r\nIdempotency-Key: incomplete\r\nContent-Length: 300\r\n\r\n{", policyPath)
	if err != nil {
		t.Fatal(err)
	}
	_, _ = io.ReadAll(slow)
	_ = slow.Close()
	if elapsed := time.Since(start); elapsed < 90*time.Millisecond || elapsed > time.Second || puts.Load() != 1 {
		t.Fatal("partial native body did not follow earlier parent without writing")
	}
	natural := dial()
	_, err = fmt.Fprintf(natural, "GET %s HTTP/1.1\r\nHost: example.test\r\nX-Independent-Natural: yes\r\n\r\n", policyPath)
	if err != nil {
		t.Fatal(err)
	}
	independentWait(t, getEntered)
	independentWait(t, getExpired)
	if n := time.Duration(naturalBudget.Load()); n < 2900*time.Millisecond || n > 3*time.Second {
		t.Fatal("native preauthentication did not use original GET 3s")
	}
	if active.Load() != 1 {
		t.Fatal("expired authority tail was released before actual completion")
	}
	release()
	response, _ := io.ReadAll(natural)
	_ = natural.Close()
	if bytes.Contains(response, []byte(`"rules"`)) || bytes.Contains(response, []byte("200 OK")) {
		t.Fatal("late native authority published candidate")
	}
	server.CloseClientConnections()
	server.Close()
	deadline := time.Now().Add(time.Second)
	for {
		mu.Lock()
		n := len(connections)
		mu.Unlock()
		if n == 0 && active.Load() == 0 {
			break
		}
		if time.Now().After(deadline) {
			t.Fatal("native connections/handlers did not actually join")
		}
		time.Sleep(time.Millisecond)
	}
	if hits.Load() != 6 || puts.Load() != 1 {
		t.Fatal("unexpected native dispatch count")
	}
	t.Log("six exact native requests; error/success same-connection reuse; original GET3s and earlier PUT120ms; all connections and handlers joined")
}
