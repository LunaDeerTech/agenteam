type policySpy struct {
	get func(context.Context, identity.Actor) (outbound.Policy, error)
	put func(context.Context, identity.Actor, outbound.CommandMeta, outbound.Rules) (outbound.UpdateResult, error)
}

func (s policySpy) GetPolicy(ctx context.Context, a identity.Actor) (outbound.Policy, error) {
	return s.get(ctx, a)
}
func (s policySpy) UpdatePolicy(ctx context.Context, a identity.Actor, m outbound.CommandMeta, r outbound.Rules) (outbound.UpdateResult, error) {
	return s.put(ctx, a, m, r)
}

type boundarySpy struct {
	check     func(http.ResponseWriter, *http.Request) error
	authorize func(*http.Request, identity.AccessIntent) (identity.Actor, error)
}

func (b boundarySpy) CheckRequest(w http.ResponseWriter, r *http.Request) error {
	if b.check != nil {
		return b.check(w, r)
	}
	w.Header().Set("Cache-Control", "no-store")
	w.Header().Set("X-Content-Type-Options", "nosniff")
	w.Header().Set("Referrer-Policy", "no-referrer")
	return nil
}
func (b boundarySpy) RequireSystem(r *http.Request, i identity.AccessIntent) (identity.Actor, error) {
	return b.authorize(r, i)
}
func (boundarySpy) WriteProblem(w http.ResponseWriter, r *http.Request, e error) {
	new(account.HTTPBoundary).WriteProblem(w, r, e)
}

type deadlineRecorder struct {
	*httptest.ResponseRecorder
	mu          sync.Mutex
	read, write time.Time
	onRead      func(time.Time)
	failWrite   bool
}

func recorder() *deadlineRecorder { return &deadlineRecorder{ResponseRecorder: httptest.NewRecorder()} }
func (w *deadlineRecorder) SetReadDeadline(at time.Time) error {
	w.mu.Lock()
	w.read = at
	fn := w.onRead
	w.mu.Unlock()
	if fn != nil {
		fn(at)
	}
	return nil
}
func (w *deadlineRecorder) SetWriteDeadline(at time.Time) error {
	w.mu.Lock()
	defer w.mu.Unlock()
	w.write = at
	return nil
}
func (w *deadlineRecorder) Write(b []byte) (int, error) {
	if w.failWrite {
		return 0, io.ErrClosedPipe
	}
	return w.ResponseRecorder.Write(b)
}
func (w *deadlineRecorder) cleared() bool {
	w.mu.Lock()
	defer w.mu.Unlock()
	return w.read.IsZero() && w.write.IsZero()
}

// This store supplies a controlled read result only. It is not DB/authorization
// evidence; production GetPolicy constructs the opaque Policy used by wire tests.
type readStore struct {
	*postgres.Store
	raw []byte
}

func (s *readStore) WithinTx(ctx context.Context, _ foundation.TransactionCause, fn func(context.Context, foundation.Tx) error) foundation.CommitResult {
	if e := fn(ctx, foundation.NewTx()); e != nil {
		var f *foundation.Fault
		if errors.As(e, &f) {
			return foundation.NotCommittedResult(f)
		}
		return foundation.NotCommittedResult(fault(foundation.DependencyUnavailable))
	}
	return foundation.CommittedResult()
}
func (s *readStore) InTx(foundation.Tx) (postgres.SQLExecutor, error) { return s, nil }
func (*readStore) AcquireAll(context.Context, foundation.Tx, []foundation.LockRequest) error {
	return nil
}
func (s *readStore) QueryRow(context.Context, string, ...any) pgx.Row { return policyRow{s.raw} }

type policyRow struct{ raw []byte }

func (r policyRow) Scan(v ...any) error {
	if len(v) != 2 {
		return errors.New("unexpected controlled read")
	}
	*v[0].(*int64) = 1
	*v[1].(*[]byte) = bytes.Clone(r.raw)
	return nil
}

type pureAuthority struct{}

func (pureAuthority) RequireCurrentSession(context.Context, foundation.Tx, identity.Actor) error {
	return nil
}
func (pureAuthority) AuthorizeSystem(_ context.Context, _ foundation.Tx, a identity.Actor, i identity.AccessIntent) (identity.AccessGrant, error) {
	at, e := foundation.NewInstant(time.Now())
	if e != nil {
		return identity.AccessGrant{}, e
	}
	return identity.NewAccessGrant(a, identity.SystemScope(), i, at, 1)
}

