func constructionCore(t *testing.T) *account.Service {
	t.Helper()
	key := func(b byte) string { return base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{b}, 32)) }
	cr, e := cursor.LoadKeyring(fmt.Sprintf(`{"format":1,"current_kid":"c","keys":[{"kid":"c","key_b64":%q}]}`, key(11)))
	if e != nil {
		t.Fatal(e)
	}
	sr, e := secret.LoadKeyring(fmt.Sprintf(`{"format":1,"current_version":"1","keys":[{"version":"1","key_b64":%q}]}`, key(12)), cr)
	if e != nil {
		t.Fatal(e)
	}
	dr, e := object.LoadDownloadKeyring(fmt.Sprintf(`{"format":1,"current_kid":"d","keys":[{"kid":"d","key_b64":%q}]}`, key(13)), cr, sr)
	if e != nil {
		t.Fatal(e)
	}
	ak, e := account.LoadKeyring(fmt.Sprintf(`{"format":1,"current_kid":"a","keys":[{"kid":"a","key_b64":%q}]}`, key(14)), cr, sr, dr)
	if e != nil {
		t.Fatal(e)
	}
	a, e := account.NewAuthority(&noIOStore{}, ak)
	if e != nil {
		t.Fatal(e)
	}
	catalog := event.NewCatalog()
	sessions, e := accountc.DefineSessionsRevoked(catalog)
	if e != nil {
		t.Fatal(e)
	}
	delivery, e := accountc.DefineDeliveryRequested(catalog)
	if e != nil {
		t.Fatal(e)
	}
	pid, e := foundation.NewID[accountc.Process]()
	if e != nil {
		t.Fatal(e)
	}
	core, e := account.New(account.Dependencies{Authority: a, Audit: &unusedAudit{}, Secrets: &secret.Service{}, Events: &unusedEvents{}, SessionsRevoked: sessions, DeliveryRequested: delivery, Processes: unusedProcesses{id: pid}, RecoveryLog: &recoverylog.Sink{}, Challenges: &unusedChallenges{}})
	if e != nil {
		t.Fatal(e)
	}
	return core
}

func TestOutboundHTTPConstructionAndOriginalBoundary(t *testing.T) {
	core := constructionCore(t)
	policy, e := outbound.NewPolicyService(&noIOStore{}, &unusedAudit{}, outbound.Authorizations{})
	if e != nil {
		t.Fatal(e)
	}
	for _, tc := range []struct {
		p      *outbound.PolicyService
		a      *account.Service
		origin string
		ok     bool
	}{
		{policy, core, "https://example.test", true}, {nil, core, "https://example.test", false}, {policy, nil, "https://example.test", false}, {policy, &account.Service{}, "https://example.test", false}, {policy, core, "http://external.test", false},
	} {
		h, e := NewSystemHTTPHandler(tc.p, tc.a, SystemHTTPOptions{PublicOrigin: tc.origin})
		if (e == nil) != tc.ok || (h != nil) != tc.ok {
			t.Fatal("constructor dependency decision")
		}
	}
	h, e := NewSystemHTTPHandler(policy, core, SystemHTTPOptions{PublicOrigin: "https://example.test"})
	if e != nil {
		t.Fatal(e)
	}
	for _, tc := range []struct {
		name   string
		mutate func(*http.Request)
		want   int
	}{
		{"anonymous", func(*http.Request) {}, 401},
		{"host", func(r *http.Request) { r.Host = "other.test" }, 403},
		{"origin", func(r *http.Request) { r.Header.Set("Origin", "https://other.test") }, 403},
		{"fetch", func(r *http.Request) { r.Header.Set("Sec-Fetch-Site", "cross-site") }, 403},
		{"slash", func(r *http.Request) { r.URL.Path = policyPath + "//child" }, 400},
		{"dot", func(r *http.Request) { r.URL.Path = policyPath + "/../session" }, 400},
		{"raw", func(r *http.Request) { r.URL.RawPath = "/api/v1/system/%6futbound-policy" }, 400},
		{"backslash", func(r *http.Request) { r.URL.Path = policyPath + "\\child" }, 400},
		{"nul", func(r *http.Request) { r.URL.Path = policyPath + "\x00" }, 400},
		{"child", func(r *http.Request) { r.URL.Path = policyPath + "/child" }, 404},
		{"prefix", func(r *http.Request) { r.URL.Path = policyPath + "-other" }, 404},
	} {
		t.Run(tc.name, func(t *testing.T) {
			r := httptest.NewRequest("GET", "https://example.test"+policyPath, nil)
			tc.mutate(r)
			w := recorder()
			httpapi.Handler(nil, h).ServeHTTP(w, r)
			if w.Code != tc.want {
				t.Fatalf("status %d want %d", w.Code, tc.want)
			}
			if w.Header().Get("Cache-Control") != "no-store" || w.Header().Get("X-Content-Type-Options") != "nosniff" || w.Header().Get("Referrer-Policy") != "no-referrer" || len(w.Header().Values("X-Request-ID")) != 1 || w.Header().Get("Location") != "" {
				t.Fatal("unsafe headers or redirect")
			}
		})
	}
}

func TestOutboundHTTPMethodsInputAndSafeFaults(t *testing.T) {
	a := testActor(t)
	empty, e := outbound.NewRules()
	if e != nil {
		t.Fatal(e)
	}
	p := samplePolicy(t, empty)
	receipt := testReceipt(t)
	var calls atomic.Int32
	h := &systemHTTP{boundary: boundarySpy{authorize: func(_ *http.Request, _ identity.AccessIntent) (identity.Actor, error) { return a, nil }}, policy: policySpy{get: func(context.Context, identity.Actor) (outbound.Policy, error) { calls.Add(1); return p, nil }, put: func(context.Context, identity.Actor, outbound.CommandMeta, outbound.Rules) (outbound.UpdateResult, error) {
		calls.Add(1)
		return receipt, nil
	}}}
	for _, method := range []string{"HEAD", "POST", "PATCH", "DELETE", "OPTIONS", "TRACE"} {
		w := recorder()
		r := httptest.NewRequest(method, "https://example.test"+policyPath, nil)
		h.ServeHTTP(w, r)
		if w.Code != 405 || w.Header().Get("Allow") != "GET, PUT" || calls.Load() != 0 {
			t.Fatal("unsupported method dispatched")
		}
		if method == "HEAD" && w.Body.Len() != 0 {
			t.Fatal("HEAD wrote body")
		}
	}
	for _, mutate := range []func(*http.Request){
		func(r *http.Request) { r.URL.ForceQuery = true }, func(r *http.Request) { r.URL.RawQuery = "x=1" },
		func(r *http.Request) { r.Body = io.NopCloser(strings.NewReader("x")); r.ContentLength = 0 },
		func(r *http.Request) { r.ContentLength = 1 }, func(r *http.Request) { r.ContentLength = -1 }, func(r *http.Request) { r.TransferEncoding = []string{"chunked"} },
	} {
		w := recorder()
		r := httptest.NewRequest("GET", "https://example.test"+policyPath, nil)
		mutate(r)
		h.ServeHTTP(w, r)
		if w.Code != 400 || calls.Load() != 0 {
			t.Fatal("forbidden query/body reached service")
		}
	}
	for _, method := range []string{"GET", "PUT"} {
		w := recorder()
		r := httptest.NewRequest("GET", "https://example.test"+policyPath, nil)
		if method == "PUT" {
			r = updateRequest(`{"expected_version":"1","rules":[]}`)
		}
		h.ServeHTTP(w, r)
		if w.Code != 200 || !w.cleared() {
			t.Fatal("successful response or connection cleanup")
		}
	}
	if calls.Load() != 2 {
		t.Fatal("duplicate service call")
	}
	for _, code := range []foundation.Code{foundation.VersionConflict, foundation.IdempotencyKeyReused, foundation.CommitUnknown, foundation.DependencyUnbound, foundation.Forbidden} {
		h.policy = policySpy{get: func(context.Context, identity.Actor) (outbound.Policy, error) {
			return p, foundation.NewFault(code, foundation.Unknown).WithCause(errors.New("private-cause-10.55.0.0-secret"))
		}}
		w := recorder()
		h.ServeHTTP(w, httptest.NewRequest("GET", "https://example.test"+policyPath, nil))
		var problem httpapi.Problem
		if json.Unmarshal(w.Body.Bytes(), &problem) != nil || problem.Code != code || problem.CommitState != foundation.Unknown || problem.Instance != "/api/v1" {
			t.Fatal("fault classification changed")
		}
		if bytes.Contains(w.Body.Bytes(), []byte("private-cause")) || bytes.Contains(w.Body.Bytes(), []byte(`"rules"`)) {
			t.Fatal("failed read leaked candidate or cause")
		}
		if code == foundation.CommitUnknown && (w.Code != 503 || problem.RetryHint != "lookup") {
			t.Fatal("Unknown compatibility hint changed")
		}
	}
}

func TestOutboundHTTPBudgetIncludesPreauthenticationAndService(t *testing.T) {
	a := testActor(t)
	receipt := testReceipt(t)
	empty, e := outbound.NewRules()
	if e != nil {
		t.Fatal(e)
	}
	p := samplePolicy(t, empty)
	for _, method := range []string{"GET", "PUT"} {
		for _, earlier := range []bool{false, true} {
			t.Run(fmt.Sprintf("%s/earlier=%t", method, earlier), func(t *testing.T) {
				start := time.Now()
				ctx := context.Background()
				cancel := func() {}
				budget := 3 * time.Second
				if method == "PUT" {
					budget = 30 * time.Second
				}
				if earlier {
					budget = 2 * time.Second
					ctx, cancel = context.WithTimeout(ctx, budget)
				}
				defer cancel()
				var deadline time.Time
				h := &systemHTTP{boundary: boundarySpy{authorize: func(r *http.Request, i identity.AccessIntent) (identity.Actor, error) {
					var ok bool
					deadline, ok = r.Context().Deadline()
					if !ok || deadline.After(start.Add(budget+100*time.Millisecond)) || deadline.Before(start.Add(budget-200*time.Millisecond)) {
						t.Fatal("authentication lacked original budget")
					}
					if method == "PUT" && i != identity.Mutate || method == "GET" && i != identity.Read {
						t.Fatal("wrong permission intent")
					}
					return a, nil
				}}, policy: policySpy{get: func(c context.Context, _ identity.Actor) (outbound.Policy, error) {
					d, _ := c.Deadline()
					if !d.Equal(deadline) {
						t.Fatal("read renewed budget")
					}
					return p, nil
				}, put: func(c context.Context, _ identity.Actor, _ outbound.CommandMeta, _ outbound.Rules) (outbound.UpdateResult, error) {
					d, _ := c.Deadline()
					if !d.Equal(deadline) {
						t.Fatal("write renewed budget")
					}
					return receipt, nil
				}}}
				r := httptest.NewRequest(method, "https://example.test"+policyPath, nil)
				if method == "PUT" {
					r = updateRequest(`{"expected_version":"1","rules":[]}`)
				}
				w := recorder()
				h.ServeHTTP(w, r.WithContext(ctx))
				if w.Code != 200 || !w.cleared() {
					t.Fatal("budget cleanup")
				}
			})
		}
	}
	// Unsupported deadline adapters fail before any preauthentication/service.
	h := &systemHTTP{boundary: boundarySpy{authorize: func(*http.Request, identity.AccessIntent) (identity.Actor, error) {
		t.Fatal("unsupported writer authenticated")
		return a, nil
	}}}
	w := httptest.NewRecorder()
	h.ServeHTTP(w, httptest.NewRequest("GET", "https://example.test"+policyPath, nil))
	if w.Code != 503 {
		t.Fatal("unsupported writer silently downgraded")
	}
}

func mustStayPending(t *testing.T, done <-chan any) {
	t.Helper()
	select {
	case <-done:
		t.Fatal("owner returned before actual tail")
	case <-time.After(20 * time.Millisecond):
	}
}
func asyncServe(h http.Handler, w http.ResponseWriter, r *http.Request) <-chan any {
	done := make(chan any, 1)
	go func() { defer func() { done <- recover() }(); h.ServeHTTP(w, r) }()
	return done
}
func waitServe(t *testing.T, done <-chan any) any {
	t.Helper()
	select {
	case v := <-done:
		return v
	case <-time.After(time.Second):
		t.Fatal("handler failed to join")
		return nil
	}
}

func TestOutboundHTTPCancellationJoinsServiceAndCallback(t *testing.T) {
	a := testActor(t)
	empty, e := outbound.NewRules()
	if e != nil {
		t.Fatal(e)
	}
	p := samplePolicy(t, empty)
	receipt := testReceipt(t)
	for _, method := range []string{"GET", "PUT"} {
		t.Run(method, func(t *testing.T) {
			entered, observed, release := make(chan struct{}), make(chan struct{}), make(chan struct{})
			tail := func(ctx context.Context) { close(entered); <-ctx.Done(); close(observed); <-release }
			h := &systemHTTP{boundary: boundarySpy{authorize: func(*http.Request, identity.AccessIntent) (identity.Actor, error) { return a, nil }}, policy: policySpy{get: func(c context.Context, _ identity.Actor) (outbound.Policy, error) { tail(c); return p, nil }, put: func(c context.Context, _ identity.Actor, _ outbound.CommandMeta, _ outbound.Rules) (outbound.UpdateResult, error) {
				tail(c)
				return receipt, nil
			}}}
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			r := httptest.NewRequest(method, "https://example.test"+policyPath, nil)
			if method == "PUT" {
				r = updateRequest(`{"expected_version":"1","rules":[]}`)
			}
			w := recorder()
			done := asyncServe(h, w, r.WithContext(ctx))
			<-entered
			cancel()
			<-observed
			mustStayPending(t, done)
			close(release)
			if waitServe(t, done) != http.ErrAbortHandler || w.Body.Len() != 0 || !w.cleared() {
				t.Fatal("late success published, mislabeled or unjoined")
			}
		})
	}
	entered, release := make(chan struct{}), make(chan struct{})
	var once sync.Once
	w := recorder()
	w.onRead = func(at time.Time) {
		if !at.IsZero() && at.Before(time.Now()) {
			once.Do(func() { close(entered) })
			<-release
		}
	}
	h := &systemHTTP{boundary: boundarySpy{authorize: func(*http.Request, identity.AccessIntent) (identity.Actor, error) { return a, nil }}, policy: policySpy{get: func(context.Context, identity.Actor) (outbound.Policy, error) { return p, nil }}}
	done := asyncServe(h, w, httptest.NewRequest("GET", "https://example.test"+policyPath, nil))
	<-entered
	mustStayPending(t, done)
	close(release)
	if waitServe(t, done) != nil || !w.cleared() {
		t.Fatal("cancel callback escaped reset")
	}
}

func TestOutboundHTTPWriteFailureAbortsWithoutSecondProblem(t *testing.T) {
	a := testActor(t)
	receipt := testReceipt(t)
	calls := 0
	h := &systemHTTP{boundary: boundarySpy{authorize: func(*http.Request, identity.AccessIntent) (identity.Actor, error) { return a, nil }}, policy: policySpy{put: func(context.Context, identity.Actor, outbound.CommandMeta, outbound.Rules) (outbound.UpdateResult, error) {
