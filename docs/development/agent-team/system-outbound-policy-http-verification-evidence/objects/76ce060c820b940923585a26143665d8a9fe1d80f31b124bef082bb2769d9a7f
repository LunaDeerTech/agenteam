}

// Native transport proof, separate from controlled boundary/writer tests. No
// Account/DB authority or outbound classifier is replaced as a production port.
func TestOutboundHTTPNativeBodyCancellationAndConnectionReuse(t *testing.T) {
	a := testActor(t)
	receipt := testReceipt(t)
	empty, e := outbound.NewRules()
	if e != nil {
		t.Fatal(e)
	}
	p := samplePolicy(t, empty)
	var puts atomic.Int32
	var active atomic.Int32
	var requests atomic.Int32
	var mu sync.Mutex
	conns := map[net.Conn]bool{}
	h := &systemHTTP{boundary: boundarySpy{authorize: func(*http.Request, identity.AccessIntent) (identity.Actor, error) { return a, nil }}, policy: policySpy{get: func(context.Context, identity.Actor) (outbound.Policy, error) { return p, nil }, put: func(context.Context, identity.Actor, outbound.CommandMeta, outbound.Rules) (outbound.UpdateResult, error) {
		puts.Add(1)
		return receipt, nil
	}}}
	var logs bytes.Buffer
	// Log writes are sequential in the reuse case; discard for the separate
	// cancelled connection below so no concurrent bytes.Buffer access occurs.
	base := httpapi.Handler(slog.New(slog.NewJSONHandler(&logs, nil)), h)
	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		active.Add(1)
		defer active.Add(-1)
		requests.Add(1)
		if r.Header.Get("X-Test-Short") != "" {
			ctx, cancel := context.WithTimeout(r.Context(), 100*time.Millisecond)
			defer cancel()
			httpapi.Handler(nil, h).ServeHTTP(w, r.WithContext(ctx))
			return
		}
		base.ServeHTTP(w, r)
	}))
	server.Config.ConnState = func(c net.Conn, s http.ConnState) {
		mu.Lock()
		defer mu.Unlock()
		if s == http.StateClosed || s == http.StateHijacked {
			delete(conns, c)
		} else {
			conns[c] = true
		}
	}
	server.Start()
	closed := false
	t.Cleanup(func() {
		if !closed {
			server.CloseClientConnections()
			server.Close()
		}
	})
	address := server.Listener.Addr().String()
	host, _, e := net.SplitHostPort(address)
	if e != nil || host != "127.0.0.1" {
		t.Fatal("fixture not owned loopback")
	}
	conn, e := net.DialTimeout("tcp", address, time.Second)
	if e != nil {
		t.Fatal(e)
	}
	defer conn.Close()
	_ = conn.SetDeadline(time.Now().Add(3 * time.Second))
	reader := bufio.NewReader(conn)
	for i := 0; i < 2; i++ {
		_, e = fmt.Fprintf(conn, "GET %s HTTP/1.1\r\nHost: example.test\r\n\r\n", policyPath)
		if e != nil {
			t.Fatal(e)
		}
		response, e := http.ReadResponse(reader, &http.Request{Method: "GET"})
		if e != nil {
			t.Fatal("cleared request deadline poisoned reused connection", e)
		}
		body, e := io.ReadAll(response.Body)
		closeErr := response.Body.Close()
		if e != nil || closeErr != nil || response.StatusCode != 200 || !bytes.Contains(body, []byte(`"rules":[]`)) {
			t.Fatal("native GET failed")
		}
	}
	_ = conn.Close()
	if strings.Count(logs.String(), `"event":"http_request"`) != 2 {
		t.Fatal("duplicate outer middleware")
	}
	slow, e := net.DialTimeout("tcp", address, time.Second)
	if e != nil {
		t.Fatal(e)
	}
	defer slow.Close()
	_ = slow.SetDeadline(time.Now().Add(2 * time.Second))
	_, e = fmt.Fprintf(slow, "PUT %s HTTP/1.1\r\nHost: example.test\r\nX-Test-Short: yes\r\nContent-Type: application/json\r\nIdempotency-Key: slow-body\r\nContent-Length: 500\r\n\r\n{", policyPath)
	if e != nil {
		t.Fatal(e)
	}
	started := time.Now()
	_, _ = io.ReadAll(slow)
	_ = slow.Close()
	if time.Since(started) > time.Second || puts.Load() != 0 {
		t.Fatal("native body outlived parent or reached service")
	}
	server.CloseClientConnections()
	server.Close()
	closed = true
	deadline := time.Now().Add(time.Second)
	for {
		mu.Lock()
		n := len(conns)
		mu.Unlock()
		if n == 0 && active.Load() == 0 {
			break
		}
		if time.Now().After(deadline) {
			t.Fatal("native server/connection/handler did not join")
		}
		time.Sleep(time.Millisecond)
	}
	if requests.Load() != 3 {
		t.Fatal("native proof did not hit every request")
	}
}
