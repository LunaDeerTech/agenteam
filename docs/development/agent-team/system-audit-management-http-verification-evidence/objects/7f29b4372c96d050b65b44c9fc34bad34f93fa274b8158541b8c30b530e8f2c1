+// Native tests are selected separately from Pure. They require the explicitly
+// granted loopback window; neither package compilation nor Pure executes them.
+type nativeAuditBody struct {
+	io.ReadCloser
+	eof, closed *atomic.Int32
+}
+
+func (b nativeAuditBody) Read(p []byte) (int, error) {
+	n, err := b.ReadCloser.Read(p)
+	if err == io.EOF {
+		b.eof.Add(1)
+	}
+	return n, err
+}
+func (b nativeAuditBody) Close() error { b.closed.Add(1); return b.ReadCloser.Close() }
+
+type nativeAuditResult struct{ aborted bool }
+
+func nativeAuditListener(t *testing.T, handler http.Handler) (string, <-chan nativeAuditResult, *atomic.Int32) {
+	t.Helper()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	results := make(chan nativeAuditResult, 4)
+	var active sync.WaitGroup
+	connections := &atomic.Int32{}
+	server := &http.Server{ErrorLog: log.New(io.Discard, "", 0), Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		active.Add(1)
+		defer active.Done()
+		defer func() {
+			value := recover()
+			results <- nativeAuditResult{aborted: value == http.ErrAbortHandler}
+			if value != nil {
+				panic(value)
+			}
+		}()
+		handler.ServeHTTP(w, r)
+	}), ConnState: func(_ net.Conn, state http.ConnState) {
+		if state == http.StateNew {
+			connections.Add(1)
+		}
+	}}
+	served := make(chan error, 1)
+	go func() { served <- server.Serve(listener) }()
+	t.Cleanup(func() {
+		if err := server.Close(); err != nil {
+			t.Error("native server close", err)
+		}
+		_ = listener.Close()
+		if err := <-served; !errors.Is(err, http.ErrServerClosed) {
+			t.Error("native Serve terminal", err)
+		}
+		active.Wait()
+	})
+	return listener.Addr().String(), results, connections
+}
+
+func nativeAuditDial(t *testing.T, address string) net.Conn {
+	t.Helper()
+	conn, err := net.DialTimeout("tcp", address, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = conn.Close() })
+	if err = conn.SetDeadline(time.Now().Add(10 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	return conn
+}
+
+func nativeAuditTerminal(t *testing.T, results <-chan nativeAuditResult) nativeAuditResult {
+	t.Helper()
+	select {
+	case result := <-results:
+		return result
+	case <-time.After(5 * time.Second):
+		t.Fatal("native handler not joined")
+		return nativeAuditResult{}
+	}
+}
