+type budgetWriter struct {
+	*httptest.ResponseRecorder
+	mu            sync.Mutex
+	reads, writes []time.Time
+	setRead       func(time.Time) error
+	flushErr      error
+	short         bool
+	flushes       int
+}
+
+func newBudgetWriter() *budgetWriter { return &budgetWriter{ResponseRecorder: httptest.NewRecorder()} }
+func (w *budgetWriter) SetReadDeadline(at time.Time) error {
+	if w.setRead != nil {
+		if err := w.setRead(at); err != nil {
+			return err
+		}
+	}
+	w.mu.Lock()
+	w.reads = append(w.reads, at)
+	w.mu.Unlock()
+	return nil
+}
+func (w *budgetWriter) SetWriteDeadline(at time.Time) error {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	w.writes = append(w.writes, at)
+	return nil
+}
+func (w *budgetWriter) Write(p []byte) (int, error) {
+	if w.short {
+		return len(p) - 1, nil
+	}
+	return w.ResponseRecorder.Write(p)
+}
+func (w *budgetWriter) FlushError() error { w.flushes++; return w.flushErr }
+func aborts(run func()) (aborted bool) {
+	defer func() {
+		if value := recover(); value != nil {
+			if value != http.ErrAbortHandler {
+				panic(value)
+			}
+			aborted = true
+		}
+	}()
+	run()
+	return false
+}
+
+type closeBody struct {
+	io.Reader
+	close  func() error
+	closed atomic.Int32
+}
+
+func (b *closeBody) Close() error {
+	b.closed.Add(1)
+	if b.close != nil {
+		return b.close()
+	}
+	return nil
+}
