+				(&systemHTTP{&testReader{}, &testBoundary{}}).ServeHTTP(nativeAuditFailureWriter{w, name == "short-write", name == "flush-error"}, r)
+			}))
+			conn := nativeAuditDial(t, address)
+			if _, err := io.WriteString(conn, "GET "+auditPath+" HTTP/1.1\r\nHost: "+address+"\r\nContent-Length: 0\r\n\r\n"); err != nil {
+				t.Fatal(err)
+			}
