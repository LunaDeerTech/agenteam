+func TestSystemAuditReadDeadlineAndActualTail(t *testing.T) {
+	for _, earlier := range []bool{false, true} {
+		name := "local-three-seconds"
+		parentBudget := 10 * time.Second
+		if earlier {
+			name = "earlier-parent"
+			parentBudget = 60 * time.Millisecond
+		}
+		t.Run(name, func(t *testing.T) {
+			service, store, actor, id := systemTestService(t)
+			parent, cancel := context.WithTimeout(context.Background(), parentBudget)
+			defer cancel()
+			parentDeadline, _ := parent.Deadline()
+			atEntry, expired, release := make(chan context.Context, 1), make(chan struct{}), make(chan struct{})
+			var once sync.Once
+			store.scan = func(ctx context.Context) scanner {
+				atEntry <- ctx
+				return auditScanFunc(func(...any) error { <-ctx.Done(); close(expired); <-release; return ctx.Err() })
+			}
+			done := make(chan error, 1)
+			joined := make(chan struct{})
+			start := time.Now()
+			go func() {
+				defer close(joined)
+				record, err := service.GetSystem(parent, actor, id)
+				if !reflect.DeepEqual(record, contract.SafeRecord{}) {
+					done <- errors.New("candidate after deadline")
+					return
+				}
+				done <- err
+			}()
+			t.Cleanup(func() {
+				cancel()
+				once.Do(func() { close(release) })
+				<-joined
+			})
+			var actual context.Context
+			select {
+			case actual = <-atEntry:
+			case <-time.After(time.Second):
+				t.Fatal("query missing")
+			}
+			entered := time.Now()
+			deadline, ok := actual.Deadline()
+			if !ok || earlier && !deadline.Equal(parentDeadline) || !earlier && (deadline.Before(start.Add(3*time.Second)) || deadline.After(entered.Add(3*time.Second)) || !deadline.Before(parentDeadline)) {
+				t.Fatal("deadline extended or restarted")
+			}
+			select {
+			case <-expired:
+			case <-time.After(4 * time.Second):
+				t.Fatal("original query context did not expire")
+			}
+			if actual.Err() != context.DeadlineExceeded || !earlier && parent.Err() != nil {
+				t.Fatal("wrong cancellation boundary")
+			}
+			select {
+			case <-done:
+				t.Fatal("returned before real tail joined")
+			default:
+			}
+			if store.active.Load() != 1 {
+				t.Fatal("owner released before tail")
+			}
+			once.Do(func() { close(release) })
+			err := <-done
+			wantSystemFault(t, err, foundation.DependencyUnavailable, foundation.NotCommitted)
+			if !errors.Is(err, context.DeadlineExceeded) || store.active.Load() != 0 || store.started.Load() != 1 {
+				t.Fatal("cancel cause or actual terminal accounting lost")
+			}
+		})
+	}
+}
