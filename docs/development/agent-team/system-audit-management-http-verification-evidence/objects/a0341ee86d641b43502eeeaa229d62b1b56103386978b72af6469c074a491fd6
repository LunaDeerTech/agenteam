+func TestSystemAuditReadTransactionPublication(t *testing.T) {
+	service, store, actor, id := systemTestService(t)
+	entered, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	store.tail = func(context.Context) { close(entered); <-release }
+	type result struct {
+		record contract.SafeRecord
+		err    error
+	}
+	done := make(chan result, 1)
+	joined := make(chan struct{})
+	go func() {
+		defer close(joined)
+		record, err := service.GetSystem(context.Background(), actor, id)
+		done <- result{record, err}
+	}()
+	t.Cleanup(func() {
+		once.Do(func() { close(release) })
+		<-joined
+	})
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("did not reach transaction tail")
+	}
+	select {
+	case <-done:
+		t.Fatal("candidate escaped before transaction ended")
+	default:
+	}
+	if store.active.Load() != 1 {
+		t.Fatal("transaction ownership released early")
+	}
+	once.Do(func() { close(release) })
+	got := <-done
+	if got.err != nil || got.record.AuditID != id || store.active.Load() != 0 {
+		t.Fatal("normal transaction did not publish one record", got.err)
+	}
+	want := []string{"begin", "user-shared", "session", "administrator", "executor", "query-row", "callback-ended", "transaction-ended"}
+	if !reflect.DeepEqual(store.steps, want) || store.started.Load() != 1 {
+		t.Fatal("transaction sequence changed", store.steps)
+	}
