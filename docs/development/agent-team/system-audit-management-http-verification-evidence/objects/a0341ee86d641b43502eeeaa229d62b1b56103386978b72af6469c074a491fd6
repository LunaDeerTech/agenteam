+func TestSystemAuditLegacyQueryScopeAndValidationEquivalence(t *testing.T) {
+	service, store, actor, id := systemTestService(t)
+	zeroCalls := 0
+	service.auth.Sessions = sessionPort(func(_ context.Context, tx foundation.Tx, _ identity.Actor) error {
+		if tx.Valid() {
+			t.Error("legacy Session gained a transaction")
+		}
+		zeroCalls++
+		return nil
+	})
+	service.auth.System = systemPort(func(_ context.Context, tx foundation.Tx, a identity.Actor, intent identity.AccessIntent) (identity.AccessGrant, error) {
+		if tx.Valid() {
+			t.Error("legacy authority gained a transaction")
+		}
+		now, _ := foundation.NewInstant(time.Now())
+		return identity.NewAccessGrant(a, identity.SystemScope(), intent, now, 1)
+	})
+	got, err := service.Get(context.Background(), actor, identity.SystemScope(), id)
+	if err != nil || got.AuditID != id || store.started.Load() != 0 || zeroCalls != 1 {
+		t.Fatal("legacy detail semantics changed", err)
+	}
+	_, err = service.List(context.Background(), actor, identity.SystemScope(), contract.Filter{}, foundation.PageRequest{Limit: 0})
+	wantSystemFault(t, err, foundation.InvalidArgument, foundation.NotStarted)
+	if zeroCalls != 2 {
+		t.Fatal("legacy validation moved before authorization")
+	}
+	_, err = service.List(context.Background(), actor, identity.SystemScope(), contract.Filter{ActorKind: identity.AgentRun, AgentID: id.String(), Action: contract.ProjectCreateAccepted}, foundation.PageRequest{Limit: 7})
+	wantSystemFault(t, err, foundation.DependencyUnavailable, foundation.NotStarted)
+	wantTail := "WHERE scope=$1 AND scope_key=$2 AND actor_kind=$3 AND action=$4 AND ((actor_kind='agent_run' AND agent_id=$5) OR (resource_kind='agent' AND resource_id=$5)) ORDER BY created_at DESC,id DESC LIMIT $6"
+	if !strings.HasSuffix(store.query, wantTail) || !reflect.DeepEqual(store.args, []any{"system", "system", "agent_run", string(contract.ProjectCreateAccepted), id.String(), 8}) {
+		t.Fatal("original filter/sentinel query changed")
+	}
+	project, _ := foundation.ParseID[identity.Project](id.String())
+	scope, _ := identity.InProject(project)
+	_, _ = service.listRecords(context.Background(), store, scope, contract.Filter{}, foundation.PageRequest{Limit: 1}, nil)
+	if !strings.HasSuffix(store.query, "WHERE scope=$1 AND scope_key=$2 AND project_id=$3 ORDER BY created_at DESC,id DESC LIMIT $4") || !reflect.DeepEqual(store.args, []any{"project", id.String(), id.String(), 2}) {
+		t.Fatal("legacy Project predicate changed")
+	}
+}
