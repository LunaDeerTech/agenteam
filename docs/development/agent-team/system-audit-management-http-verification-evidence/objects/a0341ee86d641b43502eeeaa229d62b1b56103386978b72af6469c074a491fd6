+					t.Fatal("failed sentinel/tail/sign exposed a page")
+				}
+				return
+			}
+			if err != nil || len(got.Items) != 1 || got.NextCursor == "" {
+				t.Fatal("valid page missing", err)
+			}
+			position, err := service.keys.Verify(got.NextCursor, binding)
+			if err != nil || position.Scalars[1].Value() != systemRecordID {
+				t.Fatal("cursor did not use last retained record")
+			}
+			legacy, err := service.recordPage(&auditTestRows{rows: []auditTestRow{first, extra}}, binding, 1, nil)
+			if err != nil || legacy.NextCursor != got.NextCursor || legacy.Items[0].AuditID != got.Items[0].AuditID {
+				t.Fatal("old page/cursor behavior changed")
+			}
+		})
+	}
+}
