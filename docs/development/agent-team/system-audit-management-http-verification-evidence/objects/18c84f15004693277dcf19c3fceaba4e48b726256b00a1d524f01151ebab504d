+	if err != nil || parsed.String() != requestID {
+		t.Fatal("successful Audit response request identity is not canonical")
+	}
+	deadline := time.NewTimer(time.Second)
+	defer deadline.Stop()
+	tick := time.NewTicker(time.Millisecond)
+	defer tick.Stop()
+	for {
+		entries := f.log.requests(requestID)
+		if len(entries) != 0 {
+			if len(entries) != 1 || entries[0]["route"] != route {
+				t.Fatal("real root did not log exactly one successful Audit request at its route")
+			}
+			return
+		}
+		select {
+		case <-tick.C:
+		case <-deadline.C:
+			t.Fatal("real root log does not share the successful Audit response request identity")
+		}
+	}
 }
 
