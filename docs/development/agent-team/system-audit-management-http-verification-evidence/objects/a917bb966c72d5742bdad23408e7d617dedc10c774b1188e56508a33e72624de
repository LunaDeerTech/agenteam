+type nativeAuditFailureWriter struct {
+	http.ResponseWriter
+	short, flush bool
+}
+
+func (w nativeAuditFailureWriter) Unwrap() http.ResponseWriter { return w.ResponseWriter }
+func (w nativeAuditFailureWriter) Write(p []byte) (int, error) {
+	if w.short {
+		return w.ResponseWriter.Write(p[:1])
+	}
+	return w.ResponseWriter.Write(p)
+}
+func (w nativeAuditFailureWriter) FlushError() error {
+	if err := http.NewResponseController(w.ResponseWriter).Flush(); err != nil {
+		return err
+	}
+	if w.flush {
+		return io.ErrClosedPipe
+	}
+	return nil
