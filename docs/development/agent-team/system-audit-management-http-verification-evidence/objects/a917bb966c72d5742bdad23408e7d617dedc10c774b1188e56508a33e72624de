+			if _, err := io.WriteString(conn, "GET "+auditPath+" HTTP/1.1\r\nHost: "+address+"\r\nContent-Length: 0\r\n\r\n"); err != nil {
+				t.Fatal(err)
+			}
+			reader := bufio.NewReader(conn)
+			response, err := http.ReadResponse(reader, &http.Request{Method: "GET"})
+			if err == nil {
+				data, readErr := io.ReadAll(response.Body)
+				_ = response.Body.Close()
+				if bytes.Contains(data, []byte("application/problem")) || name == "short-write" && readErr == nil {
+					t.Fatal("short write or second response hidden")
+				}
+			}
+			if !nativeAuditTerminal(t, results).aborted || closed.Load() != 1 {
+				t.Fatal("write failure escaped native abort/Close")
+			}
+			var one [1]byte
+			if n, err := reader.Read(one[:]); n != 0 || err == nil {
+				t.Fatal("aborted connection survived")
+			}
+		})
+	}
