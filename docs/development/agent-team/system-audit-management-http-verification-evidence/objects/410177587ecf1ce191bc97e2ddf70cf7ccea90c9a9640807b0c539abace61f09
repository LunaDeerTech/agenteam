func typedRecord(t *testing.T, tc typedCase) c.SafeRecord {
	t.Helper()
	u, _ := foundation.ParseID[identity.User](wireID)
	session, _ := foundation.ParseID[identity.Session]("01900000-0000-7000-8000-000000000002")
	actor, _ := identity.NewHuman(u, session)
	if tc.service != "" {
		registration, err := identity.RegisterService(tc.service)
		if err != nil {
			t.Fatal(err)
		}
		actor, err = registration.Actor("sha256:"+strings.Repeat("a", 64), identity.SystemScope())
		if err != nil {
			t.Fatal(err)
		}
	}
	id := wireID
	if tc.resource == "secret_master" || tc.resource == "outbound_policy" {
		id = ""
	}
	resource, err := c.NewResource(c.ResourceKind(tc.resource), id)
	if err != nil {
		t.Fatal("invalid resource prerequisite", err)
	}
	metadata, err := c.DecodeMetadata(c.Action(tc.action), []byte(tc.metadata))
	if err != nil {
		t.Fatal("invalid typed metadata prerequisite", tc.action, err)
	}
	entry, err := c.NewEntry(c.EntryFields{Scope: identity.SystemScope(), Actor: actor, Action: c.Action(tc.action), Outcome: tc.outcome, Resource: resource, Metadata: metadata})
	if err != nil {
		t.Fatal("invalid typed entry prerequisite", tc.action, err)
	}
	fields := entry.Fields()
	aid, _ := foundation.ParseID[c.Record](wireID)
	at, err := foundation.NewInstant(time.Date(2026, 10, 6, 0, 0, 0, 123456000, time.UTC))
	if err != nil {
		t.Fatal(err)
	}
	summary := c.ActorSummary{Kind: identity.Human, ID: wireID}
	if tc.service != "" {
		summary = c.ActorSummary{Kind: identity.Service, Service: tc.service, CauseRef: actor.Details().CauseRef}
	}
	return c.SafeRecord{AppendReceipt: c.AppendReceipt{AuditID: aid, CreatedAt: at}, Scope: fields.Scope, Actor: summary, Action: fields.Action, Outcome: fields.Outcome, Resource: fields.Resource, Metadata: fields.Metadata, Associations: fields.Associations, Summary: "untrusted-summary-canary"}
}

func TestAuditHTTPPureTypedProjection(t *testing.T) {
	cases := typedCases()
	if len(cases) != 37 {
		t.Fatal("missing System action")
	}
	for _, tc := range cases {
		t.Run(tc.action, func(t *testing.T) {
			record := typedRecord(t, tc)
			body, err := encodeRecord(record)
			if err != nil {
				t.Fatal("formal typed record rejected", err)
			}
			var object map[string]any
			if json.Unmarshal(body, &object) != nil || len(object) != 10 || object["scope"] != "system" || bytes.Contains(body, []byte("untrusted-summary-canary")) {
				t.Fatal("not the explicit closed DTO")
			}
			actor := object["actor"].(map[string]any)
			if tc.service == "" && (len(actor) != 2 || actor["id"] != wireID) || tc.service != "" && len(actor) != 3 {
				t.Fatal("actor projection widened")
			}
			if tc.action == "account.logout" && (object["resource"].(map[string]any)["id"] != wireID || object["metadata"].(map[string]any)["session_id"] != wireID) {
				t.Fatal("legitimate Session audit identity removed")
			}
			if tc.action == "object.upload.complete" && (!bytes.Contains(body, []byte(`\u0026`)) || bytes.Contains(body, []byte(`\\u0026`))) {
				t.Fatal("typed escaping changed or doubled")
			}
		})
	}
	services := []identity.ServiceName{identity.SecretService, identity.SecretMaintenance, identity.OutboundService, identity.ObjectService, identity.ObjectMaintenance, identity.ProjectLifecycle, identity.OutboxDelivery, identity.AccountBootstrap, identity.AccountAuth, identity.AccountMaintenance, identity.AccountMail, identity.ModelRuntime, identity.ProjectInitialization}
	for _, service := range services {
		tc := cases[0]
		tc.service = service
		if _, err := encodeRecord(typedRecord(t, tc)); err != nil {
			t.Fatal("registered service was narrowed", service)
		}
	}
	for _, change := range []func(*c.SafeRecord){
		func(r *c.SafeRecord) { r.Actor.ProjectID = wireID }, func(r *c.SafeRecord) { r.Actor.Kind = identity.AgentRun }, func(r *c.SafeRecord) { r.Actor.ID = "bad" },
		func(r *c.SafeRecord) { r.AuditID = c.ID{} }, func(r *c.SafeRecord) { r.Action = c.AccountLogout }, func(r *c.SafeRecord) { r.Associations.ExecutionID = wireID },
		func(r *c.SafeRecord) {
			p, _ := foundation.ParseID[identity.Project](wireID)
			r.Scope, _ = identity.InProject(p)
		},
		func(r *c.SafeRecord) { r.Resource, _ = c.NewResource(c.ModelConfigResource, wireID) },
	} {
		record := typedRecord(t, cases[0])
		change(&record)
		if body, err := encodePage(foundation.Page[c.SafeRecord]{Items: []c.SafeRecord{typedRecord(t, cases[0]), record}}); err == nil || body != nil {
			t.Fatal("bad record exposed partial page")
		}
	}
	model := typedRecord(t, cases[len(cases)-1])
	model.Associations.RequestID = wireID
	if _, err := encodeRecord(model); err == nil {
		t.Fatal("Model association widened")
	}
}

func TestAuditHTTPPureQueryClosure(t *testing.T) {
	filter, page, err := query("", false)
	if err != nil || page.Limit != 50 || filter.Validate() != nil {
		t.Fatal("default page")
	}
	for _, raw := range []string{"limit=0", "limit=201", "limit=", "limit=01", "limit=+1", "limit=1e2", "limit=1&limit=1", "scope=system", "project_id=" + wireID, "actor_kind=service&actor_id=" + wireID, "x[]=a", "cursor=%", "limit=1;action=", "from=not-time", "from=2026-10-06T00:00:00Z&to=2026-10-06T00:00:00Z", "action=unknown", "actor_id=bad", strings.Repeat("x", (32<<10)+1)} {
		if _, _, err := query(raw, false); err == nil {
			t.Errorf("accepted invalid query %q", raw[:min(len(raw), 80)])
		}
	}
	if _, _, err := query("", true); err == nil {
		t.Fatal("bare ? accepted")
	}
	if _, _, err := query("cursor="+strings.Repeat("A", 8193), false); err == nil {
		t.Fatal("cursor bound ignored")
	}
	values := url.Values{"limit": {"200"}, "cursor": {""}, "from": {"2026-10-06T02:00:00+02:00"}, "to": {"2026-10-07T00:00:00.000001Z"}, "actor_kind": {"agent_run"}, "actor_id": {wireID}, "action": {"project.create.accepted"}, "outcome": {"unknown"}, "resource_kind": {"agent"}, "resource_id": {wireID}, "tool_id": {wireID}, "execution_id": {wireID}, "operation_id": {wireID}, "approval_id": {wireID}, "runner_id": {wireID}, "agent_id": {wireID}}
	filter, page, err = query(values.Encode(), false)
	if err != nil || page.Limit != 200 || filter.From.String() != "2026-10-06T00:00:00.000000Z" || filter.ExecutionID != wireID || filter.AgentID != wireID {
		t.Fatal("original full Filter narrowed", err)
	}
}

func TestAuditHTTPPureEncodedBudget(t *testing.T) {
	record := typedRecord(t, typedCases()[6])
	record.Actor = c.ActorSummary{Kind: identity.Service, Service: identity.ProjectInitialization, CauseRef: "sha256:" + strings.Repeat("f", 64)}
	record.Associations = c.Associations{ToolID: wireID, RequestID: wireID, RunnerID: wireID, CorrelationID: wireID, HTTPTraceID: wireID}
	items := make([]c.SafeRecord, 200)
	for i := range items {
		items[i] = record
	}
	body, err := encodePage(foundation.Page[c.SafeRecord]{Items: items, NextCursor: strings.Repeat("A", 8192)})
	if err != nil || len(body) > successBytes {
		t.Fatal("bounded typed page rejected", err)
	}
	empty, err := encodePage(foundation.Page[c.SafeRecord]{})
	if err != nil || string(empty) != `{"items":[],"next_cursor":null}` {
		t.Fatal("empty page contract")
	}
	if b, err := encode(struct {
		Value string `json:"value"`
	}{strings.Repeat("X", successBytes)}); err == nil || b != nil {
		t.Fatal("final encoded byte limit missing")
	}
	for _, token := range []string{"bad<token", strings.Repeat("A", 8193)} {
		if _, err := encodePage(foundation.Page[c.SafeRecord]{NextCursor: token}); err == nil {
			t.Fatal("unsafe cursor escaped budget")
		}
	}
	// Synthetic JSON escaping only: these characters are not asserted to be
	// legal typed metadata or a reachable maximal producer payload.
	data, err := encode(struct {
		M json.RawMessage `json:"m"`
	}{json.RawMessage(`{"s":"\u003c\u003e\u0026\u2028\u2029"}`)})
	if err != nil || bytes.Contains(data, []byte(`\\u`)) || bytes.Count(data, []byte(`\u`)) != 5 {
		t.Fatal("RawMessage was double encoded")
	}
	// The longest ASCII shell is a conservative Cartesian upper bound.
	shell := recordDTO{AuditID: record.AuditID, CreatedAt: record.CreatedAt, Scope: "system", Actor: serviceActor{"service", identity.ProjectInitialization, "sha256:" + strings.Repeat("f", 64)}, Action: c.RotationComplete, Outcome: c.Success, Resource: resourceDTO{c.AccountSettingsResource, wireID}, Associations: associationsDTO{wireID, wireID, wireID, wireID, wireID}, Summary: "Master key rotation completed"}
	raw, _ := json.Marshal(shell)
	if len(raw)-4 != 739 || (len(raw)-4+4096)*200+8420 != 975420 {
		t.Fatal("encoded budget arithmetic changed")
	}
}

type testBoundary struct {
	check func(http.ResponseWriter, *http.Request) error
	auth  func(*http.Request) (identity.Actor, error)
	calls atomic.Int32
}

func (b *testBoundary) CheckRequest(w http.ResponseWriter, r *http.Request) error {
	w.Header().Set("Cache-Control", "no-store")
	w.Header().Set("X-Content-Type-Options", "nosniff")
	w.Header().Set("Referrer-Policy", "no-referrer")
	if b.check != nil {
		return b.check(w, r)
	}
	return nil
}
func (b *testBoundary) RequireSystem(r *http.Request, intent identity.AccessIntent) (identity.Actor, error) {
	b.calls.Add(1)
	if intent != identity.Read {
		return identity.Actor{}, fault(foundation.Forbidden)
	}
	if b.auth != nil {
		return b.auth(r)
	}
	u, _ := foundation.ParseID[identity.User](wireID)
	s, _ := foundation.ParseID[identity.Session](wireID)
	return identity.NewHuman(u, s)
}
func (b *testBoundary) WriteProblem(w http.ResponseWriter, r *http.Request, err error) {
	clone := r.Clone(r.Context())
	u := *r.URL
	u.Path = "/api/v1"
	u.RawPath = ""
	clone.URL = &u
	httpapi.WriteProblem(w, clone, err)
}

type testReader struct {
	list  func(context.Context) (foundation.Page[c.SafeRecord], error)
