}

type budgetWriter struct {
	*httptest.ResponseRecorder
	mu            sync.Mutex
	reads, writes []time.Time
	setRead       func(time.Time) error
	flushErr      error
	short         bool
	flushes       int
}

func newBudgetWriter() *budgetWriter { return &budgetWriter{ResponseRecorder: httptest.NewRecorder()} }
func (w *budgetWriter) SetReadDeadline(at time.Time) error {
	if w.setRead != nil {
		if err := w.setRead(at); err != nil {
			return err
		}
	}
	w.mu.Lock()
	w.reads = append(w.reads, at)
	w.mu.Unlock()
	return nil
}
func (w *budgetWriter) SetWriteDeadline(at time.Time) error {
	w.mu.Lock()
	defer w.mu.Unlock()
	w.writes = append(w.writes, at)
	return nil
}
func (w *budgetWriter) Write(p []byte) (int, error) {
	if w.short {
		return len(p) - 1, nil
	}
	return w.ResponseRecorder.Write(p)
}
func (w *budgetWriter) FlushError() error { w.flushes++; return w.flushErr }
func aborts(run func()) (aborted bool) {
	defer func() {
		if value := recover(); value != nil {
			if value != http.ErrAbortHandler {
				panic(value)
			}
			aborted = true
		}
	}()
	run()
	return false
}

type closeBody struct {
	io.Reader
	close  func() error
	closed atomic.Int32
}

func (b *closeBody) Close() error {
	b.closed.Add(1)
	if b.close != nil {
		return b.close()
	}
	return nil
}

func TestAuditHTTPPureRoutesAndAuthorizationOrder(t *testing.T) {
	for _, tc := range []struct {
		method, path       string
		status, auth, read int
	}{
		{"GET", auditPath, 200, 1, 1}, {"HEAD", auditPath, 405, 0, 0}, {"POST", auditPath, 405, 0, 0}, {"OPTIONS", auditPath + "/" + wireID, 405, 0, 0},
		{"GET", auditPath + "/", 404, 0, 0}, {"GET", auditPath + "/" + wireID + "/", 404, 0, 0}, {"GET", auditPath + "/not-id", 400, 1, 0},
		{"GET", auditPath + "/" + wireID + "?", 400, 1, 0}, {"GET", auditPath + "?x=1", 400, 1, 0}, {"GET", auditPath + "-near", 404, 0, 0},
	} {
		t.Run(tc.method+tc.path, func(t *testing.T) {
			b, s := &testBoundary{}, &testReader{}
			h := &systemHTTP{s, b}
			w := newBudgetWriter()
			r := httptest.NewRequest(tc.method, tc.path, nil)
			if aborts(func() { httpapi.Handler(nil, h).ServeHTTP(w, r) }) {
				t.Fatal("normal response aborted")
			}
			if w.Code != tc.status || int(b.calls.Load()) != tc.auth || int(s.calls.Load()) != tc.read {
				t.Fatal("route/order changed", w.Code, b.calls.Load(), s.calls.Load())
			}
			if tc.status == 405 && w.Header().Get("Allow") != "GET" {
				t.Fatal("wrong Allow")
			}
			if tc.method == "HEAD" && w.Body.Len() != 0 {
				t.Fatal("HEAD error body")
			}
			if tc.status != 200 && tc.method != "HEAD" {
				var problem map[string]any
				_ = json.Unmarshal(w.Body.Bytes(), &problem)
				if problem["instance"] != "/api/v1" {
					t.Fatal("reflected request")
				}
			}
			if w.flushes != 1 || !w.reads[len(w.reads)-1].IsZero() || !w.writes[len(w.writes)-1].IsZero() {
				t.Fatal("response tail did not finish/reset")
			}
		})
	}
	b := &testBoundary{auth: func(*http.Request) (identity.Actor, error) { return identity.Actor{}, fault(foundation.Forbidden) }}
	s := &testReader{}
	w := newBudgetWriter()
	(&systemHTTP{s, b}).ServeHTTP(w, httptest.NewRequest("GET", auditPath+"?bad=1", nil))
	if w.Code != 403 || s.calls.Load() != 0 {
		t.Fatal("parsing bypassed current authority")
	}
	if _, err := NewSystemHTTPHandler(nil, nil, SystemHTTPOptions{}); err == nil {
		t.Fatal("nil constructor accepted")
	}
}

