// This verifier is confined to the schema keywords used by this document. It
// checks concrete formal DTOs and negative mutations, not an HTTP implementation.
func schemaAccepts(root, common map[string]any, schema map[string]any, value any) bool {
	if reference, ok := schema["$ref"].(string); ok {
		parts := strings.SplitN(reference, "#", 2)
		document := root
		if parts[0] == "./common.json" {
			document = common
		}
		var node any = document
		for _, part := range strings.Split(strings.TrimPrefix(parts[1], "/"), "/") {
			node = node.(map[string]any)[part]
			if node == nil {
				return false
			}
		}
		return schemaAccepts(document, common, node.(map[string]any), value)
	}
	if expected, ok := schema["const"]; ok && !reflect.DeepEqual(expected, value) {
		return false
	}
	if values, ok := schema["enum"].([]any); ok {
		found := false
		for _, expected := range values {
			if reflect.DeepEqual(expected, value) {
				found = true
			}
		}
		if !found {
			return false
		}
	}
	for _, key := range []string{"oneOf", "anyOf", "allOf"} {
		if branches, ok := schema[key].([]any); ok {
			count := 0
			for _, branch := range branches {
				if schemaAccepts(root, common, branch.(map[string]any), value) {
					count++
				}
			}
			if key == "oneOf" && count != 1 || key == "anyOf" && count == 0 || key == "allOf" && count != len(branches) {
				return false
			}
		}
	}
	if branch, ok := schema["not"].(map[string]any); ok && schemaAccepts(root, common, branch, value) {
		return false
	}
	if condition, ok := schema["if"].(map[string]any); ok && schemaAccepts(root, common, condition, value) {
		if branch, ok := schema["then"].(map[string]any); ok && !schemaAccepts(root, common, branch, value) {
			return false
		}
	}
	if kind, ok := schema["type"].(string); ok {
		valid := false
		switch kind {
		case "object":
			_, valid = value.(map[string]any)
		case "array":
			_, valid = value.([]any)
		case "string":
			_, valid = value.(string)
		case "null":
			valid = value == nil
		case "integer":
			n, ok := value.(float64)
			valid = ok && n == float64(int64(n))
		case "boolean":
			_, valid = value.(bool)
		}
		if !valid {
			return false
		}
	}
	if object, ok := value.(map[string]any); ok {
		properties, _ := schema["properties"].(map[string]any)
		if required, ok := schema["required"].([]any); ok {
			for _, key := range required {
				if _, ok := object[key.(string)]; !ok {
					return false
				}
			}
		}
		for key, child := range object {
			if property, ok := properties[key].(map[string]any); ok {
				if !schemaAccepts(root, common, property, child) {
					return false
				}
			} else if schema["additionalProperties"] == false {
				return false
			}
		}
	}
	if text, ok := value.(string); ok {
		if pattern, ok := schema["pattern"].(string); ok {
			expression, err := regexp.Compile(pattern)
			if err != nil {
				panic(err)
			}
			if !expression.MatchString(text) {
				return false
			}
		}
		if n, ok := schema["minLength"].(float64); ok && len([]rune(text)) < int(n) {
			return false
		}
		if n, ok := schema["maxLength"].(float64); ok && len([]rune(text)) > int(n) {
			return false
		}
	}
	if array, ok := value.([]any); ok {
		if n, ok := schema["minItems"].(float64); ok && len(array) < int(n) {
			return false
		}
		if n, ok := schema["maxItems"].(float64); ok && len(array) > int(n) {
			return false
		}
		for i, child := range array {
			if item, ok := schema["items"].(map[string]any); ok && !schemaAccepts(root, common, item, child) {
				return false
			}
			if schema["uniqueItems"] == true {
				for _, before := range array[:i] {
					if reflect.DeepEqual(before, child) {
						return false
					}
				}
			}
		}
	}
	return true
}

func TestAuditHTTPPureOpenAPIClosedContract(t *testing.T) {
	load := func(name string) map[string]any {
		t.Helper()
		path := filepath.Join("..", "..", "..", "..", "api", "openapi", name)
		raw, err := os.ReadFile(path)
		if err != nil {
			t.Fatal(err)
		}
		var value map[string]any
		if json.Unmarshal(raw, &value) != nil {
			t.Fatal("invalid OpenAPI JSON")
		}
		return value
	}
	document, common := load("audit.json"), load("common.json")
	paths := document["paths"].(map[string]any)
	if len(paths) != 2 || len(common["paths"].(map[string]any)) != 0 {
		t.Fatal("route scope widened")
	}
	for path, item := range paths {
		operations := item.(map[string]any)
		if len(operations) != 1 || operations["get"] == nil {
			t.Fatal("GET-only drift")
		}
		op := operations["get"].(map[string]any)
		security := op["security"].([]any)
		if len(security) != 2 || len(security[0].(map[string]any)) != 1 || len(security[1].(map[string]any)) != 1 || security[0].(map[string]any)["Session"] == nil || security[1].(map[string]any)["LocalSession"] == nil {
			t.Fatal("anonymous/CSRF security drift")
		}
		params := op["parameters"].([]any)
		if path == auditPath {
			names := map[string]bool{}
			for _, p := range params {
				names[p.(map[string]any)["name"].(string)] = true
			}
			if len(names) != 16 {
				t.Fatal("filter parameter count")
			}
			for _, name := range []string{"limit", "cursor", "from", "to", "actor_kind", "actor_id", "action", "outcome", "resource_kind", "resource_id", "tool_id", "execution_id", "operation_id", "approval_id", "runner_id", "agent_id"} {
				if !names[name] {
					t.Fatal("missing filter", name)
				}
			}
		} else if path != auditPath+"/{id}" || len(params) != 1 {
			t.Fatal("detail route mismatch")
		}
	}
	schemas := document["components"].(map[string]any)["schemas"].(map[string]any)
	schema := schemas["SystemAuditRecord"].(map[string]any)
	if len(schema["oneOf"].([]any)) != 37 {
		t.Fatal("action branch count")
	}
	for _, tc := range append(typedCases(), conditionalCases()...) {
		t.Run(tc.action, func(t *testing.T) {
			body, err := encodeRecord(typedRecord(t, tc))
			if err != nil {
				t.Fatal(err)
			}
			var value map[string]any
			_ = json.Unmarshal(body, &value)
			if !schemaAccepts(document, common, schema, value) {
				t.Fatal("schema rejected formal DTO", tc.action)
			}
			value["extra"] = true
			if schemaAccepts(document, common, schema, value) {
				t.Fatal("schema unknown record field")
			}
			delete(value, "extra")
			meta := value["metadata"].(map[string]any)
			meta["extra"] = true
			if schemaAccepts(document, common, schema, value) {
				t.Fatal("schema arbitrary metadata")
			}
			delete(meta, "extra")
			value["scope"] = "project"
			if schemaAccepts(document, common, schema, value) {
				t.Fatal("System schema accepted Project")
			}
		})
	}
	for _, tc := range []struct {
		name   string
		index  int
		change func(map[string]any)
	}{
		{"authenticated-needs-session", 15, func(v map[string]any) { delete(v["metadata"].(map[string]any), "session_id") }},
		{"authenticated-forbids-reason", 15, func(v map[string]any) { v["metadata"].(map[string]any)["reason"] = "session_invalid" }},
		{"phase-outcome", 15, func(v map[string]any) { v["outcome"] = "denied" }},
		{"unknown-needs-reason", 29, func(v map[string]any) { delete(v["metadata"].(map[string]any), "reason") }},
		{"retry-forbids-channel", 28, func(v map[string]any) { v["metadata"].(map[string]any)["channel"] = "smtp" }},
		{"retry-human-only", 28, func(v map[string]any) {
			v["actor"] = map[string]any{"kind": "service", "service": "account-mail", "cause_ref": wireID}
		}},
		{"replacement-needs-id", 35, func(v map[string]any) { delete(v["metadata"].(map[string]any), "replacement_id") }},
		{"model-associations", 34, func(v map[string]any) { v["associations"].(map[string]any)["request_id"] = wireID }},
		{"agent-initiator-needs-execution", 10, func(v map[string]any) { delete(v["metadata"].(map[string]any), "initiator_execution_id") }},
		{"object-actor", 10, func(v map[string]any) { v["actor"] = map[string]any{"kind": "human", "id": wireID} }},
		{"wrong-resource-kind", 16, func(v map[string]any) { v["resource"].(map[string]any)["kind"] = "user" }},
		{"master-forbids-id", 4, func(v map[string]any) { v["resource"].(map[string]any)["id"] = wireID }},
		{"metadata-null", 0, func(v map[string]any) { v["metadata"] = nil }},
	} {
		t.Run(tc.name, func(t *testing.T) {
			body, err := encodeRecord(typedRecord(t, typedCases()[tc.index]))
			if err != nil {
				t.Fatal(err)
			}
			var value map[string]any
			_ = json.Unmarshal(body, &value)
			tc.change(value)
			if schemaAccepts(document, common, schema, value) {
				t.Fatal("conditional schema widened")
			}
		})
	}
}
