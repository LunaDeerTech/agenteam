		{"nonzero", 1, nil, "x"}, {"unknown", -1, nil, ""}, {"chunked", 0, []string{"chunked"}, ""}, {"actual-nonempty", 0, nil, "x"}, {"actual-eof", 0, nil, ""},
	} {
		t.Run(tc.name, func(t *testing.T) {
			b, s := &testBoundary{}, &testReader{}
			body := &closeBody{Reader: strings.NewReader(tc.body)}
			r := httptest.NewRequest("GET", auditPath, nil)
			r.Body = body
			r.ContentLength = tc.length
			r.TransferEncoding = tc.transfer
			w := newBudgetWriter()
			(&systemHTTP{s, b}).ServeHTTP(w, r)
			want := 400
			if tc.name == "actual-eof" {
				want = 200
			}
			if w.Code != want || body.closed.Load() != 1 || (want == 400 && s.calls.Load() != 0) {
				t.Fatal("framing/actual body/close boundary changed")
			}
		})
	}
	for _, name := range []string{"capability", "short-write", "flush-error"} {
		t.Run(name, func(t *testing.T) {
			b, s := &testBoundary{}, &testReader{}
			h := &systemHTTP{s, b}
			var w http.ResponseWriter = httptest.NewRecorder()
			if name != "capability" {
				v := newBudgetWriter()
				v.short = name == "short-write"
				if name == "flush-error" {
					v.flushErr = errors.New("write-failed")
				}
				w = v
			}
			if !aborts(func() { h.ServeHTTP(w, httptest.NewRequest("GET", auditPath, nil)) }) {
				t.Fatal("failed I/O did not abort")
			}
			if name == "capability" && (b.calls.Load() != 0 || s.calls.Load() != 0) {
				t.Fatal("unbounded capability fallback reached services")
			}
		})
	}
}

func TestAuditHTTPPurePreauthenticationBudgetAndCallbackJoin(t *testing.T) {
	for _, tc := range []struct {
		name         string
		parentBudget time.Duration
	}{{"local-three-seconds", time.Minute}, {"earlier-parent", 50 * time.Millisecond}} {
		t.Run(tc.name, func(t *testing.T) {
			parent, cancel := context.WithTimeout(context.Background(), tc.parentBudget)
			defer cancel()
			parentDeadline, _ := parent.Deadline()
			entered, release := make(chan struct{}), make(chan struct{})
			var once sync.Once
			w := newBudgetWriter()
			w.setRead = func(at time.Time) error {
				if !at.IsZero() && !at.After(time.Now()) {
					once.Do(func() { close(entered); <-release })
				}
				return nil
			}
			body := &closeBody{Reader: strings.NewReader("")}
			started := time.Now()
			b := &testBoundary{auth: func(r *http.Request) (identity.Actor, error) {
				enteredAt := time.Now()
				actual, _ := r.Context().Deadline()
				if tc.parentBudget < readBudget && !actual.Equal(parentDeadline) {
					t.Error("earlier parent was extended before auth")
				}
				if tc.parentBudget > readBudget && (actual.Before(started.Add(readBudget)) || actual.After(enteredAt.Add(readBudget)) || !actual.Before(parentDeadline)) {
					t.Error("local budget did not start before authentication")
				}
				<-r.Context().Done()
				if !errors.Is(r.Context().Err(), context.DeadlineExceeded) || tc.parentBudget > readBudget && parent.Err() != nil {
					t.Error("wrong actual context cancellation")
				}
				<-entered // only the cancellation callback can reach the gate before auth returns
				return identity.Actor{}, r.Context().Err()
			}}
			s := &testReader{}
			r := httptest.NewRequest("GET", auditPath, nil).WithContext(parent)
			r.Body = body
			done, joined := make(chan bool, 1), make(chan struct{})
			var releaseOnce sync.Once
			go func() { defer close(joined); done <- aborts(func() { (&systemHTTP{s, b}).ServeHTTP(w, r) }) }()
			t.Cleanup(func() { cancel(); releaseOnce.Do(func() { close(release) }); <-joined })
			select {
			case <-entered:
			case <-time.After(readBudget + time.Second):
				t.Fatal("cancel callback did not run")
			}
			select {
			case <-done:
				t.Fatal("handler returned before cancellation I/O tail")
			default:
			}
			if s.calls.Load() != 0 {
				t.Fatal("late preauth reached audit")
			}
			releaseOnce.Do(func() { close(release) })
			if !<-done || body.closed.Load() != 1 {
				t.Fatal("cancel failed to abort/close")
			}
			<-joined
			w.mu.Lock()
			defer w.mu.Unlock()
			if !w.reads[len(w.reads)-1].IsZero() || !w.writes[len(w.writes)-1].IsZero() {
				t.Fatal("deadline cleared before callback joined")
			}
		})
	}
}

