# Copy to .env at the project root. After changes, run compose up again.
COMPOSE_PROJECT_NAME=agenteam-dev
# Development access from any host; false restores strict HTTPS/origin checks.
AGENTEAM_DEV_MODE=true
AGENTEAM_DEV_PORT=8080
# Relative paths resolve from the project root; absolute paths also work.
AGENTEAM_DEV_DATA_DIR=./.dev
