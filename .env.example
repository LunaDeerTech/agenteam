# Copy this file to .env in the repository root. Docker Compose loads .env for
# interpolation; it is not a Central environment file. Shell variables override
# these values. After changes, run compose up again, not just restart app.
COMPOSE_PROJECT_NAME=agenteam-dev

# Local browser entry: http://localhost:8080. This also sets Central's matching
# PUBLIC_ORIGIN. Database and MinIO ports stay private to the Compose network.
AGENTEAM_DEV_PORT=8080

# Set before the first start (Linux: id -u / id -g). Positive IDs only; keep the
# same IDs when reusing .dev, whose files and ProcessGuard belong to this user.
AGENTEAM_DEV_UID=1000
AGENTEAM_DEV_GID=1000

# Development-only credentials. Choose your own values before the first start.
# Keep them with existing .dev data: changing PostgreSQL's environment alone
# does not rotate an already initialized database role's password.
# Use printable ASCII without spaces. Single-quote values containing $ or #.
AGENTEAM_DEV_DATABASE_PASSWORD='agenteam-local-development'
AGENTEAM_DEV_MINIO_ROOT_USER='agenteam'
AGENTEAM_DEV_MINIO_ROOT_PASSWORD='agenteam-local-development-minio'

# Pinned official object storage image. Override only with a compatible image.
AGENTEAM_DEV_MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z

# Five independent keyrings and the machine ID are generated once in .dev/config.
# Do not put model API keys here. Execution Runtime remains disabled.
