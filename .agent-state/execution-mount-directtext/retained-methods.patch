+"""Offline selector controls only; never invoke native harness entry points."""
+import ast
+import hashlib
+import json
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[5]
+OUT = Path(__file__).resolve().parent
+SELECTOR = '^TestExecutionMountFirstRound$'
+TOP = 'TestExecutionMountFirstRound'
+CASES = frozenset((TOP, TOP + '/nonempty-terminal-and-historical-replay',
+                   TOP + '/held-join-terminal-rollback-and-unknown'))
+PATHS = {
+    'driver': '.agent-state/work-owner-http/root_chain_driver.py',
+    'supervisor': '.agent-state/task-planning-recovery/pg_only_supervisor.py',
+}
+
+
+def constants_and_functions(raw, filename):
+    # Imports needed by these maps/functions only. Do not execute module-level
+    # calls or main; function definitions retain their original unchanged AST.
+    tree = ast.parse(raw, filename=filename)
+    selected = []
+    for node in tree.body:
+        if isinstance(node, (ast.Assign, ast.AnnAssign, ast.FunctionDef)):
+            selected.append(node)
+    namespace = {'__file__': filename, 'Path': Path, 're': re}
+    exec(compile(ast.Module(body=selected, type_ignores=[]), filename, 'exec'), namespace)
+    return tree, namespace
+
+
+def strip_new_key(tree, name):
+    matches = 0
+    for node in tree.body:
+        if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == name for t in node.targets):
+            assert isinstance(node.value, ast.Dict)
+            keep = []
+            for key, value in zip(node.value.keys, node.value.values):
+                if isinstance(key, ast.Constant) and key.value == SELECTOR:
+                    matches += 1
+                else:
+                    keep.append((key, value))
+            node.value.keys = [k for k, _ in keep]
+            node.value.values = [v for _, v in keep]
+    assert matches == 1
+    return ast.dump(tree, include_attributes=False)
+
+
+loaded = {}
+hashes = {}
+for label, relative in PATHS.items():
+    filename = str(ROOT / relative)
+    raw = Path(filename).read_text()
+    before = (OUT / (label + '-before.py')).read_text()
+    current_tree, current = constants_and_functions(raw, filename)
+    old_tree, old = constants_and_functions(before, filename)
+    key = 'METADATA_INPUTS' if label == 'driver' else 'METADATA_GROUPS'
+    assert strip_new_key(current_tree, key) == ast.dump(old_tree, include_attributes=False)
+    assert {k: v for k, v in current[key].items() if k != SELECTOR} == old[key]
+    if label == 'driver':
+        assert current['TARGETS'][SELECTOR] == 'tests/projectvariable'
+        assert {k: v for k, v in current['TARGETS'].items() if k != SELECTOR} == old['TARGETS']
+        assert set(old['METADATA_INPUTS']['^TestExecutionMountCapture$']).issubset(current[key][SELECTOR])
+        assert all((ROOT / p).is_file() and not (ROOT / p).is_symlink() for p in current[key][SELECTOR])
+    loaded[label] = current
+    hashes[relative] = hashlib.sha256(raw.encode()).hexdigest()
+
+supervisor = loaded['supervisor']
+assert supervisor['METADATA_GROUPS'][SELECTOR] == CASES
+
+
+def transcript(cases, selector=SELECTOR):
+    # Synthetic control data, explicitly not actual Go or native evidence.
+    return '\n'.join([*(f'=== RUN   {n}' for n in sorted(cases)),
+                      *(f'--- PASS: {n} (0.00s)' for n in sorted(cases)),
+                      f'D03 explicit test actual_wait pid=123 code=0 selector={selector}', ''])
+
+
+verify = supervisor['metadata_results']
+assert verify(transcript(CASES), SELECTOR)
+assert not verify(transcript(CASES - {TOP + '/held-join-terminal-rollback-and-unknown'}), SELECTOR)
+assert not verify(transcript(CASES | {TOP + '/unregistered-case'}), SELECTOR)
+extra = '^TestExecutionMountFirstRound|TestUnregistered$'
+assert not verify(transcript(CASES, extra), extra)
+assert not verify(transcript(CASES).replace('code=0 ', 'code=1 '), SELECTOR)
+result = {'kind': 'offline synthetic Python controls', 'selector': SELECTOR,
+          'cases': sorted(CASES), 'same_ast_after_removing_new_key': True,
+          'old_effective_maps_unchanged': True, 'target': 'tests/projectvariable',
+          'positive': True, 'missing_sub_rejected': True, 'extra_sub_rejected': True,
+          'extra_selector_rejected': True, 'nonzero_wait_rejected': True,
+          'source_sha256': hashes, 'no_go_or_native': True}
+(OUT / 'result.json').write_text(json.dumps(result, indent=2, sort_keys=True) + '\n')
+print(json.dumps(result, sort_keys=True))
