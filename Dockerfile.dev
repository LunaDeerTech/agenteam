# syntax=docker/dockerfile:1
# The default target contains tools; application source is mounted at runtime.
FROM golang:1.27.1-alpine AS go
FROM node:24.12.0-alpine AS dev-toolchain
RUN --mount=type=secret,id=dev_ca \
    set -eu; \
    if [ -f /run/secrets/dev_ca ]; then \
        test -s /etc/ssl/cert.pem; \
        mkdir -p /usr/local/share/ca-certificates; \
        cp /run/secrets/dev_ca /usr/local/share/ca-certificates/dev-environment.crt; \
        chmod 0644 /usr/local/share/ca-certificates/dev-environment.crt; \
        printf '\n' >> /etc/ssl/cert.pem; \
        cat /run/secrets/dev_ca >> /etc/ssl/cert.pem; \
        printf '\n' >> /etc/ssl/cert.pem; \
    fi; \
    apk add --no-cache ca-certificates git su-exec; \
    update-ca-certificates
RUN rm -f /etc/machine-id && ln -s /dev-state/config/machine-id /etc/machine-id
COPY --from=go /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}" GOTOOLCHAIN=local
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
RUN test "$(go env GOVERSION)" = go1.27.1 && test "$(node --version)" = v24.12.0
WORKDIR /workspace

# The historical official release still publishes these verified assets.
# Do not use dl.min.io or the unavailable MinIO container repositories.
# Reuse the small official runtime already needed by the web service.
FROM nginx:1.28.0-alpine@sha256:30f1c0d78e0ad60901648be663a710bdadf19e4c10ac6782c235200619158284 AS minio
ARG TARGETOS
ARG TARGETARCH
RUN --mount=type=secret,id=dev_ca \
    set -eu; \
    test "$TARGETOS" = linux; \
    case "$TARGETARCH" in \
        amd64) minio_sha256=7c5bd8512c6e966455b1d198209358b2d191c77a83ab377c4073281065fb855f ;; \
        arm64) minio_sha256=5c83cd2cf151717ba0243f73e1c7802ff36e272b67144bdd7f1f7d684fd6f03d ;; \
        ppc64le) minio_sha256=bf2b20db16d1b9e598ffcaa8c775908b558512346f81d359437125a1f1048d13 ;; \
        *) echo "Unsupported MinIO release platform: $TARGETOS/$TARGETARCH" >&2; exit 1 ;; \
    esac; \
    if [ -f /run/secrets/dev_ca ]; then \
        test -s /etc/ssl/cert.pem; \
        printf '\n' >> /etc/ssl/cert.pem; \
        cat /run/secrets/dev_ca >> /etc/ssl/cert.pem; \
        printf '\n' >> /etc/ssl/cert.pem; \
    fi; \
    minio_release=RELEASE.2025-09-07T16-13-09Z; \
    minio_source=https://raw.githubusercontent.com/minio/minio/07c3a429bfed433e49018cb0f78a52145d4bedeb; \
    curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --cacert /etc/ssl/cert.pem --output /tmp/minio.download "https://github.com/minio/minio/releases/download/$minio_release/minio.linux-$TARGETARCH.$minio_release"; \
    printf '%s  /tmp/minio.download\n' "$minio_sha256" | sha256sum -c -; \
    mkdir -p /usr/share/licenses/minio /data; \
    curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --cacert /etc/ssl/cert.pem --output /usr/bin/docker-entrypoint.sh "$minio_source/dockerscripts/docker-entrypoint.sh"; \
    curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --cacert /etc/ssl/cert.pem --output /usr/share/licenses/minio/LICENSE "$minio_source/LICENSE"; \
    mv /tmp/minio.download /usr/local/bin/minio; \
    chmod 0755 /usr/local/bin/minio /usr/bin/docker-entrypoint.sh
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
    org.opencontainers.image.revision="07c3a429bfed433e49018cb0f78a52145d4bedeb" \
    org.opencontainers.image.version="RELEASE.2025-09-07T16-13-09Z" \
    org.opencontainers.image.licenses="AGPL-3.0-or-later"
WORKDIR /data
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/docker-entrypoint.sh"]
CMD ["server", "/data", "--console-address", ":9001"]

# Keep an unqualified `docker build -f Dockerfile.dev` a toolchain build.
FROM dev-toolchain AS toolchain
